---
// One documentation page, laid out like a product manual rather than a
// marketing page: a fixed column of navigation on the left (the site's own
// header and footer are not shown here), this page's prose in the middle, and
// the rail of its own headings on the right. Below 1024px the navigation folds
// into a drawer behind a slim top bar.
import MarketingLayout from "../components/marketing/MarketingLayout.astro"
import { docsNav, docsOrder, groupOf, neighbours } from "../data/docs-nav"
import "../styles/docs.css"
import "../styles/docs-shell.css"

interface Props {
  /** The page's id, which is also its slug and its entry in docs-nav. */
  id?: string
  /** For the introduction, which is not a leaf in the navigation. */
  title?: string
  eyebrow?: string
  description?: string
}

const { id, title, eyebrow, description } = Astro.props
const entry = id ? docsOrder.find((link) => link.id === id) : undefined
if (id && !entry) throw new Error(`/docs/${id} has no entry in docs-nav.ts`)
const heading = entry?.title ?? title ?? "Documentation"
const blurb = entry?.blurb ?? description ?? ""
const group = id ? groupOf(id) : (eyebrow ?? "Documentation")
const { previous, next } = id ? neighbours(id) : { previous: undefined, next: docsOrder[0] }

// Lucide-style strokes, drawn inline so the sidebar needs no icon package.
const icons = {
  docs: '<path d="M2 4h6a4 4 0 0 1 4 4v12a3 3 0 0 0-3-3H2z"/><path d="M22 4h-6a4 4 0 0 0-4 4v12a3 3 0 0 1 3-3h7z"/>',
  releases: '<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/>',
  home: '<path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
  download: '<path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/>',
}

const primary: { label: string; href: string; icon: keyof typeof icons; current?: boolean }[] = [
  { label: "Documentation", href: "/docs", icon: "docs", current: true },
  { label: "Releases", href: "/releases", icon: "releases" },
  { label: "Vector home", href: "/", icon: "home" },
  { label: "Download", href: "/download", icon: "download" },
]

const footer: [string, string][] = [
  ["FAQ", "/docs/faq"],
  ["Troubleshooting", "/docs/troubleshooting"],
  ["Log in", "/login"],
]


---

<MarketingLayout title={`${heading} — Vector docs`} description={blurb}>
  <div class="docs-page">
    <header class="dx-top">
      <a class="dx-brand" href="/" aria-label="Vector home">
        <img src="/vector-logo.png" alt="" width="26" height="26" />
        <span>Vector</span>
        <em>Docs</em>
      </a>
      <div class="dx-top-actions">
        <button class="dx-icon-button" type="button" aria-label="Search the documentation" data-open-search>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle><line x1="16.5" y1="16.5" x2="21" y2="21"></line>
          </svg>
        </button>
      </div>
    </header>

    <button class="dx-crumbbar" type="button" aria-expanded="false" data-drawer-open>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <line x1="4" y1="7" x2="20" y2="7"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="17" x2="20" y2="17"></line>
      </svg>
      <span class="dx-crumbbar-group">{group}</span>
      <svg class="dx-crumbbar-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <path d="m9 6 6 6-6 6"></path>
      </svg>
      <b>{heading}</b>
    </button>

    <div class="dx-scrim" data-scrim hidden></div>

    <aside class="dx-side" data-drawer aria-label="Documentation">
      <div class="dx-side-head">
        <a class="dx-brand" href="/" aria-label="Vector home">
          <img src="/vector-logo.png" alt="" width="26" height="26" />
          <span>Vector</span>
          <em>Docs</em>
        </a>
        <button class="dx-icon-button dx-drawer-close" type="button" aria-label="Close navigation" data-drawer-close>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>

      <div class="dx-search-row">
        <div class="dx-search">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle><line x1="16.5" y1="16.5" x2="21" y2="21"></line>
          </svg>
          <input type="search" placeholder="Search..." aria-label="Search the documentation" data-dx-search />
          <kbd data-search-hint>⌘K</kbd>
          <div class="dx-results" data-dx-results hidden></div>
        </div>
      </div>

      <nav class="dx-nav" aria-label="Documentation sections">
        <ul class="dx-primary">
          {
            primary.map((link) => (
              <li>
                <a href={link.href} class:list={{ current: link.current }} aria-current={link.current ? "page" : undefined}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[link.icon]} />
                  <span>{link.label}</span>
                </a>
              </li>
            ))
          }
        </ul>

        {
          docsNav.map((navGroup) => (
            <div class="dx-group">
              <p class="dx-group-label">{navGroup.label}</p>
              <ul>
                {navGroup.links.map((link) => (
                  <li>
                    <a
                      href={`/docs/${link.id}`}
                      class:list={{ current: link.id === id }}
                      aria-current={link.id === id ? "page" : undefined}
                    >
                      {link.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>

      <ul class="dx-side-foot">
        {
          footer.map(([label, href]) => (
            <li>
              <a href={href}>
                <span>{label}</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M7 17 17 7"></path><path d="M9 7h8v8"></path>
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </aside>

    <div class="dx-stage">
      <main class="dx-main">
        <p class="dx-eyebrow">{group}</p>
        <h1 class="dx-title">{heading}</h1>

        <div class="dx-body docs-content">
          <section class="doc-section" id={id ?? "docs"}>
            <slot />
          </section>
        </div>

        <nav class="dx-pager" aria-label="More documentation">
          {
            previous ? (
              <a class="dx-pager-link" href={`/docs/${previous.id}`} rel="prev">
                <span class="dx-pager-dir">Previous</span>
                <b>{previous.title}</b>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a class="dx-pager-link dx-pager-next" href={`/docs/${next.id}`} rel="next">
                <span class="dx-pager-dir">Next</span>
                <b>{next.title}</b>
              </a>
            )
          }
        </nav>

      </main>

      <aside class="dx-rail" aria-label="On this page">
        <div class="dx-rail-inner">
          <p class="dx-rail-title">On this page</p>
          <ol class="dx-rail-list" data-dx-rail></ol>
        </div>
      </aside>
    </div>
  </div>
</MarketingLayout>

<script is:inline define:vars={{ index: docsOrder.map((l) => ({ i: l.id, t: l.title, b: l.blurb, g: groupOf(l.id) })) }}>
  window.__docsIndex = index
</script>

<script>
  type Page = { i: string; t: string; b: string; g: string }
  const pages: Page[] = (window as any).__docsIndex ?? []
  const isMac = /Mac|iPhone|iPad/.test(navigator.platform)

  const escape = (text: string) =>
    text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;")

  const matches = (query: string, limit: number) => {
    const words = query.toLowerCase().split(/\s+/).filter((word) => word.length > 2 || query.trim().length <= 2)
    if (!words.length) return []
    const scored = pages
      .map((page) => {
        const hay = `${page.t} ${page.g} ${page.b}`.toLowerCase()
        const hits = words.filter((word) => hay.includes(word)).length
        const title = page.t.toLowerCase()
        return { page, hits, lead: title.startsWith(query.toLowerCase()) ? 1 : 0, inTitle: words.filter((w) => title.includes(w)).length }
      })
      .filter((row) => row.hits > 0)
      .sort((a, b) => b.lead - a.lead || b.hits - a.hits || b.inTitle - a.inTitle)
    return scored.slice(0, limit).map((row) => row.page)
  }

  // ---- the rail: this page's own headings ------------------------------------
  const body = document.querySelector<HTMLElement>(".dx-body")
  const rail = document.querySelector<HTMLElement>("[data-dx-rail]")
  const railColumn = document.querySelector<HTMLElement>(".dx-rail")

  const slug = (text: string) =>
    text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 60)

  const headings = body ? [...body.querySelectorAll<HTMLElement>("h2, h3")] : []
  const used = new Set([...document.querySelectorAll("[id]")].map((element) => element.id))
  for (const heading of headings) {
    if (heading.id) continue
    let candidate = slug(heading.textContent ?? "")
    let n = 2
    while (!candidate || used.has(candidate)) candidate = `${slug(heading.textContent ?? "section")}-${n++}`
    used.add(candidate)
    heading.id = candidate
  }

  if (rail && railColumn) {
    if (!headings.length) railColumn.dataset.empty = "true"
    else
      rail.innerHTML = headings
        .map(
          (heading) =>
            `<li class="${heading.tagName === "H3" ? "is-sub" : ""}"><a href="#${heading.id}">${escape((heading.textContent ?? "").trim())}</a></li>`,
        )
        .join("")
  }

  const railLinks = rail ? [...rail.querySelectorAll<HTMLAnchorElement>("a")] : []
  const markRail = () => {
    let current = railLinks[0]
    for (const link of railLinks) {
      const target = document.getElementById(decodeURIComponent(link.hash.slice(1)))
      if (target && target.getBoundingClientRect().top <= 120) current = link
    }
    for (const link of railLinks) link.classList.toggle("is-active", link === current)
  }
  addEventListener("scroll", markRail, { passive: true })
  markRail()

  // ---- the drawer, below 1024px ----------------------------------------------
  const drawer = document.querySelector<HTMLElement>("[data-drawer]")
  const scrim = document.querySelector<HTMLElement>("[data-scrim]")
  const openButton = document.querySelector<HTMLButtonElement>("[data-drawer-open]")
  const drawerMode = () => matchMedia("(max-width: 1023.98px)").matches
  const setDrawer = (open: boolean) => {
    drawer?.classList.toggle("is-open", open)
    if (scrim) scrim.hidden = !open
    openButton?.setAttribute("aria-expanded", String(open))
    document.documentElement.style.overflow = open ? "hidden" : ""
  }
  openButton?.addEventListener("click", () => setDrawer(!drawer?.classList.contains("is-open")))
  scrim?.addEventListener("click", () => setDrawer(false))
  document.querySelector("[data-drawer-close]")?.addEventListener("click", () => setDrawer(false))
  drawer?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) setDrawer(false)
  })
  matchMedia("(max-width: 1023.98px)").addEventListener("change", (event) => {
    if (!event.matches) setDrawer(false)
  })

  // The current page's nav entry should be in view when the sidebar is long,
  // without scrolling at all when it is already visible.
  const currentLink = document.querySelector<HTMLElement>(".dx-nav .dx-group a.current")
  const scroller = document.querySelector<HTMLElement>(".dx-nav")
  if (currentLink && scroller) {
    const offset = currentLink.getBoundingClientRect().top - scroller.getBoundingClientRect().top
    if (offset + currentLink.offsetHeight > scroller.clientHeight - 24)
      scroller.scrollTop = offset - scroller.clientHeight / 2
  }

  // ---- search over every page -------------------------------------------------
  const input = document.querySelector<HTMLInputElement>("[data-dx-search]")
  const results = document.querySelector<HTMLElement>("[data-dx-results]")
  const searchHint = document.querySelector<HTMLElement>("[data-search-hint]")
  if (searchHint) searchHint.textContent = isMac ? "⌘K" : "Ctrl K"

  const run = () => {
    if (!input || !results) return
    const query = input.value.trim()
    if (!query) {
      results.hidden = true
      return
    }
    const rows = matches(query, 8)
    results.innerHTML = rows.length
      ? rows
          .map((page) => `<a href="/docs/${page.i}"><b>${escape(page.t)}</b><span>${escape(page.g)}</span></a>`)
          .join("")
      : '<p class="dx-none">Nothing matches.</p>'
    results.hidden = false
  }

  const focusSearch = () => {
    if (drawerMode()) setDrawer(true)
    requestAnimationFrame(() => input?.focus())
  }

  input?.addEventListener("input", run)
  input?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      input.value = ""
      if (results) results.hidden = true
      input.blur()
    }
    if (event.key === "Enter") {
      const first = results?.querySelector("a")
      if (first) (first as HTMLAnchorElement).click()
    }
  })
  document.querySelectorAll("[data-open-search]").forEach((button) => button.addEventListener("click", focusSearch))
  document.addEventListener("click", (event) => {
    if (results && !results.contains(event.target as Node) && event.target !== input) results.hidden = true
  })

  // ---- keyboard ---------------------------------------------------------------
  window.addEventListener("keydown", (event) => {
    const typing = event.target instanceof Element && event.target.closest("input, textarea, [contenteditable]")
    const mod = event.metaKey || event.ctrlKey
    if (mod && event.key.toLowerCase() === "k") {
      event.preventDefault()
      focusSearch()
    } else if (event.key === "/" && !typing) {
      event.preventDefault()
      focusSearch()
    } else if (event.key === "Escape") {
      setDrawer(false)
    }
  })
</script>
