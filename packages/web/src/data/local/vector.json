{
  "$schema": "https://vectordev.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "model": "company/coder",
  "small_model": "company/small",
  "provider": {
    "company": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Company model servers",
      "options": {
        "baseURL": "https://llm.corp.example.com/v1"
      },
      "models": {
        "coder": {
          "name": "Coder",
          "tool_call": true,
          "limit": { "context": 131072, "output": 8192 }
        },
        "small": {
          "name": "Small",
          "tool_call": true,
          "limit": { "context": 32768, "output": 4096 }
        }
      }
    }
  },
  "computer": {
    "enabled": true,
    "default_app_access": "ask",
    "allow_always": true,
    "background": true,
    "keep_awake": true,
    "away_minutes": 30,
    "screenshot_retention_days": 7,
    "max_actions": 300,
    "max_minutes": 45,
    "native_tools": "off",
    "screenshots": {
      "keep": 3,
      "max_width": 1440,
      "max_height": 900
    },
    "apps": {
      "macos": {
        "com.apple.calculator": "allow",
        "com.microsoft.Excel@UBF8T346G9": "deny"
      },
      "windows": [
        {
          "aumid": "Microsoft.WindowsCalculator_8wekyb3d8bbwe!App",
          "access": "allow"
        },
        {
          "publisher": "Microsoft Corporation",
          "product": "Microsoft Excel",
          "binary": "EXCEL.EXE",
          "access": "deny"
        }
      ]
    }
  },
  "local": {
    "enabled": true,
    "lock": true,
    "web": "network",
    "endpoints": ["https://llm.corp.example.com", "https://*.ml.corp.example.com"],
    "user_may": ["endpoints", "web"],
    "endpoint_domains": ["*.corp.example.com"],
    "web_domains": {
      "allow": ["docs.corp.example.com"],
      "deny": []
    },
    "locked_keys": ["model", "small_model"],
    "ca": { "files": ["corp-root.pem"] },
    "updates": {
      "url": "https://mirror.corp.example.com/vector/"
    },
    "log": { "retain_days": 90 }
  }
}
