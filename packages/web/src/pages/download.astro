---
import MarketingFooter from "../components/marketing/MarketingFooter.astro"
import MarketingLayout from "../components/marketing/MarketingLayout.astro"
import MarketingNav from "../components/marketing/MarketingNav.astro"

export const prerender = true

const platforms = [
  { id: "mac-arm64", family: "macOS", label: "Apple silicon", detail: "M1, M2, M3, M4, and newer" },
  { id: "mac-x64", family: "macOS", label: "Intel", detail: "Intel-based Mac computers" },
  { id: "windows-x64", family: "Windows", label: "64-bit", detail: "Most Windows 10 and 11 computers" },
  { id: "windows-arm64", family: "Windows", label: "ARM64", detail: "Windows computers with ARM processors" },
  { id: "linux-x64", family: "Linux", label: "x86_64 AppImage", detail: "Most Intel and AMD Linux computers" },
  { id: "linux-arm64", family: "Linux", label: "ARM64 AppImage", detail: "Linux computers with ARM processors" },
]
---

<MarketingLayout
  title="Buy Vector - $99/year"
  description="Purchase Vector for $99 per year. Includes the desktop app, updates, and one active computer."
>
  <div class="purchase-page">
    <MarketingNav active="download" />

    <main>
      <section class="purchase-hero">
        <div class="purchase-copy">
          <p class="eyebrow">Vector 1.17.29</p>
          <h1>Own your engineering workspace.</h1>
          <p class="lede">
            One annual license for the complete Vector desktop experience: agent sessions, a real editor,
            terminal, controlled browser, isolated workspaces, review, and publishing through your accounts.
          </p>

          <div class="included-list">
            <span><i aria-hidden="true"></i> macOS, Windows, and Linux</span>
            <span><i aria-hidden="true"></i> All desktop updates during the paid year</span>
            <span><i aria-hidden="true"></i> One active computer at a time</span>
            <span><i aria-hidden="true"></i> Bring your own models and provider keys</span>
          </div>
        </div>

        <form class="purchase-card" data-purchase-form>
          <div class="price-row">
            <div>
              <span>Vector annual license</span>
              <strong>$99</strong>
            </div>
            <small>per year</small>
          </div>

          <label class="email-field">
            <span>Purchase email</span>
            <input data-purchase-email type="email" name="email" autocomplete="email" placeholder="you@example.com" required />
          </label>

          <fieldset>
            <legend>Choose your computer</legend>
            <div class="platform-grid">
              {platforms.map((platform, index) => (
                <label class="platform-option">
                  <input type="radio" name="platform" value={platform.id} checked={index === 0} />
                  <span>
                    <b>{platform.family} · {platform.label}</b>
                    <small>{platform.detail}</small>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <label class="terms-row">
            <input data-purchase-terms type="checkbox" required />
            <span>
              I agree to the <a href="/legal/license" target="_blank">software license</a> and
              <a href="/legal/terms" target="_blank">subscription terms</a>. The plan renews yearly until cancelled.
            </span>
          </label>

          <button class="purchase-button" type="submit" data-purchase-button disabled>
            <span data-purchase-button-label>Checking availability...</span>
            <b aria-hidden="true">→</b>
          </button>
          <p class="purchase-status" data-purchase-status role="status" aria-live="polite"></p>
          <p class="secure-note">Secure checkout and billing by Stripe. A purchase receipt and license key are emailed to you.</p>
        </form>
      </section>

      <section class="license-explainer">
        <div>
          <p class="eyebrow">How access works</p>
          <h2>A license that belongs to you.</h2>
        </div>
        <div class="steps">
          <article><span>01</span><h3>Purchase securely</h3><p>Stripe handles payment. Vector never receives your card number.</p></article>
          <article><span>02</span><h3>Receive your key</h3><p>Your private license key and download link arrive by email.</p></article>
          <article><span>03</span><h3>Activate one computer</h3><p>Use Vector on one active machine, with a seven-day offline grace period.</p></article>
          <article><span>04</span><h3>Control renewal</h3><p>Cancel in Vector Settings at any time. Access continues through the paid year.</p></article>
        </div>
      </section>

      <section class="purchase-note">
        <div><p class="eyebrow">Already purchased?</p><h2>Open Vector and enter the key from your email.</h2></div>
        <a href="/docs">Read the installation guide <span aria-hidden="true">→</span></a>
      </section>
    </main>

    <MarketingFooter />
  </div>
</MarketingLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-purchase-form]")
  const button = document.querySelector<HTMLButtonElement>("[data-purchase-button]")
  const label = document.querySelector<HTMLElement>("[data-purchase-button-label]")
  const status = document.querySelector<HTMLElement>("[data-purchase-status]")
  let available = false

  const selectedFromQuery = new URLSearchParams(location.search).get("target")
  if (selectedFromQuery) {
    const option = form?.querySelector<HTMLInputElement>(`input[name="platform"][value="${CSS.escape(selectedFromQuery)}"]`)
    if (option) option.checked = true
  }

  fetch("/api/billing/config", { headers: { accept: "application/json" } })
    .then(async (response) => {
      const payload = await response.json()
      available = Boolean(response.ok && payload.available)
      if (!button || !label || !status) return
      button.disabled = !available
      label.textContent = available ? "Continue to secure checkout" : "Paid launch is being configured"
      if (!available) status.textContent = "Purchases are not open yet. Current beta users can continue using their installed build."
    })
    .catch(() => {
      if (!label || !status) return
      label.textContent = "Checkout temporarily unavailable"
      status.textContent = "Vector could not reach the billing service. Please try again shortly."
    })

  form?.addEventListener("submit", async (event) => {
    event.preventDefault()
    if (!available || !button || !label || !status) return
    const email = form.querySelector<HTMLInputElement>("[data-purchase-email]")?.value.trim()
    const termsAccepted = Boolean(form.querySelector<HTMLInputElement>("[data-purchase-terms]")?.checked)
    const target = form.querySelector<HTMLInputElement>('input[name="platform"]:checked')?.value
    if (!email || !termsAccepted || !target) return form.reportValidity()

    button.disabled = true
    label.textContent = "Opening Stripe..."
    status.textContent = ""
    try {
      sessionStorage.setItem("vector-purchase-target", target)
      const response = await fetch("/api/billing/checkout", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ email, termsAccepted }),
      })
      const payload = await response.json()
      if (!response.ok || !payload.url) throw new Error(payload.error?.message || "Checkout could not start.")
      location.assign(payload.url)
    } catch (cause) {
      button.disabled = false
      label.textContent = "Continue to secure checkout"
      status.textContent = cause instanceof Error ? cause.message : "Checkout could not start."
    }
  })
</script>

<style>
  .purchase-page { min-width: 320px; overflow: hidden; background: rgba(8, 6, 13, 0.58); }
  main { width: min(1120px, calc(100% - 48px)); margin: 0 auto; }
  .eyebrow { margin: 0 0 16px; color: var(--accent-strong); font-size: 11px; font-weight: 680; text-transform: uppercase; }
  .purchase-hero { min-height: 760px; padding: 86px 0 100px; display: grid; grid-template-columns: minmax(0, 1fr) 450px; align-items: center; gap: 80px; }
  .purchase-copy h1 { max-width: 650px; margin: 0; color: var(--ink); font-size: clamp(52px, 6.5vw, 82px); font-weight: 560; line-height: .98; }
  .lede { max-width: 650px; margin: 28px 0 0; color: var(--muted-strong); font-size: 17px; line-height: 1.7; }
  .included-list { margin-top: 34px; display: grid; gap: 13px; color: rgba(245, 242, 248, .72); font-size: 13px; }
  .included-list span { display: flex; align-items: center; gap: 10px; }
  .included-list i { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px rgba(170, 140, 255, .1); }
  .purchase-card { padding: 28px; color: var(--ink); background: var(--glass-fill-strong); border: 1px solid var(--glass-line-strong); border-radius: 24px; box-shadow: var(--glass-shadow); backdrop-filter: blur(30px) saturate(150%); }
  .price-row { padding-bottom: 22px; display: flex; align-items: end; justify-content: space-between; border-bottom: 1px solid var(--line); }
  .price-row div { display: grid; gap: 6px; }
  .price-row span, fieldset legend, .email-field > span { color: var(--muted); font-size: 11px; }
  .price-row strong { font-size: 42px; font-weight: 570; line-height: 1; }
  .price-row small { color: var(--muted); font-size: 12px; }
  .email-field { margin-top: 22px; display: grid; gap: 8px; }
  .email-field input { min-height: 44px; padding: 0 13px; color: var(--ink); background: rgba(5, 4, 7, .42); border: 1px solid var(--line-strong); border-radius: 10px; outline: none; }
  .email-field input:focus { border-color: rgba(182, 147, 255, .6); box-shadow: 0 0 0 3px rgba(156, 109, 255, .12); }
  fieldset { margin: 20px 0 0; padding: 0; border: 0; }
  fieldset legend { margin-bottom: 9px; }
  .platform-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px; }
  .platform-option { position: relative; min-width: 0; }
  .platform-option input { position: absolute; opacity: 0; pointer-events: none; }
  .platform-option > span { min-height: 58px; padding: 10px 11px; display: grid; align-content: center; gap: 4px; background: rgba(255, 255, 255, .03); border: 1px solid var(--line); border-radius: 10px; cursor: pointer; }
  .platform-option b { overflow: hidden; color: rgba(245, 242, 248, .82); font-size: 11px; font-weight: 580; text-overflow: ellipsis; white-space: nowrap; }
  .platform-option small { overflow: hidden; color: var(--muted); font-size: 9px; text-overflow: ellipsis; white-space: nowrap; }
  .platform-option input:checked + span { background: rgba(155, 108, 255, .1); border-color: rgba(188, 157, 255, .38); box-shadow: inset 0 0 0 1px rgba(172, 130, 255, .1); }
  .terms-row { margin-top: 18px; display: grid; grid-template-columns: 16px 1fr; gap: 9px; color: var(--muted); font-size: 10px; line-height: 1.5; }
  .terms-row input { margin: 2px 0 0; accent-color: #a47aff; }
  .terms-row a { color: var(--accent-strong); }
  .purchase-button { width: 100%; min-height: 46px; margin-top: 20px; padding: 0 15px; display: flex; align-items: center; justify-content: space-between; color: #130e1b; background: #d2c3f8; border: 0; border-radius: 11px; font-size: 12px; font-weight: 650; cursor: pointer; }
  .purchase-button:disabled { cursor: default; opacity: .55; }
  .purchase-status { min-height: 0; margin: 11px 0 0; color: #e5b4b4; font-size: 10px; line-height: 1.45; }
  .purchase-status:empty { display: none; }
  .secure-note { margin: 15px 0 0; color: rgba(245, 242, 248, .35); font-size: 9px; line-height: 1.5; text-align: center; }
  .license-explainer { padding: 96px 0; display: grid; grid-template-columns: 320px 1fr; gap: 80px; border-top: 1px solid var(--line); }
  .license-explainer h2, .purchase-note h2 { margin: 0; color: var(--ink); font-size: 36px; font-weight: 560; line-height: 1.1; }
  .steps { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; overflow: hidden; background: var(--line); border: 1px solid var(--line); border-radius: 16px; }
  .steps article { padding: 23px; background: rgba(14, 11, 19, .88); }
  .steps span { color: var(--accent); font: 10px ui-monospace, monospace; }
  .steps h3 { margin: 18px 0 0; font-size: 14px; font-weight: 590; }
  .steps p { margin: 8px 0 0; color: var(--muted); font-size: 11px; line-height: 1.55; }
  .purchase-note { margin: 0 0 70px; padding: 34px; display: flex; align-items: end; justify-content: space-between; gap: 32px; background: var(--glass-fill); border: 1px solid var(--glass-line); border-radius: 20px; }
  .purchase-note a { color: var(--accent-strong); font-size: 12px; text-decoration: none; white-space: nowrap; }
  @media (max-width: 900px) { .purchase-hero { grid-template-columns: 1fr; gap: 48px; } .purchase-card { width: min(520px, 100%); } .license-explainer { grid-template-columns: 1fr; gap: 36px; } }
  @media (max-width: 600px) { main { width: min(100% - 28px, 1120px); } .purchase-hero { padding-top: 58px; } .purchase-copy h1 { font-size: 48px; } .purchase-card { padding: 20px; border-radius: 18px; } .platform-grid, .steps { grid-template-columns: 1fr; } .purchase-note { align-items: flex-start; flex-direction: column; } }
</style>
