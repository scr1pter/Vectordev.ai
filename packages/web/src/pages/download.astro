---
import MarketingFooter from "../components/marketing/MarketingFooter.astro"
import MarketingLayout from "../components/marketing/MarketingLayout.astro"
import MarketingNav from "../components/marketing/MarketingNav.astro"

export const prerender = true

const downloads = [
  {
    family: "macOS",
    mark: "mac",
    options: [
      {
        label: "Apple silicon",
        detail: "M1, M2, M3, M4, and newer Apple chips",
        href: "/download/mac-arm64",
        platform: "mac-arm64",
      },
      {
        label: "Intel",
        detail: "Intel-based Mac computers",
        href: "/download/mac-x64",
        platform: "mac-x64",
      },
    ],
  },
  {
    family: "Windows",
    mark: "win",
    options: [
      {
        label: "64-bit",
        detail: "Most Windows 10 and Windows 11 computers",
        href: "/download/windows",
        platform: "windows",
      },
      {
        label: "ARM64",
        detail: "Windows computers with an ARM processor",
        href: "/download/windows-arm64",
        platform: "windows-arm64",
      },
    ],
  },
  {
    family: "Linux",
    mark: "linux",
    options: [
      {
        label: "x86_64 AppImage",
        detail: "Most Intel and AMD Linux computers",
        href: "/download/linux",
        platform: "linux",
      },
      {
        label: "ARM64 AppImage",
        detail: "Linux computers with an ARM processor",
        href: "/download/linux-arm64",
        platform: "linux-arm64",
      },
    ],
  },
]
---

<MarketingLayout
  title="Download Vector"
  description="Download Vector for macOS, Windows, or Linux. Choose the installer that matches your computer."
>
  <div class="download-page">
    <MarketingNav active="download" />

    <main>
      <section class="download-hero">
        <div class="hero-copy">
          <p class="eyebrow">Vector 1.17.26</p>
          <h1>Your engineering workspace, on your computer.</h1>
          <p>
            Work with local repositories, your own model providers, a real editor, a controlled browser,
            isolated agents, and project publishing from one desktop application.
          </p>
        </div>

        <div class="recommended-card" data-recommended-card>
          <div class="recommended-copy">
            <span class="recommendation-label">Recommended for this computer</span>
            <h2 data-recommended-title>Choose your Vector installer</h2>
            <p data-recommended-detail>Select a platform below to begin the download.</p>
          </div>
          <a class="recommended-action" data-recommended-action href="#all-downloads">View downloads</a>
        </div>
      </section>

      <section id="all-downloads" class="downloads-section">
        <div class="section-heading">
          <p class="eyebrow">Desktop releases</p>
          <h2>Download for your platform.</h2>
        </div>

        <div class="platform-list">
          {downloads.map((platform) => (
            <article class="platform-row">
              <div class="platform-name">
                <span aria-hidden="true">{platform.mark}</span>
                <h3>{platform.family}</h3>
              </div>
              <div class="platform-options">
                {platform.options.map((option) => (
                  <a href={option.href} data-download={option.platform}>
                    <span>
                      <strong>{option.label}</strong>
                      <small>{option.detail}</small>
                    </span>
                    <b aria-hidden="true">↓</b>
                  </a>
                ))}
              </div>
            </article>
          ))}
        </div>

        <div class="release-meta">
          <span>Version 1.17.26</span>
          <span>Desktop installers</span>
          <a href="/download/checksums">Verify checksums</a>
        </div>
      </section>

      <section class="install-section">
        <div class="section-heading">
          <p class="eyebrow">Installation</p>
          <h2>Open the installer and start building.</h2>
        </div>
        <div class="install-grid">
          <article>
            <span>01</span>
            <h3>Install Vector</h3>
            <p>Open the downloaded file and complete the normal installation flow for your operating system.</p>
          </article>
          <article>
            <span>02</span>
            <h3>Open a repository</h3>
            <p>Select a local project. Vector keeps sessions, tools, and isolated work attached to it.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Connect a model</h3>
            <p>Add a supported provider in Settings, choose a model, and send the first engineering request.</p>
          </article>
        </div>
      </section>

      <section class="help-band">
        <div>
          <p class="eyebrow">Need a hand?</p>
          <h2>Setup is covered in the documentation.</h2>
        </div>
        <a href="/docs#install">Read the installation guide <span aria-hidden="true">→</span></a>
      </section>
    </main>

    <MarketingFooter />
  </div>
</MarketingLayout>

<script>
  const ua = navigator.userAgent.toLowerCase()
  const platform = navigator.platform.toLowerCase()
  const isArmMac =
    /mac/.test(platform) &&
    ((navigator as Navigator & { userAgentData?: { architecture?: string } }).userAgentData?.architecture === "arm" ||
      /arm|apple/.test(ua))

  let preferred: { selector: string; title: string; detail: string } | undefined

  if (/mac/.test(platform)) {
    preferred = isArmMac
      ? {
          selector: "mac-arm64",
          title: "Download Vector for Apple silicon",
          detail: "DMG installer for M1, M2, M3, M4, and newer Apple chips.",
        }
      : {
          selector: "mac-arm64",
          title: "Download Vector for macOS",
          detail: "Choose Apple silicon for modern Macs, or select Intel below.",
        }
  } else if (/win/.test(platform)) {
    preferred = {
      selector: "windows",
      title: "Download Vector for Windows",
      detail: "64-bit installer for most Windows 10 and Windows 11 computers.",
    }
  } else if (/linux/.test(platform)) {
    preferred = {
      selector: "linux",
      title: "Download Vector for Linux",
      detail: "x86_64 AppImage for most Intel and AMD Linux computers.",
    }
  }

  if (preferred) {
    const source = document.querySelector<HTMLAnchorElement>(`[data-download="${preferred.selector}"]`)
    const title = document.querySelector<HTMLElement>("[data-recommended-title]")
    const detail = document.querySelector<HTMLElement>("[data-recommended-detail]")
    const action = document.querySelector<HTMLAnchorElement>("[data-recommended-action]")

    if (source && title && detail && action) {
      title.textContent = preferred.title
      detail.textContent = preferred.detail
      action.textContent = "Download now"
      action.href = source.href
    }
  }
</script>

<style>
  .download-page {
    min-width: 320px;
    overflow: hidden;
    color: var(--ink);
    background: var(--page);
  }

  .eyebrow {
    margin: 0 0 16px;
    color: var(--accent-strong);
    font-size: 12px;
    font-weight: 720;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .download-hero,
  .downloads-section,
  .install-section,
  .help-band {
    width: min(1120px, calc(100% - 48px));
    margin: 0 auto;
  }

  .download-hero {
    min-height: 670px;
    padding: 92px 0 96px;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(340px, 0.75fr);
    align-items: center;
    gap: 84px;
    border-bottom: 1px solid var(--line-strong);
  }

  .hero-copy h1 {
    max-width: 700px;
    margin: 0;
    font-size: 72px;
    font-weight: 720;
    line-height: 1;
    letter-spacing: 0;
  }

  .hero-copy > p:not(.eyebrow) {
    max-width: 650px;
    margin: 28px 0 0;
    color: var(--muted-strong);
    font-size: 18px;
  }

  .recommended-card {
    min-height: 320px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: #f4f4f6;
    background: #171719;
    border: 1px solid #2d2d32;
    border-radius: 8px;
    box-shadow: 0 24px 54px rgba(0, 0, 0, 0.28);
    animation: settle-in 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .recommendation-label {
    color: #b9a8f6;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .recommended-copy h2 {
    margin: 42px 0 0;
    font-size: 32px;
    font-weight: 650;
    line-height: 1.12;
    letter-spacing: 0;
  }

  .recommended-copy p {
    margin: 14px 0 0;
    color: #a7a7af;
    font-size: 14px;
  }

  .recommended-action {
    min-height: 48px;
    padding: 0 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #171719;
    background: #b9a8f6;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: background 180ms ease, transform 180ms ease;
  }

  .recommended-action:hover {
    background: #d0c5fb;
    transform: translateY(-2px);
  }

  .downloads-section,
  .install-section {
    padding: 126px 0;
    border-bottom: 1px solid var(--line);
  }

  .section-heading {
    max-width: 720px;
  }

  .section-heading h2,
  .help-band h2 {
    margin: 0;
    font-size: 56px;
    font-weight: 680;
    line-height: 1.04;
    letter-spacing: 0;
  }

  .platform-list {
    margin-top: 68px;
    border-top: 1px solid var(--line-strong);
  }

  .platform-row {
    padding: 30px 0;
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 40px;
    border-bottom: 1px solid var(--line);
  }

  .platform-name {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .platform-name > span {
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-strong);
    background: var(--accent-soft);
    border-radius: 6px;
    font-size: 10px;
    font-weight: 760;
    text-transform: uppercase;
  }

  .platform-name h3 {
    margin: 0;
    font-size: 20px;
    font-weight: 660;
  }

  .platform-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .platform-options a {
    min-height: 82px;
    padding: 15px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    text-decoration: none;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .platform-options a:hover {
    background: var(--surface-soft);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .platform-options a > span {
    min-width: 0;
    display: grid;
    gap: 3px;
  }

  .platform-options strong {
    font-size: 14px;
  }

  .platform-options small {
    color: var(--muted);
    font-size: 11px;
  }

  .platform-options b {
    color: var(--accent-strong);
    font-size: 20px;
    font-weight: 500;
  }

  .release-meta {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    color: var(--muted);
    font-size: 12px;
  }

  .release-meta a {
    color: var(--accent-strong);
    text-decoration: none;
  }

  .install-grid {
    margin-top: 66px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
  }

  .install-grid article {
    min-height: 250px;
    padding: 26px 30px 28px 0;
    border-bottom: 1px solid var(--line);
  }

  .install-grid article + article {
    padding-left: 30px;
    border-left: 1px solid var(--line);
  }

  .install-grid span {
    color: var(--accent-strong);
    font-size: 11px;
    font-weight: 720;
  }

  .install-grid h3 {
    margin: 62px 0 10px;
    font-size: 20px;
  }

  .install-grid p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .help-band {
    padding: 120px 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 54px;
  }

  .help-band h2 {
    max-width: 720px;
  }

  .help-band a {
    flex: 0 0 auto;
    color: var(--ink);
    font-size: 14px;
    font-weight: 650;
    text-decoration: none;
  }

  .help-band a span {
    margin-left: 4px;
    display: inline-block;
    transition: transform 180ms ease;
  }

  .help-band a:hover span {
    transform: translateX(4px);
  }

  @keyframes settle-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 900px) {
    .download-hero {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .hero-copy h1 {
      font-size: 60px;
    }

    .recommended-card {
      min-height: 270px;
    }

    .platform-row {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  @media (max-width: 720px) {
    .download-hero,
    .downloads-section,
    .install-section,
    .help-band {
      width: min(100% - 28px, 1120px);
    }

    .download-hero {
      min-height: auto;
      padding: 62px 0 74px;
    }

    .hero-copy h1 {
      font-size: 46px;
    }

    .downloads-section,
    .install-section {
      padding: 92px 0;
    }

    .section-heading h2,
    .help-band h2 {
      font-size: 40px;
    }

    .platform-options,
    .install-grid {
      grid-template-columns: 1fr;
    }

    .install-grid article,
    .install-grid article + article {
      min-height: auto;
      padding: 24px 0 28px;
      border-left: 0;
    }

    .install-grid h3 {
      margin-top: 34px;
    }

    .help-band {
      align-items: flex-start;
      flex-direction: column;
      padding: 96px 0;
    }
  }
</style>
