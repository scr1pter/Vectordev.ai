---
import MarketingFooter from "../../components/marketing/MarketingFooter.astro"
import MarketingLayout from "../../components/marketing/MarketingLayout.astro"
import MarketingNav from "../../components/marketing/MarketingNav.astro"

export const prerender = true

const downloads = [
  ["mac-arm64", "macOS", "Apple silicon"],
  ["mac-x64", "macOS", "Intel"],
  ["windows-x64", "Windows", "64-bit"],
  ["windows-arm64", "Windows", "ARM64"],
  ["linux-x64", "Linux", "x86_64 AppImage"],
  ["linux-arm64", "Linux", "ARM64 AppImage"],
] as const
---

<MarketingLayout title="Your Vector license" description="Claim your Vector license and download the desktop application.">
  <div class="success-page">
    <MarketingNav active="download" />
    <main>
      <section class="success-card" data-success-card>
        <div class="success-loading" data-success-loading>
          <img src="/vector-logo.png" alt="" />
          <p>Confirming your Vector purchase...</p>
        </div>

        <div class="success-content" data-success-content hidden>
          <div class="success-icon"><span aria-hidden="true">✓</span></div>
          <p class="eyebrow">Purchase complete</p>
          <h1>Your Vector license is ready.</h1>
          <p class="success-lede">We also emailed this key to <strong data-customer-email></strong>. Keep it private.</p>

          <div class="license-box">
            <span>License key</span>
            <code data-license-key></code>
            <button type="button" data-copy-key>Copy key</button>
          </div>

          <div class="download-block">
            <div>
              <h2>Choose one installer</h2>
              <p>Your purchase includes one initial installer download. In-app updates are included during the paid subscription period.</p>
            </div>
            <div class="download-grid">
              {downloads.map(([target, family, label]) => (
                <a href="#" data-download-target={target}>
                  <span><strong>{family}</strong><small>{label}</small></span><b aria-hidden="true">↓</b>
                </a>
              ))}
            </div>
          </div>

          <div class="activation-help">
            <div><span>1</span><p>Install and open Vector.</p></div>
            <div><span>2</span><p>Paste the license key.</p></div>
            <div><span>3</span><p>Manage renewal in Settings → Billing &amp; license.</p></div>
          </div>
        </div>

        <div class="success-error" data-success-error hidden>
          <img src="/vector-logo.png" alt="" />
          <p class="eyebrow">Purchase lookup</p>
          <h1>We could not load this license.</h1>
          <p data-error-message>The checkout link is missing or expired.</p>
          <a href="/download">Return to purchase page</a>
        </div>
      </section>
    </main>
    <MarketingFooter />
  </div>
</MarketingLayout>

<script>
  const session = new URLSearchParams(location.search).get("session_id")
  const loading = document.querySelector<HTMLElement>("[data-success-loading]")
  const content = document.querySelector<HTMLElement>("[data-success-content]")
  const error = document.querySelector<HTMLElement>("[data-success-error]")
  const errorMessage = document.querySelector<HTMLElement>("[data-error-message]")

  const fail = (message: string) => {
    if (loading) loading.hidden = true
    if (content) content.hidden = true
    if (error) error.hidden = false
    if (errorMessage) errorMessage.textContent = message
  }

  if (!session) {
    fail("This page needs the Stripe checkout link from your purchase email.")
  } else {
    fetch(`/api/billing/claim?session_id=${encodeURIComponent(session)}`, { headers: { accept: "application/json" } })
      .then(async (response) => {
        const payload = await response.json()
        if (!response.ok || !payload.licenseKey || !payload.downloadToken) {
          throw new Error(payload.error?.message || "Vector could not confirm this purchase.")
        }
        if (loading) loading.hidden = true
        if (content) content.hidden = false
        const key = document.querySelector<HTMLElement>("[data-license-key]")
        const email = document.querySelector<HTMLElement>("[data-customer-email]")
        if (key) key.textContent = payload.licenseKey
        if (email) email.textContent = payload.status?.email || "your purchase email"

        document.querySelector<HTMLButtonElement>("[data-copy-key]")?.addEventListener("click", async (event) => {
          await navigator.clipboard.writeText(payload.licenseKey)
          event.currentTarget.textContent = "Copied"
        })

        const preferred = sessionStorage.getItem("vector-purchase-target")
        const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-download-target]")]
        for (const link of links) {
          const target = link.dataset.downloadTarget || ""
          link.href = `/api/billing/download?token=${encodeURIComponent(payload.downloadToken)}&target=${encodeURIComponent(target)}`
          if (preferred === target) link.dataset.recommended = "true"
          link.addEventListener("click", () => {
            for (const other of links) if (other !== link) other.setAttribute("aria-disabled", "true")
          })
        }
      })
      .catch((cause) => fail(cause instanceof Error ? cause.message : "Vector could not confirm this purchase."))
  }
</script>

<style>
  .success-page { min-height: 100vh; background: rgba(8, 6, 13, .62); }
  main { width: min(940px, calc(100% - 40px)); min-height: 760px; margin: 0 auto; padding: 82px 0 100px; }
  .success-card { min-height: 590px; padding: 46px; color: var(--ink); background: var(--glass-fill-strong); border: 1px solid var(--glass-line-strong); border-radius: 26px; box-shadow: var(--glass-shadow); backdrop-filter: blur(30px) saturate(150%); }
  [hidden] { display: none !important; }
  .success-loading { min-height: 480px; display: grid; place-items: center; align-content: center; gap: 16px; color: var(--muted); font-size: 13px; }
  .success-loading img, .success-error img { width: 44px; height: 44px; border-radius: 11px; }
  .success-icon { width: 44px; height: 44px; display: grid; place-items: center; color: #c9ffda; background: rgba(63, 190, 110, .11); border: 1px solid rgba(94, 225, 143, .19); border-radius: 50%; }
  .eyebrow { margin: 24px 0 8px; color: var(--accent-strong); font-size: 10px; font-weight: 680; text-transform: uppercase; }
  h1 { margin: 0; font-size: 42px; font-weight: 570; line-height: 1.08; }
  .success-lede { margin: 15px 0 0; color: var(--muted-strong); font-size: 13px; }
  .license-box { margin-top: 30px; padding: 16px; display: grid; grid-template-columns: 1fr auto; gap: 9px 16px; background: rgba(5, 4, 7, .4); border: 1px solid var(--line); border-radius: 13px; }
  .license-box span { grid-column: 1 / -1; color: var(--muted); font-size: 10px; }
  .license-box code { min-width: 0; overflow: hidden; color: #e2d7fb; font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
  .license-box button { padding: 0; color: var(--accent-strong); background: transparent; border: 0; font-size: 11px; cursor: pointer; }
  .download-block { margin-top: 36px; padding-top: 30px; border-top: 1px solid var(--line); }
  .download-block h2 { margin: 0; font-size: 20px; font-weight: 590; }
  .download-block > div > p { margin: 7px 0 0; color: var(--muted); font-size: 11px; }
  .download-grid { margin-top: 18px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .download-grid a { min-height: 62px; padding: 12px; display: flex; align-items: center; justify-content: space-between; color: var(--ink); background: rgba(255, 255, 255, .035); border: 1px solid var(--line); border-radius: 11px; text-decoration: none; }
  .download-grid a[data-recommended="true"] { background: rgba(155, 108, 255, .1); border-color: rgba(190, 160, 255, .35); }
  .download-grid a[aria-disabled="true"] { pointer-events: none; opacity: .35; }
  .download-grid span { display: grid; gap: 4px; }
  .download-grid strong { font-size: 11px; font-weight: 590; }
  .download-grid small { color: var(--muted); font-size: 9px; }
  .download-grid b { color: var(--accent); font-size: 15px; }
  .activation-help { margin-top: 28px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .activation-help > div { display: flex; gap: 9px; align-items: flex-start; }
  .activation-help span { width: 20px; height: 20px; flex: 0 0 auto; display: grid; place-items: center; color: var(--accent-strong); background: rgba(155, 108, 255, .09); border-radius: 50%; font-size: 9px; }
  .activation-help p { margin: 2px 0 0; color: var(--muted); font-size: 10px; line-height: 1.45; }
  .success-error { min-height: 480px; display: grid; place-items: start; align-content: center; max-width: 560px; margin: auto; text-align: left; }
  .success-error p:not(.eyebrow) { color: var(--muted); }
  .success-error a { margin-top: 20px; padding: 11px 15px; color: #17111f; background: #d1c1f7; border-radius: 10px; font-size: 11px; font-weight: 650; text-decoration: none; }
  @media (max-width: 720px) { .success-card { padding: 28px 22px; border-radius: 20px; } .download-grid, .activation-help { grid-template-columns: 1fr; } .license-box { grid-template-columns: 1fr; } .license-box button { justify-self: start; } h1 { font-size: 34px; } }
</style>
