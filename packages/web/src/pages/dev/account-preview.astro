---
import { AccountPage } from "../../components/marketing/account/AccountPage"
import MarketingLayout from "../../components/marketing/MarketingLayout.astro"

// Dev-only design harness for the logged-in account page. Never built for prod.
if (!import.meta.env.DEV) return Astro.redirect("/account")

const preview = { user: { id: "usr_preview", email: "krishna@vectordev.ai", name: "Krishna Bharadwaj" } }
---

<MarketingLayout title="Account preview (dev)" description="Design harness" noindex>
  <div class="account-environment">
    <AccountPage client:only="react" preview={preview} />
  </div>
</MarketingLayout>
