    question: "Does the browser replace Chrome or Firefox?",
    answer:
      "No. It is a controlled project browser for previewing, testing, and completing approved web workflows alongside the active agent session.",
  },
  {
    question: "Do I need an API key?",
    answer:
      "No. Vector comes with models included, among them NVIDIA's Nemotron and Meta's Muse Spark, so you can work without connecting a provider. You can also bring your own key for Claude, GPT, Gemini and the rest; availability and billing for those depend on the provider you connect. Included models are served by outside providers, and some may use your prompts to improve their models, so use your own provider key for confidential code.",
  },
  {
    question: "How do I buy and activate Vector?",
    answer:
      "Create a Vector account with Google or email, then open Account. Desktop access is free during private beta; an optional Stripe purchase, $10 a month or $99 a year, adds your private VEC1 license key and billing controls. Enter that key when the desktop app asks for activation. Either way, models are included with Vector, so you need no API key.",
  },
]
---

<MarketingLayout
  title="Vector Documentation"
  description="Learn how to install Vector, open a repository, run agents, test with the controlled browser, review changes, and publish projects."
>
  <div class="docs-page">
    <div class="docs-topbar">
      <MarketingNav active="docs" />
    </div>

    <div class="docs-progress" aria-hidden="true"><i data-progress></i></div>

    <div class="docs-shell">
      <header class="docs-header">
        <p class="docs-kicker">Documentation</p>
        <h1>Build with Vector.</h1>
        <p class="docs-lede">
          Open a local repository, direct one or many agents, work beside them in the editor, verify the result in the
          terminal and browser, then review and publish without leaving the workspace.
        </p>
        <nav class="docs-quick" aria-label="Quick links">
          <a class="is-tour" href="/docs/product">Product tour <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg></a>
          <a href="#first-task">Run your first session <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg></a>
          <a href="#agent-workspaces">Use multiple agents <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg></a>
          <a href="#cloud-services">Publish a repository <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg></a>
        </nav>
      </header>

      <button
        class="docs-toc-toggle"
        type="button"
        aria-controls="docs-contents"
        aria-expanded="false"
        aria-haspopup="dialog"
        data-chrome
      >
        <svg class="toggle-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01" /></svg>
        <span class="toggle-label">Contents</span>
        <span class="toggle-current" data-toc-current></span>
        <svg class="toggle-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
      </button>

      <aside class="docs-sidebar" id="docs-contents" aria-label="Documentation contents">
        <div class="docs-sidebar-inner">
          <div class="docs-sidebar-head" data-chrome>
            <p id="docs-contents-title">Contents</p>
            <button class="docs-sidebar-close" type="button" aria-label="Close contents">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
          </div>
          <div class="docs-search">
            <label class="docs-sr" for="docs-search">Search the guide</label>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <input id="docs-search" type="search" placeholder="Search documentation" autocomplete="off" spellcheck="false" />
            <kbd aria-hidden="true">/</kbd>
          </div>
          <nav class="docs-nav" aria-label="Documentation sections">
            <ul class="docs-nav-tour" role="list">
              <li>
                <a href="/docs/product" data-doc-link>
                  <span class="tour-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="m15.5 8.5-1.6 4.6a1.5 1.5 0 0 1-.9.9l-4.5 1.5 1.6-4.6a1.5 1.5 0 0 1 .9-.9z" /></svg>
                  </span>
                  <span>Product tour</span>
                  <svg class="tour-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7" /><path d="M8 7h9v9" /></svg>
                </a>
              </li>
            </ul>
            {navigation.map((group, index) => (
              <div class="docs-nav-group" data-doc-group>
                <p class="docs-nav-label" id={`docs-nav-group-${index}`}>{group.label}</p>
                <ul role="list" aria-labelledby={`docs-nav-group-${index}`}>
                  {group.links.map(([label, id]) => (
                    <li><a href={`#${id}`} data-doc-link>{label}</a></li>
                  ))}
                </ul>
              </div>
            ))}
            <p class="search-empty" hidden>No matching section.</p>
          </nav>
        </div>
      </aside>

      <main class="docs-content">
        <section id="install" class="doc-section">
          <div class="doc-heading">
            <h2>Install Vector</h2>
            <a class="doc-anchor" href="#install" aria-label="Link to Install Vector" data-chrome></a>
          </div>
          <p>
            Download the installer that matches your computer, open it, and move through the operating
            system's installation flow. Vector is available for Apple silicon and Intel Macs, Windows,
            and Linux.
          </p>
          <div class="callout">
            <strong>Start with the right build.</strong>
            <span>The download page detects your platform and keeps every architecture available.</span>
            <a class="callout-link" href="/login?returnTo=%2Faccount">Sign in to download →</a>
          </div>
        </section>

        <section id="open-repository" class="doc-section">
          <div class="doc-heading">
            <h2>Open a repository</h2>
            <a class="doc-anchor" href="#open-repository" aria-label="Link to Open a repository" data-chrome></a>
          </div>
          <p>
            From Home, choose <strong>Open repository</strong> and select a local project folder. Vector
            attaches conversations, browser state, usage, engineering tools, and agent workspaces to
            that repository.
          </p>
          <ol class="steps">
            <li><span>1</span><div><strong>Open repository</strong><p>Select the folder containing the project you want to build.</p></div></li>
            <li><span>2</span><div><strong>Create a session</strong><p>Start with one clear outcome rather than a list of unrelated ideas.</p></div></li>
            <li><span>3</span><div><strong>Choose a model</strong><p>Pick one of the models included with Vector, no API key needed, or one from a provider you connected.</p></div></li>
          </ol>
        </section>

        <section id="first-task" class="doc-section">
          <div class="doc-heading">
            <h2>Run your first task</h2>
            <a class="doc-anchor" href="#first-task" aria-label="Link to Run your first task" data-chrome></a>
          </div>
          <p>
            Describe the result, the constraints, and how Vector should verify the work. A strong first
            request is specific enough to test but small enough to review.
          </p>
          <div class="prompt-example" data-copy-block>
            <div class="code-bar">
              <span>Example</span>
              <button class="copy-button" type="button" aria-label="Copy example prompt" data-copy data-chrome>
                <svg class="icon-copy" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15H4.5A1.5 1.5 0 0 1 3 13.5v-9A1.5 1.5 0 0 1 4.5 3h9A1.5 1.5 0 0 1 15 4.5V5" /></svg>
                <svg class="icon-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                <span data-copy-label>Copy</span>
              </button>
            </div>
            <p data-copy-source>
              Add a responsive settings page to this project. Follow the existing design system, run
              the relevant tests, open the app in the browser, and summarize every changed file.
            </p>
            <span class="docs-sr" aria-live="polite" data-copy-status data-chrome></span>
          </div>
          <figure class="docs-image">
            <img
              src={screenshotAgent.src}
              width={screenshotAgent.width}
              height={screenshotAgent.height}
              alt="An active Vector agent session attached to an isolated workspace"
              loading="lazy"
            />
            <figcaption>The task, tools, changes, and project remain in one workspace.</figcaption>
          </figure>
        </section>

        <section id="vector-agent" class="doc-section">
          <div class="doc-heading">
            <h2>Vector Agent</h2>
            <a class="doc-anchor" href="#vector-agent" aria-label="Link to Vector Agent" data-chrome></a>
          </div>
          <p>
            The main session can inspect the repository, edit files, run commands, use project tools,
            and report a reviewable result. Use Plan mode when you want analysis without edits, and
            switch back to an editing mode when the plan is approved.
          </p>
          <p>
            When a big task splits into pieces that do not depend on each other, the agent hands them to subagents
            that run at the same time; a small task it does itself. It calls a subagent specialist when part of the
            work fits one. See
            <a href="#subagents">Subagents and subagent specialists</a>.
          </p>
          <div class="definition-grid">
            <article><strong>Quick</strong><p>Short answers and lightweight requests with a smaller context budget.</p></article>
            <article><strong>Normal</strong><p>The default balance of speed, context, and execution depth.</p></article>
            <article><strong>Fast</strong><p>Prioritizes lower latency and may use more parallel model work.</p></article>
            <article><strong>Plan</strong><p>Reviews and proposes an approach without changing project files.</p></article>
          </div>
        </section>

        <section id="agent-workspaces" class="doc-section">
          <div class="doc-heading">
            <h2>Agent workspaces</h2>
            <a class="doc-anchor" href="#agent-workspaces" aria-label="Link to Agent workspaces" data-chrome></a>
          </div>
          <p>
            Use another workspace when work can happen independently: one agent can handle the
            interface while another investigates tests or infrastructure. Vector isolates each agent
            in a Git worktree or managed project copy so unfinished work does not alter the main files.
          </p>
          <ol class="steps">
            <li><span>1</span><div><strong>Create a workspace</strong><p>Name the responsibility and send its first request.</p></div></li>
            <li><span>2</span><div><strong>Keep working</strong><p>Switch between workspaces while they stream activity independently.</p></div></li>
            <li><span>3</span><div><strong>Review and merge</strong><p>Inspect the diff and checks before bringing selected work into main.</p></div></li>
          </ol>
          <h3>Coordinated runs: one objective, a team of agents</h3>
          <p>
            Instead of naming each workspace yourself, choose <strong>Coordinate agents</strong> in the launcher and
            give Vector the objective. A planner model reads the repository and writes a plan: tasks with roles —
            explore, implement, debug, test, review, security, docs — and the dependencies between them. Each task
            becomes its own agent in its own workspace, routed to a model by tier, and tasks run as soon as the ones
            they depend on finish. Explore, debug, test, review and security tasks go to the matching subagent
            specialist; implement and docs tasks run on the general agent.
          </p>
          <p>
            You set the strategy (economy, balanced or quality), the most agents that may run at once, and how many
            run in parallel. The run reports as one board — planning, running, needs review — and nothing reaches your
            main checkout until you look at the combined diff and merge it.
          </p>
          <p class="note is-caution">
            Two agents should not intentionally edit the same lines at the same time. Split work by
            responsibility to reduce conflicts and make review easier.
          </p>
          <p class="note">
            Teams can be wired everyone-to-everyone, coordinator-to-workers, or any pairing you set. A message to a
            teammate you have not linked is refused and told so, rather than dropped where the sender never finds out.
          </p>
        </section>

        <section id="project-rules" class="doc-section">
          <div class="doc-heading">
            <h2>Project rules</h2>
            <a class="doc-anchor" href="#project-rules" aria-label="Link to Project rules" data-chrome></a>
          </div>
          <p>
            A rule is a standard written the way you would say it to a new teammate — "we don't put database query
            logic in the controller". Open <strong>Project rules</strong> from the workspace rail, the home screen, or
            Settings, write the rule, and point it at a repository and optionally at the files it governs.
          </p>
          <ol class="steps">
            <li><span>1</span><div><strong>Write it in plain English</strong><p>No rule language, no schema. One sentence describing the standard.</p></div></li>
            <li><span>2</span><div><strong>Scope it</strong><p>Leave the repository empty to apply it everywhere, or name one. Add file paths like <code>src/app/web/*.tsx</code> to narrow it further.</p></div></li>
            <li><span>3</span><div><strong>Commit it</strong><p>Vector writes the rules to <code>.vector/RULES.md</code> in the repository. Commit that file and your whole team gets the same rules.</p></div></li>
          </ol>
          <ul class="feature-list">
            <li><strong>Vector agents</strong><span>Read the rules file directly — the engine loads it as an instruction file on every prompt.</span></li>
            <li><strong>Claude Code, Codex, Cursor</strong><span>Read their own instruction files and never see it, so Vector copies the matching rules into the prompt it hands them.</span></li>
            <li><strong>Scope survives as words</strong><span>Instruction files load whole, so the file paths a rule covers are stated in the sentence the agent reads.</span></li>
          </ul>
          <p class="note">
            A rule that conflicts with the task you asked for is reported rather than silently resolved. Vector tells
            the agent to say so instead of quietly picking a side.
          </p>
        </section>

        <section id="agent-dashboard" class="doc-section">
          <div class="doc-heading">
            <h2>Agent Dashboard</h2>
            <a class="doc-anchor" href="#agent-dashboard" aria-label="Link to Agent Dashboard" data-chrome></a>
          </div>
          <p>
            Every agent in the project on one board: <strong>Running</strong>, <strong>Needs you</strong> and
            <strong>Done</strong>. Open it from the workspace rail. Switch to a list for a denser view of the same
            three groups.
          </p>
          <ul class="feature-list">
            <li><strong>Needs you</strong><span>Merges failed with needs-review, including a finished run that reported an error. Both are stopped and waiting on a person.</span></li>
            <li><strong>Filters that compose</strong><span>Status, Team, Pull request and Agent. Two values in one menu means either; values in two menus means both.</span></li>
            <li><strong>Pull request state</strong><span>Open, merged, or never opened — merge state wins, so a merged run does not sit under "open" forever.</span></li>
            <li><strong>Teams as a unit</strong><span>Agents sharing a team or swarm filter together, and the board shows the messages they sent each other mid-run.</span></li>
          </ul>
          <p class="note is-caution">
            Two agents holding uncommitted work on the same file are reported as a clash. Merging both will conflict —
            review one before merging the other.
          </p>
        </section>

        <section id="external-agents" class="doc-section">
          <div class="doc-heading">
            <h2>Claude Code, Codex and Cursor</h2>
            <a class="doc-anchor" href="#external-agents" aria-label="Link to Claude Code, Codex and Cursor" data-chrome></a>
          </div>
          <p>
            A workspace can run someone else's CLI instead of Vector's own agent. Vector finds the CLI through your
            login shell, so a tool installed by nvm, Homebrew or an app bundle is detected even though a desktop app
            inherits none of that.
          </p>
          <ol class="steps">
            <li><span>1</span><div><strong>Pick the runtime</strong><p>Choose Claude Code, Codex or Cursor when you create the workspace. The tile shows the version it found, or that it is signed out.</p></div></li>
            <li><span>2</span><div><strong>Let it work</strong><p>The run happens in an isolated worktree or copy. Vector streams its output and runs the project's own checks afterwards.</p></div></li>
            <li><span>3</span><div><strong>Keep talking</strong><p>The workspace has a message box. A follow-up resumes the CLI's own conversation, so it still remembers the file it just changed.</p></div></li>
          </ol>
          <ul class="feature-list">
            <li><strong>Signed out is visible</strong><span>Vector asks each CLI whether it is authenticated and shows "Signed out" with the one command that fixes it.</span></li>
            <li><strong>Resume, or an honest restart</strong><span>If a CLI refuses to resume, Vector re-briefs it with a written summary and labels that turn as restarted rather than pretending it remembers.</span></li>
            <li><strong>They can receive, not send</strong><span>External CLIs have no teammate-message tool, so they can be told what teammates did but cannot reply.</span></li>
          </ul>
        </section>

        <section id="automations" class="doc-section">
          <div class="doc-heading">
            <h2>Automations</h2>
            <a class="doc-anchor" href="#automations" aria-label="Link to Automations" data-chrome></a>
          </div>
          <p>
            An automation is one task Vector runs again and again on a schedule. Open <strong>Automations</strong> from
            the home screen, write the task, choose the repositories it runs in, and pick how often it repeats.
          </p>
          <ul class="feature-list">
            <li><strong>Across repositories</strong><span>One task and one schedule, in every repository you select. Each run reports back separately.</span></li>
            <li><strong>New or existing sessions</strong><span>Continue a thread you already started, or open a fresh session for every run.</span></li>
            <li><strong>While you are away</strong><span>Vector stays in the tray after you close the window, so runs fire without you there.</span></li>
          </ul>
          <p class="note">
            Runs that fall due while Vector is fully closed are not replayed one by one. The next start catches up with
            a single run and says how many it skipped.
          </p>
        </section>

        <section id="agent-editor" class="doc-section">
          <div class="doc-heading">
            <h2>Agent and Editor</h2>
            <a class="doc-anchor" href="#agent-editor" aria-label="Link to Agent and Editor" data-chrome></a>
          </div>
          <p>
            Agent and Editor are two modes over one Vector session. Switch to Editor when you want to work directly:
            search the project, open files in tabs, edit with language support, or keep the same agent beside the
            file and ask it to make the change.
          </p>
          <ul class="feature-list">
            <li><strong>Find a file</strong><span>Use project search to open a file full-screen in a persistent tab.</span></li>
            <li><strong>Edit normally</strong><span>Your changes are written to the active repository or isolated workspace.</span></li>
            <li><strong>Ask beside the code</strong><span>The session does not restart when you switch views, so the agent keeps the task and its history.</span></li>
          </ul>
        </section>

        <section id="browser" class="doc-section">
          <div class="doc-heading">
            <h2>Controlled browser</h2>
            <a class="doc-anchor" href="#browser" aria-label="Link to Controlled browser" data-chrome></a>
          </div>
          <p>
            The Browser is attached to the current repository and session. Open a local preview or URL,
            interact manually, or ask Vector to inspect and test the page as part of the engineering task.
          </p>
          <div class="do-dont">
            <article>
              <strong>Good uses</strong>
              <p>Local UI testing, console inspection, screenshots, documentation research, and approved deployment workflows.</p>
            </article>
            <article>
              <strong>Approval stays visible</strong>
              <p>Take over for sign-in, secrets, payments, destructive changes, and other sensitive actions.</p>
            </article>
          </div>
        </section>

        <section id="terminal-review" class="doc-section">
          <div class="doc-heading">
            <h2>Terminal and review</h2>
            <a class="doc-anchor" href="#terminal-review" aria-label="Link to Terminal and review" data-chrome></a>
          </div>
          <p>
            The Terminal runs commands inside the active repository or isolated workspace. Review keeps the files an
            agent changed, validation results, risk signals and merge controls together, so you can inspect what will
            land before it touches the primary checkout.
          </p>
        </section>

        <section id="cloud-services" class="doc-section">
          <div class="doc-heading">
            <h2>Cloud Services</h2>
            <a class="doc-anchor" href="#cloud-services" aria-label="Link to Cloud Services" data-chrome></a>
          </div>
          <p>
            Cloud work is part of the task, not a panel you operate afterwards. The agent drives it through one
            permission-gated tool: it checks which providers are connected, detects the project's build settings,
            prepares a Supabase-backed database or authentication, syncs environment values to the linked host,
            publishes, and lists recent deployments. Every action that creates, changes, or spends asks you first.
          </p>
          <ul class="feature-list">
            <li><strong>A publish that is checked</strong><span>Publishing ends with a real browser load of the deployed URL, and the agent reports the page it found and the console errors it saw rather than assuming the deploy worked.</span></li>
            <li><strong>Failures come with logs</strong><span>The agent reads recent deployment logs from the host, so a broken deploy is diagnosed from the actual build or runtime error.</span></li>
            <li><strong>Migrations it can apply</strong><span>The <code>.sql</code> migrations in your repository can be applied to the linked database, with a record of which ones already ran, so running again is safe.</span></li>
            <li><strong>Your own accounts</strong><span>Vercel, Netlify, Supabase, and AWS connect with your credentials, and the resources stay in them. Vector does not host your app.</span></li>
          </ul>
          <p class="note">
            These cloud actions run in the Vector desktop app, where the provider connections live. The terminal CLI
            runs the same agent, but tells it that this tool is unavailable there rather than half-performing the work.
          </p>
        </section>

        <section id="models" class="doc-section">
          <div class="doc-heading">
            <h2>Models and BYOK</h2>
            <a class="doc-anchor" href="#models" aria-label="Link to Models and BYOK" data-chrome></a>
          </div>
          <h3>Models included with Vector</h3>
          <p>
            You do not need an API key. Vector comes with models included, today among them NVIDIA's
            Nemotron and Meta's Muse Spark, in the desktop app and the CLI alike. A new install starts
            on Big Pickle, so the first session works before you connect anything. The lineup changes
            as providers add and retire models.
          </p>
          <p class="note is-caution">
            Included models are served by outside providers, and some may use your prompts to improve
            their models. For confidential code, use your own provider key.
          </p>
          <h3>Bring your own key</h3>
          <p>
            Connect a provider in Settings, or run <code>vector auth login</code> in the terminal, then
            select a model in the session composer. Model availability, context limits, pricing, and
            rate limits come from the provider. Vector's usage view tracks the information returned by
            those sessions.
          </p>
        </section>

        <section id="connections" class="doc-section">
          <div class="doc-heading">
            <h2>MCP and connections</h2>
            <a class="doc-anchor" href="#connections" aria-label="Link to MCP and connections" data-chrome></a>
          </div>
          <p>
            MCP servers and project connections give an agent structured access to approved tools.
            Add only services you trust, confirm the permissions they request, and verify the
            connection before depending on it in a task.
          </p>
          <p class="note">
            A listed integration is not automatically connected. It becomes available only after its
            setup succeeds and Vector reports it as active.
          </p>
        </section>

        <section id="review" class="doc-section">
          <div class="doc-heading">
            <h2>Review and recovery</h2>
            <a class="doc-anchor" href="#review" aria-label="Link to Review and recovery" data-chrome></a>
          </div>
          <p>
            Review changed files before merging or publishing. Checkpoints preserve recoverable
            project states, while isolated workspace diffs show exactly what an agent wants to bring
            into the main branch.
          </p>
          <p>To review a whole branch before you push, see <a href="#code-review">Code review</a>.</p>
        </section>

        <section id="tools" class="doc-section">
          <div class="doc-heading">
            <h2>The agent's tools</h2>
            <a class="doc-anchor" href="#tools" aria-label="Link to The agent's tools" data-chrome></a>
          </div>
          <p>
            The agent changes your project through a fixed set of first-class tools rather than free-form shell commands, so its behaviour is the same in the desktop app, in the terminal and in GitHub Actions.
          </p>
          <ul class="feature-list">
            <li><strong>Files</strong><span><code>read</code> with line offsets and limits, <code>write</code>, <code>edit</code> for an exact string replacement, and <code>apply_patch</code> for a patch that spans several files.</span></li>
            <li><strong>Search</strong><span><code>glob</code> for filename patterns and <code>grep</code> for content, so it finds code without reading whole directories.</span></li>
            <li><strong>Language servers</strong><span><code>lsp</code> asks your project's language servers for a definition, the references to a symbol, hover type information or a workspace symbol search — the same answers your editor gets.</span></li>
            <li><strong>The web</strong><span><code>websearch</code> takes a query and a mode — <code>auto</code>, <code>fast</code> or <code>deep</code> — and <code>webfetch</code> returns one URL as markdown, text or HTML. Search works on the models included with Vector, or on an Exa or Parallel key you supply.</span></li>
            <li><strong>The shell</strong><span><code>bash</code> runs commands in the project, behind the permission rules below.</span></li>
            <li><strong>Keeping it legible</strong><span><code>todowrite</code> maintains the checklist you can see, and <code>question</code> lets the agent stop and ask you a structured question instead of guessing.</span></li>
          </ul>
          <p class="note">
            Tools are built in. MCP servers and plugins add more beside them; they never replace these.
          </p>
        </section>

        <section id="permissions" class="doc-section">
          <div class="doc-heading">
            <h2>Permissions</h2>
            <a class="doc-anchor" href="#permissions" aria-label="Link to Permissions" data-chrome></a>
          </div>
          <p>
            Every tool action is checked against a ruleset whose effect is <strong>allow</strong>, <strong>ask</strong> or <strong>deny</strong>. Rules from the agent, from the project and from your saved answers are merged: deny wins, then ask, then allow, and anything with no matching rule defaults to ask. An agent with no permissions at all is denied everything rather than trusted.
          </p>
          <p>
            When you answer <strong>always</strong>, that allow is saved for the project, so the same action is not asked again. Saved answers are per project, and you can clear them.
          </p>
          <p class="note is-caution">
            For unattended runs the terminal agent takes <code>--auto</code> (also spelled <code>--yolo</code> or <code>--dangerously-skip-permissions</code>). It auto-approves anything not explicitly denied — deny rules still hold. It is off by default, and it is the flag to think twice about.
          </p>
        </section>

        <section id="context" class="doc-section">
          <div class="doc-heading">
            <h2>Context and compaction</h2>
            <a class="doc-anchor" href="#context" aria-label="Link to Context and compaction" data-chrome></a>
          </div>
          <p>
            A long session does not fail when it reaches the model's context limit. Vector compacts it: older turns are summarised and pruned while a protected window of recent work is kept intact, and the run continues from the compacted history. A dedicated internal agent writes that summary, so it is written for the model that has to keep working rather than for a reader.
          </p>
          <p>
            Compaction can also be triggered deliberately, and the transcript records where it happened.
          </p>
        </section>

        <section id="skills" class="doc-section">
          <div class="doc-heading">
            <h2>Skills</h2>
            <a class="doc-anchor" href="#skills" aria-label="Link to Skills" data-chrome></a>
          </div>
          <p>
            A skill is a packaged set of instructions for a recurring kind of work — a house style, a review checklist, a deployment runbook. Vector finds a skill as a <code>SKILL.md</code> (or <code>&lt;name&gt;.md</code>) in a skill folder, project or global, and the agent calls it by name from the list of available skills.
          </p>
          <p>
            Downloaded skills are cached under a versioned directory, so updating one is clean rather than a manual copy. Skills are a Vector mechanism, not an MCP server.
          </p>
        </section>

        <section id="commands" class="doc-section">
          <div class="doc-heading">
            <h2>Custom commands</h2>
            <a class="doc-anchor" href="#commands" aria-label="Link to Custom commands" data-chrome></a>
          </div>
          <p>
            Your own commands are Markdown files in a <code>command/</code> or <code>commands/</code> folder, in the project or in your global config. Frontmatter carries the metadata, the body is the prompt template, and the file's path becomes the name — so <code>command/review/api.md</code> is available as <code>review/api</code>.
          </p>
          <p class="doc-cmd"><code>vector run --command review/api "the new billing endpoints"</code><button class="doc-cmd-copy" type="button" aria-label="Copy this command">Copy</button></p>
        </section>

        <section id="custom-agents" class="doc-section">
          <div class="doc-heading">
            <h2>Custom agents and subagents</h2>
            <a class="doc-anchor" href="#custom-agents" aria-label="Link to Custom agents and subagents" data-chrome></a>
          </div>
          <p>
            Vector ships nine subagents an agent can delegate to: a general one, and the specialists <strong>explore</strong>, <strong>review</strong>, <strong>judge</strong>, <strong>debug</strong>, <strong>test</strong>, <strong>security</strong>, <strong>performance</strong> and <strong>migration</strong>. Explore, review, judge and security carry a read-only boundary that is re-applied after your repository's config is merged, so a checked-in file cannot turn a read-only reviewer into one that writes; they can still run verification commands from an allowlist such as <code>git diff</code>, <code>git log</code> and the project's test and build scripts.
          </p>
          <p>
            Delegation does not recurse. A subagent cannot start subagents of its own, and nesting stops at two levels. A parent can declare which paths each subagent owns, and Vector refuses two siblings that claim overlapping paths; tasks can depend on each other, run in the background and be resumed later by id.
          </p>
          <p>
            You can add your own:
          </p>
          <p class="doc-cmd"><code>vector agent create --description "reviews SQL migrations" --mode subagent
vector agent list</code><button class="doc-cmd-copy" type="button" aria-label="Copy this command">Copy</button></p>
          <p class="note">
            There is no cap on how many subagents one session runs at once. Past six running siblings Vector tells the model to mention the spend, because each subagent spends on your keys.
          </p>
        </section>

        <section id="cli-terminal" class="doc-section">
          <div class="doc-heading">
            <h2>The terminal agent</h2>
            <a class="doc-anchor" href="#cli-terminal" aria-label="Link to The terminal agent" data-chrome></a>
          </div>
          <p>
            Running <code>vector</code> with no subcommand starts the interactive agent in the current directory, or in the path you pass. It takes the same session flags as <code>run</code>: <code>--model</code>, <code>--agent</code>, <code>--prompt</code>, <code>--continue</code>, <code>--session</code> and <code>--fork</code>. <code>--mini</code> starts a minimal interface, and <code>--replay</code>, <code>--no-replay</code> and <code>--replay-limit</code> control how much history is redrawn when you resume or resize.
          </p>
          <p class="doc-cmd"><code>vector
vector ~/code/myapp --model anthropic/claude-sonnet-5</code><button class="doc-cmd-copy" type="button" aria-label="Copy this command">Copy</button></p>
        </section>

        <section id="cli-run" class="doc-section">
          <div class="doc-heading">
            <h2>One-shot and scripted runs</h2>
            <a class="doc-anchor" href="#cli-run" aria-label="Link to One-shot and scripted runs" data-chrome></a>
          </div>
          <p>
            <code>vector run</code> sends one prompt and prints the result. It is the surface you script against: <code>--format json</code> emits raw events for a pipeline, <code>--file</code> attaches files, <code>--model</code> and <code>--agent</code> choose who answers, <code>--variant</code> sets reasoning effort and <code>--title</code> names the session. <code>--continue</code> resumes the last session, <code>--session</code> a specific one, and <code>--fork</code> branches instead of appending.
          </p>
          <p class="doc-cmd"><code>vector run "why is the checkout test flaky?" --format json
vector run -c "now fix it" --variant high</code><button class="doc-cmd-copy" type="button" aria-label="Copy this command">Copy</button></p>
        </section>

        <section id="cli-account" class="doc-section">
          <div class="doc-heading">
            <h2>Account and CLI tokens</h2>
            <a class="doc-anchor" href="#cli-account" aria-label="Link to Account and CLI tokens" data-chrome></a>
          </div>
          <p>
            The published <code>vector</code> binary is free but needs a Vector account. <code>vector login</code> opens the page that mints a token, or takes one directly with <code>--token</code>; <code>vector whoami</code> prints who is signed in and <code>vector logout</code> removes it. The same token is the <code>VECTOR_CLI_TOKEN</code> secret used by GitHub Actions.
          </p>
          <p class="doc-cmd"><code>vector login
vector whoami</code><button class="doc-cmd-copy" type="button" aria-label="Copy this command">Copy</button></p>
          <p class="note">
            The token is verified about once a day and cached with a seven-day offline grace window, so a flaky network never locks you out of your own terminal. Only a definitive invalid or expired answer signs you out. <code>login</code>, <code>logout</code>, <code>whoami</code>, <code>completion</code>, <code>upgrade</code> and <code>uninstall</code> work signed out.
          </p>
        </section>

        <section id="cli-models" class="doc-section">
          <div class="doc-heading">
            <h2>Models and variants in the terminal</h2>
            <a class="doc-anchor" href="#cli-models" aria-label="Link to Models and variants in the terminal" data-chrome></a>
          </div>
          <p>
            <code>vector models</code> lists every model available to you — the ones included with Vector and the providers you have connected. Pass a provider id to filter, <code>--verbose</code> for metadata such as per-token cost, and <code>--refresh</code> to re-pull the catalogue instead of using the cached copy.
          </p>
          <p class="doc-cmd"><code>vector models
vector models anthropic --verbose</code><button class="doc-cmd-copy" type="button" aria-label="Copy this command">Copy</button></p>
          <p>
            Models that expose reasoning effort take <code>--variant</code>. The level resolves from the flag, then your saved preference, then what the session last used, and your choice is kept per provider and model.
          </p>
        </section>

        <section id="cli-sessions" class="doc-section">
          <div class="doc-heading">
            <h2>Sessions: list, export, share</h2>
            <a class="doc-anchor" href="#cli-sessions" aria-label="Link to Sessions: list, export, share" data-chrome></a>
          </div>
          <p>
            <code>vector session list</code> prints recent sessions, with <code>--max-count</code> to cap them and <code>--format</code> for scripting; <code>vector session delete &lt;id&gt;</code> removes one permanently. Those ids are what <code>--session</code> takes elsewhere.
          </p>
          <p class="doc-cmd"><code>vector session list -n 20
vector export <id> --sanitize > session.json
vector import session.json</code><button class="doc-cmd-copy" type="button" aria-label="Copy this command">Copy</button></p>
          <p>
            <code>vector export</code> writes a session's transcript and metadata as JSON, and <code>--sanitize</code> redacts the sensitive parts — transcript text, file contents, subtask commands — so it can be attached to a bug report. <code>vector import</code> reads that file back, from a path or from a share URL; <code>vector run --share</code> publishes a link for a run.
          </p>
        </section>

        <section id="cli-mcp" class="doc-section">
          <div class="doc-heading">
            <h2>MCP from the terminal</h2>
            <a class="doc-anchor" href="#cli-mcp" aria-label="Link to MCP from the terminal" data-chrome></a>
          </div>
          <p>
            <code>vector mcp add</code> registers a server: <code>--url</code> for a remote one with <code>--header KEY=VALUE</code>, or a command with <code>--env KEY=VALUE</code> for a local one. <code>vector mcp list</code> shows every configured server and whether it is reachable.
          </p>
          <p class="doc-cmd"><code>vector mcp add linear --url https://mcp.linear.app/sse
vector mcp auth linear
vector mcp list</code><button class="doc-cmd-copy" type="button" aria-label="Copy this command">Copy</button></p>
          <p>
            For OAuth-protected servers, <code>vector mcp auth</code> runs the flow, <code>vector mcp auth list</code> shows which servers are OAuth-capable and their status, <code>vector mcp logout</code> drops stored credentials, and <code>vector mcp debug &lt;name&gt;</code> diagnoses a failing connection.
          </p>
        </section>

        <section id="cli-plugins" class="doc-section">
          <div class="doc-heading">
            <h2>Plugins</h2>
            <a class="doc-anchor" href="#cli-plugins" aria-label="Link to Plugins" data-chrome></a>
          </div>
          <p>
            <code>vector plugin &lt;module&gt;</code> installs an npm module as a plugin and writes it into your config; <code>--global</code> installs into the global config rather than the project's, and <code>--force</code> replaces a version already there. A plugin can register extra tools, which the registry merges alongside the built-in ones.
          </p>
          <p class="doc-cmd"><code>vector plugin @acme/vector-plugin -g</code><button class="doc-cmd-copy" type="button" aria-label="Copy this command">Copy</button></p>
          <p class="note">
            <code>--pure</code> on any command runs without external plugins. It is the first thing to try when you suspect one of breaking a run.
          </p>
        </section>

        <section id="cli-server" class="doc-section">
          <div class="doc-heading">
            <h2>Server, web and editors</h2>
            <a class="doc-anchor" href="#cli-server" aria-label="Link to Server, web and editors" data-chrome></a>
          </div>
          <p>
            <code>vector serve</code> runs the agent as a headless server with <code>--port</code> and <code>--hostname</code>; <code>vector web</code> starts the same server and opens the browser interface. <code>vector attach &lt;url&gt;</code> connects a terminal session to a server that is already running, with <code>--dir</code> to choose the directory on it, the usual session flags, and <code>--username</code> and <code>--password</code> for basic auth.
          </p>
          <p class="doc-cmd"><code>vector serve --port 4096
vector attach http://localhost:4096 --dir ~/code/myapp</code><button class="doc-cmd-copy" type="button" aria-label="Copy this command">Copy</button></p>
          <p>
            <code>vector acp</code> starts an Agent Client Protocol server, so an ACP-speaking editor can drive Vector's agent as its backend.
          </p>
        </section>

        <section id="cli-github" class="doc-section">
          <div class="doc-heading">
            <h2>GitHub from the terminal</h2>
            <a class="doc-anchor" href="#cli-github" aria-label="Link to GitHub from the terminal" data-chrome></a>
          </div>
          <p>
            <code>vector pr &lt;number&gt;</code> fetches a pull request's branch, checks it out and starts Vector in that working tree — the shortcut for picking a review conversation up on your own machine.
          </p>
          <p class="doc-cmd"><code>vector pr 482
vector github review --pr 482 --dry-run</code><button class="doc-cmd-copy" type="button" aria-label="Copy this command">Copy</button></p>
          <p>
            The generated workflow calls two commands you can also run yourself. <code>vector github run</code> executes the agent for a GitHub event, with <code>--event</code> for a payload and <code>--token</code> for a personal access token. <code>vector github review</code> reviews a pull request and posts the result; <code>--dry-run</code> prints every write it would make as JSON instead of posting, which is how you test a configuration change without commenting on a real pull request.
          </p>
        </section>

        <section id="cli-maintenance" class="doc-section">
          <div class="doc-heading">
            <h2>Upkeep, flags and your data</h2>
            <a class="doc-anchor" href="#cli-maintenance" aria-label="Link to Upkeep, flags and your data" data-chrome></a>
          </div>
          <p>
            <code>vector upgrade</code> moves the CLI to the newest version, or one you name, with <code>--method</code> when several installation methods are possible. <code>vector uninstall</code> removes it, keeping configuration with <code>--keep-config</code> or sessions with <code>--keep-data</code>, and <code>--dry-run</code> lists what would go.
          </p>
          <p class="doc-cmd"><code>vector db path
vector db "select count(*) from session"</code><button class="doc-cmd-copy" type="button" aria-label="Copy this command">Copy</button></p>
          <p>
            Vector keeps sessions, messages, permissions and shares in a local SQLite database. <code>vector db</code> opens a sqlite3 shell against it, <code>vector db "&lt;query&gt;"</code> runs one query with <code>--format</code> for the output shape, and <code>vector db path</code> prints where the file is. It is the plain answer to where your data lives: on your disk, in a file you can open yourself.
          </p>
          <ul class="feature-list">
            <li><strong>--print-logs</strong><span>Send logs to stderr.</span></li>
            <li><strong>--log-level</strong><span>DEBUG, INFO, WARN or ERROR.</span></li>
            <li><strong>--pure</strong><span>Run without external plugins.</span></li>
            <li><strong>vector completion</strong><span>Print a shell completion script.</span></li>
          </ul>
        </section>

        <section id="troubleshooting" class="doc-section">
          <div class="doc-heading">
            <h2>Troubleshooting</h2>
            <a class="doc-anchor" href="#troubleshooting" aria-label="Link to Troubleshooting" data-chrome></a>
          </div>
          <div class="troubleshooting">
            <article><strong>The agent does not respond</strong><p>Confirm a provider and model are connected, then check whether the provider reports a quota or authentication error.</p></article>
            <article><strong>The browser cannot open the app</strong><p>Start the development server in Terminal and use the local URL printed by the project.</p></article>
            <article><strong>A workspace cannot be created</strong><p>Open a repository first and confirm the folder is writable. Git repositories provide the cleanest isolated-workspace flow.</p></article>
            <article><strong>A deployment fails</strong><p>Open the deployment log, verify the build command and output directory, and check required environment values.</p></article>
            <article><strong>macOS says Vector cannot be opened</strong><p>Preview builds are not yet notarized by Apple, so macOS blocks them on first launch. Try to open Vector once, then go to System Settings → Privacy &amp; Security, find the message about Vector, and choose Open Anyway. Or run <code>xattr -dr com.apple.quarantine /Applications/Vector.app</code> in Terminal. You only need to do this once.</p></article>
            <article><strong>Windows shows a SmartScreen warning</strong><p>Preview installers are not yet code-signed. Choose More info, then Run anyway.</p></article>
            <article><strong>The Linux AppImage does not start</strong><p>Make the file executable first with <code>chmod +x</code> on the downloaded AppImage, then run it.</p></article>
            <article><strong>Vector never offers an update</strong><p>Preview builds are unsigned, and unsigned builds cannot update themselves. Download the latest version from your account page to upgrade; your projects and settings stay where they are.</p></article>
          </div>
        </section>

        <section id="faq" class="doc-section">
          <div class="doc-heading">
            <h2>Frequently asked questions</h2>
            <a class="doc-anchor" href="#faq" aria-label="Link to Frequently asked questions" data-chrome></a>
          </div>
          <div class="faq-list">
            {faqs.map((item) => (
              <details>
                <summary><span>{item.question}</span><span class="faq-icon" aria-hidden="true"></span></summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </section>

        <section id="why-vector" class="doc-section">
          <div class="doc-heading">
            <h2>Why Vector</h2>
            <a class="doc-anchor" href="#why-vector" aria-label="Link to Why Vector" data-chrome></a>
          </div>
          <p>
            Most tools write the code. The hard part was never the writing. Vector is a workspace, not a wrapper
            around one trick: the editor, the memory, the measured spend, the verification, the connectors, the
            browser, the cloud accounts, the parallel agents and the schedule all sit in one place, over the
            repository already on your disk. No single feature is the reason to use it — the combination is.
          </p>
          <div class="doc-tally">
            <div><strong>135</strong><span>connectors ready to turn on</span></div>
            <div><strong>No cap</strong><span>on agents and subagents running at once</span></div>
            <div><strong>4</strong><span>runtimes — Vector's and three others</span></div>
            <div><strong>0</strong><span>lines of your code uploaded to Vector by default</span></div>
          </div>
          <h3>Nine parts, one workspace</h3>
          <div class="doc-grid">
            {pillars.map((pillar) => (
              <article class="doc-card">
                <small>{pillar.eyebrow}</small>
                <h4>{pillar.name}</h4>
                <p>{pillar.body}</p>
              </article>
            ))}
          </div>
          <p class="note">
            Works alongside what you already use: {ecosystem.join(", ")}. Models come included, and BYOK works
            too — bring the agents, models, and services you already trust.
          </p>
        </section>

        <section id="operating-loop" class="doc-section">
          <div class="doc-heading">
            <h2>One operating loop</h2>
            <a class="doc-anchor" href="#operating-loop" aria-label="Link to One operating loop" data-chrome></a>
          </div>
          <p>
            From a brief to verified, shipped work. Vector keeps the request, repository context, your own edits,
            agent activity, files, terminal, browser, measured usage, review, and release in one place.
          </p>
          <ol class="steps">
            {workflow.map(([title, body], index) => (
              <li><span>{index + 1}</span><div><strong>{title}</strong><p>{body}</p></div></li>
            ))}
          </ol>
          <div class="doc-grid doc-grid-4">
            <article class="doc-card"><h3>Editor, file search, terminal</h3><p>A real editor over your own files, with project-wide search, language diagnostics, a terminal, and an editor agent beside them.</p></article>
            <article class="doc-card"><h3>Memory and measured spend</h3><p>Local memory in one file you can inspect, edit, or erase. Model economics records the tokens and cost the provider reported.</p></article>
            <article class="doc-card"><h3>Review before main</h3><p>Inspect diffs, focused checks, pull-request findings, risk signals, checkpoints, and an optional independent judge verdict before work reaches the primary files.</p></article>
            <article class="doc-card"><h3>MCP, providers, and Cloud</h3><p>Bring your own model provider, connect approved tools through MCP and the plugin catalog, and publish through infrastructure accounts that already belong to you.</p></article>
          </div>
        </section>

        <section id="local-memory" class="doc-section">
          <div class="doc-heading">
            <h2>Local memory</h2>
            <a class="doc-anchor" href="#local-memory" aria-label="Link to Local memory" data-chrome></a>
          </div>
          <p>
            Vector lets you save durable facts about how you work — your stack, your conventions, the corrections you
            would otherwise repeat — in one <code>MEMORY.md</code> file inside Vector's local app config directory. It
            is read in every repository and automatically included in the context Vector sends to the model provider
            you choose. Settings shows its path, size, last change, and full contents; erasing removes the file rather
            than emptying it.
          </p>
          <p class="note">The file is never uploaded to Vector's servers. Memory is yours to inspect, edit, or delete.</p>
        </section>

        <section id="tokenomics" class="doc-section">
          <div class="doc-heading">
            <h2>Tokenomics engine</h2>
            <a class="doc-anchor" href="#tokenomics" aria-label="Link to Tokenomics engine" data-chrome></a>
          </div>
          <p>
            The number is the provider's, not ours. Vector records what a run really spent by reading what the
            provider reported on the assistant messages — input, output, reasoning, cache reads and cache writes —
            along with the provider's own cost figure. Nothing is inferred from character counts. That ledger is then
            held against the limits you set: per day, per run, per project.
          </p>
          <dl class="doc-rows">
            {spendRows.map(([term, detail]) => (<div><dt>{term}</dt><dd>{detail}</dd></div>))}
          </dl>
          <p class="note">
            Economics that learn: every session feeds measured token and cost evidence into model recommendations, so
            the ranking is built from what providers actually reported rather than from list prices. A model gets no
            recommendation until it has at least three recorded runs for that kind of task, and an unmeasured model
            never outranks one that reported a real cost.
          </p>
        </section>

        <section id="hulk" class="doc-section">
          <div class="doc-heading">
            <h2>HULK — hidden unique licence keys</h2>
            <a class="doc-anchor" href="#hulk" aria-label="Link to HULK — hidden unique licence keys" data-chrome></a>
          </div>
          <p>
            Every copy has its own key. No shared serial, no keygen-shaped pattern, nothing embedded in the installer.
            Each purchase mints a key that exists only for that buyer, and activation ties it to the machines it runs
            on. Vector's licence is a fixed price you pay us; model usage is metered by whichever provider you brought.
          </p>
          <dl class="doc-rows">
            {licenseRows.map(([term, detail]) => (<div><dt>{term}</dt><dd>{detail}</dd></div>))}
          </dl>
          <p class="note is-caution">
            HULK is designed to make casual key-sharing not work and to keep your hardware private while doing it. It
            is not — and no licence system is — a guarantee against a determined attacker with your machine in hand.
          </p>
        </section>

        <section id="verified-completion" class="doc-section">
          <div class="doc-heading">
            <h2>Verified completion</h2>
            <a class="doc-anchor" href="#verified-completion" aria-label="Link to Verified completion" data-chrome></a>
          </div>
          <p>
            Completion you can check, instead of a confident summary. Turn on LLM-as-a-judge and finishing stops
            being the agent's own opinion. Before it starts, the agent writes down the observable success criteria
            your request implies. After implementing, it has to exercise the work rather than describe it. Then the
            Judge, a read-only subagent specialist, compares the original request, the criteria, the changed files and
            the captured test output. A FAIL names the specific repair and sends the agent back to work, up to three
            rounds.
          </p>
          <p class="note">Opt-in, and it spends extra model calls on every prompt it covers. It does not apply to the plan lane or the quick lane.</p>
        </section>

        <section id="controlled-browser" class="doc-section">
          <div class="doc-heading">
            <h2>Controlled browser</h2>
            <a class="doc-anchor" href="#controlled-browser" aria-label="Link to Controlled browser, in Why Vector" data-chrome></a>
          </div>
          <p>
            The browser is a real Chromium view embedded in the Vector window, not a screenshot service. The agent
            opens the running product, clicks and types, reads console and network failures, captures what it saw,
            repairs the code, and retests. It refuses to type into password, one-time-code and card fields — it pauses
            and hands the live browser to you, then resumes with what it can see.
          </p>
        </section>

        <section id="only-in-vector" class="doc-section">
          <div class="doc-heading">
            <h2>Only in Vector</h2>
            <a class="doc-anchor" href="#only-in-vector" aria-label="Link to Only in Vector" data-chrome></a>
          </div>
          <p>
            Things that are rarely true in one place. The difficult part is not generating text. It is keeping what
            you know, knowing what it cost, proving the work holds, and leaving you in control of what lands.
          </p>
          <dl class="doc-rows">
            {systemRows.map(([term, detail]) => (<div><dt>{term}</dt><dd>{detail}</dd></div>))}
          </dl>
        </section>

        <section id="conditions" class="doc-section">
          <div class="doc-heading">
            <h2>The conditions, stated</h2>
            <a class="doc-anchor" href="#conditions" aria-label="Link to The conditions, stated" data-chrome></a>
          </div>
          <p>
            Where a capability has a catch, here it is. Rather than leaving these in footnotes, every one of them is
            written out in one place.
          </p>
          <dl class="doc-rows">
            {conditions.map(([term, detail]) => (<div><dt>{term}</dt><dd>{detail}</dd></div>))}
          </dl>
          <p class="note">
            The sandbox flag: operating-system confinement is enabled with the <code>OPENCODE_SHELL_SANDBOX</code>
            environment variable. It is opt-in and off by default, uses a seatbelt profile on macOS and bwrap on Linux
            where installed, and has no Windows equivalent — so on Windows Vector reports that it is running
            unconfined instead of implying protection it cannot provide.
          </p>
        </section>

        <section id="subagents" class="doc-section">
          <div class="doc-heading">
            <h2>Subagents and subagent specialists</h2>
            <a class="doc-anchor" href="#subagents" aria-label="Link to Subagents and subagent specialists" data-chrome></a>
          </div>
          <p>
            Vector's agent does not have to do every part of a task itself. It can hand self-contained pieces of the
            work to other agents, which run at the same time. There are two kinds, and Vector uses the same two names in
            the chat, in Background tasks, and in Settings → Agents.
          </p>
          <div class="doc-grid doc-grid-4">
            <article class="doc-card">
              <small>General purpose · for big tasks</small>
              <h3>Subagents</h3>
              <p>A subagent takes whatever piece of the task the main agent hands it: answer a question about the code, change a group of files, find out why a check fails. Vector uses them for big tasks, one per independent part, launched together so they run at the same time, and does small tasks itself. You can turn them off in Settings → Agents.</p>
            </article>
            <article class="doc-card">
              <small>Named · one focus each</small>
              <h3>Subagent specialists</h3>
              <p>A subagent specialist is a named agent with a fixed focus and its own permissions. Vector calls one when part of the task fits that focus, such as reviewing a diff or finding the cause of a failure. Agents you define yourself count as custom specialists.</p>
            </article>
          </div>
          <h3>How they differ</h3>
          <dl class="doc-rows">
            {subagentKinds.map(([term, detail]) => (<div><dt>{term}</dt><dd>{detail}</dd></div>))}
          </dl>
          <h3>The eight subagent specialists</h3>
          <p>
            Explore, Review, Judge and Security can read your project and run checks, but they cannot edit it. Debug,
            Test, Performance and Migration can edit. To ask for one yourself, type <code>@</code> and its name in the
            composer.
          </p>
          <div class="doc-grid doc-grid-3">
            {crew.map((member) => (
              <article class="doc-card">
                <small>{member.summary}{member.readOnly ? " · read-only" : ""}</small>
                <h4>{member.name}</h4>
                <p>{member.role}</p>
              </article>
            ))}
          </div>
          <h3>Where you see them</h3>
          <ul class="feature-list">
            <li><strong>In the chat</strong><span>Each batch of delegated work appears as a card in the conversation, with its title, kind, how many agents are working, their status and the time so far, and one square per agent. Click it to open that work in Background tasks.</span></li>
            <li><strong>In Background tasks</strong><span>Open the panel with the Tasks button in the session header, or with Cmd+Shift+B (Ctrl+Shift+B on Windows and Linux). Each card shows the kind, the elapsed time, how many agents and their tokens, and one row per agent with its model, tokens and time. A running card has a Stop button, running work is shown in purple, and finished tasks collect under Finished.</span></li>
            <li><strong>In Settings</strong><span>Settings → Agents explains both kinds and has the General subagents switch, which turns subagents off. Subagent specialists keep working when it is off.</span></li>
          </ul>
          <h3>Turning subagents off</h3>
          <p>
            Subagents are on by default. With them off, Vector's agent does the work itself, except parts that fit a
            subagent specialist, which it can still hand to one. You can also still ask for a specialist yourself with
            <code>@</code> and its name.
          </p>
          <ul class="feature-list">
            <li><strong>In the desktop app</strong><span>Switch off General subagents in Settings → Agents. Changing it stops any work in progress, and the new setting applies from your next message.</span></li>
            <li><strong>In the terminal</strong><span>The terminal reads its own config file, so the desktop switch does not change it. Add <code>{'"agent": { "general": { "disable": true } }'}</code> to <code>~/.config/vector/opencode.json</code> (<code>%USERPROFILE%\.config\vector\opencode.json</code> on Windows). It takes effect the next time you start Vector in the terminal.</span></li>
            <li><strong>For one project</strong><span>Put the same setting in the project's <code>opencode.json</code>. It turns subagents off for that project in the terminal and the desktop app alike, whatever the switch says.</span></li>
          </ul>
          <p class="note">
            Subagents are not agent workspaces. A subagent works inside your session and your checkout and reports to the
            main agent. An agent workspace is a separate session in its own worktree or copy that you start, watch in the
            Agent Dashboard, and merge yourself. See <a href="#agent-workspaces">Agent workspaces</a>.
          </p>
        </section>

        <section id="comparison" class="doc-section">
          <div class="doc-heading">
            <h2>How Vector compares</h2>
            <a class="doc-anchor" href="#comparison" aria-label="Link to How Vector compares" data-chrome></a>
          </div>
          <p>
            Vector combines capabilities commonly split across an agent, an editor, a browser, a Git client, and a
            deployment dashboard. Capabilities change quickly, so verify current vendor documentation. A dash means
            Vector makes no claim.
          </p>
          <div class="doc-table-wrap" role="region" aria-label="Comparison table" tabindex="0">
            <table class="doc-table">
              <thead><tr><th scope="col">Capability</th><th scope="col">Vector</th><th scope="col">Claude Code</th><th scope="col">Codex</th><th scope="col">Cursor</th><th scope="col">App builders</th></tr></thead>
              <tbody>
                {comparison.map((row) => (<tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td class:list={{ "is-word": /^\S+$/.test(cell) }}>{cell}</td>)}</tr>))}
              </tbody>
            </table>
          </div>
          <dl class="doc-rows">
            {connectionGroups.map(([term, detail]) => (<div><dt>{term}</dt><dd>{detail}</dd></div>))}
          </dl>
        </section>

        <section id="velocity" class="doc-section">
          <div class="doc-heading">
            <h2>Vector Velocity model <span class="doc-soon">Coming soon</span></h2>
            <a class="doc-anchor" href="#velocity" aria-label="Link to Vector Velocity model" data-chrome></a>
          </div>
          <p>
            Vector Velocity is Vector's own model — over 300 billion parameters — tuned for the loop Vector actually runs — planning, tool calls,
            edits, checks, and verification — rather than for open-ended chat. It will join the models included with
            Vector, selectable like any other provider in the desktop app and the CLI, and measured by the same
            Tokenomics engine as everything else.
          </p>
          <p class="note">
            Until Velocity ships, Big Pickle is the default model included with Vector in the desktop app and the CLI,
            and bring-your-own keys cover Claude, GPT, Gemini and the other supported providers.
          </p>
        </section>

        <section id="api-platform" class="doc-section">
          <div class="doc-heading">
            <h2>API platform <span class="doc-soon">Coming soon</span></h2>
            <a class="doc-anchor" href="#api-platform" aria-label="Link to API platform" data-chrome></a>
          </div>
          <p>
            Programmatic access to the same workspace: start sessions, run tasks, read transcripts and measured spend,
            manage connections, and trigger automations from your own systems and CI. Vector accounts and CLI tokens
            are the credential, so the account you already have is all the API needs.
          </p>
          <p class="note">The API platform is in development. The CLI is the first programmable surface today — <code>vector run "…"</code> works in scripts and CI with a <code>VECTOR_CLI_TOKEN</code>.</p>
        </section>

        <section id="multiplayer" class="doc-section">
          <div class="doc-heading">
            <h2>Multiplayer</h2>
            <a class="doc-anchor" href="#multiplayer" aria-label="Link to Multiplayer" data-chrome></a>
          </div>
          <p>
            One workspace, several people. <code>vector invite</code> starts your workspace as a shared server and prints
            two links: your own, and an invite link for teammates. Anyone who opens the invite lands in the same Vector
            UI, on the same sessions, files, and agents, as a guest. The header shows who is present, and a short
            "joined" or "left" notice when someone comes or goes.
          </p>
          <dl class="doc-rows">
            <div><dt>How the link works</dt><dd>The invite carries a guest password that is generated fresh each time you run <code>vector invite</code>. Guests are a separate credential from you, so revoking access is as simple as ending the session with Ctrl+C.</dd></div>
            <div><dt>Where it works</dt><dd>Anywhere on your network out of the box. From elsewhere, expose the port through a tunnel you already trust — <code>tailscale serve &lt;port&gt;</code> or <code>cloudflared tunnel --url http://localhost:&lt;port&gt;</code> — and share that host instead.</dd></div>
            <div><dt>What guests can do</dt><dd>Everything you can in that workspace: read and steer sessions, open files, run the agent. Share the link only with people you would hand your keyboard to.</dd></div>
          </dl>
        </section>

        <section id="github" class="doc-section">
          <div class="doc-heading">
            <h2>GitHub automation</h2>
            <a class="doc-anchor" href="#github" aria-label="Link to GitHub automation" data-chrome></a>
          </div>
          <p>
            Task in, pull request out. Run <code>vector github install</code> once inside a repository: it writes a
            workflow that installs the CLI from npm on every <code>/vector</code> comment, then add the
            <code>VECTOR_CLI_TOKEN</code> secret from your account page. From then on, commenting
            <code>/vector fix the flaky auth test</code> on an issue opens a branch and a pull request; commenting on an
            existing pull request replies on that branch.
          </p>
          <p>
            Every pull request carries its evidence, not just a diff: a Changes table with line counts per file, the
            output of any test, typecheck, lint, or build command the agent ran with its exit code, the measured token
            cost of the run, the judge's PASS or FAIL verdict when a judge pass ran, and a link back to the workflow run.
            Reviewers see what was checked before they read a line.
          </p>
          <p class="note">
            A model included with Vector runs the workflow with nothing but the account token, no API key needed. Add a provider key as a second secret to
            use Claude, GPT, or Gemini in CI. One repository setting is required: under Settings → Actions → General →
            Workflow permissions, tick "Allow GitHub Actions to create and approve pull requests" (GitHub leaves it off
            by default; without it the branch is pushed and Vector comments a compare link instead). Pull requests opened
            with the built-in GitHub token do not trigger the repository's other workflows; use a personal access token
            if you need CI to run on them.
          </p>
        </section>

        <section id="code-review" class="doc-section">
          <div class="doc-heading">
            <h2>Code review</h2>
            <a class="doc-anchor" href="#code-review" aria-label="Link to Code review" data-chrome></a>
          </div>
          <p>
            Every pull request, reviewed. Say yes to automatic review during <code>vector github install</code> and
            Vector reviews each pull request when it opens and again on every push. It leaves one summary comment with
            the risk, what changed and the files that matter, and comments on the exact lines, each with a severity
            and, where it is safe, a fix you can commit from GitHub. It reads the repository, not just the diff: it
            opens the changed files, follows their callers and checks the tests. On the next push it reviews only what
            changed and says what got fixed instead of repeating itself.
          </p>
          <dl class="doc-rows">
            <div><dt>What you get</dt><dd>A summary that is edited in place, and one review per push that contains only new comments. Severities are Blocking, Concern and Nit; nits and anything outside the changed lines stay in the summary. Vector only ever comments. It never approves or blocks a pull request, unless you set <code>failOn</code> to make its check fail on blocking issues.</dd></div>
            <div><dt>Commands</dt><dd><code>/vector review</code> reviews again, <code>/vector review full</code> starts over, and <code>/vector pause</code> or <code>/vector resume</code> turns automatic reviews off or on for one pull request (or add the <code>vector:paused</code> label). Reply <code>/vector fix</code> on a comment and Vector applies that fix. A person with write access, or the pull request's author, can resolve a comment or react to it with a thumbs-down, and Vector won't raise it again. Commands need write access.</dd></div>
            <div><dt>Your rules</dt><dd>Write plain-English rules in <code>.vector/review.md</code>. A <code>## path: src/billing/**</code> heading scopes the rules under it. Tune limits in <code>.vector/review.json</code>: <code>maxComments</code> (10), <code>minSeverity</code> (concern), <code>minConfidence</code> (0.7), <code>ignore</code>, <code>security</code>, <code>maxCostUsd</code>. Both are read from the base branch, so a pull request can't change the rules it is reviewed under, except by editing the workflow file, which needs write access.</dd></div>
            <div><dt>Low noise</dt><dd>Lockfiles, build output, generated and vendored files, snapshots and binaries are skipped and listed. Drafts, dependency bots and pull requests labelled <code>vector:skip</code> are skipped. To review drafts too, delete the <code>draft == false</code> line from <code>.github/workflows/vector.yml</code>. Very large pull requests get a note with a cost estimate instead of a review.</dd></div>
            <div><dt>Cost</dt><dd>Reviews run on your own provider keys, or on a model included with Vector with no key needed. Every review ends with the model, the tokens, what it cost and the total for that pull request. Each review stops at <code>maxCostUsd</code> ($2.00), automatic reviews of one pull request stop at <code>maxCostUsdPerPr</code> ($10.00), and <code>REVIEW_MAX_COST_USD_PER_MONTH</code> in the workflow caps a month. Set <code>REVIEW_AUTO_MODEL</code> to use a cheaper model for automatic reviews.</dd></div>
            <div><dt>Before you push</dt><dd><code>vector review</code> runs the same review on your branch against its merge-base with the default branch. Use <code>--uncommitted</code> for work in progress, <code>--json</code> for scripts, and <code>--fail-on blocking</code> in a pre-push hook.</dd></div>
            <div><dt>Security</dt><dd>The reviewer can only read. It cannot edit files, run commands or browse the web; Vector's own code gathers git history and posts the results. Pull requests from forks are not reviewed automatically, because GitHub gives their runs no secrets. A maintainer can comment <code>/vector review</code>, and that review never checks out or runs the fork's code.</dd></div>
          </dl>
          <p class="note">
            Reviews post as github-actions[bot] and need only <code>contents: read</code> and
            <code>pull-requests: write</code>. A review can go past its budget by at most one model step, and it says so
            when it stops early. The monthly cap is best-effort on very busy repositories.
          </p>
        </section>

        <section id="follow" class="doc-section">
          <div class="doc-heading">
            <h2>Follow mode</h2>
            <a class="doc-anchor" href="#follow" aria-label="Link to Follow mode" data-chrome></a>
          </div>
          <p>
            Watch the agent type. With Follow mode on, the editor opens whatever file the agent is editing, scrolls to
            the lines it changed, tints them in that agent's colour, and places a labelled caret at the end of the
            edit. Every edit is attributed to the agent that made it, so a session with several agents reads like a
            shared document with named cursors.
          </p>
          <dl class="doc-rows">
            <div><dt>Turn it off when you are typing</dt><dd>The eye button in the Codespace toolbar, or Settings → General → "Follow the agent in the editor". Off, the agent's edits to the file you have open are still highlighted; other files stay closed until you open them.</dd></div>
            <div><dt>What it never does</dt><dd>Your own saves, build output, and formatter runs do not move the editor. Only edits published by an agent do.</dd></div>
          </dl>
        </section>

        <section id="changelog" class="doc-section">
          <div class="doc-heading">
            <h2>Changelog</h2>
            <a class="doc-anchor" href="#changelog" aria-label="Link to Changelog" data-chrome></a>
          </div>
          <p>Keep the whole build in view. Recent releases, newest first.</p>
          <ol class="changelog">
            {changelog.map(([date, title, blurb]) => {
              const [when, version] = date.split(" · ")
              return (
                <li>
                  <h3>{title}</h3>
                  <p class="changelog-date">
                    <span>{when}</span>
                    {version && <span class="changelog-version">{version}</span>}
                  </p>
                  <p class="changelog-body">{blurb}</p>
                </li>
              )
            })}
          </ol>
        </section>
      </main>

      <aside class="docs-rail" aria-label="In this section">
        <div class="docs-rail-inner">
          <p class="docs-rail-title" data-rail-title>In this section</p>
          <ol class="docs-rail-list" data-rail></ol>
        </div>
      </aside>
    </div>

    <MarketingFooter />
  </div>
</MarketingLayout>

<script>
  const sidebar = document.querySelector<HTMLElement>("#docs-contents")
  const scroller = document.querySelector<HTMLElement>(".docs-nav")
  const input = document.querySelector<HTMLInputElement>("#docs-search")
  const empty = document.querySelector<HTMLElement>(".search-empty")
  const toggle = document.querySelector<HTMLButtonElement>(".docs-toc-toggle")
  const closeButton = document.querySelector<HTMLButtonElement>(".docs-sidebar-close")
  const currentLabel = document.querySelector<HTMLElement>("[data-toc-current]")
  const groups = [...document.querySelectorAll<HTMLElement>("[data-doc-group]")]
  const sections = [...document.querySelectorAll<HTMLElement>(".docs-content > .doc-section[id]")]
  const compact = window.matchMedia("(max-width: 1023.98px)")
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")

  // Every sidebar link, with the section it points at, so search can match a section's words as well as its name.
  const entries = [...document.querySelectorAll<HTMLAnchorElement>("[data-doc-link]")].map((link) => {
    const href = link.getAttribute("href") ?? ""
    const id = href.startsWith("#") ? decodeURIComponent(href.slice(1)) : ""
    const section = id ? document.getElementById(id) : null
    return {
      link,
      id,
      item: link.closest("li") ?? link,
      label: (link.textContent ?? "").replace(/\s+/g, " ").trim(),
      body: (section?.textContent ?? "").replace(/\s+/g, " ").toLowerCase(),
    }
  })
  const entryById = new Map(entries.filter((entry) => entry.id).map((entry) => [entry.id, entry]))

  // ---- Search ------------------------------------------------------------------------------------------------

  function filter() {
    if (!input) return
    const query = input.value.trim().toLowerCase()
    let matches = 0

    for (const entry of entries) {
      const visible =
        !query || entry.label.toLowerCase().includes(query) || (query.length > 2 && entry.body.includes(query))
      entry.item.hidden = !visible
      if (visible) matches += 1
    }

    for (const group of groups) group.hidden = !group.querySelector("li:not([hidden])")
    if (empty) empty.hidden = matches > 0
  }

  input?.addEventListener("input", filter)
  input?.addEventListener("keydown", (event) => {
    if (event.key === "Enter") {
      // A section whose name matches beats one that only mentions the words somewhere in its text.
      const query = input.value.trim().toLowerCase()
      const visible = entries.filter((entry) => !entry.item.hidden)
      const first = visible.find((entry) => entry.label.toLowerCase().includes(query)) ?? visible[0]
      if (!first) return
      event.preventDefault()
      first.link.click()
    } else if (event.key === "Escape" && input.value) {
      event.preventDefault()
      event.stopPropagation()
      input.value = ""
      filter()
    }
  })

  // ---- In-section rail, progress, and copyable commands ------------------------------------------------------

  const rail = document.querySelector<HTMLElement>("[data-rail]")
  const railTitle = document.querySelector<HTMLElement>("[data-rail-title]")
  const progress = document.querySelector<HTMLElement>("[data-progress]")

  const slug = (text: string) =>
    text
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "")

  // Subheadings are written without ids; give them stable ones so the rail can
  // link to them and so those links can be shared.
  const usedIds = new Set([...document.querySelectorAll<HTMLElement>("[id]")].map((element) => element.id))
  for (const section of sections) {
    for (const heading of section.querySelectorAll<HTMLElement>("h3")) {
      if (heading.id) continue
      const base = `${section.id}-${slug(heading.textContent ?? "")}`.slice(0, 64)
      let id = base
      let n = 2
      while (usedIds.has(id)) id = `${base}-${n++}`
      usedIds.add(id)
      heading.id = id
    }
  }

  function fillRail(id: string) {
    if (!rail) return
    const section = id ? document.getElementById(id) : null
    const headings = section ? [...section.querySelectorAll<HTMLElement>("h3[id]")] : []
    const column = rail.closest<HTMLElement>(".docs-rail")
    rail.innerHTML = ""
    if (!headings.length) {
      if (column) column.dataset.empty = "true"
      return
    }
    if (column) delete column.dataset.empty
    if (railTitle) railTitle.textContent = "In this section"
    for (const heading of headings) {
      const item = document.createElement("li")
      const link = document.createElement("a")
      link.href = `#${heading.id}`
      link.textContent = (heading.textContent ?? "").replace(/\s+/g, " ").trim()
      item.append(link)
      rail.append(item)
    }
  }

  function markRail() {
    if (!rail) return
    const links = [...rail.querySelectorAll<HTMLAnchorElement>("a")]
    let current: HTMLAnchorElement | undefined
    for (const link of links) {
      const target = document.getElementById(decodeURIComponent(link.hash.slice(1)))
      if (target && target.getBoundingClientRect().top <= 160) current = link
    }
    for (const link of links) link.classList.toggle("is-active", link === current)
  }

  function paintProgress() {
    if (!progress) return
    const root = document.documentElement
    const span = root.scrollHeight - window.innerHeight
    progress.style.width = `${span > 0 ? Math.min(100, Math.max(0, (window.scrollY / span) * 100)) : 0}%`
  }

  window.addEventListener("scroll", () => {
    markRail()
    paintProgress()
  }, { passive: true })
  window.addEventListener("resize", paintProgress)

  for (const button of document.querySelectorAll<HTMLButtonElement>(".doc-cmd-copy")) {
    const command = button.parentElement?.querySelector("code")
    if (!command) continue
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText((command.textContent ?? "").trim())
        button.textContent = "Copied"
        button.dataset.copied = "true"
      } catch {
        button.textContent = "Press ⌘C"
      }
      window.setTimeout(() => {
        button.textContent = "Copy"
        delete button.dataset.copied
      }, 1800)
    })
  }

  // ---- Active section ----------------------------------------------------------------------------------------

  let activeId = ""
  let frame = 0
  let lockUntil = 0
  let pointerInNav = false

  function revealInNav(link: HTMLElement) {
    if (!scroller || pointerInNav || compact.matches) return
    const box = scroller.getBoundingClientRect()
    const rect = link.getBoundingClientRect()
    const top = box.top + 40
    const bottom = Math.min(box.bottom, window.innerHeight) - 56
    if (rect.top >= top && rect.bottom <= bottom) return
    scroller.scrollTo({
      top: scroller.scrollTop + rect.top - box.top - (bottom - box.top) / 2,
      behavior: reducedMotion.matches ? "auto" : "smooth",
    })
  }

  function setActive(id: string) {
    if (id === activeId) return
    activeId = id
    for (const entry of entries) {
      const on = entry.id !== "" && entry.id === id
      entry.link.classList.toggle("is-active", on)
      if (on) entry.link.setAttribute("aria-current", "location")
      else entry.link.removeAttribute("aria-current")
    }
    const entry = entryById.get(id)
    if (currentLabel) currentLabel.textContent = entry?.label ?? ""
    if (entry) revealInNav(entry.link)
    fillRail(id)
    markRail()
  }

  function measure() {
    frame = 0
    if (performance.now() < lockUntil) return
    const line = Math.min(window.innerHeight * 0.3, 240)
    let current = ""
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= line) current = section.id
      else break
    }
    const root = document.documentElement
    const last = sections[sections.length - 1]
    if (last && window.scrollY + window.innerHeight >= root.scrollHeight - 2 && last.getBoundingClientRect().top < window.innerHeight) {
      current = last.id
    }
    setActive(current)
  }

  function schedule() {
    if (!frame) frame = requestAnimationFrame(measure)
  }

  window.addEventListener("scroll", schedule, { passive: true })
  window.addEventListener("resize", schedule)
  window.addEventListener("scrollend", () => {
    lockUntil = 0
    schedule()
  })
  paintProgress()
  scroller?.addEventListener("pointerenter", () => (pointerInNav = true))
  scroller?.addEventListener("pointerleave", () => (pointerInNav = false))
  schedule()

  // ---- Contents menu (below 1024px) --------------------------------------------------------------------------

  let open = false
  let inerted: HTMLElement[] = []

  function focusables() {
    if (!sidebar) return []
    return [...sidebar.querySelectorAll<HTMLElement>("a[href], button:not([disabled]), input:not([disabled])")].filter(
      (element) => element.getClientRects().length > 0,
    )
  }

  function openContents() {
    if (!sidebar || !toggle || open || !compact.matches) return
    open = true
    sidebar.classList.add("is-open")
    sidebar.setAttribute("role", "dialog")
    sidebar.setAttribute("aria-modal", "true")
    sidebar.setAttribute("aria-labelledby", "docs-contents-title")
    toggle.setAttribute("aria-expanded", "true")
    inerted = [...document.querySelectorAll<HTMLElement>(".docs-page > *, .docs-shell > *")].filter(
      (element) => element !== sidebar && !element.contains(sidebar),
    )
    for (const element of inerted) element.inert = true
    document.documentElement.style.overflow = "hidden"

    const active = activeId ? entryById.get(activeId)?.link : undefined
    if (active && scroller) scroller.scrollTop = active.offsetTop - scroller.clientHeight / 2
    closeButton?.focus()
  }

  function closeContents(restoreFocus = true) {
    if (!sidebar || !toggle || !open) return
    open = false
    sidebar.classList.remove("is-open")
    sidebar.removeAttribute("role")
    sidebar.removeAttribute("aria-modal")
    sidebar.removeAttribute("aria-labelledby")
    toggle.setAttribute("aria-expanded", "false")
    for (const element of inerted) element.inert = false
    inerted = []
    document.documentElement.style.overflow = ""
    if (restoreFocus) toggle.focus()
  }

  toggle?.addEventListener("click", () => (open ? closeContents() : openContents()))
  closeButton?.addEventListener("click", () => closeContents())
  sidebar?.addEventListener("click", (event) => {
    if (open && event.target === sidebar) closeContents()
  })
  compact.addEventListener("change", () => {
    if (!compact.matches) closeContents(false)
    activeId = ""
    schedule()
  })

  for (const entry of entries) {
    entry.link.addEventListener("click", () => {
      if (entry.id) {
        setActive(entry.id)
        lockUntil = performance.now() + 1200
      }
      closeContents(false)
    })
  }

  document.addEventListener("keydown", (event) => {
    if (open && event.key === "Escape") {
      event.preventDefault()
      closeContents()
      return
    }

    if (open && event.key === "Tab") {
      const items = focusables()
      if (!items.length) return
      const first = items[0]
      const last = items[items.length - 1]
      const inside = sidebar?.contains(document.activeElement)
      if (event.shiftKey && (document.activeElement === first || !inside)) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && (document.activeElement === last || !inside)) {
        event.preventDefault()
        first.focus()
      }
      return
    }

    // "/" jumps to search, unless the reader is already typing somewhere.
    if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return
    const target = event.target as HTMLElement | null
    if (target?.closest("input, textarea, select, [contenteditable]")) return
    event.preventDefault()
    if (compact.matches) openContents()
    input?.focus()
  })

  // ---- Copy buttons ------------------------------------------------------------------------------------------

  function legacyCopy(text: string) {
    const area = document.createElement("textarea")
    area.value = text
    area.setAttribute("readonly", "")
    area.style.position = "fixed"
    area.style.opacity = "0"
    document.body.append(area)
    area.select()
    let copied = false
    try {
      copied = document.execCommand("copy")
    } catch {
      copied = false
    }
    area.remove()
    return copied
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    const block = button.closest<HTMLElement>("[data-copy-block]")
    const source = block?.querySelector<HTMLElement>("[data-copy-source]")
    const label = button.querySelector<HTMLElement>("[data-copy-label]")
    const status = block?.querySelector<HTMLElement>("[data-copy-status]")
    let timer = 0

    button.addEventListener("click", async () => {
      const text = (source?.textContent ?? "").replace(/\s+/g, " ").trim()
      if (!text) return
      let copied = false
      try {
        await navigator.clipboard.writeText(text)
        copied = true
      } catch {
        copied = legacyCopy(text)
      }
      button.dataset.state = copied ? "copied" : "failed"
      if (label) label.textContent = copied ? "Copied" : "Copy failed"
      if (status) status.textContent = copied ? "Copied to clipboard" : "Copy failed"
      window.clearTimeout(timer)
      timer = window.setTimeout(() => {
        delete button.dataset.state
        if (label) label.textContent = "Copy"
        if (status) status.textContent = ""
      }, 1800)
    })
  }
</script>

