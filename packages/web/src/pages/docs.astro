const ecosystem = [
  "Claude Code",
  "Codex",
  "Cursor Agent",
  "Anthropic",
  "OpenAI",
  "Google",
  "MCP",
  "GitHub",
  "GitLab",
  "Linear",
  "Sentry",
  "Figma",
  "Stripe",
  "Vercel",
