  /* Thesis */
  .ip-thesis { display: grid; gap: 18px; }
  .ip-thesis h1 { font-size: clamp(32px, 5.2vw, 54px); font-weight: 800; line-height: 1.04; max-width: 17ch; }
  .ip-thesis h1 em { font-style: normal; background: linear-gradient(100deg, #7659d0 0%, #8b6ce3 40%, #b39cf4 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .ip-thesis .ip-lede { font-size: 17px; color: var(--muted); max-width: 66ch; }
  .ip-thesis .ip-lede strong { color: var(--ink); font-weight: 600; }
  .ip-facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--surface); }
  .ip-fact { padding: 14px 16px; display: grid; gap: 2px; border-left: 1px solid var(--line); min-width: 0; align-content: start; }
  .ip-fact:first-child { border-left: 0; }
  .ip-fact strong { font-family: var(--font-display); font-size: 26px; font-weight: 800; letter-spacing: -0.02em; }
  .ip-fact span { font-size: 13px; color: var(--muted); }
  @media (max-width: 760px) { .ip-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } .ip-fact:nth-child(3) { border-left: 0; } .ip-fact:nth-child(n+3) { border-top: 1px solid var(--line); } }

  /* Section heads */
  .ip-section { display: grid; gap: 18px; min-width: 0; }
  .ip-section-head { display: grid; gap: 6px; }
  .ip-section-head h2 { font-size: clamp(22px, 3vw, 28px); font-weight: 700; }
  .ip-section-head p { color: var(--muted); max-width: 72ch; }

  /* Lists */
  ul.ip-clean { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  ul.ip-clean li { padding-left: 16px; position: relative; }
  ul.ip-clean li::before { content: ""; position: absolute; left: 0; top: 0.62em; width: 6px; height: 6px; border-radius: 2px; background: var(--accent); }

  /* Problem / product */
  .ip-two { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 28px; }
  @media (max-width: 860px) { .ip-two { grid-template-columns: minmax(0, 1fr); } }
  .ip-today { gap: 14px; align-content: start; }
  .ip-problem { display: grid; gap: 12px; align-content: start; }
  .ip-problem li { color: var(--muted); }
  .ip-problem li strong { color: var(--ink); font-weight: 600; }
  .ip-caps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
  @media (max-width: 560px) { .ip-caps { grid-template-columns: minmax(0, 1fr); } }
  .ip-cap { background: var(--surface); padding: 14px 16px; display: grid; gap: 4px; min-width: 0; align-content: start; }
  .ip-cap h3 { font-size: 15px; font-weight: 700; letter-spacing: -0.005em; }
  .ip-cap p { font-size: 13.5px; color: var(--muted); }

  /* Comparison grid */
  .ip-grid-wrap { overflow-x: auto; border: 1px solid var(--line-strong); border-radius: 14px; background: var(--surface); }
  table.ip-compare { border-collapse: separate; border-spacing: 0; width: 100%; min-width: 760px; }
  .ip-compare th, .ip-compare td { padding: 11px 12px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  .ip-compare thead th { font-family: var(--font-display); font-size: 13.5px; font-weight: 700; color: var(--ink); background: var(--raised); }
  .ip-compare thead th small { display: block; font-family: var(--font-body); font-weight: 400; font-size: 11.5px; color: var(--muted); }
  .ip-compare tbody th { font-weight: 600; font-size: 14px; width: 19%; }
  .ip-compare tbody th span, .ip-compare tfoot th span { display: block; font-weight: 400; font-size: 12.5px; color: var(--muted); margin-top: 2px; }
  .ip-compare td { font-size: 12.5px; color: var(--muted); width: 13%; }
  .ip-compare td.ip-vec { width: 16%; }
  .ip-compare .ip-cell { display: block; }
  .ip-compare tr.ip-group th { width: auto; font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--faint); padding-block: 9px 7px; background: var(--raised); }
  .ip-compare .ip-vec { background: var(--accent-soft); border-left: 1px solid var(--accent); }
  .ip-compare thead .ip-vec { background: var(--accent-deep); color: #ffffff; border-left-color: var(--accent-deep); }
  .ip-compare thead .ip-vec small { color: rgba(255, 255, 255, 0.78); }
  .ip-compare td.ip-vec { color: var(--ink); }
  .ip-compare tfoot th, .ip-compare tfoot td { border-bottom: 0; border-top: 1px solid var(--line-strong); font-weight: 600; font-size: 14px; }
  .ip-compare tfoot td b { font-family: var(--font-display); font-size: 20px; font-weight: 800; color: var(--ink); }
  .ip-compare tfoot td.ip-vec b { color: var(--accent); font-size: 24px; }
  .ip-sym { display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; margin-bottom: 6px; font-size: 12px; font-weight: 700; font-style: normal; line-height: 1; vertical-align: top; }
  .ip-sym.ip-yes { background: var(--good); color: var(--bg); }
  .ip-sym.ip-part { border: 2px solid var(--part); background: linear-gradient(90deg, var(--part) 50%, transparent 50%); }
  .ip-sym.ip-no { border: 1.5px solid var(--none); color: var(--none); }
  .ip-sym.ip-vec-yes { width: 24px; height: 24px; background: var(--accent); color: var(--accent-ink); font-size: 14px; }
  .ip-sym.ip-vec-part { width: 24px; height: 24px; border: 2px solid var(--accent); background: linear-gradient(90deg, var(--accent) 50%, transparent 50%); }
  .ip-legend { display: flex; flex-wrap: wrap; gap: 18px; font-size: 12.5px; color: var(--muted); align-items: center; }
  .ip-legend span { display: inline-flex; align-items: center; gap: 7px; }
  .ip-legend .ip-sym { margin: 0; width: 16px; height: 16px; font-size: 10px; }
  .ip-footnote { font-size: 12.5px; color: var(--faint); max-width: 92ch; }
  .ip-footnote strong { color: var(--muted); font-weight: 500; }

  /* Phone: each capability becomes a card, Vector's answer first, then the five others two to a row. */
  @media (max-width: 760px) {
    .ip-grid-wrap { overflow: visible; border: 0; border-radius: 0; background: none; }
    table.ip-compare, .ip-compare tbody, .ip-compare tfoot, .ip-compare tr, .ip-compare th, .ip-compare td { display: block; width: auto; min-width: 0; }
    table.ip-compare { min-width: 0; }
    .ip-compare thead { display: none; }
    .ip-compare tbody { display: grid; gap: 10px; margin-bottom: 18px; }
    .ip-compare tr.ip-group { display: block; }
    .ip-compare tr.ip-group th { background: none; border: 0; padding: 0; }
    .ip-compare tbody tr:not(.ip-group), .ip-compare tfoot tr { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); border: 1px solid var(--line-strong); border-radius: 12px; background: var(--surface); overflow: hidden; }
    .ip-compare tbody tr th[scope="row"], .ip-compare tfoot th { grid-column: 1 / -1; order: -2; width: auto; border-bottom: 1px solid var(--line); }
    .ip-compare tbody tr th[scope="row"] span { display: inline; margin: 0; }
    .ip-compare tbody tr th[scope="row"] span::before { content: " · "; }
    .ip-compare td.ip-vec { grid-column: 1 / -1; order: -1; width: auto; border-left: 0; border-bottom: 1px solid var(--accent); }
    .ip-compare td { border-bottom: 1px solid var(--line); display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; align-content: start; column-gap: 8px; row-gap: 4px; }
    .ip-compare td .ip-sym { grid-column: 1; grid-row: 1; margin-bottom: 0; }
    .ip-compare td .ip-cell { grid-column: 1 / -1; grid-row: 2; }
    .ip-compare td:nth-child(odd):not(.ip-vec) { border-left: 1px solid var(--line); }
    .ip-compare tbody td:nth-child(6) { grid-column: 1 / -1; border-bottom: 0; }
    .ip-compare td::before { content: attr(data-label); grid-column: 2; grid-row: 1; font-family: var(--font-display); font-weight: 700; font-size: 12.5px; color: var(--ink); }
    .ip-compare td.ip-vec::before { color: var(--accent); }
    .ip-compare tfoot tr { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .ip-compare tfoot th, .ip-compare tfoot td { border-top: 0; }
    .ip-compare tfoot td { grid-template-columns: minmax(0, 1fr); align-items: start; align-content: space-between; gap: 2px; padding-inline: 8px; }
    .ip-compare tfoot td::before { grid-column: 1; grid-row: 1; font-size: 11px; overflow-wrap: anywhere; }
    .ip-compare tfoot td b { grid-row: 2; }
    .ip-compare tfoot td.ip-vec { padding-inline: 12px; }
    .ip-compare tfoot td:nth-child(odd):not(.ip-vec) { border-left: 0; }
    .ip-compare tfoot td:not(.ip-vec) + td:not(.ip-vec) { border-left: 1px solid var(--line); }
  }

  /* Tool stack */
  .ip-stack { display: grid; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--surface); }
  .ip-stack-head, .ip-stack-row { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.25fr) minmax(0, 1.45fr); gap: 18px; padding: 13px 16px; }
  .ip-stack-head { background: var(--raised); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint); }
  .ip-stack-row { border-top: 1px solid var(--line); }
  .ip-stack-row h3 { font-size: 15px; font-weight: 700; }
  .ip-stack-today { font-size: 13px; color: var(--muted); }
  .ip-stack-vector { font-size: 13.5px; color: var(--ink); }
  .ip-stack-tag { display: none; }
  .ip-fit { display: inline-block; margin-left: 4px; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); border: 1px solid var(--accent); border-radius: 999px; padding: 0 7px; white-space: nowrap; vertical-align: 1px; }
  @media (max-width: 760px) {
    .ip-stack-head { display: none; }
    .ip-stack-row { grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .ip-stack-head + .ip-stack-row { border-top: 0; }
    .ip-stack-tag { display: block; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); margin-bottom: 2px; }
  }
  .ip-callouts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 760px) { .ip-callouts { grid-template-columns: minmax(0, 1fr); } }
  .ip-callout { border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: 12px; padding: 16px 18px; background: var(--surface); display: grid; gap: 6px; align-content: start; min-width: 0; }
  .ip-callout strong { font-family: var(--font-display); font-size: 30px; font-weight: 800; letter-spacing: -0.02em; color: var(--accent); line-height: 1.1; }
  .ip-callout strong small { font-size: 15px; font-weight: 600; color: var(--muted); letter-spacing: 0; }
  .ip-callout p { font-size: 13.5px; color: var(--muted); }

  /* Model layer */
  .ip-reasons { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 860px) { .ip-reasons { grid-template-columns: minmax(0, 1fr); } }
  .ip-reason { border-top: 2px solid var(--accent); padding-top: 12px; display: grid; gap: 6px; align-content: start; min-width: 0; }
  .ip-reason-n { font-family: var(--font-mono); font-size: 12px; color: var(--accent); }
  .ip-reason h3 { font-size: 16.5px; font-weight: 700; }
  .ip-reason p { font-size: 13.5px; color: var(--muted); }

  .ip-gap { display: grid; gap: 16px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); padding: 20px; min-width: 0; }
  .ip-gap-head h3 { font-size: clamp(18px, 2.4vw, 21px); font-weight: 700; max-width: 40ch; }
  .ip-chart { margin: 0; display: grid; gap: 10px; min-width: 0; }
  .ip-plot { position: relative; height: 196px; margin-inline: 6px; }
  .ip-clusters { position: absolute; left: 0; right: 0; top: 0; height: 40px; }
  .ip-clusters span { position: absolute; top: 0; transform: translateX(-50%); font-size: 11.5px; line-height: 1.25; color: var(--muted); text-align: center; white-space: nowrap; }
  .ip-clusters b { font-family: var(--font-display); font-size: 15px; font-weight: 800; color: var(--ink); }
  .ip-dots { position: absolute; left: 0; right: 0; top: 44px; height: 92px; }
  .ip-dot, .ip-vring { position: absolute; top: calc(50% + var(--y, 0px)); width: 11px; height: 11px; border-radius: 50%; transform: translate(-50%, -50%); }
  .ip-dot { background: var(--dot); box-shadow: 0 0 0 2px var(--surface); transition: transform 120ms ease; }
  .ip-dot:hover { transform: translate(-50%, -50%) scale(1.35); background: var(--ink); }
  .ip-vring { --y: -24px; width: 15px; height: 15px; border: 2.5px solid var(--accent); background: var(--surface); z-index: 1; }
  .ip-vline { position: absolute; top: 44px; height: 102px; width: 0; border-left: 2px dashed var(--accent); transform: translateX(-1px); pointer-events: none; }
  .ip-axis { position: absolute; left: 0; right: 0; top: 146px; height: 24px; border-top: 1px solid var(--line-strong); }
  .ip-axis span { position: absolute; top: 5px; transform: translateX(-50%); font-family: var(--font-mono); font-size: 11px; color: var(--faint); }
  .ip-axis span::before { content: ""; position: absolute; left: 50%; top: -9px; height: 4px; border-left: 1px solid var(--line-strong); }
  .ip-vlabel { position: absolute; top: 174px; transform: translateX(-50%); font-family: var(--font-mono); font-size: 11.5px; color: var(--accent); white-space: nowrap; }
  @media (max-width: 520px) {
    .ip-dot { width: 8px; height: 8px; box-shadow: 0 0 0 1.5px var(--surface); }
    .ip-vring { width: 12px; height: 12px; }
    .ip-gap { padding: 16px; }
    .ip-vlabel { transform: translateX(-78%); }
  }
  .ip-gap-points { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 24px; }
  @media (max-width: 760px) { .ip-gap-points { grid-template-columns: minmax(0, 1fr); } }
  .ip-gap-points li { font-size: 13.5px; color: var(--muted); padding-left: 14px; border-left: 2px solid var(--line-strong); }
  .ip-gap-points strong { color: var(--ink); font-weight: 600; }

  .ip-details { font-size: 12.5px; color: var(--muted); }
  .ip-details summary { cursor: pointer; font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); width: fit-content; }
  .ip-model-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px 24px; padding-top: 12px; }
  @media (max-width: 760px) { .ip-model-list { grid-template-columns: minmax(0, 1fr); } }
  .ip-model-list h4, .ip-source-groups h4 { font-size: 12.5px; font-weight: 700; color: var(--ink); margin-bottom: 6px; }
  .ip-model-list ul, .ip-source-groups ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .ip-model-list li { display: flex; justify-content: space-between; gap: 10px; border-bottom: 1px solid var(--line); padding-bottom: 3px; }
  .ip-model-list li i { font-style: normal; color: var(--faint); }
  .ip-model-list li b { font-weight: 500; color: var(--ink); font-family: var(--font-mono); font-size: 12px; }

  .ip-velocity { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: 24px; align-items: start; }
  @media (max-width: 860px) { .ip-velocity { grid-template-columns: minmax(0, 1fr); } }
  .ip-vcard { position: relative; overflow: hidden; border: 1px solid var(--accent); border-radius: 14px; padding: 22px; display: grid; gap: 12px; background: linear-gradient(160deg, var(--accent-soft), transparent 70%), var(--surface); min-width: 0; }
  .ip-vcard::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 3px; background: linear-gradient(90deg, #7659d0, #a287ef, #c0acf9); }
  .ip-vcard .ip-status { justify-self: start; }
  .ip-vcard h3 { font-size: clamp(24px, 3.2vw, 30px); font-weight: 800; letter-spacing: -0.02em; }
  .ip-vsize { font-size: 14px; color: var(--muted); }
  .ip-vsize b { font-family: var(--font-display); font-size: 34px; font-weight: 800; letter-spacing: -0.03em; color: var(--accent); margin-right: 6px; }
  .ip-vcard > p:not(.ip-vsize) { color: var(--muted); max-width: 60ch; }
  .ip-vcard li { font-size: 13.5px; color: var(--muted); }
  .ip-vcard li strong { color: var(--ink); font-weight: 600; }
  .ip-why-us { display: grid; gap: 14px; padding-top: 4px; min-width: 0; }
  .ip-why-item { display: grid; gap: 3px; padding-left: 14px; border-left: 2px solid var(--accent); }
  .ip-why-item h4 { font-size: 15px; font-weight: 700; }
  .ip-why-item p { font-size: 13.5px; color: var(--muted); }

  /* Benchmark */
  .ip-bench { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 28px; align-items: start; }
  @media (max-width: 860px) { .ip-bench { grid-template-columns: minmax(0, 1fr); } }
  .ip-bench-claim { display: grid; gap: 10px; }
  .ip-big { font-family: var(--font-display); font-weight: 800; font-size: clamp(40px, 6vw, 60px); letter-spacing: -0.03em; line-height: 1; color: var(--accent); }
  .ip-bars { display: grid; gap: 14px; }
  .ip-bar-row { display: grid; gap: 5px; }
  .ip-bar-label { display: flex; justify-content: space-between; gap: 10px; font-size: 13px; }
  .ip-bar-label b { font-weight: 600; }
  .ip-save { font-family: var(--font-mono); font-size: 12px; color: var(--good); white-space: nowrap; }
  .ip-bar-pair { display: grid; gap: 4px; }
  .ip-bar { display: grid; grid-template-columns: 92px minmax(0, 1fr); align-items: center; gap: 10px; font-size: 12px; color: var(--muted); }
  .ip-track { height: 14px; border-radius: 4px; background: var(--raised); position: relative; }
  .ip-fill { position: relative; height: 100%; border-radius: 4px; display: flex; align-items: center; justify-content: flex-end; }
  .ip-fill.ip-v { background: linear-gradient(90deg, #7659d0, #a287ef); }
  .ip-fill.ip-c { background: var(--compare); }
  .ip-fill i { font-style: normal; font-family: var(--font-mono); font-size: 11px; position: absolute; left: 100%; margin-left: 6px; color: var(--muted); white-space: nowrap; }

  /* Personas */
  .ip-people { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 900px) { .ip-people { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .ip-people { grid-template-columns: minmax(0, 1fr); } }
  .ip-person { border-top: 2px solid var(--accent); padding-top: 12px; display: grid; gap: 6px; align-content: start; min-width: 0; }
  .ip-person h3 { font-size: 15.5px; font-weight: 700; }
  .ip-person .ip-why { font-size: 13.5px; color: var(--muted); }
  .ip-fit-label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint); }

  /* Roadmap */
  .ip-road { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--surface); }
  @media (max-width: 900px) { .ip-road { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .ip-road { grid-template-columns: minmax(0, 1fr); } }
  .ip-milestone { padding: 18px; display: grid; gap: 8px; align-content: start; border-left: 1px solid var(--line); min-width: 0; position: relative; }
  .ip-milestone:first-child { border-left: 0; }
  @media (max-width: 900px) { .ip-milestone:nth-child(3) { border-left: 0; } .ip-milestone:nth-child(n+3) { border-top: 1px solid var(--line); } }
  @media (max-width: 560px) { .ip-milestone { border-left: 0; } .ip-milestone:nth-child(n+2) { border-top: 1px solid var(--line); } }
  .ip-milestone::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 3px; background: linear-gradient(90deg, #7659d0, #a287ef); opacity: 0.85; }
  .ip-milestone h3 { font-size: 18px; font-weight: 700; }
  .ip-milestone p { font-size: 13.5px; color: var(--muted); }
  .ip-stage { justify-self: start; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); border: 1px solid var(--accent); border-radius: 999px; padding: 1px 8px; }

  /* Business + limits */
  .ip-split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px; }
  @media (max-width: 860px) { .ip-split { grid-template-columns: minmax(0, 1fr); } }
  .ip-panel { border: 1px solid var(--line); border-radius: 12px; padding: 18px; background: var(--surface); display: grid; gap: 12px; align-content: start; min-width: 0; }
  .ip-panel h2 { font-size: 20px; font-weight: 700; }
  .ip-tiers { display: flex; flex-wrap: wrap; gap: 8px; }
  .ip-tier { font-family: var(--font-mono); font-size: 12.5px; padding: 6px 10px; border-radius: 8px; background: var(--raised); border: 1px solid var(--line); }
  .ip-tier b { color: var(--ink); font-weight: 500; }
  .ip-tier span { color: var(--muted); }
  .ip-status { display: inline-block; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--part); border: 1px solid var(--part); border-radius: 999px; padding: 1px 8px; vertical-align: middle; }
