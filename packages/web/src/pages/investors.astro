    .ip-compare td:nth-child(odd):not(.ip-vec) { border-left: 1px solid var(--line); }
    .ip-compare tbody td:nth-child(6) { grid-column: 1 / -1; border-bottom: 0; }
    .ip-compare td::before { content: attr(data-label); grid-column: 2; grid-row: 1; font-family: var(--font-display); font-weight: 700; font-size: 12.5px; color: var(--ink); }
    .ip-compare td.ip-vec::before { color: var(--accent); }
    .ip-compare tfoot tr { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .ip-compare tfoot th, .ip-compare tfoot td { border-top: 0; }
    .ip-compare tfoot td { grid-template-columns: minmax(0, 1fr); align-items: start; align-content: space-between; gap: 2px; padding-inline: 8px; }
    .ip-compare tfoot td::before { grid-column: 1; grid-row: 1; font-size: 11px; overflow-wrap: anywhere; }
    .ip-compare tfoot td b { grid-row: 2; }
    .ip-compare tfoot td.ip-vec { padding-inline: 12px; }
