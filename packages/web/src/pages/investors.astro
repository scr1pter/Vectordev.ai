---
import "@fontsource/ibm-plex-mono/400.css"
import "@fontsource/ibm-plex-mono/500.css"
import MarketingLayout from "../components/marketing/MarketingLayout.astro"

export const prerender = true

// Comparison grid. Each cell is [mark, text]: y = yes, p = partly, n = no. Facts come from each company's own docs and
// pricing pages, re-checked 15 October 2026 (see the sources list at the foot of the page). Cursor moved to new plans
// on 12 October 2026, so its cells follow the new pricing page. Codex's cells name no price, so the grid never sets a
// Codex price against Vector's free workspace.
const products = [
  { name: "Cursor", kind: "AI code editor (SpaceX)" },
  { name: "Codex", kind: "OpenAI" },
  { name: "Claude Code", kind: "Anthropic" },
  { name: "Lovable", kind: "App builder" },
  { name: "Base44", kind: "App builder (Wix)" },
]

const groups = [
  {
    name: "Agents",
    rows: [
      {
        cap: "Parallel agents, isolated",
        note: "Each task in its own git worktree",
        cells: [
          ["y", "Agents Window, worktrees, cloud agents"],
          ["y", "Worktrees in the app, cloud tasks"],
          ["y", "Worktrees, /batch, cloud sessions"],
          ["p", "Drafts: a separate copy and chat per person"],
          ["n", "None documented"],
        ],
        vector: ["y", "Clash flags, then merge after your tests and a secret scan"],
      },
      {
        cap: "Runs other vendors' agents",
        // Conductor and Superset are not columns in this grid, so the row itself says they do this too.
        note: "Side by side, in one place; orchestrators such as Conductor and Superset do this too",
        cells: [
          ["p", "Their editor extensions, in separate panels"],
          ["n", "Imports their settings, runs its own"],
          ["n", "Workers are always Claude sessions"],
          ["n", "Its own agent only"],
          ["n", "Its own agent only"],
        ],
        vector: ["y", "Claude Code, Codex and Cursor Agent, each in an isolated checkout"],
      },
      {
        cap: "Specialist subagents",
        note: "Delegated work that reports back",
        cells: [
          ["y", "Custom subagents"],
          ["y", "Custom agents; worker and explorer built in"],
          ["y", "Custom subagents; agent teams (experimental)"],
          ["p", "Read-only research and review helpers"],
          ["n", "None documented"],
        ],
        vector: ["y", "9 built in: general, explore, review, judge, debug, test, security, performance, migration; they run in the background and can be steered"],
      },
    ],
  },
  {
    name: "Quality",
    rows: [
      {
        cap: "AI review on pull requests",
        note: "In place of a separate review bot",
        cells: [
          ["y", "Bugbot from the $30 plan, about $1–1.50 a run"],
          ["y", "@codex review, on paid plans"],
          ["y", "Team and Enterprise, billed on tokens; Anthropic puts the average at $15–25 a review"],
          ["n", "Security scan before publishing"],
          ["n", "App security scan"],
        ],
        vector: ["y", "Vectorscope on GitHub, desktop and CLI; no Vector fee, only model tokens"],
      },
      {
        cap: "Issue to pull request",
        note: "From a ticket to a reviewable branch",
        cells: [
          ["y", "Linear, GitHub or Slack to a cloud-agent PR"],
          ["p", "Linear issue to a cloud task; you open the PR"],
          ["y", "@claude in its GitHub Action"],
          ["n", "None"],
          ["n", "None"],
        ],
        vector: ["y", "An issue comment becomes a branch and a PR listing the commands it ran and their results"],
      },
      {
        cap: "Browser testing",
        note: "Of the running app",
        cells: [
          ["y", "Browser tool with console, network, screenshots"],
          ["p", "In the desktop app only"],
          ["p", "Chrome extension, direct Anthropic plans only"],
          ["y", "Remote browser against the preview"],
          ["p", "Testing agent; cannot test sign-in steps"],
        ],
        vector: ["y", "Browser agent; Vercel publishes get a browser smoke test by default"],
      },
    ],
  },
  {
    name: "Ship and collaborate",
    rows: [
      {
        cap: "Deploy and database from the agent",
        note: "Publish, migrate, set environment",
        cells: [
          ["p", "Through Vercel and Supabase plugins"],
          ["p", "Through third-party plugins"],
          ["p", "Through third-party plugins"],
          ["y", "Built-in hosting and database"],
          ["y", "Built-in backend, database and hosting"],
        ],
        vector: ["y", "Vector Cloud: Vercel previews with health and browser checks; Supabase SQL shown before it runs"],
      },
      {
        cap: "Live multiplayer",
        note: "Teammates in the same live work",
        cells: [
          ["p", "Read-only shared transcripts (Teams)"],
          ["n", "None documented"],
          ["p", "Shared session links, not live"],
          ["y", "Collaborators see changes as they happen"],
          ["y", "Real-time canvas with named cursors"],
        ],
        vector: ["p", "Early: a teammate joins a live session by invite link"],
      },
    ],
  },
  {
    name: "Cost and access",
    rows: [
      {
        cap: "Cost of every session",
        note: "In dollars, per session and model",
        cells: [
          ["p", "Monthly spend limits; no per-task cost documented"],
          ["p", "Workspace spend controls; no per-task cost documented"],
          ["p", "Session estimate and limits"],
          ["p", "Credits per message, credit limits"],
          ["p", "Monthly credits, not dollars"],
        ],
        vector: ["y", "Sessions priced from provider-reported tokens wherever the model has a price, subagents included, with a live cap you set"],
      },
      {
        cap: "Any model, any provider",
        note: "Including local and free models",
        cells: [
          ["p", "Hosted models; own keys for 5 providers"],
          ["p", "OpenAI models by default; Responses-compatible providers, Bedrock, Ollama or LM Studio"],
          ["p", "Officially Claude models only; others through a gateway, without Anthropic support"],
          ["n", "No model picker documented"],
          ["p", "10 models; picking one needs a paid plan"],
        ],
        vector: ["y", "219 providers, local endpoints, free models"],
      },
      {
        cap: "Your repos, on your machine",
        note: "Any existing codebase, run locally",
        cells: [
          ["y", "Any local or remote repo"],
          ["y", "Local repos and cloud tasks"],
          ["y", "Any repo, terminal and IDE"],
          ["p", "Cloud-hosted apps; cannot import a repo"],
          ["p", "Imports a repo into its cloud"],
        ],
        vector: ["y", "Desktop and CLI on your machine"],
      },
      {
        cap: "The whole product, free",
        note: "Agents, review and testing included",
        cells: [
          ["p", "Limited free tier; review and cloud agents from $30/mo"],
          ["p", "Free desktop tier; CLI, IDE and review on paid plans"],
          ["n", "Not on the free plan; from $17/mo"],
          ["p", "5 build credits a day free, 30 a month"],
          ["p", "25 messages a month free"],
        ],
        vector: ["y", "Free workspace; bring a model account, a local model or your own free OpenRouter account"],
      },
    ],
  },
]

const allRows = groups.flatMap((group) => group.rows)
const fullMarks = products.map((_, index) => allRows.filter((row) => row.cells[index][0] === "y").length)
const vectorFullMarks = allRows.filter((row) => row.vector[0] === "y").length
const closest = products[fullMarks.indexOf(Math.max(...fullMarks))]
const markLabel = { y: "Yes", p: "Partly", n: "No" }
const markClass = { y: "ip-yes", p: "ip-part", n: "ip-no" }
const vectorMarkClass = { y: "ip-vec-yes", p: "ip-vec-part", n: "ip-no" }

const stack = [
  {
    job: "Running many agents",
    today: "Conductor $50 Pro · Superset $15–20 per user",
    vector: "Outside agents beside Vector's, each in an isolated checkout, merged after tests and a secret scan.",
    fit: "Replaces locally",
  },
  {
    job: "AI code review",
    today: "CodeRabbit from $24 per developer · Greptile $30 per seat",
    vector: "Vectorscope on GitHub, desktop and CLI, with a verify pass that re-checks blocking findings. No Vector fee.",
    fit: "Does the job",
  },
  {
    job: "Cost tracking and caps",
    today: "Helicone $79 Pro · Langfuse $29–199",
    vector: "Sessions priced wherever the model has a price; the Run Guard stops a run at your cap, within one step for each agent running.",
    fit: "Covers coding agents",
  },
  {
    job: "Deploys and databases",
    today: "Vercel and Supabase dashboards, by hand",
    vector: "Vector Cloud previews, rolls back and migrates on your Vercel and Supabase accounts, showing SQL first and asking before every account change.",
    fit: "Controls them",
  },
]

// The checked-in offline archive docs/benchmarks/vector-efficiency-2026-10 (summary.json, integrated HTTP cells): Vector
// on the Messages API against Claude Code 2.1.215, medians of three repetitions, in US dollars per task. Both agents made
// the same number of model requests in every task. Each runtime's simulated cache is fresh at the start of a repetition
// and carries across its tasks and sessions within it; the second session is a new process with that cache warm.
// Only the three fix tasks are quoted: the archive's fourth, long-loop, scripts a read of src/args.ts, a file its
// fixture does not have, so both agents get an error result for that step. Bars put 20 cents at 100%.
const bench = [
  { id: "solo-fix", label: "Fix a bug: test, read, edit, re-test", first: { vector: 0.051005, claude: 0.153329 }, second: { vector: 0.020625, claude: 0.081438 } },
  { id: "delegate-explore", label: "Hand exploration to a subagent, then verify", first: { vector: 0.035368, claude: 0.141836 }, second: { vector: 0.026053, claude: 0.103717 } },
  { id: "delegate-general", label: "Hand a task to a general subagent, then verify", first: { vector: 0.039049, claude: 0.149377 }, second: { vector: 0.024817, claude: 0.100459 } },
]
const sessions = [
  { key: "first", name: "First" },
  { key: "second", name: "Second" },
] as const
const cents = (usd: number) => (Math.round(usd * 1000) / 10).toFixed(1)
const barWidth = (usd: number) => `${((usd / 0.2) * 100).toFixed(1)}%`
const saving = (pair: { vector: number; claude: number }) => Math.round((1 - pair.vector / pair.claude) * 100)

// The newest very large coding model from each of four makers, checked 17 October 2026 against each model card or
// maker's announcement. Vector Velocity is in development and the page gives it only its size, 550B parameters: no
// active size, base model or compute provider, and no sizes for the four beyond the 480B in Qwen3-Coder's name.
const largeModels = [
  { name: "Qwen3-Coder-480B", maker: "Qwen", weights: "Open (Apache 2.0)", agent: "Qwen Code, Cline" },
  { name: "Composer 2.5", maker: "Cursor", weights: "Not published", agent: "Cursor" },
  { name: "SWE-2", maker: "Cognition", weights: "Not published", agent: "Devin" },
  { name: "Kimi K2.7 Code", maker: "Moonshot", weights: "Open (Modified MIT)", agent: "Kimi Code CLI" },
]
---

{/* The investor one-pager. Unlisted: noindex, not linked from the site, shared by link only. */}
<MarketingLayout
  title="Vector · Investor one-pager"
  description="Why Vector is inevitable: the workspace that runs the labs' agents side by side cannot belong to a lab. Vector's free agent workspace, its offline benchmark, the model it is building and its roadmap to many more cloud services."
  noindex
>
  <div class="ip-root">
<div class="ip-page">
  <header class="ip-top">
    <div class="ip-brand">
      <span class="ip-mark" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14"><path d="M1.5 2.5 L7 12 L12.5 2.5" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      Vector
    </div>
    <div class="ip-meta"><span>vectordev.ai</span><span>Agentic coding workspace</span><span>October 2026</span></div>
  </header>

  <section class="ip-thesis" aria-labelledby="thesis-title">
    <div class="ip-eyebrow">Why Vector is inevitable</div>
    <h1 id="thesis-title">The workspace that runs the labs' agents side by side cannot <em>belong to a lab</em>.</h1>
    <p class="ip-lede">Over a quarter of organisations send different work to different models,<sup>1</sup> yet each lab builds its agent around its own. <strong>Vector is the neutral harness:</strong> its own lean agent beside Claude Code, Codex and Cursor Agent, on any model, with review, testing and deploys built in. The workspace is free; Vector plans to earn on model credits, its own model and its own cloud services.</p>
    <div class="ip-facts">
      <div class="ip-fact"><strong class="ip-num">67–75%</strong><span>less modelled spend than Claude Code in a first session, offline*</span></div>
      <div class="ip-fact"><strong class="ip-num">219</strong><span>model providers and 8,184 models, plus local ones</span></div>
      <div class="ip-fact"><strong class="ip-num">3</strong><span>outside agents: Claude Code, Codex, Cursor Agent</span></div>
      <div class="ip-fact"><strong class="ip-num">$0</strong><span>for the workspace, on desktop and in the terminal</span></div>
    </div>
  </section>

  <section class="ip-section" aria-labelledby="now-title">
    <div class="ip-section-head">
      <div class="ip-eyebrow">Why now</div>
      <h2 id="now-title">Three shifts make a neutral harness inevitable</h2>
    </div>
    <div class="ip-reasons">
      <div class="ip-reason">
        <span class="ip-reason-n ip-num">01</span>
        <h3>The labs close ranks</h3>
        <p>Labs sell their own agents (Claude Code passed $2.5B in run-rate revenue in February 2026) and cut others off: Anthropic limited Windsurf's access to Claude and blocked third-party tools from Claude Pro and Max, and OpenAI says Cursor's access ends on 12 November 2026.</p>
      </div>
      <div class="ip-reason">
        <span class="ip-reason-n ip-num">02</span>
        <h3>Good models are cheap and open</h3>
        <p>The price of a given level of performance falls 9x to 900x a year,<sup>2</sup> and Cursor's Composer 2.5 and Cognition's SWE-2 are built on Moonshot's open Kimi models. The model alone is no moat, and a harness can now afford its own.</p>
      </div>
      <div class="ip-reason">
        <span class="ip-reason-n ip-num">03</span>
        <h3>Every token is a line on the bill</h3>
        <p>38% of organisations set usage limits to control AI cost,<sup>1</sup> and Cursor ran at negative gross margins until its own model and cheaper open ones lifted it to slightly positive (TechCrunch, April 2026). The harness decides how many tokens a task takes.</p>
      </div>
    </div>
    <div class="ip-callout ip-answer">
      <h3>And if a lab cuts Vector off?</h3>
      <p>Vector depends on no single lab. It runs each vendor's own CLI, installed and signed in by the developer, and its own agent runs on any provider in its catalog or a local model. If one door closes, the work moves to another model.</p>
    </div>
  </section>

  <section class="ip-section" aria-labelledby="stack-title">
    <div class="ip-section-head">
      <div class="ip-eyebrow">All in one · desktop 1.99.108</div>
      <h2 id="stack-title">One free workspace in place of a stack of tools</h2>
      <p>Teams buy these separately today, often per developer. Vector does the core of each in one free workspace.</p>
    </div>
    <div class="ip-stack" role="list">
      <div class="ip-stack-head" aria-hidden="true"><span>Job</span><span>What teams buy today · list price a month</span><span>In Vector, free</span></div>
      {stack.map((item) => (
        <div class="ip-stack-row" role="listitem">
          <h3>{item.job}</h3>
          <p class="ip-stack-today"><span class="ip-stack-tag">Today</span>{item.today}</p>
          <p class="ip-stack-vector"><span class="ip-stack-tag">In Vector</span>{item.vector} <span class="ip-fit">{item.fit}</span></p>
        </div>
      ))}
    </div>
    <div class="ip-callout">
      <strong class="ip-num">$1.5B</strong>
      <p>CodeRabbit's valuation for AI review alone (Series C, August 2026). Vectorscope does that job in the free workspace.</p>
    </div>
    <details class="ip-details ip-grid-details">
      <summary>{`Twelve capabilities, six products · Vector has ${vectorFullMarks}, ${closest.name} has ${Math.max(...fullMarks)}`}</summary>
      <div class="ip-grid-body">
        <p class="ip-muted ip-small">Each cell says how that product handles it today. Vector chose these rows because they are the jobs it is built for: it has {vectorFullMarks} of the {allRows.length} in full, and the closest in this grid, {closest.name}, has {Math.max(...fullMarks)}.</p>
        <div class="ip-legend" aria-label="Legend">
          <span><i class="ip-sym ip-yes" aria-hidden="true">✓</i>Yes</span>
          <span><i class="ip-sym ip-part" aria-hidden="true"></i>Partly</span>
          <span><i class="ip-sym ip-no" aria-hidden="true">✕</i>No</span>
        </div>
        <div class="ip-grid-wrap">
          <table class="ip-compare">
            <thead>
              <tr>
                <th scope="col">Capability</th>
                {products.map((product) => <th scope="col">{product.name}<small>{product.kind}</small></th>)}
                <th scope="col" class="ip-vec">Vector<small>Agent workspace</small></th>
              </tr>
            </thead>
            {groups.map((group) => (
              <tbody>
                <tr class="ip-group"><th scope="rowgroup" colspan="7">{group.name}</th></tr>
                {group.rows.map((row) => (
                  <tr>
                    <th scope="row">{row.cap}<span>{row.note}</span></th>
                    {row.cells.map((cell, index) => (
                      <td data-label={products[index].name}>
                        <i class={`ip-sym ${markClass[cell[0] as "y" | "p" | "n"]}`} aria-label={markLabel[cell[0] as "y" | "p" | "n"]}>{cell[0] === "y" ? "✓" : cell[0] === "n" ? "✕" : ""}</i>
                        <span class="ip-cell">{cell[1]}</span>
                      </td>
                    ))}
                    <td class="ip-vec" data-label="Vector">
                      <i class={`ip-sym ${vectorMarkClass[row.vector[0] as "y" | "p" | "n"]}`} aria-label={markLabel[row.vector[0] as "y" | "p" | "n"]}>{row.vector[0] === "y" ? "✓" : ""}</i>
                      <span class="ip-cell">{row.vector[1]}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            ))}
            <tfoot>
              <tr class="ip-tally">
                <th scope="row">Full marks<span>Rows marked Yes, out of {allRows.length}</span></th>
                {fullMarks.map((count, index) => <td data-label={products[index].name}><b class="ip-num">{count}</b></td>)}
                <td class="ip-vec" data-label="Vector"><b class="ip-num">{vectorFullMarks}</b></td>
              </tr>
            </tfoot>
          </table>
        </div>
        <p class="ip-footnote"><strong>Where Vector matches the field:</strong> parallel agents in worktrees, subagents, AI pull-request review, issue-to-PR, browser testing and local repos. Cursor, Codex and Claude Code have these too, Lovable and Base44 lead on live collaboration and built-in hosting, and orchestrators such as Conductor and Superset also run several agents side by side. Vector's edge is doing these jobs in one free workspace, beside its own agent, on any model, with a price on each Vector session whose model has one. Competitor details come from each company's official docs and pricing pages, checked 15 October 2026.</p>
      </div>
    </details>
    <p class="ip-footnote"><strong>Status:</strong> every row ships in desktop 1.99.108, but on a Windows WSL server and in the 1.99.99 CLI the Run Guard, repository trust and the new subagent controls do not apply yet. List prices checked 15–17 October 2026. <strong>Privacy:</strong> Vector itself never trains on prompts or code, and prompts follow each model provider's rules. Requests to free models whose providers don't train ask them not to, and free models whose providers may train are labelled May train on your prompts and sent only after the user accepts that once.</p>
  </section>

  <section class="ip-section ip-bench" aria-labelledby="bench-title">
    <div class="ip-bench-claim">
      <div class="ip-eyebrow">Measured offline</div>
      <h2 id="bench-title"><span class="ip-big ip-num">67–75%</span> less modelled spend than Claude Code in a first session*</h2>
      <p class="ip-bench-second"><b class="ip-num">75%</b> less in a second session, with the simulated cache warm.</p>
      <p class="ip-muted">Same three scripted fix tasks, same number of model requests, same list rates, against Claude Code 2.1.215. The gap is what each sends: in the archived run, Vector's first request in a new session was about 9,000 tokens, Claude Code's about 30,000.</p>
    </div>
    <div class="ip-bars" role="img" aria-label={`Modelled cost per scripted task in US cents, Vector versus Claude Code: ${bench.map((row) => `${row.label.toLowerCase()}, first session ${cents(row.first.vector)} versus ${cents(row.first.claude)}, second session ${cents(row.second.vector)} versus ${cents(row.second.claude)}`).join("; ")}.`}>
      <div class="ip-bar-key" aria-hidden="true"><span><i class="ip-fill ip-v"></i>Vector</span><span><i class="ip-fill ip-c"></i>Claude Code</span><span>US cents per task, by session</span></div>
      {bench.map((row) => (
        <div class="ip-bar-row">
          <b class="ip-bar-task">{row.label}</b>
          {sessions.map((session) => (
            <div class="ip-bar-session">
              <span class="ip-bar-name">{session.name}</span>
              <div class="ip-bar-pair">
                <div class="ip-track"><div class="ip-fill ip-v" style={`width:${barWidth(row[session.key].vector)}`}><i>{cents(row[session.key].vector)}¢</i></div></div>
                <div class="ip-track"><div class="ip-fill ip-c" style={`width:${barWidth(row[session.key].claude)}`}><i>{cents(row[session.key].claude)}¢</i></div></div>
              </div>
              <span class="ip-save">{saving(row[session.key])}% less</span>
            </div>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section class="ip-section" aria-labelledby="model-title">
    <div class="ip-section-head">
      <div class="ip-eyebrow">The model layer</div>
      <h2 id="model-title">Neutral on models, with one built for its own harness</h2>
      <p>Vector runs any model the developer picks. Coding models are now trained inside a harness, as Composer and SWE-1.5 were, so Vector is building Velocity for its own: one more choice in the picker, designed to cost significantly less to run than other very large coding models.</p>
    </div>

    <div class="ip-gap">
      <div class="ip-gap-head">
        <h3 id="large-title">Four very large coding models, and the agents they ship with</h3>
        <p>The newest very large coding model from each of four makers.</p>
      </div>
      <div class="ip-four-wrap">
        <table class="ip-four" aria-labelledby="large-title">
          <thead>
            <tr><th scope="col">Model</th><th scope="col">Weights</th><th scope="col">Ships with</th></tr>
          </thead>
          <tbody>
            {largeModels.map((model) => (
              <tr>
                <th scope="row">{model.name}<small>{model.maker}</small></th>
                <td data-label="Weights">{model.weights}</td>
                <td data-label="Ships with">{model.agent}</td>
              </tr>
            ))}
            <tr class="ip-four-v">
              <th scope="row">Vector Velocity<small>Vector · 550B parameters · <span class="ip-stage">In development</span></small></th>
              <td data-label="Weights">None yet</td>
              <td data-label="Ships with">Vector, through Codium (planned)</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="ip-footnote">Cursor and Cognition publish no sizes; Composer 2.5 is built on Kimi K2.5 and SWE-2 on Kimi K3. From model cards and makers' posts, 17 October 2026.</p>
    </div>

    <div class="ip-velocity">
      <div class="ip-vcard">
        <span class="ip-stage">In development</span>
        <h3>Vector Velocity</h3>
        <p class="ip-vsize"><b class="ip-num">550B</b> parameters</p>
        <p>Vector's own model, specialised for agentic computer use, agentic workflows and Vector's own harness, plus other coding and developer-tool tasks.</p>
        <ul class="ip-clean">
          <li><strong>Work has started; there are no weights or benchmarks yet,</strong> so this page makes no performance claims for it.</li>
        </ul>
      </div>
      <div class="ip-why-us">
        <h3 class="ip-eyebrow">Why Velocity is needed</h3>
        <div class="ip-why-item"><h4>Designed to cost significantly less to run than all four</h4><p>A task is many requests, 5 to 8 in the scripted tasks above. Velocity is designed to finish Vector's tasks for significantly less than any of the four, because it is being built for the loop Vector runs rather than for another agent's. That is a design goal; with no weights yet, nothing is measured.</p></div>
        <div class="ip-why-item"><h4>Built for Vector's own loop</h4><p>The open two run in Vector today, but their cards point to other agents. Velocity is being built for planning, tool calls, edits, checks and subagents, and is planned to sell through Codium. Other open coding models already run in Vector; Velocity's bet is training inside Vector's own harness, the way Cursor and Cognition trained their models inside theirs. That harness training is the edge.</p></div>
      </div>
    </div>
  </section>

