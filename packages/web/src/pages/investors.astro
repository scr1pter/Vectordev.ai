  @media (max-width: 760px) { .ip-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } .ip-fact:nth-child(3) { border-left: 0; } .ip-fact:nth-child(n+3) { border-top: 1px solid var(--line); } }

  /* Section heads */
  .ip-section { display: grid; gap: 18px; min-width: 0; }
