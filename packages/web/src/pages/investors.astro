---
import "@fontsource/ibm-plex-mono/400.css"
import "@fontsource/ibm-plex-mono/500.css"
import MarketingLayout from "../components/marketing/MarketingLayout.astro"

export const prerender = true

// Comparison grid. Each cell is [mark, text]: y = yes, p = partly, n = no. Facts come from each company's own docs and
// pricing pages, checked 11 October 2026 (see the sources list at the foot of the page).
const products = [
  { name: "Cursor", kind: "AI code editor" },
  { name: "Codex", kind: "OpenAI" },
  { name: "Claude Code", kind: "Anthropic" },
  { name: "Lovable", kind: "App builder" },
  { name: "Base44", kind: "App builder (Wix)" },
]

const groups = [
  {
    name: "Agents",
    rows: [
      {
        cap: "Parallel agents, isolated",
        note: "Each task in its own git worktree",
        cells: [
          ["y", "Agents Window, worktrees, cloud agents"],
          ["y", "Worktrees in the app, cloud tasks"],
          ["y", "Worktrees, /batch, cloud sessions"],
          ["n", "One agent per project"],
          ["n", "None documented"],
        ],
        vector: ["y", "Clash flags, then merge after your tests and a secret scan"],
      },
      {
        cap: "Runs other vendors' agents",
        note: "Side by side, supervised, in one place",
        cells: [
          ["p", "Their editor extensions, in separate panels"],
          ["n", "Imports their settings, runs its own"],
          ["n", "Workers are always Claude sessions"],
          ["n", "Its own agent only"],
          ["n", "Its own agent only"],
        ],
        vector: ["y", "Claude Code, Codex and Cursor Agent, each in a worktree"],
      },
      {
        cap: "Specialist subagents",
        note: "Delegated work that reports back",
        cells: [
          ["y", "Custom subagents"],
          ["y", "Custom agents; worker and explorer built in"],
          ["y", "Custom subagents; agent teams (experimental)"],
          ["p", "Read-only research and review helpers"],
          ["n", "None documented"],
        ],
        vector: ["y", "8 built in: explore, review, judge, security, debug, test, performance, migration"],
      },
    ],
  },
  {
    name: "Quality",
    rows: [
      {
        cap: "AI review on pull requests",
        note: "In place of a separate review bot",
        cells: [
          ["y", "Bugbot, about $1–1.50 a run"],
          ["y", "@codex review, on plans from $20/mo"],
          ["y", "Team and Enterprise preview, about $15–25 a review"],
          ["n", "Security scan before publishing"],
          ["n", "App security scan"],
        ],
        vector: ["y", "Vectorscope on GitHub, desktop and CLI; no Vector fee"],
      },
      {
        cap: "Issue to pull request",
        note: "From a ticket to a reviewable branch",
        cells: [
          ["y", "Linear, GitHub or Slack to a cloud-agent PR"],
          ["p", "Linear issue to a cloud task; you open the PR"],
          ["y", "@claude in its GitHub Action"],
          ["n", "None"],
          ["n", "None"],
        ],
        vector: ["y", "An issue comment becomes a branch and a PR with test evidence"],
      },
      {
        cap: "Browser testing",
        note: "Of the running app",
        cells: [
          ["y", "Browser tool with console, network, screenshots"],
          ["p", "In the desktop app only"],
          ["p", "Chrome extension, direct Anthropic plans only"],
          ["y", "Remote browser against the preview"],
          ["p", "Testing agent; cannot test sign-in steps"],
        ],
        vector: ["y", "Browser agent; every deploy gets a browser smoke test"],
      },
    ],
  },
  {
    name: "Ship and collaborate",
    rows: [
      {
        cap: "Deploy and database from the agent",
        note: "Publish, migrate, set environment",
        cells: [
          ["p", "Through Vercel and Supabase plugins"],
          ["p", "Through third-party plugins"],
          ["p", "Through third-party plugins"],
          ["y", "Built-in hosting and database"],
          ["y", "Built-in backend, database and hosting"],
        ],
        vector: ["y", "Vercel publishing with health checks; Supabase migrations with a dry run"],
      },
      {
        cap: "Live multiplayer",
        note: "Teammates in the same live work",
        cells: [
          ["p", "Read-only shared transcripts (Teams)"],
          ["n", "None documented"],
          ["p", "Shared session links, not live"],
          ["y", "Collaborators see changes as they happen"],
          ["y", "Real-time canvas with named cursors"],
        ],
        vector: ["p", "Early: a teammate joins a live session by invite link"],
      },
    ],
  },
  {
    name: "Cost and access",
    rows: [
      {
        cap: "Cost of every session",
        note: "In dollars, per session and model",
        cells: [
          ["p", "Monthly spend limits, no per-task cost"],
          ["p", "Workspace spend controls, no per-task cost"],
          ["p", "Session estimate and limits, Claude models only"],
          ["p", "Credits per message, credit limits"],
          ["p", "Monthly credits, not dollars"],
        ],
        vector: ["y", "Every session priced, subagents included, with model advice"],
      },
      {
        cap: "Any model, any provider",
        note: "Including local and free models",
        cells: [
          ["p", "Hosted models; own keys for 5 providers"],
          ["p", "OpenAI models; local through Ollama or LM Studio"],
          ["p", "Claude models only"],
          ["n", "No model choice"],
          ["p", "8 models, on the Builder plan and up"],
        ],
        vector: ["y", "219 providers, local endpoints, free models"],
      },
      {
        cap: "Your repos, on your machine",
        note: "Any existing codebase, run locally",
        cells: [
          ["y", "Any local or remote repo"],
          ["y", "Local repos and cloud tasks"],
          ["y", "Any repo, terminal and IDE"],
          ["p", "Cloud projects; cannot import a repo"],
          ["p", "Imports a repo into its cloud"],
        ],
        vector: ["y", "Desktop and CLI on your machine"],
      },
      {
        cap: "The whole product, free",
        note: "Agents, review and testing included",
        cells: [
          ["p", "Limited free tier; Bugbot billed per run"],
          ["p", "Free desktop tier; CLI, IDE and review from $20/mo"],
          ["n", "Not on the free plan; from $17/mo"],
          ["p", "5 builds a day free"],
          ["p", "25 messages a month free"],
        ],
        vector: ["y", "Free workspace; bring a model account or use free models"],
      },
    ],
  },
]

const allRows = groups.flatMap((group) => group.rows)
const fullMarks = products.map((_, index) => allRows.filter((row) => row.cells[index][0] === "y").length)
const vectorFullMarks = allRows.filter((row) => row.vector[0] === "y").length
const closest = products[fullMarks.indexOf(Math.max(...fullMarks))]
const markLabel = { y: "Yes", p: "Partly", n: "No" }
const markClass = { y: "ip-yes", p: "ip-part", n: "ip-no" }
const vectorMarkClass = { y: "ip-vec-yes", p: "ip-vec-part", n: "ip-no" }

// Open-weight, coding-specialised models since 2024 by total parameters (billions), from their public model cards.
// x is the position on a log scale from 5B to 1.5T; y is a beeswarm offset in pixels so close sizes do not overlap.
const scale = (billions: number) => ((Math.log10(billions) - Math.log10(5)) / (Math.log10(1500) - Math.log10(5))) * 100
const models = [
  { name: "Seed-Coder-8B", maker: "ByteDance Seed", size: 8, y: 0 },
  { name: "Mellum2", maker: "JetBrains", size: 12, y: 0 },
  { name: "DeepSeek-Coder-V2-Lite", maker: "DeepSeek", size: 16, y: 0 },
  { name: "Codestral", maker: "Mistral", size: 22, y: 0 },
  { name: "Devstral Small 2", maker: "Mistral", size: 24, y: 12 },
  { name: "North Mini Code", maker: "Cohere", size: 30, y: -12 },
  { name: "Qwen3-Coder-30B-A3B", maker: "Qwen", size: 30.5, y: 12 },
  { name: "Qwen2.5-Coder-32B", maker: "Qwen", size: 32, y: -24 },
  { name: "KAT-Dev", maker: "Kwaipilot", size: 33, y: 24 },
  { name: "Laguna XS 2.1", maker: "Poolside", size: 33, y: -36 },
  { name: "KAT-Coder-V2.5-Dev", maker: "Kwaipilot", size: 35, y: 0 },
  { name: "Kimi-Dev-72B", maker: "Moonshot", size: 72, y: 0 },
  { name: "KAT-Dev-72B-Exp", maker: "Kwaipilot", size: 72, y: -12 },
  { name: "Qwen3-Coder-Next", maker: "Qwen", size: 80, y: 12 },
  { name: "Laguna S 2.1", maker: "Poolside", size: 118, y: 0 },
  { name: "Devstral 2", maker: "Mistral", size: 123, y: -12 },
  { name: "Laguna M.1", maker: "Poolside", size: 225, y: 0 },
  { name: "DeepSeek-Coder-V2", maker: "DeepSeek", size: 236, y: -12 },
  { name: "Qwen3-Coder-480B-A35B", maker: "Qwen", size: 480, y: 0 },
  { name: "Kimi K2.7 Code", maker: "Moonshot", size: 1000, y: 0 },
]
const sizeLabel = (billions: number) => (billions >= 1000 ? `${billions / 1000}T` : `${billions}B`)
const buckets = [
  { label: "8–35B", models: models.filter((model) => model.size <= 35) },
  { label: "72–123B", models: models.filter((model) => model.size > 35 && model.size < 200) },
  { label: "225B–1T", models: models.filter((model) => model.size >= 200) },
]
const bucketCentre = (bucket: (typeof buckets)[number]) =>
  (scale(bucket.models[0].size) + scale(bucket.models[bucket.models.length - 1].size)) / 2
const ticks = [10, 30, 100, 300, 1000]
const velocityAt = scale(400)

const stack = [
  {
    job: "AI code review",
    today: "CodeRabbit $24–30 per developer · Greptile $30 per seat · Graphite $40 per user · Cursor Bugbot about $1–1.50 a run · Claude Code Review about $15–25 a review",
    vector: "Vectorscope reviews pull requests on GitHub, in the desktop app and in the CLI, with specialist reviewers, a verify pass that drops findings it cannot confirm, and a spend limit per review.",
    fit: "Replaces",
  },
  {
    job: "Multi-agent orchestration",
    today: "Conductor $50 Pro, $60 per user Teams · Superset $15–20 per user",
    vector: "Vector's agent and your installed Claude Code, Codex and Cursor Agent run in parallel worktrees on one dashboard, merged after your tests and a secret scan.",
    fit: "Replaces",
  },
  {
    job: "Agent cost tracking",
    today: "Helicone $79 Pro · Langfuse $29 Core, $199 Pro",
    vector: "Tokenomics prices every session and model from provider-reported tokens, subagents included, and recommends models from measured runs.",
    fit: "Replaces for coding agents",
  },
  {
    job: "Browser testing by an agent",
    today: "Momentic $125 a month plus usage · QA Wolf billed per credit and runner minute",
    vector: "A browser agent tests the running app, and every Vercel deploy gets a health check and a browser smoke test.",
    fit: "Overlaps",
  },
  {
    job: "Separate agent apps",
    today: "Claude Code, Codex and Cursor, each in its own window with its own history",
    vector: "One dashboard runs all of them on your existing subscriptions, next to Vector's own agent.",
    fit: "Runs them",
  },
  {
    job: "Deploy and database consoles",
    today: "Vercel and Supabase dashboards, opened by hand",
    vector: "Publishing, environment variables and Supabase migrations with a dry run, started from the task.",
    fit: "Controls them",
  },
]
---

{/* The investor one-pager. Unlisted: noindex, not linked from the site, shared by link only. */}
<MarketingLayout
  title="Vector · Investor one-pager"
  description="Vector, the control room for every AI coding agent: how it compares, the tools it replaces, why it is building its own coding model, the measured cost benchmark, roadmap and business model."
  noindex
>
  <div class="ip-root">
<div class="ip-page">
  <header class="ip-top">
    <div class="ip-brand">
      <span class="ip-mark" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14"><path d="M1.5 2.5 L7 12 L12.5 2.5" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      Vector
    </div>
    <div class="ip-meta"><span>vectordev.ai</span><span>Agentic coding workspace</span><span>October 2026</span></div>
  </header>

  <section class="ip-thesis" aria-labelledby="thesis-title">
    <div class="ip-eyebrow">For teams that build with AI agents</div>
    <h1 id="thesis-title">The control room for <em>every</em> AI coding agent.</h1>
    <p class="ip-lede">Many teams now run Claude Code, Codex and Cursor side by side, then pay per seat for a review bot, an orchestration app and a cost tracker on top. Vector replaces that stack with one free workspace: every agent, any model, code review, browser testing, deploys and a price on every session. Next, it is building <strong>Vector Velocity</strong>, its own large coding model for that loop.</p>
    <div class="ip-facts">
      <div class="ip-fact"><strong class="ip-num">219</strong><span>model providers, plus local and free models</span></div>
      <div class="ip-fact"><strong class="ip-num">3</strong><span>outside agents run inside Vector: Claude Code, Codex, Cursor Agent</span></div>
      <div class="ip-fact"><strong class="ip-num">58–64%</strong><span>lower request cost than Claude Code on the same scripted work*</span></div>
      <div class="ip-fact"><strong class="ip-num">$0</strong><span>for the workspace on macOS, Windows, Linux and the terminal</span></div>
    </div>
  </section>

  <section class="ip-section ip-two" aria-label="Problem and product">
    <div class="ip-problem">
      <div class="ip-section-head">
        <div class="ip-eyebrow">The problem</div>
        <h2>AI agents multiplied. Control didn't.</h2>
      </div>
      <ul class="ip-clean">
        <li><strong>Every agent is a separate island.</strong> Each vendor's tool runs its own agent in its own window, so three agents means three places to look.</li>
        <li><strong>Each one is tied to one vendor's models,</strong> though 27% of organisations already send different work to different models.<sup>1</sup></li>
        <li><strong>The rest is a stack of seats.</strong> AI review, agent orchestration and cost tracking are separate subscriptions, mostly priced per developer.</li>
        <li><strong>Nobody sees the bill per task.</strong> Spend arrives as credits or a monthly invoice, while 38% of organisations already use usage limits to control AI cost.<sup>1</sup></li>
      </ul>
    </div>
    <div class="ip-section ip-today">
      <div class="ip-section-head">
        <div class="ip-eyebrow">What Vector does today</div>
        <h2>One workspace. Every agent. Any model.</h2>
      </div>
      <div class="ip-caps">
        <div class="ip-cap"><h3>Every agent, one dashboard</h3><p>Vector's agent and your installed Claude Code, Codex and Cursor Agent each run in their own git worktree, on one dashboard that flags clashes, then merge back after your tests and a secret scan.</p></div>
        <div class="ip-cap"><h3>Any model</h3><p>8,184 models from 219 providers with your own keys, any OpenAI-compatible or local endpoint, and free models through OpenRouter.</p></div>
        <div class="ip-cap"><h3>Vectorscope review</h3><p>Pull-request review on GitHub, desktop and CLI, with a verify pass that drops findings it cannot confirm. An issue comment becomes a branch and a PR with test evidence.</p></div>
        <div class="ip-cap"><h3>Specialist subagents</h3><p>Explore, Review, Judge, Security, Debug, Test, Performance and Migration specialists run in the background and report back.</p></div>
        <div class="ip-cap"><h3>Tokenomics</h3><p>Every session is priced from the tokens the provider reported, subagents included, and Vector recommends models once a task type has measured runs.</p></div>
        <div class="ip-cap"><h3>Test and ship from the task</h3><p>A browser agent tests the running app. Environment variables, Supabase migrations with a dry run, and Vercel publishing with health and browser checks.</p></div>
      </div>
    </div>
  </section>

  <section class="ip-section" aria-labelledby="compare-title">
    <div class="ip-section-head">
      <div class="ip-eyebrow">Where Vector is different</div>
      <h2 id="compare-title">Twelve capabilities, six products</h2>
      <p>Each cell says how that product handles it today. Vector has {vectorFullMarks} of the {allRows.length} in full; the closest, {closest.name}, has {Math.max(...fullMarks)}.</p>
    </div>
    <div class="ip-legend" aria-label="Legend">
      <span><i class="ip-sym ip-yes" aria-hidden="true">✓</i>Yes</span>
      <span><i class="ip-sym ip-part" aria-hidden="true"></i>Partly</span>
      <span><i class="ip-sym ip-no" aria-hidden="true">✕</i>No</span>
    </div>
    <div class="ip-grid-wrap">
      <table class="ip-compare">
        <thead>
          <tr>
            <th scope="col">Capability</th>
            {products.map((product) => <th scope="col">{product.name}<small>{product.kind}</small></th>)}
            <th scope="col" class="ip-vec">Vector<small>Agent workspace</small></th>
          </tr>
        </thead>
        {groups.map((group) => (
          <tbody>
            <tr class="ip-group"><th scope="rowgroup" colspan="7">{group.name}</th></tr>
            {group.rows.map((row) => (
              <tr>
                <th scope="row">{row.cap}<span>{row.note}</span></th>
                {row.cells.map((cell, index) => (
                  <td data-label={products[index].name}>
                    <i class={`ip-sym ${markClass[cell[0] as "y" | "p" | "n"]}`} aria-label={markLabel[cell[0] as "y" | "p" | "n"]}>{cell[0] === "y" ? "✓" : cell[0] === "n" ? "✕" : ""}</i>
                    <span class="ip-cell">{cell[1]}</span>
                  </td>
                ))}
                <td class="ip-vec" data-label="Vector">
                  <i class={`ip-sym ${vectorMarkClass[row.vector[0] as "y" | "p" | "n"]}`} aria-label={markLabel[row.vector[0] as "y" | "p" | "n"]}>{row.vector[0] === "y" ? "✓" : ""}</i>
                  <span class="ip-cell">{row.vector[1]}</span>
                </td>
              </tr>
            ))}
          </tbody>
        ))}
        <tfoot>
          <tr class="ip-tally">
            <th scope="row">Full marks<span>Rows marked Yes, out of {allRows.length}</span></th>
            {fullMarks.map((count, index) => <td data-label={products[index].name}><b class="ip-num">{count}</b></td>)}
            <td class="ip-vec" data-label="Vector"><b class="ip-num">{vectorFullMarks}</b></td>
          </tr>
        </tfoot>
      </table>
    </div>
    <p class="ip-footnote"><strong>Where Vector matches the field:</strong> parallel agents in worktrees, subagents, AI pull-request review, issue-to-PR, browser testing and local repos. Cursor, Codex and Claude Code have these too, and Lovable and Base44 lead on live collaboration and built-in hosting. Vector's edge is running every vendor's agent, on any model, with a price on each session, for free. Competitor details come from each company's official docs and pricing pages, checked 11 October 2026; sources are listed at the end.</p>
  </section>

  <section class="ip-section" aria-labelledby="stack-title">
    <div class="ip-section-head">
      <div class="ip-eyebrow">What Vector consolidates</div>
      <h2 id="stack-title">One workspace instead of a stack of tools</h2>
      <p>Teams buy each of these jobs separately today, usually per developer. Vector does the core job of each inside the free workspace, on the team's own model account. The specialists go deeper in their own lanes; Vector's advantage is that the jobs share one place, one set of agents and one bill.</p>
    </div>
    <div class="ip-stack" role="list">
      <div class="ip-stack-head" aria-hidden="true"><span>Job</span><span>What teams buy today · list price a month</span><span>In Vector, free</span></div>
      {stack.map((item) => (
        <div class="ip-stack-row" role="listitem">
          <h3>{item.job}</h3>
          <p class="ip-stack-today"><span class="ip-stack-tag">Today</span>{item.today}</p>
          <p class="ip-stack-vector"><span class="ip-stack-tag">In Vector</span>{item.vector} <span class="ip-fit">{item.fit}</span></p>
        </div>
      ))}
    </div>
    <div class="ip-callouts">
      <div class="ip-callout">
        <strong class="ip-num">$1,080<small> a month</small></strong>
        <p>What a 10-developer team pays at list price for just two of these, CodeRabbit Team ($48 a seat, annual) and Conductor Teams ($60 a seat), before any model usage. In Vector both jobs come with the free workspace; reviews run on the team's own model account, so they still use tokens.</p>
      </div>
      <div class="ip-callout">
        <strong class="ip-num">$1.5B</strong>
        <p>CodeRabbit's valuation for AI review alone (Series C, August 2026), and Cursor agreed to buy Graphite in December 2025. Orchestration on its own is harder to charge for: Vibe Kanban's maker shut down in April 2026 with most users on its free tier. Vector gives the workspace away and earns on the model usage that runs through it.</p>
      </div>
    </div>
    <p class="ip-footnote"><strong>Controlled, not hosted:</strong> Vector deploys to Vercel and migrates Supabase on the team's own accounts. Hosting, databases and billing for them stay with those providers.</p>
  </section>

  <section class="ip-section" aria-labelledby="model-title">
    <div class="ip-section-head">
      <div class="ip-eyebrow">The model layer</div>
      <h2 id="model-title">Why Vector is building its own coding model</h2>
      <p>Every coding tool sells software but pays for tokens. Whoever owns the model controls the cost line, the speed and the roadmap.</p>
    </div>
    <div class="ip-reasons">
      <div class="ip-reason">
        <span class="ip-reason-n ip-num">01</span>
        <h3>Model spend is the cost line</h3>
        <p>Coding tools pay for every token they serve. Cursor ran at negative gross margins until its own Composer model and cheaper open models brought it to slightly positive (TechCrunch, April 2026). A model Vector owns lets Vector set its own price and serving speed.</p>
      </div>
      <div class="ip-reason">
        <span class="ip-reason-n ip-num">02</span>
        <h3>The model vendors sell competing agents</h3>
        <p>Claude Code alone passed $2.5B in run-rate revenue (Anthropic, February 2026). Access also gets withdrawn: Anthropic cut Windsurf's direct Claude capacity at a few days' notice (June 2025) and stopped Claude subscriptions working in third-party coding tools (January 2026). OpenAI is ending Cursor's direct model access after SpaceX bought it (August 2026).</p>
      </div>
      <div class="ip-reason">
        <span class="ip-reason-n ip-num">03</span>
        <h3>Models are trained for one harness</h3>
        <p>OpenAI's guide for its Codex models says they were trained on its own patch format and terminal tool, and may not be on other tools. Cursor trained Composer with reinforcement learning inside Cursor's own agent, and Cognition built SWE-1.5 together with its own harness. Every lab tunes for its own agent first; Vector's loop of specialists, review pass and cross-agent merge checks is nobody's training target but Vector's.</p>
      </div>
    </div>

    <div class="ip-gap">
      <div class="ip-gap-head">
        <h3>Large coding models are rare. None is built for a workspace that runs every agent.</h3>
      </div>
      <figure class="ip-chart">
        <div class="ip-plot" role="img" aria-label={`Strip chart of ${models.length} open-weight coding-specialised models by total parameters, on a log scale: ${buckets.map((bucket) => `${bucket.models.length} between ${bucket.label}`).join(", ")}. A dashed line marks Vector Velocity's planned size of about 400B; only Qwen3-Coder-480B and Kimi K2.7 Code are larger.`}>
          <div class="ip-clusters" aria-hidden="true">
            {buckets.map((bucket) => (
              <span style={`left:${bucketCentre(bucket).toFixed(2)}%`}><b class="ip-num">{bucket.models.length}</b> models<br />{bucket.label}</span>
            ))}
          </div>
          <div class="ip-dots" aria-hidden="true">
            {models.map((model) => (
              <span class="ip-dot" style={`left:${scale(model.size).toFixed(2)}%;--y:${model.y}px`} title={`${model.name} · ${model.maker} · ${sizeLabel(model.size)}`}></span>
            ))}
            <span class="ip-vring" style={`left:${velocityAt.toFixed(2)}%`} title="Vector Velocity · planned about 400B · in development"></span>
          </div>
          <div class="ip-vline" style={`left:${velocityAt.toFixed(2)}%`} aria-hidden="true"></div>
          <div class="ip-axis" aria-hidden="true">
            {ticks.map((tick) => <span style={`left:${scale(tick).toFixed(2)}%`}>{sizeLabel(tick)}</span>)}
          </div>
          <div class="ip-vlabel" style={`left:${velocityAt.toFixed(2)}%`} aria-hidden="true">Velocity · planned ~400B</div>
        </div>
        <figcaption class="ip-footnote">Each dot is one open-weight, coding-specialised model released since 2024, by total parameters on a log scale; hover a dot, or open the list below, for names. Vector's count from public model cards on 11 October 2026; small releases may be missing. Most new specialists are mixture-of-experts models that use only 3–8B parameters per token.</figcaption>
        <details class="ip-details">
          <summary>The {models.length} models in this chart</summary>
          <div class="ip-model-list">
            {buckets.map((bucket) => (
              <div>
                <h4>{bucket.label} · {bucket.models.length}</h4>
                <ul>
                  {bucket.models.map((model) => <li><span>{model.name} <i>{model.maker}</i></span><b class="ip-num">{sizeLabel(model.size)}</b></li>)}
                </ul>
              </div>
            ))}
          </div>
        </details>
      </figure>
      <ul class="ip-gap-points">
        <li><strong>Most open coding specialists stop around 35B parameters:</strong> 11 of the 20 counted here.</li>
        <li><strong>Only four pass 200B, and only two are larger than Velocity's planned size:</strong> Qwen3-Coder-480B (July 2025) and Kimi K2.7 Code (1T, a coding post-train of the general Kimi K2.6). Each is tuned for its maker's own command-line agent.</li>
        <li><strong>At the frontier, coding runs on general models.</strong> Every entry on the Terminal-Bench 4.0 leaderboard (6 October 2026) uses one, and OpenAI now recommends its general GPT-6.1 Sol for Codex.</li>
        <li><strong>The closed coding models are each tuned for one company's agent:</strong> Composer for Cursor, SWE-1.5 for Windsurf's Cascade, GPT-5.3-Codex for Codex.</li>
      </ul>
    </div>

    <div class="ip-velocity">
      <div class="ip-vcard">
        <span class="ip-status">In development</span>
        <h3>Vector Velocity</h3>
        <p class="ip-vsize"><b class="ip-num">~400B</b> parameters, planned</p>
        <p>Vector's own coding model. At its planned size it would sit among the largest disclosed coding-tuned models, and, as far as public information shows, the first built for a workspace that runs every agent and model.</p>
        <ul class="ip-clean">
          <li><strong>Designed for Vector's loop:</strong> planning, tool calls, edits, checks and verification, across the specialists and the review pass.</li>
          <li><strong>Sold in the open:</strong> one choice in the picker beside 219 providers, priced by the same tokenomics, so it has to win on measured cost.</li>
          <li><strong>Served through Codium,</strong> so model spend that goes to other labs today can go to Vector's own model.</li>
          <li><strong>Not trained on customers' code.</strong> There are no weights or benchmarks yet, so this page makes no performance claims for it.</li>
        </ul>
      </div>
      <div class="ip-why-us">
        <div class="ip-eyebrow">Why Vector can build it</div>
        <div class="ip-why-item"><h4>It owns the harness</h4><p>The agent, its tools and its eight specialists are Vector's, so the loop the model is trained for is fixed and known, not a guess about someone else's product.</p></div>
        <div class="ip-why-item"><h4>It already measures cost per task</h4><p>Every session is priced from provider-reported tokens, and an offline benchmark prices every request. Velocity gets measured with the same tools as every other model.</p></div>
        <div class="ip-why-item"><h4>It has the channel</h4><p>Velocity ships into a free workspace on desktop and in the terminal, and sells through Codium, with no new product for anyone to adopt.</p></div>
      </div>
    </div>
  </section>

  <section class="ip-section ip-bench" aria-labelledby="bench-title">
