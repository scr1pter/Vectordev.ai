---
import { publicModelPlans } from "../../../../api/_lib/model-plan-config"
import { CodiumPricing } from "../components/marketing/codium/CodiumPricing"
import MarketingLayout from "../components/marketing/MarketingLayout.astro"
import MarketingNav from "../components/marketing/MarketingNav.astro"
import SiteFooter from "../components/marketing/SiteFooter.astro"
import { codiumPricing } from "../lib/codium-pricing"
import { readModelPlanConfig } from "../lib/model-plans"

export const prerender = true

// Only Codium credits and token estimates reach the page and its island props, never model prices.
const pricing = codiumPricing(readModelPlanConfig(publicModelPlans()))
const prices = pricing.monthly.map((plan) => plan.price)
---

<MarketingLayout
  title="Pricing · Vector Codium"
  description={`Vector is free. Vector Codium adds managed coding models with credits: monthly plans or one-time top-ups${prices.length ? ` from $${Math.min(...prices)} to $${Math.max(...prices)}` : ""}, with no automatic overages.`}
>
  <div class="codium-page">
    <MarketingNav active="codium" />
    <main>
      <header class="codium-hero">
        <p class="codium-eyebrow">Vector Codium</p>
        <h1>Pricing</h1>
        <p class="codium-lead">
          The Vector workspace is free. Codium adds managed coding models you pay for with credits, monthly or as you
          go.
        </p>
      </header>
      <CodiumPricing client:load pricing={pricing} />
    </main>
    <SiteFooter />
  </div>
</MarketingLayout>

<style is:global>
  .codium-page {
    min-height: 100vh;
    background: radial-gradient(ellipse 820px 420px at 50% 60px, rgba(122, 84, 220, 0.2), transparent 70%);
    font-family: var(--font-landing);
  }
  .codium-page > .site-header { font-family: var(--font-sans); }
  .codium-page main {
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
    padding: 64px 0 120px;
  }
  .codium-hero { max-width: 640px; margin: 0 auto 36px; text-align: center; }
  .codium-eyebrow { margin: 0; color: var(--accent-strong); font-size: 13px; font-weight: 520; letter-spacing: 0.02em; }
  .codium-hero h1 {
    margin: 14px 0 0;
    font-size: clamp(44px, 6vw, 64px);
    font-weight: 520;
    line-height: 1.05;
    letter-spacing: -0.035em;
    background: linear-gradient(170deg, #ffffff 0%, #f1eaff 44%, var(--accent-strong) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .codium-lead { margin: 20px auto 0; color: var(--muted-strong); font-size: 15.5px; line-height: 1.65; }
  @media (max-width: 640px) {
    .codium-page main { width: calc(100% - 32px); padding-top: 36px; }
  }
</style>
