---
import DocsPage from "../../layouts/DocsPage.astro"
import { faqs } from "../../data/docs-content"

export const prerender = true
---

<DocsPage id="faq">

          <div class="faq-list">
            {faqs.map((item) => (
              <details>
                <summary><span>{item.question}</span><span class="faq-icon" aria-hidden="true"></span></summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
</DocsPage>
