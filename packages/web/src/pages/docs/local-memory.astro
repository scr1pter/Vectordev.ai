---
// Local memory as desktop 1.99.109 and earlier have it. The page stays while those are the published releases; once
// 1.99.110 is, it goes and /docs/local-memory redirects to /docs/brain (test/brain-docs.test.ts holds this).
import DocsPage from "../../layouts/DocsPage.astro"
import { brainRelease } from "../../data/vector-releases"

export const prerender = true
---

<DocsPage id="local-memory">

          <p class="note">{brainRelease.since} <a href="/docs/brain">Vector Brain</a> replaces local memory.</p>
          <p>
            Vector lets you save durable facts about how you work — your stack, your conventions, the corrections you
            would otherwise repeat — in one <code>MEMORY.md</code> file inside Vector's local app config directory. It
            is read in every repository and automatically included in the context Vector sends to the model provider
            you choose.
          </p>
          <p>
            Settings shows its path, size, last change, and full contents; erasing removes the file rather than
            emptying it.
          </p>
          <p class="note">The file is never uploaded to Vector's servers. Memory is yours to inspect, edit, or delete.</p>
</DocsPage>
