---
// The documentation's front door. Every subject is its own page under /docs;
// this one says what Vector is, points at the first three pages, and lists the
// groups. It also catches the old single-page anchors — /docs#code-review and
// the rest are still linked from the landing page and from inside the app — and
// sends them to the page that subject now lives on.
import DocsPage from "../../layouts/DocsPage.astro"
import { docsMoved, docsNav, docsOrder } from "../../data/docs-nav"
import { publishedDesktopVersion, release199 } from "../../data/vector-releases"

export const prerender = true

const nextRelease = release199.at(-1)

const start = [
  ["install", "Install Vector", "macOS, Windows or Linux, and the CLI in any terminal."],
  ["first-task", "Your first task", "Point Vector at a project on your disk, ask for a change, review what it did."],
  ["vector-agent", "Vector Agent", "What the agent can do, its tools, and the rules it follows."],
] as const
---

<DocsPage
  title="Vector documentation"
  eyebrow="Start here"
  description="How to install Vector, run agents on your own repository, review what they did, and ship it."
>
  <p class="dx-lede">
    Vector is an engineering workspace with an agent of its own: an editor, a terminal, a browser and a code reviewer
    around one agent that works in the repository already on your disk. These pages cover every part of it.
  </p>

  <h2>Release notes</h2>
  <p>
    The current desktop download is <strong>{publishedDesktopVersion}</strong>.
    {
      nextRelease && nextRelease.version !== publishedDesktopVersion && (
        <>
          {" "}Prepared for the next release:{" "}
          <a href="/docs/changelog">
            {nextRelease.version} — {nextRelease.title}
          </a>
          . These changes are not included in the current download yet.
        </>
      )
    }
    {" "}<a href="/docs/changelog">Read the full version history and availability notes.</a>
  </p>

  <h2>Get going</h2>
  <ol class="steps">
    {
      start.map(([id, title, blurb]) => (
        <li>
          <span />
          <div>
            <strong>
              <a href={`/docs/${id}`}>{title}</a>
            </strong>
            <p>{blurb}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <h2>Everything else</h2>
  <div class="dx-cards">
    {
      docsNav.map((group) => (
        <a class="dx-card" href={`/docs/${group.links[0].id}`}>
          <b>{group.label}</b>
          <span>
            {group.links
              .map((link) => link.title)
              .slice(0, 3)
              .join(" · ")}
          </span>
          <span class="dx-card-count">{group.links.length} pages</span>
        </a>
      ))
    }
  </div>

  <p class="note">
    Looking for the short version — what Vector is and what it does? That lives on
    <a href="/">the home page</a>.
  </p>
</DocsPage>

<script is:inline define:vars={{ ids: docsOrder.map((link) => link.id), moved: docsMoved }}>
  // The single-page docs used one anchor per subject. Those links are still out
  // there — on the landing page, in the app's help menu, in old messages — so a
  // hash that names a page, or a page that was merged into another, redirects
  // to where that subject lives now rather than landing on nothing.
  const hash = decodeURIComponent(location.hash.replace(/^#/, ""))
  const target = Object.hasOwn(moved, hash) ? moved[hash] : ids.includes(hash) ? hash : ""
  if (target) location.replace(`/docs/${target}`)
</script>
