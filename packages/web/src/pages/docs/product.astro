---
// The product tour: the long story that used to follow the landing page's hero.
// The sections themselves live in ProductTour.astro, which keeps their ids, so
// links such as /docs/product#ch-cli land on the section they name.
import MarketingLayout from "../../components/marketing/MarketingLayout.astro"
import MarketingNav from "../../components/marketing/MarketingNav.astro"
import ProductTour from "../../components/marketing/ProductTour.astro"

export const prerender = true
---

<MarketingLayout
  title="Vector product tour"
  description="Everything Vector does: the surfaces it runs on, its own engine, the CLI, the models included with Vector, one measured benchmark, and pricing."
>
  <ProductTour>
    <MarketingNav slot="nav" active="product" />

    <header class="tour-header" aria-labelledby="tour-title">
      <p class="tour-kicker" data-reveal>Product</p>
      <h1 id="tour-title" data-reveal style="--rd: 60ms">Everything Vector does.</h1>
      <p class="tour-intro" data-reveal style="--rd: 120ms">
        Where Vector runs, the engine underneath it, the CLI, the models included with Vector, one measured benchmark,
        and what it costs.
      </p>
      <a class="tour-back" href="/docs" data-reveal style="--rd: 180ms">
        <span aria-hidden="true">←</span> Back to the documentation
      </a>
    </header>
  </ProductTour>
</MarketingLayout>

<style>
  /* Same measure as the sections below, so the header's left edge is theirs. */
  .tour-header {
    width: min(1240px, calc(100% - 56px));
    margin-inline: auto;
    padding: clamp(40px, 6vw, 84px) 0 0;
  }

  .tour-kicker {
    margin: 0 0 16px;
    color: #c9b0ff;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.11em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .tour-header h1 {
    max-width: 16ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(40px, 4.2vw, 58px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .tour-intro {
    max-width: 60ch;
    margin: 18px 0 0;
    color: rgba(255, 255, 255, 0.62);
    font-size: 17px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .tour-back {
    min-height: 40px;
    margin-top: 26px;
    padding: 0 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #e2d7ff;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(224, 211, 255, 0.16);
    border-radius: 999px;
    transition:
      background 180ms ease,
      border-color 180ms ease;
  }

  .tour-back span {
    color: #c9b0ff;
    transition: transform 180ms ease;
  }

  .tour-back:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(224, 211, 255, 0.28);
  }

  .tour-back:hover span {
    transform: translateX(-3px);
  }

  @media (max-width: 640px) {
    .tour-header {
      width: calc(100% - 24px);
    }

    .tour-intro {
      font-size: 15.5px;
    }

    .tour-back {
      min-height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tour-back span {
      transition: none;
    }

    .tour-back:hover span {
      transform: none;
    }
  }
</style>
