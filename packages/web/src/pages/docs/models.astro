import DocsPage from "../../layouts/DocsPage.astro"

export const prerender = true
---

<DocsPage id="models">

          <h3>Models included with Vector</h3>
          <p>
            Vector is moving the models it includes onto a provider it has its own agreement with.
            While that is being set up, no models ship with the app: connect a provider below, and
            your subscription covers Vector itself rather than model usage.
          </p>
          <p class="note">
            Earlier builds offered a set of no-key models through OpenCode Zen's shared gateway. Those
            requests ran against OpenCode's own endpoint, so Vector has stopped serving them. Nothing
            you configured yourself is affected: your own keys, including an OpenCode key, keep working.
          </p>
          <h3>Bring your own key</h3>
          <p>
            Connect a provider in Settings, or run <code>vector auth login</code> in the terminal, then
            select a model in the session composer. Model availability, context limits, pricing, and
            rate limits come from the provider. Vector's usage view tracks the information returned by
            those sessions.
          </p>
</DocsPage>
