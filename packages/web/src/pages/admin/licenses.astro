---
import MarketingLayout from "../../components/marketing/MarketingLayout.astro"

// The operator console. Deliberately not linked from anywhere, not in the
// sitemap, and useless without the operator token — but the token is what
// actually protects it, not the obscurity. Everything here is rendered client
// side from /api/admin/*, so no customer data is ever baked into the build.
export const prerender = true
---

<MarketingLayout title="Vector licences" description="Operator console." noindex>
  <main class="ops">
    <header class="ops-head">
      <div>
        <p class="ops-kicker">Operator</p>
        <h1>Licences</h1>
      </div>
      <form class="ops-auth" data-auth>
        <input type="password" data-token placeholder="Operator token" autocomplete="off" spellcheck="false" />
        <button type="submit">Load</button>
      </form>
    </header>

    <p class="ops-note" data-note>Enter the operator token to load licences.</p>

    <section class="ops-summary" data-summary hidden></section>

    <div class="ops-toolbar" data-toolbar hidden>
      <input type="search" data-search placeholder="Search email, customer id, device…" />
      <span class="ops-count" data-shown></span>
    </div>

    <div class="ops-table-wrap" data-table-wrap hidden>
      <table class="ops-table">
        <thead>
          <tr>
            <th>Customer</th><th>State</th><th>Plan</th><th>Device</th>
            <th>Last seen</th><th>Activated</th><th>Moves</th><th>Renews</th><th>Actions</th>
          </tr>
        </thead>
        <tbody data-rows></tbody>
      </table>
    </div>
  </main>

  <style>
    .ops {
      width: min(1400px, 94vw);
      margin: 0 auto;
      padding: 40px 0 96px;
      color: var(--ink);
      font-size: 14px;
    }
    .ops-head {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      align-items: flex-end;
      justify-content: space-between;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--line);
    }
    .ops-kicker {
      margin: 0 0 4px;
      color: var(--purple-soft, #b69ff7);
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .ops h1 { margin: 0; font-size: clamp(26px, 3vw, 34px); letter-spacing: -0.02em; }
    .ops-auth { display: flex; gap: 8px; }
    .ops-auth input, .ops-toolbar input {
      min-width: 260px;
      padding: 9px 12px;
      color: var(--ink);
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--line);
      border-radius: 9px;
      font: inherit;
    }
    .ops-auth button {
      padding: 9px 16px;
      color: #120d17;
      background: linear-gradient(180deg, #f5f0ff, #cfb8ff);
      border: 0;
      border-radius: 9px;
      font-weight: 650;
      cursor: pointer;
    }
    .ops-note { margin: 20px 0 0; color: var(--muted); }
    .ops-note[data-tone="error"] { color: #ff9c9c; }

    .ops-summary {
      display: grid;
      gap: 12px;
      margin-top: 24px;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    }
    .ops-stat {
      padding: 14px 16px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--line);
      border-radius: 12px;
    }
    .ops-stat strong { display: block; font-size: 26px; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
    .ops-stat span { display: block; margin-top: 3px; color: var(--muted); font-size: 11.5px; }
    .ops-stat[data-key="total"] { border-color: color-mix(in oklab, #b69ff7 45%, var(--line)); }

    .ops-toolbar { display: flex; gap: 14px; align-items: center; margin-top: 26px; }
    .ops-count { color: var(--muted); font-size: 12px; }

    .ops-table-wrap { margin-top: 14px; overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; }
    .ops-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    .ops-table th {
      padding: 10px 12px;
      color: var(--muted);
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: 0.07em;
      text-align: left;
      text-transform: uppercase;
      border-bottom: 1px solid var(--line);
      white-space: nowrap;
    }
    .ops-table td { padding: 11px 12px; border-bottom: 1px solid rgba(224, 211, 255, 0.07); vertical-align: top; }
    .ops-table tr:last-child td { border-bottom: 0; }
    .ops-email { font-weight: 600; }
    .ops-id { color: var(--muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10.5px; }

    .ops-pill {
      display: inline-block;
      padding: 3px 9px;
      border-radius: 999px;
      font-size: 10.5px;
      font-weight: 650;
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }
    .ops-pill[data-state="active"] { color: #7ce0aa; background: rgba(97, 201, 150, 0.14); }
    .ops-pill[data-state="canceling"] { color: #e3c68a; background: rgba(214, 169, 92, 0.14); }
    .ops-pill[data-state="grace"] { color: #e3c68a; background: rgba(214, 169, 92, 0.14); }
    .ops-pill[data-state="past_due"] { color: #ff9c9c; background: rgba(230, 120, 125, 0.16); }
    .ops-pill[data-state="expired"] { color: var(--muted); background: rgba(255, 255, 255, 0.06); }
    .ops-pill[data-state="revoked"] { color: #ff9c9c; background: rgba(230, 120, 125, 0.22); }

    .ops-actions { display: flex; flex-wrap: wrap; gap: 6px; }
    .ops-actions button {
      padding: 5px 9px;
      color: var(--ink);
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--line);
      border-radius: 7px;
      font-size: 11px;
      cursor: pointer;
    }
    .ops-actions button:hover { background: rgba(255, 255, 255, 0.1); }
    .ops-actions button[data-danger] { color: #ff9c9c; border-color: rgba(230, 120, 125, 0.4); }
    .ops-actions button:disabled { opacity: 0.5; cursor: wait; }
  </style>

  <script is:inline>
    ;(() => {
      const el = (sel) => document.querySelector(sel)
      const note = el("[data-note]")
      const rows = el("[data-rows]")
      let token = sessionStorage.getItem("vector-ops-token") || ""
      let all = []

      const say = (message, tone) => {
        note.textContent = message
        if (tone) note.dataset.tone = tone
        else delete note.dataset.tone
      }

      const api = async (path, init) => {
        const response = await fetch(path, {
          ...init,
          headers: { ...(init?.headers || {}), authorization: `Bearer ${token}`, "content-type": "application/json" },
        })
        const payload = await response.json().catch(() => ({}))
        if (!response.ok) throw new Error(payload?.error?.message || `Request failed (${response.status})`)
        return payload
      }

      const date = (value) => (value ? new Date(value).toISOString().slice(0, 10) : "—")

      const STATS = [
        ["total", "licences"],
        ["onlineNow", "online now"],
        ["activeToday", "active today"],
        ["activeThisWeek", "active this week"],
        ["dormant", "dormant 30d+"],
        ["active", "active licence"],
        ["grace", "in grace"],
        ["pastDue", "past due"],
        ["canceling", "canceling"],
        ["expired", "expired"],
        ["revoked", "revoked"],
        ["activated", "activated"],
        ["neverActivated", "never activated"],
      ]

      const paintSummary = (summary) => {
        const box = el("[data-summary]")
        box.replaceChildren()
        for (const [key, label] of STATS) {
          const card = document.createElement("div")
          card.className = "ops-stat"
          card.dataset.key = key
          const value = document.createElement("strong")
          value.textContent = String(summary[key] ?? 0)
          const name = document.createElement("span")
          name.textContent = label
          card.append(value, name)
          box.appendChild(card)
        }
        box.hidden = false
      }

      const act = async (licence, action, button) => {
        if (action === "revoke" && !confirm(`Revoke the licence for ${licence.email}? They lose access immediately.`)) {
          return
        }
        const reason = action === "revoke" || action === "release-device" ? prompt("Note for the record (optional):") ?? "" : ""
        button.disabled = true
        try {
          await api("/api/admin/license-action", {
            method: "POST",
            body: JSON.stringify({ customerId: licence.customerId, action, reason }),
          })
          await load()
        } catch (error) {
          say(error.message, "error")
          button.disabled = false
        }
      }

      const paintRows = (licences) => {
        rows.replaceChildren()
        el("[data-shown]").textContent = `${licences.length} shown`
        for (const licence of licences) {
          const tr = document.createElement("tr")

          const who = document.createElement("td")
          const email = document.createElement("div")
          email.className = "ops-email"
          email.textContent = licence.email || "(no email)"
          const id = document.createElement("div")
          id.className = "ops-id"
          id.textContent = licence.customerId + (licence.licenceLast ? ` · ····${licence.licenceLast}` : "")
          who.append(email, id)

          const state = document.createElement("td")
          const pill = document.createElement("span")
          pill.className = "ops-pill"
          pill.dataset.state = licence.state
          pill.textContent = licence.state.replace("_", " ")
          state.appendChild(pill)

          const plan = document.createElement("td")
          plan.textContent = licence.plan

          const device = document.createElement("td")
          if (licence.deviceFingerprint) {
            const name = document.createElement("div")
            name.textContent = licence.deviceName || "unnamed"
            const fp = document.createElement("div")
            fp.className = "ops-id"
            fp.textContent = `${licence.devicePlatform || "?"} · ${licence.deviceFingerprint}`
            device.append(name, fp)
          } else {
            device.textContent = "—"
          }

          // "Last seen" is the honest answer to who is actually using Vector:
          // the desktop licence gate re-checks every 15 minutes while the app
          // is open, and each check stamps it.
          const seen = document.createElement("td")
          if (licence.lastSeenAt) {
            const ago = Date.now() - Date.parse(licence.lastSeenAt)
            const mins = Math.round(ago / 60000)
            seen.textContent =
              mins < 20 ? "online now" : mins < 90 ? `${mins}m ago` : ago < 86400000 ? `${Math.round(ago / 3600000)}h ago` : `${Math.round(ago / 86400000)}d ago`
            if (mins < 20) seen.style.color = "#7ce0aa"
          } else {
            seen.textContent = "never"
          }

          const activated = document.createElement("td")
          activated.textContent = date(licence.activatedAt)

          const moves = document.createElement("td")
          moves.textContent = String(licence.transferCount)

          const renews = document.createElement("td")
          renews.textContent = date(licence.periodEnd)

          const actions = document.createElement("td")
          const box = document.createElement("div")
          box.className = "ops-actions"
          const add = (label, action, danger) => {
            const button = document.createElement("button")
            button.type = "button"
            button.textContent = label
            if (danger) button.dataset.danger = "1"
            button.addEventListener("click", () => act(licence, action, button))
            box.appendChild(button)
          }
          if (licence.deviceFingerprint) add("Free device", "release-device")
          if (licence.state === "revoked") add("Restore", "restore")
          else add("Revoke", "revoke", true)
          if (licence.state === "past_due" || licence.state === "grace") add("+7d grace", "extend-grace")
          actions.appendChild(box)

          tr.append(who, state, plan, device, seen, activated, moves, renews, actions)
          rows.appendChild(tr)
        }
      }

      const load = async () => {
        say("Loading…")
        try {
          const query = el("[data-search]").value.trim()
          const payload = await api(`/api/admin/licenses${query ? `?q=${encodeURIComponent(query)}` : ""}`)
          all = payload.licences
          paintSummary(payload.summary)
          paintRows(all)
          el("[data-toolbar]").hidden = false
          el("[data-table-wrap]").hidden = false
          say(
            `${payload.summary.total} licences · ${payload.summary.onlineNow} online now · ${payload.summary.activeToday} active today · ${payload.summary.active} on an active plan`,
          )
          sessionStorage.setItem("vector-ops-token", token)
        } catch (error) {
          say(error.message, "error")
        }
      }

      el("[data-auth]").addEventListener("submit", (event) => {
        event.preventDefault()
        token = el("[data-token]").value.trim() || token
        if (!token) return say("An operator token is required.", "error")
        void load()
      })

      let timer
      el("[data-search]").addEventListener("input", () => {
        clearTimeout(timer)
        timer = setTimeout(() => void load(), 220)
      })

      if (token) {
        el("[data-token]").value = token
        void load()
      }
    })()
  </script>
</MarketingLayout>
