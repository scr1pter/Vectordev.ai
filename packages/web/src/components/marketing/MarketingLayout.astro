---
import "../../styles/marketing.css"

interface Props {
  title: string
  description: string
  /** Keeps a page out of search results. For operator surfaces, not content. */
  noindex?: boolean
}

const { title, description, noindex = false } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://vectordev.ai").toString()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0b090d" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32x32-desktop-v4.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-desktop-v4.png" sizes="180x180" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vector" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://vectordev.ai/vector-logo.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://vectordev.ai/vector-logo.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --page: #08060d;
    --surface: rgba(30, 23, 46, 0.58);
    --surface-soft: rgba(42, 31, 64, 0.68);
    --ink: #f5f2f8;
    --muted: #9d96a8;
    --muted-strong: #c0b9cc;
    --line: rgba(224, 211, 255, 0.12);
    --line-strong: rgba(224, 211, 255, 0.22);
    --accent: #aa8cff;
    --accent-soft: rgba(154, 117, 255, 0.14);
    --accent-strong: #c9b9ff;
    --success: #61c996;
    --glass: rgba(23, 17, 36, 0.58);
    --glass-strong: rgba(30, 22, 46, 0.76);
    --glass-soft: rgba(255, 255, 255, 0.055);
    --glass-line: rgba(235, 228, 255, 0.16);
    --glass-line-strong: rgba(235, 228, 255, 0.27);
    --glass-highlight: rgba(255, 255, 255, 0.18);
    --glass-fill: linear-gradient(145deg, rgba(255, 255, 255, 0.075), rgba(185, 151, 255, 0.032) 38%, rgba(18, 13, 29, 0.48) 74%);
    --glass-fill-strong: linear-gradient(145deg, rgba(255, 255, 255, 0.1), rgba(185, 151, 255, 0.05) 38%, rgba(22, 16, 35, 0.64) 76%);
    --glass-shadow: 0 24px 80px rgba(0, 0, 0, 0.42), inset 0 1px 0 rgba(255, 255, 255, 0.16), inset 1px 0 0 rgba(255, 255, 255, 0.045), inset -1px 0 0 rgba(255, 255, 255, 0.025), inset 0 -1px 0 rgba(255, 255, 255, 0.035);
    --glass-shadow-soft: 0 14px 46px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.13), inset 1px 0 0 rgba(255, 255, 255, 0.035), inset 0 -1px 0 rgba(255, 255, 255, 0.03);
    --glass-radius: 26px;
    --glass-radius-small: 18px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    background: var(--page);
    scrollbar-color: #4a4652 var(--page);
  }

  body {
    position: relative;
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    color: var(--ink);
    background: var(--page);
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 16px;
    line-height: 1.55;
    letter-spacing: 0;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(194, 166, 255, 0.026) 1px, transparent 1px),
      linear-gradient(90deg, rgba(194, 166, 255, 0.026) 1px, transparent 1px);
    background-size: 54px 54px;
  }

  body > * {
    position: relative;
    z-index: 1;
  }

  button,
  input,
  select {
    font: inherit;
  }

  a,
  button,
  input,
  select,
  textarea {
    -webkit-tap-highlight-color: transparent;
  }

  input,
  select,
  textarea {
    color-scheme: dark;
  }

  input::placeholder,
  textarea::placeholder {
    color: #77737e;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  ::selection {
    color: #fff;
    background: var(--accent-strong);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 1ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 1ms !important;
    }
  }
</style>
