---
import "../../styles/marketing.css"

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://vectordev.ai").toString()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b090d" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32x32-desktop-v4.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-desktop-v4.png" sizes="180x180" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vector" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://vectordev.ai/vector-logo.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://vectordev.ai/vector-logo.png" />
    <title>{title}</title>
    <script is:inline>
      // Applied before paint so a light-mode visitor never sees a dark flash.
      try {
        const saved = localStorage.getItem("vector-site-theme")
        const wants = saved ?? (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark")
        if (wants === "light") document.documentElement.dataset.siteTheme = "light"
      } catch {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --shade: 255, 255, 255;
    --page: #08060d;
    --surface: rgba(30, 23, 46, 0.58);
    --surface-soft: rgba(42, 31, 64, 0.68);
    --ink: #f5f2f8;
    --muted: #9d96a8;
    --muted-strong: #c0b9cc;
    --line: rgba(224, 211, 255, 0.12);
    --line-strong: rgba(224, 211, 255, 0.22);
    --accent: #aa8cff;
    --accent-soft: rgba(154, 117, 255, 0.14);
    --accent-strong: #c9b9ff;
    --success: #61c996;
    --glass: rgba(23, 17, 36, 0.58);
    --glass-strong: rgba(30, 22, 46, 0.76);
    --glass-soft: rgba(255, 255, 255, 0.055);
    --glass-line: rgba(235, 228, 255, 0.16);
    --glass-line-strong: rgba(235, 228, 255, 0.27);
    --glass-highlight: rgba(255, 255, 255, 0.18);
    --glass-fill: linear-gradient(145deg, rgba(255, 255, 255, 0.075), rgba(185, 151, 255, 0.032) 38%, rgba(18, 13, 29, 0.48) 74%);
    --glass-fill-strong: linear-gradient(145deg, rgba(255, 255, 255, 0.1), rgba(185, 151, 255, 0.05) 38%, rgba(22, 16, 35, 0.64) 76%);
    --glass-shadow: 0 24px 80px rgba(0, 0, 0, 0.42), inset 0 1px 0 rgba(255, 255, 255, 0.16), inset 1px 0 0 rgba(255, 255, 255, 0.045), inset -1px 0 0 rgba(255, 255, 255, 0.025), inset 0 -1px 0 rgba(255, 255, 255, 0.035);
    --glass-shadow-soft: 0 14px 46px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.13), inset 1px 0 0 rgba(255, 255, 255, 0.035), inset 0 -1px 0 rgba(255, 255, 255, 0.03);
    --glass-radius: 26px;
    --glass-radius-small: 18px;
  }

  /* Light mode covers the marketing chrome only. The embedded product demos
     keep the app's own dark tokens on purpose — Vector ships dark, and a
     replica that changed colour with the website would stop being a replica. */
  :root[data-site-theme="light"] {
    color-scheme: light;
    --shade: 24, 20, 34;
    --page: #f6f5f9;
    --surface: rgba(255, 255, 255, 0.86);
    --surface-soft: rgba(255, 255, 255, 0.95);
    --ink: #17141f;
    --muted: #5f5a6b;
    --muted-strong: #3c3748;
    --line: rgba(32, 24, 52, 0.12);
    --line-strong: rgba(32, 24, 52, 0.2);
    --accent: #6f42d8;
    --accent-soft: rgba(111, 66, 216, 0.1);
    --accent-strong: #5a31c0;
    --glass: rgba(255, 255, 255, 0.72);
    --glass-strong: rgba(255, 255, 255, 0.88);
    --glass-soft: rgba(32, 24, 52, 0.04);
    --glass-line: rgba(32, 24, 52, 0.12);
    --glass-line-strong: rgba(32, 24, 52, 0.2);
    --glass-highlight: rgba(255, 255, 255, 0.9);
    --glass-fill: linear-gradient(145deg, rgba(255, 255, 255, 0.92), rgba(238, 233, 252, 0.8) 46%, rgba(255, 255, 255, 0.86) 78%);
    --glass-fill-strong: linear-gradient(145deg, #ffffff, rgba(240, 236, 253, 0.9) 46%, #ffffff 80%);
    --glass-shadow: 0 24px 60px rgba(38, 26, 74, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.9);
    --glass-shadow-soft: 0 12px 34px rgba(38, 26, 74, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.8);
    /* Backgrounds the page paints for itself, rather than inherits. */
    --ground: rgba(246, 245, 249, 0.86);
    --slab: linear-gradient(145deg, #ffffff, rgba(243, 240, 253, 0.92));
    --grid-ink: 90, 70, 150;
    --mark: #2a2140;
    --mark-accent: #6f42d8;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    background: var(--page);
    scrollbar-color: #4a4652 var(--page);
  }

  body {
    position: relative;
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    color: var(--ink);
    background: var(--page);
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 16px;
    line-height: 1.55;
    letter-spacing: 0;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(var(--grid-ink, 194, 166, 255), 0.026) 1px, transparent 1px),
      linear-gradient(90deg, rgba(var(--grid-ink, 194, 166, 255), 0.026) 1px, transparent 1px);
    background-size: 54px 54px;
  }

  body > * {
    position: relative;
    z-index: 1;
  }

  button,
  input,
  select {
    font: inherit;
  }

  a,
  button,
  input,
  select,
  textarea {
    -webkit-tap-highlight-color: transparent;
  }

  input,
  select,
  textarea {
    color-scheme: dark;
  }

  input::placeholder,
  textarea::placeholder {
    color: #77737e;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  ::selection {
    color: #fff;
    background: var(--accent-strong);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 1ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 1ms !important;
    }
  }
</style>
