---
// The one footer for every page: the landing page's card and call to action, the full link
// columns, and a base line, kept compact so it closes the page without taking it over.
import { wordmarkCells, wordmarkWidth } from "../../lib/wordmark"

const columns = [
  {
    title: "Product",
    links: [
      ["Desktop", "/download"],
      ["CLI", "/docs/terminal-agent"],
      ["Code review", "/docs/vectorscope"],
      ["Models", "/docs/models"],
    ],
  },
  {
    title: "Resources",
    links: [
      ["Docs", "/docs"],
      ["Releases", "/releases"],
      ["Checksums", "/download/checksums"],
      ["About", "/about"],
    ],
  },
  {
    title: "Platforms",
    links: [
      ["macOS", "/login?returnTo=%2Faccount%3Ftarget%3Dmac-arm64"],
      ["Windows", "/login?returnTo=%2Faccount%3Ftarget%3Dwindows-x64"],
      ["Linux", "/login?returnTo=%2Faccount%3Ftarget%3Dlinux-x64"],
    ],
  },
  {
    title: "Legal",
    links: [
      ["Software license", "/legal/license"],
      ["Terms", "/legal/terms"],
      ["Privacy", "/legal/privacy"],
      ["Third-party notices", "/legal/third-party"],
    ],
  },
]
---

<footer class="site-footer">
  <div class="footer-card">
    <div class="footer-top">
      <div class="footer-lead">
        <a class="footer-mark" href="/" aria-label="Vector home">
          <svg viewBox={`0 0 ${wordmarkWidth} 7`} fill="currentColor" shape-rendering="crispEdges" aria-hidden="true">
            {wordmarkCells.map((cell) => <rect x={cell.x} y={cell.y} width="1" height="1" />)}
          </svg>
        </a>
        <p class="footer-title">Start building with Vector.</p>
        <p class="footer-copy">
          The engineering workspace with an agent of its own. Free with a Vector account; connect your own model
          provider to start.
        </p>
        <a class="footer-cta" href="/login">Get Vector</a>
      </div>

      <div class="footer-columns">
        {
          columns.map((column) => (
            <nav class="footer-column" aria-label={column.title}>
              <h3>{column.title}</h3>
              <ul>
                {column.links.map(([label, href]) => (
                  <li>
                    <a href={href}>{label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <div class="footer-base">
      <span>© 2026 Vector</span>
      <span>Local-first. Your repositories. Your accounts. Your models.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 40px 0 32px;
  }

  .footer-card {
    width: min(1080px, calc(100% - 32px));
    margin-inline: auto;
    padding: 32px 36px 20px;
    background: rgba(20, 18, 26, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    box-shadow: 0 32px 96px rgba(0, 0, 0, 0.32);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr);
    gap: 40px;
  }

  .footer-lead {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-mark {
    display: inline-flex;
    padding: 4px 0;
    color: var(--wordmark, #b79aff);
    text-decoration: none;
    border-radius: 6px;
  }

  .footer-mark svg {
    display: block;
    width: 72px;
    height: auto;
  }

  .footer-title {
    margin: 18px 0 0;
    color: #f5f5f7;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .footer-copy {
    max-width: 34ch;
    margin: 8px 0 0;
    color: #a1a1a6;
    font-size: 13px;
    line-height: 1.55;
  }

  .footer-cta {
    margin-top: 18px;
    height: 34px;
    padding: 0 16px;
    display: inline-flex;
    align-items: center;
    color: #1d1d1f;
    background: #f5f5f7;
    border-radius: 999px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.6),
      0 8px 24px rgba(0, 0, 0, 0.3);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition:
      background 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .footer-cta:hover {
    background: #ffffff;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.6),
      0 10px 28px rgba(0, 0, 0, 0.34),
      0 0 0 5px rgba(170, 140, 255, 0.1);
    transform: translateY(-1px);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  .footer-column {
    min-width: 0;
  }

  .footer-column h3 {
    margin: 4px 0 0;
    color: #f5f5f7;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
  }

  .footer-column ul {
    margin: 10px 0 0;
    padding: 0;
    display: grid;
    gap: 2px;
    list-style: none;
  }

  .footer-column a {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    color: #a1a1a6;
    font-size: 13px;
    text-decoration: none;
    border-radius: 6px;
    transition: color 180ms ease;
  }

  .footer-column a:hover {
    color: #f5f5f7;
  }

  .footer-base {
    margin-top: 28px;
    padding-top: 16px;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: #86868b;
    font-size: 11.5px;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 640px) {
    .site-footer {
      padding: 32px 0 24px;
    }

    .footer-card {
      width: calc(100% - 24px);
      padding: 26px 20px 18px;
      border-radius: 20px;
    }

    .footer-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px 16px;
    }

    .footer-base {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
