---
// A thin rail of tick marks on the right edge of the landing page that tracks
// how far down the page you are: the tick nearest your position is the longest
// and brightest, and its neighbours taper back to the resting length. It is
// decoration, so it is hidden from assistive technology, and it only shows on
// wide screens with a mouse or trackpad, where there is room beside the page.

const count = 32
---

<div class="scroll-ticks" data-scroll-ticks aria-hidden="true">
  {Array.from({ length: count }, () => <i></i>)}
</div>

<script>
  const bootScrollTicks = () => {
    const rail = document.querySelector<HTMLElement>("[data-scroll-ticks]")
    if (!rail || rail.dataset.ready === "1") return
    rail.dataset.ready = "1"
    const ticks = Array.from(rail.children) as HTMLElement[]
    const last = Math.max(ticks.length - 1, 1)
    // How many ticks either side of the nearest one lengthen with it.
    const reach = 4.5
    let frame = 0

    const paint = () => {
      frame = 0
      if (getComputedStyle(rail).display === "none") return
      const root = document.documentElement
      const span = root.scrollHeight - globalThis.innerHeight
      const progress = span > 0 ? Math.min(1, Math.max(0, globalThis.scrollY / span)) : 0
      const at = progress * last
      ticks.forEach((tick, index) => {
        const near = Math.max(0, 1 - Math.abs(index - at) / reach)
        // Smoothstep, so the taper is a curve rather than a straight ramp.
        const weight = near * near * (3 - 2 * near)
        tick.style.transform = `scaleX(${(0.34 + 0.66 * weight).toFixed(3)})`
        tick.style.opacity = (0.22 + 0.78 * weight * weight).toFixed(3)
      })
    }

    const queue = () => {
      if (!frame) frame = requestAnimationFrame(paint)
    }

    globalThis.addEventListener("scroll", queue, { passive: true })
    globalThis.addEventListener("resize", queue, { passive: true })
    paint()
  }

  bootScrollTicks()
</script>

<style>
  .scroll-ticks {
    display: none;
  }

  /* The landing page gives every direct child position: relative, so the
     selector carries the page root to outrank that rule. */
  /* Only where the page leaves a real side margin, so the rail never sits on a card. */
  @media (min-width: 1360px) and (hover: hover) and (pointer: fine) {
    :global(.vector-marketing) > .scroll-ticks {
      position: fixed;
      top: 50%;
      right: 18px;
      z-index: 30;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 8px;
      transform: translateY(-50%);
      pointer-events: none;
    }
  }

  .scroll-ticks i {
    display: block;
    width: 32px;
    height: 2px;
    border-radius: 2px;
    background: #f5f5f7;
    opacity: 0.22;
    transform: scaleX(0.34);
    transform-origin: right center;
    transition:
      transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 320ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-ticks i {
      transition: none;
    }
  }
</style>
