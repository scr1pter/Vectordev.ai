---
// Interactive replacements for the landing page's product screenshots. A
// screenshot tells you what a thing looks like; these let you use it. Every one
// is server-rendered and only toggled by script, so nothing depends on
// JavaScript to read and the component's scoped styles always apply.

interface Props {
  kind: "editor" | "memory" | "browser" | "cloud" | "agents" | "automations" | "work" | "cost" | "terminal" | "diff"
  tag: string
  note: string
}

const { kind, tag, note } = Astro.props

const editorFiles = [
  {
    id: "limit",
    name: "limit.ts",
    dir: "middleware",
    code: `const WINDOW_MS = 60_000
const MAX = 100

// Keyed on the API token, not the IP: everyone
// behind one office NAT is not one caller.
export function allow(token: string) {
  const now = Date.now()
  const live = (seen.get(token) ?? [])
    .filter((at) => now - at < WINDOW_MS)
  if (live.length >= MAX) return false
  seen.set(token, [...live, now])
  return true
}`,
  },
  {
    id: "auth",
    name: "auth.ts",
    dir: "middleware",
    code: `export async function requireUser(req: Request) {
  const token = bearer(req)
  if (!token) throw new Unauthorized()
  // Verified against the session store rather
  // than decoded locally: a revoked session has
  // to stop working the moment it is revoked.
  const session = await sessions.find(token)
  if (!session) throw new Unauthorized()
  return session.user
}`,
  },
  {
    id: "upload",
    name: "upload.ts",
    dir: "routes",
    code: `export const config = { bodyParser: false }

export async function POST(req: Request) {
  const user = await requireUser(req)
  if (!allow(user.token)) return tooMany()
  const file = await readMultipart(req)
  // Streamed to storage, never buffered whole:
  // a 2GB upload should not become 2GB of RAM.
  return store.put(user.id, file.stream)
}`,
  },
]

const memoryFacts = [
  "Prefers Bun over npm in every project.",
  "Wants tests run before work is called done.",
  "Writes SolidJS, never destructures props.",
  "Keeps commits small and scoped to one change.",
]

const browserSteps = [
  { text: "Opened localhost:3000/checkout", ok: true },
  { text: "Filled the card field with a test number", ok: true },
  { text: "Refused to type into the CVC field", ok: true, guard: true },
  { text: "Clicked Pay", ok: true },
  { text: "Expected a receipt, got a 500", ok: false },
]

const cloudTargets = [
  { id: "vercel", name: "Vercel", detail: "vector-web · production", status: "Deployed 4m ago", meta: "Your account, your billing." },
  { id: "cloudflare", name: "Cloudflare", detail: "vector-api · workers", status: "Deployed 1h ago", meta: "Secrets redacted from every log line." },
  { id: "netlify", name: "Netlify", detail: "docs-site · main", status: "Building", meta: "Vector never proxies your repository." },
]

const boardAgents = [
  { id: "a1", column: "running", name: "Add rate limiting", state: "Editing limit.ts", age: "4m" },
  { id: "a2", column: "running", name: "Migrate session store", state: "Running commands", age: "11m" },
  { id: "a3", column: "attention", name: "Fix the flaky test", state: "PR is ready", age: "26m" },
  { id: "a4", column: "done", name: "OAuth device flow", state: "Merged", age: "1h" },
]

const boardColumns = [
  { id: "running", label: "Running" },
  { id: "attention", label: "Needs you" },
  { id: "done", label: "Done" },
]

const workSteps = [
  { text: "Read VEC-2481 from Jira, including the two linked comments", ok: true },
  { text: "Opened the repository and found the three call sites", ok: true },
  { text: "Wrote the fix and a regression test", ok: true },
  { text: "bun test — 214 passed", ok: true },
  { text: "Opened PR #612 and moved the ticket to In Review", ok: true },
  { text: "Posted the diff summary to #eng-releases", ok: true },
]

// Every figure here is a plausible shape for a real run, and the demo says so:
// the point of the meter is that Vector reports the provider's number, so the
// page must not imply these particular numbers came from anywhere.
const costRows = [
  { label: "Input", tokens: 48210, rate: 0.000003 },
  { label: "Cached input", tokens: 121400, rate: 0.0000003 },
  { label: "Output", tokens: 6120, rate: 0.000015 },
  { label: "Reasoning", tokens: 2840, rate: 0.000015 },
]

const terminalLines = [
  { text: "$ bun test middleware", kind: "cmd" },
  { text: "bun test v1.3.14", kind: "out" },
  { text: "middleware/limit.test.ts:", kind: "out" },
  { text: "  ✓ allows the first 100 calls in a window", kind: "ok" },
  { text: "  ✓ keys on the token, not the address", kind: "ok" },
  { text: "  ✗ resets the window on the boundary", kind: "bad" },
  { text: "1 fail, 2 pass", kind: "bad" },
  { text: "$ vector repair --last", kind: "cmd" },
  { text: "Reading the failing assertion, then limit.ts:24", kind: "out" },
  { text: "  edited middleware/limit.ts  +3 −1", kind: "out" },
  { text: "$ bun test middleware", kind: "cmd" },
  { text: "3 pass, 0 fail", kind: "ok" },
]

const diffHunks = [
  {
    id: "h1",
    file: "middleware/limit.ts",
    lines: [
      { text: "const WINDOW_MS = 60_000", kind: "ctx" },
      { text: "-const MAX = 60", kind: "del" },
      { text: "+const MAX = 100", kind: "add" },
    ],
  },
  {
    id: "h2",
    file: "middleware/limit.ts",
    lines: [
      { text: "export function allow(token: string) {", kind: "ctx" },
      { text: "-  const hits = seen.get(ip) ?? []", kind: "del" },
      { text: "+  // Keyed on the token: one office NAT is not one caller.", kind: "add" },
      { text: "+  const hits = seen.get(token) ?? []", kind: "add" },
    ],
  },
  {
    id: "h3",
    file: "middleware/limit.ts",
    lines: [
      { text: "  seen.set(token, [...live, now])", kind: "ctx" },
      { text: "+  metrics.increment(\"ratelimit.allow\")", kind: "add" },
    ],
  },
]

const automations = [
  { id: "r1", name: "Morning repo brief", schedule: "Every weekday at 8:00", next: "Tomorrow, 8:00" },
  { id: "r2", name: "Upgrade minor dependencies", schedule: "Every Monday", next: "Mon, 9:00" },
  { id: "r3", name: "Close stale branches", schedule: "First of the month", next: "1 Sep, 7:00" },
]
---

<div class="fd" data-fd={kind} data-term-lines={kind === "terminal" ? JSON.stringify(terminalLines) : undefined}>
  <div class="fd-top" aria-hidden="true">
    <span>{tag}</span>
    <span>{note}</span>
  </div>

  <div class="fd-body">
    {kind === "editor" && (
      <div class="fd-editor">
        <div class="fd-tree">
          {editorFiles.map((file, index) => (
            <>
              {index === 0 || editorFiles[index - 1].dir !== file.dir ? <p class="fd-tree-dir">{file.dir}</p> : null}
              <button type="button" class={`fd-tree-file${index === 0 ? " is-on" : ""}`} data-file={file.id}>
                {file.name}
              </button>
            </>
          ))}
        </div>
        <div class="fd-pane">
          <div class="fd-tabs">
            {editorFiles.map((file, index) => (
              <span class={`fd-tab${index === 0 ? " is-on" : ""}`} data-tab={file.id}>{file.name}</span>
            ))}
          </div>
          {editorFiles.map((file, index) => (
            <pre class="fd-code" data-code={file.id} hidden={index !== 0}><code>{file.code}</code></pre>
          ))}
          <div class="fd-foot">
            <span class="fd-warn">2 diagnostics</span>
            <span>TypeScript</span>
            <span>Edited by Vector agent</span>
          </div>
        </div>
      </div>
    )}

    {kind === "memory" && (
      <div class="fd-memory">
        <div class="fd-seg" role="tablist">
          <button type="button" role="tab" class="is-on" data-mem="facts">What Vector knows</button>
          <button type="button" role="tab" data-mem="path">Where it lives</button>
        </div>
        <div data-mem-panel="facts">
          {memoryFacts.map((fact) => (
            <div class="fd-fact">
              <span>{fact}</span>
              <button type="button" class="fd-forget" data-forget>Forget</button>
            </div>
          ))}
          <p class="fd-hint" data-forgotten hidden>Removed. Erasing deletes the line from the file, not just the view.</p>
        </div>
        <div data-mem-panel="path" hidden>
          <p class="fd-path">~/.config/vector/MEMORY.md</p>
          <p class="fd-hint">
            One Markdown file in your own config directory. Read in every repository, never uploaded, and deleted from
            disk when you erase it.
          </p>
        </div>
      </div>
    )}

    {kind === "browser" && (
      <div class="fd-browser">
        <div class="fd-url">localhost:3000/checkout</div>
        <div class="fd-steps">
          {browserSteps.map((step, index) => (
            <p class={`fd-step${step.ok ? "" : " is-fail"}${step.guard ? " is-guard" : ""}`} data-step hidden={index > 0}>
              {step.text}
            </p>
          ))}
        </div>
        <button type="button" class="fd-run" data-run>Run the check</button>
      </div>
    )}

    {kind === "cloud" && (
      <div class="fd-cloud">
        <div class="fd-targets">
          {cloudTargets.map((target, index) => (
            <button type="button" class={`fd-target${index === 0 ? " is-on" : ""}`} data-target={target.id}>
              <span class="fd-target-name">{target.name}</span>
              <span class="fd-target-detail">{target.detail}</span>
            </button>
          ))}
        </div>
        {cloudTargets.map((target, index) => (
          <div class="fd-detail" data-detail={target.id} hidden={index !== 0}>
            <p class="fd-detail-status">{target.status}</p>
            <p class="fd-hint">{target.meta}</p>
          </div>
        ))}
      </div>
    )}

    {kind === "agents" && (
      <div class="fd-board">
        {boardColumns.map((column) => (
          <div class="fd-col">
            <p class="fd-col-head">
              <span>{column.label}</span>
              <span class="fd-col-count" data-col-count={column.id}>
                {boardAgents.filter((agent) => agent.column === column.id).length}
              </span>
            </p>
            {boardAgents
              .filter((agent) => agent.column === column.id)
              .map((agent) => (
                <button type="button" class="fd-agent" data-agent={agent.id}>
                  <span class="fd-agent-name">{agent.name}</span>
                  <span class="fd-agent-foot">
                    <i class={`fd-dot is-${agent.column}`}></i>
                    <span>{agent.state}</span>
                    <span class="fd-agent-age">{agent.age}</span>
                  </span>
                </button>
              ))}
          </div>
        ))}
        <p class="fd-hint fd-board-hint" data-agent-hint>Pick an agent to see what it is doing.</p>
      </div>
    )}

    {kind === "work" && (
      <div class="fd-work">
        <div class="fd-ticket">
          <span class="fd-ticket-key">VEC-2481</span>
          <span class="fd-ticket-title">Uploads over 2GB fail silently on Safari</span>
          <span class="fd-ticket-meta">Jira · Bug · P2 · assigned to Vector</span>
        </div>
        <div class="fd-steps">
          {workSteps.map((step, index) => (
            <p class="fd-step" data-step hidden={index > 0}>{step.text}</p>
          ))}
        </div>
        <button type="button" class="fd-run" data-run>Next step</button>
      </div>
    )}

    {kind === "cost" && (
      <div class="fd-cost">
        <table class="fd-cost-table">
          <tbody>
            {costRows.map((row) => (
              <tr>
                <th>{row.label}</th>
                <td class="fd-cost-tokens" data-cost-tokens={row.tokens}>0</td>
                <td class="fd-cost-cash" data-cost-cash={(row.tokens * row.rate).toFixed(4)}>$0.0000</td>
              </tr>
            ))}
          </tbody>
        </table>
        <div class="fd-cost-total">
          <span>Reported by the provider</span>
          <strong data-cost-total={costRows.reduce((sum, row) => sum + row.tokens * row.rate, 0).toFixed(4)}>
            $0.0000
          </strong>
        </div>
        <button type="button" class="fd-run" data-cost-run>Meter a run</button>
        <p class="fd-hint">
          Illustrative figures. In the app every number here comes from what the provider itself reported — a run that
          reported nothing is stored as unmeasured, never as zero.
        </p>
      </div>
    )}

    {kind === "terminal" && (
      <div class="fd-term">
        <pre class="fd-term-screen" data-term-screen></pre>
        <button type="button" class="fd-run" data-term-run>Run the checks</button>
        <p class="fd-hint">
          A failed check is handed back with its real output. Vector repairs, reruns, and only then calls it done.
        </p>
      </div>
    )}

    {kind === "diff" && (
      <div class="fd-diff">
        {diffHunks.map((hunk) => (
          <div class="fd-hunk" data-hunk={hunk.id}>
            <div class="fd-hunk-head">
              <span class="fd-hunk-file">{hunk.file}</span>
              <span class="fd-hunk-actions">
                <button type="button" data-hunk-take={hunk.id}>Keep</button>
                <button type="button" data-hunk-drop={hunk.id}>Drop</button>
              </span>
            </div>
            <pre class="fd-hunk-body">{hunk.lines.map((line) => (
              <span class={`fd-line is-${line.kind}`}>{line.text}</span>
            ))}</pre>
          </div>
        ))}
        <p class="fd-diff-tally" data-diff-tally>3 of 3 hunks selected</p>
        <p class="fd-hint">
          Merging is hunk by hunk. What you drop stays behind in the agent's own worktree — your project only ever gets
          what you kept.
        </p>
      </div>
    )}

    {kind === "automations" && (
      <div class="fd-autos">
        {automations.map((automation) => (
          <div class="fd-auto" data-auto>
            <span class="fd-auto-main">
              <span class="fd-auto-name">{automation.name}</span>
              <span class="fd-auto-when" data-when={automation.next}>{automation.schedule} · next {automation.next}</span>
            </span>
            <button type="button" class="fd-pause" data-pause>Pause</button>
          </div>
        ))}
        <p class="fd-hint">Vector stays in the tray after you close the window, so these fire without you here.</p>
      </div>
    )}
  </div>
</div>

<script is:inline>
  function bootFeatureDemos() {
    for (const root of document.querySelectorAll("[data-fd]")) {
      if (root.dataset.booted === "1") continue
      root.dataset.booted = "1"
      const kind = root.dataset.fd

      if (kind === "editor") {
        root.querySelectorAll("[data-file]").forEach((button) => {
          button.addEventListener("click", () => {
            const id = button.dataset.file
            root.querySelectorAll("[data-file]").forEach((other) => other.classList.toggle("is-on", other === button))
            root.querySelectorAll("[data-tab]").forEach((tab) => tab.classList.toggle("is-on", tab.dataset.tab === id))
            root.querySelectorAll("[data-code]").forEach((code) => (code.hidden = code.dataset.code !== id))
          })
        })
      }

      if (kind === "memory") {
        root.querySelectorAll("[data-mem]").forEach((button) => {
          button.addEventListener("click", () => {
            const id = button.dataset.mem
            root.querySelectorAll("[data-mem]").forEach((other) => other.classList.toggle("is-on", other === button))
            root.querySelectorAll("[data-mem-panel]").forEach((panel) => {
              panel.hidden = panel.dataset.memPanel !== id
            })
          })
        })
        root.querySelectorAll("[data-forget]").forEach((button) => {
          button.addEventListener("click", () => {
            button.closest(".fd-fact").remove()
            root.querySelector("[data-forgotten]").hidden = false
          })
        })
      }

      if (kind === "browser" || kind === "work") {
        const steps = [...root.querySelectorAll("[data-step]")]
        const run = root.querySelector("[data-run]")
        // Each kind labels its own button, so the reset has to restore what it
        // started as rather than one demo's wording for all of them.
        const initialLabel = run.textContent
        let shown = 1
        run.addEventListener("click", () => {
          if (shown >= steps.length) {
            steps.forEach((step, index) => (step.hidden = index > 0))
            shown = 1
            run.textContent = initialLabel
            return
          }
          steps[shown].hidden = false
          shown += 1
          run.textContent = shown >= steps.length ? "Run it again" : "Next step"
        })
      }

      if (kind === "cloud") {
        root.querySelectorAll("[data-target]").forEach((button) => {
          button.addEventListener("click", () => {
            const id = button.dataset.target
            root.querySelectorAll("[data-target]").forEach((other) => other.classList.toggle("is-on", other === button))
            root.querySelectorAll("[data-detail]").forEach((detail) => {
              detail.hidden = detail.dataset.detail !== id
            })
          })
        })
      }

      if (kind === "agents") {
        const hint = root.querySelector("[data-agent-hint]")
        root.querySelectorAll("[data-agent]").forEach((button) => {
          button.addEventListener("click", () => {
            root.querySelectorAll("[data-agent]").forEach((other) => other.classList.toggle("is-on", other === button))
            const name = button.querySelector(".fd-agent-name").textContent
            const state = button.querySelector(".fd-agent-foot span").textContent
            hint.textContent = `${name} — ${state}. Its work is isolated in its own worktree until you merge it.`
          })
        })
      }

      if (kind === "cost") {
        const run = root.querySelector("[data-cost-run]")
        const rows = [...root.querySelectorAll("[data-cost-tokens]")]
        const cash = [...root.querySelectorAll("[data-cost-cash]")]
        const total = root.querySelector("[data-cost-total]")
        const nf = new Intl.NumberFormat("en-US")
        let playing = false
        run.addEventListener("click", () => {
          if (playing) return
          playing = true
          run.textContent = "Metering…"
          const started = performance.now()
          const duration = 1500
          const step = (now) => {
            const t = Math.min(1, (now - started) / duration)
            const eased = 1 - Math.pow(1 - t, 3)
            rows.forEach((cell) => (cell.textContent = nf.format(Math.round(Number(cell.dataset.costTokens) * eased))))
            cash.forEach((cell) => (cell.textContent = "$" + (Number(cell.dataset.costCash) * eased).toFixed(4)))
            total.textContent = "$" + (Number(total.dataset.costTotal) * eased).toFixed(4)
            if (t < 1) return requestAnimationFrame(step)
            playing = false
            run.textContent = "Meter it again"
          }
          requestAnimationFrame(step)
        })
      }

      if (kind === "terminal") {
        const screen = root.querySelector("[data-term-screen]")
        const run = root.querySelector("[data-term-run]")
        const lines = JSON.parse(root.dataset.termLines ?? "[]")
        let timer = 0
        const play = () => {
          clearTimeout(timer)
          screen.replaceChildren()
          run.textContent = "Running…"
          let index = 0
          const next = () => {
            if (index >= lines.length) {
              run.textContent = "Run it again"
              return
            }
            const line = lines[index]
            const el = document.createElement("span")
            el.className = "fd-term-line is-" + line.kind
            screen.appendChild(el)
            // A command types out; its output arrives whole, the way a real
            // terminal behaves.
            if (line.kind !== "cmd") {
              el.textContent = line.text
              index += 1
              timer = setTimeout(next, 220)
              return
            }
            let at = 0
            const type = () => {
              el.textContent = line.text.slice(0, at)
              at += 1
              if (at <= line.text.length) return (timer = setTimeout(type, 22))
              index += 1
              timer = setTimeout(next, 320)
            }
            type()
          }
          next()
        }
        run.addEventListener("click", play)
      }

      if (kind === "diff") {
        const tally = root.querySelector("[data-diff-tally]")
        const hunks = [...root.querySelectorAll("[data-hunk]")]
        const paint = () => {
          const kept = hunks.filter((hunk) => !hunk.classList.contains("is-dropped")).length
          tally.textContent = `${kept} of ${hunks.length} hunk${hunks.length === 1 ? "" : "s"} selected`
          tally.classList.toggle("is-none", kept === 0)
        }
        root.querySelectorAll("[data-hunk-drop]").forEach((button) => {
          button.addEventListener("click", () => {
            root.querySelector(`[data-hunk="${button.dataset.hunkDrop}"]`).classList.add("is-dropped")
            paint()
          })
        })
        root.querySelectorAll("[data-hunk-take]").forEach((button) => {
          button.addEventListener("click", () => {
            root.querySelector(`[data-hunk="${button.dataset.hunkTake}"]`).classList.remove("is-dropped")
            paint()
          })
        })
        paint()
      }

      if (kind === "automations") {
        root.querySelectorAll("[data-pause]").forEach((button) => {
          button.addEventListener("click", () => {
            const row = button.closest(".fd-auto")
            const when = row.querySelector("[data-when]")
            const paused = row.classList.toggle("is-paused")
            button.textContent = paused ? "Resume" : "Pause"
            when.textContent = paused ? "Paused — it will not run" : when.dataset.original
          })
        })
        root.querySelectorAll("[data-when]").forEach((when) => {
          when.dataset.original = when.textContent
        })
      }
    }
  }

  bootFeatureDemos()
  document.addEventListener("astro:page-load", bootFeatureDemos)
</script>

<style>
  .fd {
    overflow: hidden;
    border: 1px solid var(--hairline, rgba(224, 211, 255, 0.16));
    border-radius: 12px;
    background: rgba(10, 8, 16, 0.7);
  }

  .fd-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 13px;
    border-bottom: 1px solid var(--hairline, rgba(224, 211, 255, 0.16));
    background: rgba(255, 255, 255, 0.022);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.38);
  }

  .fd-body {
    padding: 13px;
  }

  .fd-hint {
    margin: 9px 0 0;
    font-size: 11.5px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.42);
  }

  .fd-editor {
    display: grid;
    grid-template-columns: 118px minmax(0, 1fr);
    gap: 10px;
  }

  .fd-tree-dir {
    margin: 8px 0 3px;
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.3);
  }

  .fd-tree-dir:first-child {
    margin-top: 0;
  }

  .fd-tree-file {
    display: block;
    width: 100%;
    margin-bottom: 1px;
    padding: 4px 8px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: rgba(255, 255, 255, 0.5);
    font: inherit;
    font-size: 11.5px;
    text-align: left;
    cursor: pointer;
  }

  .fd-tree-file:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
  }

  .fd-tree-file.is-on {
    background: rgba(143, 82, 255, 0.16);
    color: #fff;
  }

  .fd-pane {
    overflow: hidden;
    border: 1px solid var(--hairline, rgba(224, 211, 255, 0.16));
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.018);
  }

  .fd-tabs {
    display: flex;
