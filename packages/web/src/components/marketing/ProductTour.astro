---
// The long product story that used to follow the landing page's hero: the
// surfaces, the engine, the CLI, the models included with Vector, the benchmark,
// what it does, pricing, and the closing call to action. The landing page is now
// short, so these sections live at /docs/product (pages/docs/product.astro).
//
// Markup, CSS and scripts are copied from the landing page as it stood at
// cff050be7 (packages/web/src/components/Lander.astro), so each section looks
// the way it did there: Geist, the ASCII glyph field behind it, the sky on the
// closing section, the film grain, and the same reveal on scroll. The section
// ids are kept, so /docs/product#ch-cli and the others resolve.
//
// Slots: `nav` renders above <main>; the default slot renders first inside
// <main> and holds the page's own header, which carries the h1.
import { ArrowRight } from "lucide-react"
import MarketingFooter from "./MarketingFooter.astro"
import LanderMotion from "./LanderMotion.astro"
import LanderMaterials from "./LanderMaterials.astro"
---

<div class="vector-marketing">
  <canvas class="ascii-field" data-vector-field aria-hidden="true"></canvas>
  <LanderMotion />
  <LanderMaterials />
  <slot name="nav" />

  <main>
    <slot />

    <section id="ch-why" data-chapter="What's different" class="simple-section section-width" aria-labelledby="why-title">
      <div class="section-heading simple-heading" data-reveal>
        <p class="section-kicker">What makes it different</p>
        <h2 id="why-title">A workspace, not a wrapper.</h2>
        <p>
          Writing the code was never the only work. Vector keeps the editor, the terminal, the browser, the memory of
          the project, the review, the connectors, your cloud accounts and every agent you start in one place — over
          the repository already on your disk.
        </p>
      </div>
      <div class="simple-rows">
        <article class="simple-row" data-reveal>
          <h3>Its own engine, not a chat box</h3>
          <p>Sessions, file state, permissions and tools belong to Vector and run on your machine — the same agent in the desktop app, in your terminal and on a pull request.</p>
        </article>
        <article class="simple-row" data-reveal style="--rd: 60ms">
          <h3>Finished means checked</h3>
          <p>Turn on verified completion and a read-only judge reads your request, the changed files and the output of the checks that ran before the work counts as done.</p>
        </article>
        <article class="simple-row" data-reveal style="--rd: 120ms">
          <h3>Models come with it</h3>
          <p>Models included with Vector let you start with no API key. Your own Claude, GPT or Gemini keys sit beside the included models, and you choose per task.</p>
        </article>
        <article class="simple-row" data-reveal style="--rd: 180ms">
          <h3>As many agents as you can run</h3>
          <p>No cap on agents or subagents. Run them side by side in isolated workspaces, watch each one's work, and merge the ones you want.</p>
        </article>
        <article class="simple-row" data-reveal style="--rd: 240ms">
          <h3>Four runtimes, one workspace</h3>
          <p>Vector's own agent, plus Claude Code, Codex and Cursor Agent on the subscriptions you already pay for — sharing one checkout, one memory and one review.</p>
        </article>
        <article class="simple-row" data-reveal style="--rd: 300ms">
          <h3>Your code stays on your machine</h3>
          <p>Vector works in the repository on your disk. Nothing is uploaded to Vector; what a task needs goes to the model provider you picked, and every run records what it cost.</p>
        </article>
      </div>
    </section>

    <section id="workspace" class="simple-section section-width" aria-labelledby="surfaces-title">
      <div class="section-heading simple-heading" data-reveal>
        <p class="section-kicker">Everywhere you work</p>
        <h2 id="surfaces-title">One agent, every surface.</h2>
      </div>
      <div class="simple-grid">
        <article class="simple-card" data-reveal>
          <p class="section-kicker">Desktop</p>
          <h3>An editor with the agent built in.</h3>
          <p>Files, search, diagnostics, a terminal, and a real browser — beside an agent that can use all of them.</p>
          <a href="/login">Download →</a>
        </article>
        <article class="simple-card" data-reveal style="--rd: 60ms">
          <p class="section-kicker">CLI</p>
          <h3>The same agent in any terminal.</h3>
          <p>Run it in any repository, in any shell. Free with a Vector account, and models come included.</p>
          <a href="#ch-cli">Install →</a>
        </article>
        <article class="simple-card" data-reveal style="--rd: 120ms">
          <p class="section-kicker">Cloud</p>
          <h3>Ship from your own accounts.</h3>
          <p>Connect Vercel, Netlify, or Supabase and deploy from inside the workspace. Your keys stay yours.</p>
          <a href="/docs">Learn more →</a>
        </article>
        <article class="simple-card" data-reveal style="--rd: 180ms">
          <p class="section-kicker">Connections</p>
          <h3>Plug in the tools you already use.</h3>
          <p>135 plugins — GitHub, Linear, Sentry, Notion, Figma, Stripe and the rest — turned on with one click, plus any MCP server you write.</p>
          <a href="/docs">See the list →</a>
        </article>
      </div>
    </section>

    <section id="ch-ide" data-chapter="In the workspace" class="simple-section section-width" aria-labelledby="ide-title">
      <div class="section-heading simple-heading" data-reveal>
        <p class="section-kicker">Inside the IDE</p>
        <h2 id="ide-title">Everything the agent can reach, you can too.</h2>
        <p>
          The agent works with the same editor, shell, browser and history you do — so nothing it did is hidden from
          you, and nothing you do is hidden from it.
        </p>
      </div>
      <div class="simple-rows">
        <article class="simple-row" data-reveal>
          <h3>Agent and Editor</h3>
          <p>Two views of one session: ask for the change, or make it yourself in a real editor with project-wide search and language diagnostics.</p>
        </article>
        <article class="simple-row" data-reveal style="--rd: 40ms">
          <h3>Edits you can watch</h3>
          <p>The file an agent touches opens on its own and the change types itself in that agent's colour, behind a labelled cursor.</p>
        </article>
        <article class="simple-row" data-reveal style="--rd: 80ms">
          <h3>A real terminal</h3>
          <p>A shell in the workspace, in your repository. The agent runs commands there, and you read the same output it read.</p>
        </article>
        <article class="simple-row" data-reveal style="--rd: 120ms">
          <h3>A controlled browser</h3>
          <p>The agent loads your app, clicks through it, reads the console and reports what happened. Sites beyond your own need your approval first.</p>
        </article>
        <article class="simple-row" data-reveal style="--rd: 160ms">
          <h3>Review and checkpoints</h3>
          <p>Diffs by turn, by branch or against git, comments on a line, and a checkpoint to put a run back the way it was.</p>
        </article>
        <article class="simple-row" data-reveal style="--rd: 200ms">
          <h3>Pull requests, reviewed</h3>
          <p>Open and merge from the workspace, and Vector reviews the change — on your branch with <code>vector review</code>, or on the pull request itself.</p>
        </article>
        <article class="simple-row" data-reveal style="--rd: 240ms">
          <h3>Cloud accounts</h3>
          <p>Provision Supabase, sync environment values and publish to your own Vercel or Netlify account, without leaving the repository.</p>
        </article>
        <article class="simple-row" data-reveal style="--rd: 280ms">
          <h3>Connections</h3>
          <p>135 one-click plugins hand the agent your tools — GitHub, Linear, Sentry, Notion, Figma, Stripe and the rest — beside any MCP server you write yourself.</p>
        </article>
        <article class="simple-row" data-reveal style="--rd: 320ms">
          <h3>Parallel workspaces</h3>
          <p>Each agent gets its own checkout, so several lines of work run at once without stepping on each other. Merge the ones that worked.</p>
        </article>
        <article class="simple-row" data-reveal style="--rd: 360ms">
          <h3>Subagents in the background</h3>
          <p>Vector splits a large job on its own and runs the pieces together, with a card for each one showing what it is doing.</p>
        </article>
        <article class="simple-row" data-reveal style="--rd: 400ms">
          <h3>Memory and rules</h3>
          <p>What Vector learns lives in files you can read, edit or delete, next to the rules a project asks every agent to follow.</p>
        </article>
        <article class="simple-row" data-reveal style="--rd: 440ms">
          <h3>Spend, measured</h3>
          <p>Tokens and cost as the provider reported them, per model and per run, with limits per day, per run and per project.</p>
        </article>
      </div>
    </section>

    <section id="ch-engine" data-chapter="The engine" class="simple-section section-width" aria-labelledby="engine-title">
      <div class="section-heading simple-heading" data-reveal>
        <p class="section-kicker">Under the workspace</p>
        <h2 id="engine-title">An engine of its own.</h2>
        <p>
          Vector's agent is Vector's. It runs on your machine with its own session engine, its own tools, and its own
          memory of the project — the same agent in the desktop app, in your terminal, and on a pull request.
        </p>
      </div>
      <ul class="simple-models" data-reveal>
        <li><strong>Its own agent</strong><span>Plans, edits, runs commands, and splits work across subagents</span></li>
        <li><strong>Its own session engine</strong><span>Sessions, history, and file state persist on your machine</span></li>
        <li><strong>Its own tools</strong><span>Read, edit, shell, browser, and cloud, behind one permission gate</span></li>
        <li><strong>Its own memory</strong><span>What it learns lives in your repository, committed and reviewable</span></li>
        <li><strong>Its own verification</strong><span>A judge reads the finished work before you do</span></li>
        <li><strong>Its own accounting</strong><span>Every run measured against what the provider reported</span></li>
        <li><strong>Its own terminal agent</strong><span>The same engine, with no desktop app required</span></li>
        <li><strong>Its own model, soon</strong><span>Vector Velocity, over 300 billion parameters</span></li>
      </ul>
      <p class="simple-note" data-reveal>
        Claude Code, Codex, and Cursor Agent can run inside Vector too, on the subscriptions you already have. They
        share the checkout. The workspace, the memory, the verification, and the channel your teammates talk on stay
        Vector's own.
      </p>
    </section>

    <section id="ch-cli" data-chapter="CLI" class="simple-section section-width" aria-labelledby="cli-title">
      <div class="section-heading simple-heading" data-reveal>
        <p class="section-kicker">Vector CLI</p>
        <h2 id="cli-title">The whole agent, in your terminal.</h2>
        <p>Install once, sign in once, and start working in any repository.</p>
      </div>
      <div class="simple-cli">
        <figure class="cli-terminal" data-reveal aria-label="A Vector CLI session">
          <div class="product-bar" aria-hidden="true">
            <span class="traffic"><i></i><i></i><i></i></span>
            <span class="product-title">vector — zsh</span>
            <span class="product-status"><i></i> Vector · Models included</span>
          </div>
          <pre class="cli-screen"><code><span class="cli-prompt">$</span> npm install -g @vectordevai/cli
<span class="cli-prompt">$</span> vector
<span class="cli-ok">◇ signed in as you@yourteam.dev · model: included with Vector</span>
<span class="cli-prompt">&gt;</span> the checkout test started failing on main — find it, fix it

<span class="cli-dim">● read tests/checkout.test.ts, git log -S couponExpiry</span>
<span class="cli-dim">● the fixture clock froze before midnight UTC. patching, re-running.</span>
<span class="cli-ok">✓ 14 passing · 1 fixed · commit staged · $0.00 spent</span></code></pre>
        </figure>
        <ul class="simple-list" data-reveal>
          <li><strong>Free with a Vector account.</strong> No card needed.</li>
          <li><strong>Models included.</strong> They work the moment it installs.</li>
          <li><strong>Or bring your own key.</strong> Claude, GPT, or Gemini with <code>vector auth login</code>.</li>
          <li><strong>Multiplayer.</strong> <code>vector invite</code> shares your live workspace with a teammate over one link.</li>
          <li><strong>Works from GitHub.</strong> Comment <code>/vector</code> on an issue and get a pull request back, with the checks it ran, what it cost, and the judge's verdict.</li>
          <li><strong>Reviews pull requests.</strong> A summary and line-by-line comments on every pull request, and the same review on your own branch with <code>vector review</code> before you push.</li>
        </ul>
      </div>
    </section>

    <section id="ch-models" data-chapter="Models included" class="simple-section section-width" aria-labelledby="models-title">
      <div class="section-heading simple-heading" data-reveal>
        <p class="section-kicker">Models included with Vector</p>
        <h2 id="models-title">No API key needed. The models come with Vector.</h2>
        <p>
          Nothing to connect, no provider key, no second bill: the models come with your Vector account during the
          beta, and with your subscription once public pricing begins. Every one of them supports tool calling, so it
          can read the repository, run the checks, and edit files rather than only describe them.
        </p>
      </div>
      <p class="simple-note" data-reveal>
        Available models change as providers add and retire them, and a key of your own for Claude, GPT,
        Gemini and the rest still works beside them. Included models are served by outside providers, and some may use
        your prompts to improve their models, so use your own provider key for confidential code.
      </p>
    </section>

    <section id="ch-evidence" data-chapter="Evidence" class="simple-section section-width" aria-labelledby="evidence-title">
      <div class="section-heading simple-heading" data-reveal>
        <p class="section-kicker">Measured, not implied</p>
        <h2 id="evidence-title">One repair task, reported in full.</h2>
        <p>
          In a July 2026 scheduler-repair benchmark, Vector Balanced completed the task in 149 seconds and reported
          roughly 67% fewer tokens than Codex CLI. Both passed all five public tests. Codex passed more hidden tests, so
          this is evidence from one reproducible run, not a universal claim.
        </p>
      </div>
      <dl class="simple-stats" data-reveal>
        <div><dt>Vector Balanced</dt><dd>149s<span>Completion time</span></dd></div>
        <div><dt>Codex CLI</dt><dd>284s<span>Completion time</span></dd></div>
        <div><dt>Reported tokens</dt><dd>67%<span>Fewer for Vector</span></dd></div>
        <div><dt>Public tests</dt><dd>5 / 5<span>Passed by both</span></dd></div>
      </dl>
      <p class="simple-note" data-reveal>
        284 seconds against 149 is roughly 1.9× faster on this one task. The hidden tests went the other way, and that
        stays on the page: a benchmark that hides its loss is worth nothing.
      </p>
    </section>

    <section id="ch-features" data-chapter="What it does" class="simple-section section-width" aria-labelledby="features-title">
      <div class="section-heading simple-heading" data-reveal>
        <p class="section-kicker">Built for real work</p>
        <h2 id="features-title">Knows your project. Shows its work.</h2>
      </div>
      <div class="simple-rows">
        <article class="simple-row" data-reveal>
          <h3>Remembers how you work</h3>
          <p>What Vector learns about you stays in a file on your machine and follows you between sessions.</p>
        </article>
        <article class="simple-row" data-reveal style="--rd: 60ms">
          <h3>Records what a run cost</h3>
          <p>The number is the one your provider reported. Set limits per day, per run, per project.</p>
        </article>
        <article class="simple-row" data-reveal style="--rd: 120ms">
          <h3>Verifies before it's done</h3>
          <p>Runs the checks, opens the result in a real browser, and reads the console back before it calls it finished.</p>
        </article>
        <article class="simple-row" data-reveal style="--rd: 180ms">
          <h3>Splits the work when it helps</h3>
          <p>Vector's agent hands pieces of a task to subagents on its own and runs them together. For separate lines of work, start as many agents as your machine can run, each in its own workspace, merged when you say so.</p>
        </article>
        <article class="simple-row simple-row-wide" data-reveal style="--rd: 240ms">
          <h3>Vector Velocity <span class="simple-soon">Coming soon</span></h3>
          <p>Our own model, over 300 billion parameters, tuned for the loop Vector actually runs rather than for chat: planning a change, calling tools, editing several files at once and keeping them consistent, then checking its own work. It is not shipped yet — when it is, it comes with Vector accounts. <a href="/about">Read about it →</a></p>
        </article>
      </div>
    </section>

    <section id="ch-pricing" data-chapter="Pricing" class="simple-section section-width" aria-labelledby="pricing-title">
      <div class="section-heading simple-heading" data-reveal>
        <p class="section-kicker">Pricing</p>
        <h2 id="pricing-title">$10 a month. $99 a year.</h2>
        <p>Create a Vector account, then choose a desktop subscription: $10 a month or $99 a year. Creating an account is free; your subscription starts at checkout. Both plans include models, so you can work without a separate model-provider subscription. Bring your own key for Claude, GPT, Gemini and the rest, and that usage is billed by the provider you bring.</p>
      </div>
    </section>

    <section id="ch-get" data-chapter="Get Vector" class="closing">
      <div class="sky" aria-hidden="true">
        <i class="sky-aurora"></i>
        <i class="sky-stars"></i>
      </div>
      <h2 data-reveal class="reveal-blur">Start building.</h2>
      <p data-reveal style="--rd: 120ms">Open a repository. Write, delegate, verify, ship — without leaving it.</p>
      <a class="closing-cta" href="/login" data-reveal style="--rd: 220ms">
        <span>Get Vector</span>
        <ArrowRight size={18} strokeWidth={2} aria-hidden="true" />
      </a>
    </section>
  </main>

  <MarketingFooter />
</div>

<script>
  const reducedMotion = () => globalThis.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false

  // Signals that the animation runtime is alive. Reveal styles only hide
  // content under html.va, so a failed script load leaves the page readable.
  document.documentElement.classList.add("va")

  const initReveals = () => {
    const nodes = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]:not(.in)"))
    if (reducedMotion() || !("IntersectionObserver" in globalThis)) {
      nodes.forEach((node) => node.classList.add("in"))
      return () => {}
    }
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return
          entry.target.classList.add("in")
          observer.unobserve(entry.target)
        })
      },
      { rootMargin: "0px 0px -6%", threshold: 0.08 },
    )
    nodes.forEach((node) => observer.observe(node))
    return () => observer.disconnect()
  }

  const initField = () => {
    const canvas = document.querySelector<HTMLCanvasElement>("[data-vector-field]")
    const context = canvas?.getContext("2d")
    if (!canvas || !context) return () => {}

    const glyphs = "01VECTOR{}[]<>/\\+=:*"
    const clusters = [
      [0.84, 0.1, 0.22, 0.16, 1.05],
      [0.96, 0.32, 0.18, 0.2, 0.9],
      [0.7, 0.05, 0.16, 0.1, 0.8],
      [0.05, 0.08, 0.14, 0.12, 0.6],
      [0.08, 0.6, 0.16, 0.18, 0.5],
      [0.92, 0.78, 0.2, 0.16, 0.55],
    ]
    const hash = (x: number, y: number, seed = 0) => {
      const value = Math.sin(x * 12.9898 + y * 78.233 + seed * 37.719) * 43758.5453
      return value - Math.floor(value)
    }
    const animate = !reducedMotion()
    let width = 1
    let height = 1
    let fontSize = 12
    let animationFrame = 0
    let lastFrame = 0
    let pointerX = 0.5
    let pointerY = 0.5
    let backdropCells: Array<{
      x: number
      y: number
      glyph: string
      alpha: number
      drift: number
      speed: number
    }> = []
    let columns: Array<{
      x: number
      y: number
      speed: number
      trail: number
      phase: number
      opacity: number
    }> = []

    const build = () => {
      fontSize = width < 720 ? 8.5 : 9
      const stepX = 9
      const stepY = 10
      backdropCells = []
      for (let y = 0; y < height + stepY; y += stepY) {
        for (let x = 0; x < width + stepX; x += stepX) {
          const nx = x / Math.max(1, width)
          const ny = y / Math.max(1, height)
          const warpX = nx + Math.sin(ny * 19) * 0.018
          const warpY = ny + Math.sin(nx * 15) * 0.014
          let field = 0
          clusters.forEach(([cx, cy, rx, ry, strength], index) => {
            const dx = (warpX - cx) / rx
            const dy = (warpY - cy) / ry
            field = Math.max(field, Math.exp(-(dx * dx + dy * dy) * (1.2 + (index % 3) * 0.1)) * strength)
          })
          const texture = hash(x / stepX, y / stepY) * 0.32 + Math.sin(nx * 46 + ny * 29) * 0.07
          if (field + texture < 0.51) continue
          const copyZone = Math.exp(-(Math.pow((nx - 0.42) / 0.3, 2) + Math.pow((ny - 0.3) / 0.3, 2)))
          const edge = Math.min(1, Math.max(0, (field + texture - 0.46) * 2.1))
          backdropCells.push({
            x,
            y,
            glyph: glyphs[Math.floor(hash(x, y, 2) * glyphs.length)],
            alpha: Math.max(0.08, (0.17 + edge * 0.42) * (1 - copyZone * 0.5)),
            drift: 2 + hash(x, y, 3) * 5,
            speed: 4 + hash(x, y, 4) * 11,
          })
        }
      }

      const spacing = fontSize * 1.08
      const count = Math.ceil(width / spacing)
      columns = Array.from({ length: count }, (_, index) => ({
        x: index * spacing + spacing / 2,
        // Seed the first frame across the viewport so the field is present
        // immediately, then recycle each stream from above as it falls.
        y: Math.random() * height,
        speed: 26 + Math.random() * 40,
        trail: 10 + Math.floor(Math.random() * 19),
        phase: Math.floor(Math.random() * glyphs.length),
        opacity: 0.26 + Math.random() * 0.54,
      }))
    }

    const render = (timestamp = performance.now()) => {
      const elapsed = lastFrame ? timestamp - lastFrame : 34
      if (animate && elapsed < 30) {
        animationFrame = requestAnimationFrame(render)
        return
      }
      const delta = Math.min(elapsed, 80) / 1000
      lastFrame = timestamp
      context.clearRect(0, 0, width, height)
      context.font = `${fontSize}px ui-monospace, SFMono-Regular, Menlo, Monaco, monospace`
      context.textAlign = "center"
      context.textBaseline = "middle"
      const offsetX = (pointerX - 0.5) * 7
      const offsetY = (pointerY - 0.5) * 4
      const tick = Math.floor(timestamp / 170)
      const lineHeight = fontSize * 1.18

      backdropCells.forEach((cell) => {
        const travel = animate ? (timestamp * cell.speed) / 1000 : 0
        const y = ((cell.y + travel) % (height + lineHeight * 2)) - lineHeight
        context.fillStyle = `rgba(164, 116, 255, ${cell.alpha * 0.72})`
        context.fillText(cell.glyph, cell.x + offsetX * cell.drift * 0.34, y + offsetY * cell.drift * 0.2)
      })

      columns.forEach((column, columnIndex) => {
        if (animate) column.y += column.speed * delta
        for (let step = 0; step < column.trail; step += 1) {
          const y = column.y - step * lineHeight
          if (y < -lineHeight || y > height + lineHeight) continue
          const fade = 1 - step / column.trail
          const normalizedX = column.x / Math.max(1, width)
          const normalizedY = y / Math.max(1, height)
          const copyZone = Math.exp(
            -(Math.pow((normalizedX - 0.47) / 0.32, 2) + Math.pow((normalizedY - 0.31) / 0.29, 2)),
          )
          const alpha = Math.max(0.04, fade * fade * column.opacity * 0.78 * (1 - copyZone * 0.5))
          const glyphIndex = Math.abs(column.phase + columnIndex * 3 + tick - step * 2) % glyphs.length
          context.fillStyle =
            step === 0
              ? `rgba(226, 215, 255, ${Math.min(0.94, alpha + 0.28)})`
              : `rgba(164, 116, 255, ${alpha})`
          context.fillText(glyphs[glyphIndex], column.x + offsetX * fade, y + offsetY * fade)
        }
        if (column.y - column.trail * lineHeight <= height + lineHeight) return
        column.y = -Math.random() * height * 0.7 - lineHeight
        column.speed = 26 + Math.random() * 40
        column.trail = 10 + Math.floor(Math.random() * 19)
        column.phase = Math.floor(Math.random() * glyphs.length)
      })

      if (animate && !document.hidden) animationFrame = requestAnimationFrame(render)
    }

    const resize = () => {
      const rect = canvas.getBoundingClientRect()
      const dpr = Math.min(globalThis.devicePixelRatio || 1, 2)
      width = Math.max(1, rect.width)
      height = Math.max(1, rect.height)
      canvas.width = Math.round(width * dpr)
      canvas.height = Math.round(height * dpr)
      context.setTransform(dpr, 0, 0, dpr, 0, 0)
      build()
      if (!animate) render()
    }

    const move = (event: PointerEvent) => {
      pointerX = event.clientX / Math.max(1, globalThis.innerWidth)
      pointerY = event.clientY / Math.max(1, globalThis.innerHeight)
    }

    const visibility = () => {
      if (document.hidden) {
        if (animationFrame) cancelAnimationFrame(animationFrame)
        animationFrame = 0
        return
      }
      lastFrame = 0
      if (animate && !animationFrame) animationFrame = requestAnimationFrame(render)
    }

    const resizeObserver = new ResizeObserver(resize)
    resizeObserver.observe(canvas)
    globalThis.addEventListener("pointermove", move, { passive: true })
    document.addEventListener("visibilitychange", visibility)
    resize()
    if (animate) animationFrame = requestAnimationFrame(render)

    return () => {
      resizeObserver.disconnect()
      globalThis.removeEventListener("pointermove", move)
      document.removeEventListener("visibilitychange", visibility)
      if (animationFrame) cancelAnimationFrame(animationFrame)
    }
  }

  let cleanups: Array<() => void> = []
  const boot = () => {
    cleanups.forEach((cleanup) => cleanup())
    cleanups = [initReveals(), initField()]
  }
  const teardown = () => {
    cleanups.forEach((cleanup) => cleanup())
    cleanups = []
  }

  boot()
  document.addEventListener("astro:page-load", boot)
  document.addEventListener("astro:before-swap", teardown)
</script>

