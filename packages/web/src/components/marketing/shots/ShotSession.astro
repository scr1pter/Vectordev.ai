  }

  @container ss-conv (min-width: 1045px) {
    .ss-meta {
      position: absolute;
      top: 9px;
      right: 14px;
      margin: 0;
      padding: 4px 6px 4px 0;
    }

    .ss-divider {
      margin-bottom: 34px;
    }
  }

  /* In its own row the cost would show in the gap above a popped-out
     Background tasks panel; the panel covers it instead, as in the app. */
  @container ss-conv (max-width: 1044.98px) {
    .ss:has(.bgt[data-floating]:not([hidden])) .ss-meta {
      visibility: hidden;
