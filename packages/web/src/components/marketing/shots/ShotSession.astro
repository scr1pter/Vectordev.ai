    font-size: 12px;
    cursor: pointer;
    transition:
      background-color 120ms ease,
      border-color 120ms ease,
      color 120ms ease;
  }

  /* The tools' glyphs sit a step dimmer than their names until used. */
  .ss-tool > :global(svg) {
    color: var(--as-text-3);
