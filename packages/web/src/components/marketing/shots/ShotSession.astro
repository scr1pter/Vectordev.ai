    overflow: hidden;
    border: 1px solid rgba(226, 213, 237, 0.16);
    border-radius: 12px;
    background: #24212a;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.5);
  }

  .ss-menu[hidden] {
    display: none;
  }

  .ss-menu-search {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    margin: 0;
    padding: 0 14px;
    border-bottom: 1px solid rgba(226, 213, 237, 0.09);
    color: var(--as-text-3);
  }

  .ss-menu-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
