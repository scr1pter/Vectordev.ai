  .ss-task-meta {
    display: flex;
    grid-column: 1 / -1;
    gap: 10px;
    color: #c9c3cd;
    font-size: 13px;
    line-height: 19px;
  }

  .ss-dim {
    color: #a39dab;
    font-variant-numeric: tabular-nums;
  }

  .ss-task-stopped {
    display: none;
    align-items: center;
    gap: 6px;
    color: #a39dab;
  }

  .ss-task-stopped::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px #c9c3cd;
  }

  .ss-task[data-status="stopped"] .ss-task-stopped {
