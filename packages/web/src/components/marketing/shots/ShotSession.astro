    font: inherit;
    font-size: 13.5px;
    outline: none;
  }

  .ss-menu-search input:focus-visible {
    outline: none;
  }

  /* Under 16px, Safari on a phone zooms the page into a focused field. */
  @media (pointer: coarse) {
    .ss-menu-search input {
      font-size: 16px;
    }
  }

  .ss-menu-search input::placeholder {
    color: var(--as-text-3);
  }

  .ss-menu-list {
    display: grid;
    padding: 4px;
  }

  .ss-menu-list button,
  .ss-menu-create {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 10px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--as-text-1);
    font-family: var(--as-mono);
    font-size: 12px;
    text-align: left;
    cursor: pointer;
  }

  .ss-menu-list button[hidden] {
    display: none;
  }

  .ss-menu-list button > span {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ss-menu-list button:hover,
  .ss-menu-list button:focus-visible,
  .ss-menu-create:hover {
    background: rgba(235, 231, 238, 0.06);
    outline: none;
  }

  .ss-menu-list button :global(svg) {
    color: var(--as-bright);
    opacity: 0;
  }

  .ss-menu-list button[aria-checked="true"] :global(svg) {
    opacity: 1;
  }

  .ss-menu-note {
    padding: 8px 14px 10px;
    color: var(--as-text-3);
    font-size: 11.5px;
  }

  .ss-menu-note[hidden],
  .ss-menu-create[hidden] {
    display: none;
  }

  .ss-menu-create {
    width: calc(100% - 8px);
    margin: 0 4px 4px;
    font-family: var(--as-font);
  }

  .ss-menu-create code {
    overflow: hidden;
    color: var(--as-bright);
    font-family: var(--as-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ---- body ---- */

  .ss-body {
    container: ss-body / inline-size;
    position: relative;
    display: flex;
    flex: 1;
    min-height: 0;
  }

  .ss-conv {
    container: ss-conv / inline-size;
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    padding: 0 0 30px;
    background: var(--as-canvas);
  }

  /* The session's cost and context, at the head of the transcript: on its own
     row above the latest message, or, where the conversation is wide enough
     to keep it clear of the reading column, in the pane's top corner. */
  .ss-meta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 9px;
    margin: 0 0 7px;
    padding-right: 6px;
