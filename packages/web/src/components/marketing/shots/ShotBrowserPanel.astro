---
// The browser in the session's side panel (BrowserPanel in
// packages/app/src/pages/session/session-side-panel.tsx): back, forward,
// reload, an address bar, the sidebar toggle, open-in-browser and Publish over
// a page. The pages are small drawings of this site, so the address bar has
// somewhere real to go and "open in your browser" opens the same page here.
import { docsNav } from "../../../data/docs-nav"
import { publishedDesktopVersion, release199 } from "../../../data/vector-releases"
import { wordmarkCells } from "../../../lib/wordmark"
import ShotIcon from "./ShotIcon.astro"

const releases = release199
  .slice(0, release199.findIndex((release) => release.version === publishedDesktopVersion) + 1)
  .reverse()
  .slice(0, 4)

// The site's mobile menu (MarketingNav) and the docs page's "Get going" steps
// (pages/docs/index.astro), so the drawing reads like the pages it opens.
const menu = [
  { name: "Documentation", path: "/docs" },
  { name: "Releases", path: "/releases" },
  { name: "About", path: "/about" },
  { name: "Login", path: "/login" },
]
const steps = [
  ["install", "Install Vector", "macOS, Windows or Linux, and the CLI in any terminal."],
  ["first-task", "Your first task", "Point Vector at a project on your disk, ask for a change, review what it did."],
  ["vector-agent", "Vector Agent", "What the agent can do, its tools, and the rules it follows."],
]

// The page's falling glyphs, laid out once at build time from a fixed hash so
// every visitor sees the same field: dim glyphs, alone or in short runs,
// scattered over the whole page, a little denser toward the right.
const hash = (x: number, y: number) => {
  const value = Math.sin(x * 12.9898 + y * 78.233) * 43758.5453
  return value - Math.floor(value)
}
const glyphs = "01VECTOR{}[]<>/\\+=:*"
const field = Array.from({ length: 330 }, (_, run) => {
  // Snapped to 9px columns, as a terminal font would set them.
  const x = Math.round((Math.pow(hash(run, 1), 0.85) * 640) / 9) * 9 + 3
  const weight = x / 640
  const top = hash(run, 2) * 680 - 20
  const length = 1 + Math.floor(Math.pow(hash(run, 3), 2) * (1.5 + weight * 2))
  return Array.from({ length }, (_, step) => {
    const glyph = glyphs[Math.floor(hash(run, step + 4) * glyphs.length)]
    const alpha = (0.1 + hash(step, run) * 0.3) * (0.7 + weight * 0.3)
    return `<text x="${x}" y="${Math.round(top + step * 10)}" fill-opacity="${alpha.toFixed(2)}">${glyph.replace("<", "&lt;").replace(">", "&gt;")}</text>`
  }).join("")
}).join("")
const rain = `url("data:image/svg+xml,${encodeURIComponent(
  `<svg xmlns="http://www.w3.org/2000/svg" width="647" height="660" font-family="monospace" font-size="9" fill="#a474ff">${field}</svg>`,
)}")`
---

<div class="bp" data-browser>
  <div class="bp-toolbar">
    <button type="button" class="bp-btn" data-browser-back aria-label="Go back" title="Go back" disabled>
      <ShotIcon name="back" size={14} />
    </button>
    <button type="button" class="bp-btn" data-browser-forward aria-label="Go forward" title="Go forward" disabled>
      <ShotIcon name="forward" size={14} />
    </button>
    <button type="button" class="bp-btn" data-browser-reload aria-label="Reload page" title="Reload page">
      <ShotIcon name="reload" size={14} class="bp-reload" />
    </button>
    <form class="bp-address" data-browser-form>
      <input
        type="text"
        aria-label="Browser address"
        value="https://vectordev.ai/"
        spellcheck="false"
        autocomplete="off"
        data-browser-url
      />
      <button type="submit" class="bp-go" aria-label="Open URL" title="Open URL"><ShotIcon name="go" size={14} /></button>
    </form>
    <button type="button" class="bp-btn" data-sidebar-toggle aria-label="Toggle Vector sidebar" title="Toggle Vector sidebar" aria-pressed="false">
      <ShotIcon name="panel" size={14} />
    </button>
    <a class="bp-btn" data-browser-open href="https://vectordev.ai/" target="_blank" rel="noopener" aria-label="Open in system browser" title="Open in system browser">
      <ShotIcon name="external" size={14} />
    </a>
    <button type="button" class="bp-publish" data-browser-publish>Publish</button>
  </div>

  <div class="bp-viewport" style={`--bp-rain: ${rain}`} data-browser-viewport>
    <div class="bp-head">
      <nav class="bp-nav" aria-label="vectordev.ai">
        <a class="bp-logo" href="https://vectordev.ai/" data-browser-link="/" aria-label="vectordev.ai home">
          <span><ShotIcon name="chip" size={20} /></span>
        </a>
        <button type="button" class="bp-menu" data-browser-menu aria-expanded="false" aria-label="Menu">
          <ShotIcon name="menu" size={16} />
        </button>
        <div class="bp-menu-list" data-browser-menu-list hidden>
          {
            menu.map((item) => (
              <a href={`https://vectordev.ai${item.path}`} data-browser-link={item.path} data-menu-path={item.path}>
                {item.name}
              </a>
            ))
          }
        </div>
      </nav>
    </div>

    <section class="bp-page bp-home" data-page="/" aria-label="vectordev.ai home page">
      <svg class="bp-wordmark" viewBox="0 0 40 7" fill="currentColor" aria-hidden="true">
        {wordmarkCells.map((cell) => <rect x={cell.x} y={cell.y} width="0.84" height="0.84" />)}
      </svg>
      <p class="bp-headline">An engineering workspace that <span>has a 300B model coming.</span></p>
      <p class="bp-deck">
        Open a repository on your computer. Plan, edit, run, and ship with Vector's own agent beside your editor — on
        your desktop, in your terminal, or from the cloud.
      </p>
      <div class="bp-actions">
        <a class="bp-cta" href="https://vectordev.ai/login" data-browser-link="/login">Get Vector <ShotIcon name="arrow" size={16} /></a>
        <a
          class="bp-secondary"
          href="https://vectordev.ai/docs/terminal-agent#install-the-cli"
          data-browser-link="/docs/terminal-agent#install-the-cli">Install the CLI</a
        >
      </div>
      <p class="bp-note">Free with a Vector account. macOS, Windows, and Linux.</p>
      <div class="bp-window" aria-hidden="true">
        <div class="bp-window-bar"><span class="bp-lights"><i></i><i></i><i></i></span><span>Vector — Workspace</span><span class="bp-ready"><i></i>Ready</span></div>
        <div class="bp-window-row"><span class="bp-lights is-dim"><i></i><i></i><i></i></span><span>vectordev.ai — main</span><span class="bp-model">GPT-6 Astra</span></div>
        <div class="bp-window-body">
          <div class="bp-window-switch"><span>Agent</span><span>Editor</span></div>
          <div class="bp-window-next"><span></span><span></span></div>
        </div>
      </div>
    </section>

    <section class="bp-page bp-doc" data-page="/docs" aria-label="vectordev.ai docs page" hidden>
      <p class="bp-eyebrow">Start here</p>
      <p class="bp-title">Vector documentation</p>
      <p class="bp-lead">
        Vector is an engineering workspace with an agent of its own: an editor, a terminal, a browser and a code reviewer
        around one agent that works in the repository already on your disk. These pages cover every part of it.
      </p>
      <p class="bp-heading">Get going</p>
      <ol class="bp-steps">
        {
          steps.map(([path, name, text]) => (
            <li>
              <a href={`https://vectordev.ai/docs/${path}`} data-browser-link={`/docs/${path}`}>
                {name}
              </a>
              <span>{text}</span>
            </li>
          ))
        }
      </ol>
      <p class="bp-heading">Everything else</p>
      <div class="bp-guides">
        {
          docsNav.map((group) => (
            <a class="bp-guide" href={`https://vectordev.ai/docs/${group.links[0].id}`} data-browser-link={`/docs/${group.links[0].id}`}>
              <span class="bp-guide-name">{group.label}</span>
              <span class="bp-guide-text">
                {group.links
                  .map((link) => link.title)
                  .slice(0, 3)
                  .join(" · ")}
              </span>
              <span class="bp-guide-count">{group.links.length} pages</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="bp-page bp-doc" data-page="/releases" aria-label="vectordev.ai releases page" hidden>
      <p class="bp-eyebrow">Vector releases</p>
      <p class="bp-title">Every version. One evolving workspace.</p>
      <ol class="bp-releases">
        {
          releases.map((release, index) => (
            <li class={index === 0 ? "is-latest" : undefined}>
              <span class="bp-version">
                {release.version}
                {index === 0 ? <em>Latest</em> : null}
              </span>
              <span class="bp-release-title">{release.title}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="bp-page bp-doc" data-page="missing" aria-label="Page not in this preview" hidden>
      <p class="bp-eyebrow">Not in this preview</p>
      <p class="bp-title">This browser only has three pages.</p>
      <p class="bp-lead">
        It is a drawing of Vector's browser, so it can open the home page, the docs and the releases. The desktop app
        opens anything, starting with the app you are building on localhost.
      </p>
      <div class="bp-links">
        <a href="https://vectordev.ai/" data-browser-link="/">vectordev.ai</a>
        <a href="https://vectordev.ai/docs" data-browser-link="/docs">/docs</a>
        <a href="https://vectordev.ai/releases" data-browser-link="/releases">/releases</a>
      </div>
      <a class="bp-real" href="https://vectordev.ai/" target="_blank" rel="noopener" data-browser-real hidden>
        Open <span data-browser-real-label></span> in your browser <ShotIcon name="external" size={13} />
      </a>
    </section>

    <div class="bp-toast" data-browser-toast role="status" hidden>
      <button type="button" class="bp-toast-close" data-browser-toast-close aria-label="Dismiss"><ShotIcon name="x" size={14} /></button>
      <p class="bp-toast-title">Publish runs in the desktop app</p>
      <p class="bp-toast-text">
        It deploys the open project with your own Vercel or Netlify CLI and hands back the live link. This preview has
        no project to deploy.
      </p>
    </div>
  </div>
</div>

<script>
  const pages = ["/", "/docs", "/releases"]
  const reducedMotion = () => globalThis.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false

  // "vectordev.ai/docs", "https://vectordev.ai/docs/", "docs" and "/docs" all
  // name the same page; anything else is a page this preview does not have.
  const pathOf = (input: string) =>
    `/${input
      .trim()
      .replace(/^https?:\/\//i, "")
      .replace(/^(www\.)?vectordev\.ai/i, "")
      .replace(/^\/+|\/+$/g, "")}`
  const resolve = (input: string) => (pages.includes(pathOf(input)) ? pathOf(input) : "missing")
  // Where "open in your browser" goes: the same page on the real site when
  // the address is one of its pages, the home page otherwise.
  const realURL = (input: string) =>
    /^(https?:\/\/)?((www\.)?vectordev\.ai)?(\/[\w./-]*)?(#[\w-]*)?$/i.test(input.trim()) && input.trim() !== ""
      ? `https://vectordev.ai${pathOf(input) === "/" ? "/" : pathOf(input)}`
      : "https://vectordev.ai/"

  const boot = (root: HTMLElement) => {
    const url = root.querySelector<HTMLInputElement>("[data-browser-url]")
    const back = root.querySelector<HTMLButtonElement>("[data-browser-back]")
    const forward = root.querySelector<HTMLButtonElement>("[data-browser-forward]")
    const open = root.querySelector<HTMLAnchorElement>("[data-browser-open]")
    const toast = root.querySelector<HTMLElement>("[data-browser-toast]")
    const menu = root.querySelector<HTMLButtonElement>("[data-browser-menu]")
    const menuList = root.querySelector<HTMLElement>("[data-browser-menu-list]")
    const real = root.querySelector<HTMLAnchorElement>("[data-browser-real]")
    const realLabel = root.querySelector<HTMLElement>("[data-browser-real-label]")
    if (!url || !back || !forward || !open || !toast || !menu || !menuList || !real || !realLabel) return
    const state = { history: [{ path: "/", typed: "https://vectordev.ai/" }], at: 0, toast: 0 }

    const setMenu = (on: boolean) => {
      menuList.hidden = !on
      menu.setAttribute("aria-expanded", String(on))
    }

    const show = () => {
      const entry = state.history[state.at]
      root.querySelectorAll<HTMLElement>("[data-page]").forEach((page) => {
        page.hidden = page.dataset.page !== entry.path
        page.scrollTop = 0
      })
      root
        .querySelectorAll("[data-menu-path]")
        .forEach((link) =>
          link.setAttribute("aria-current", link.getAttribute("data-menu-path") === entry.path ? "page" : "false"),
        )
      url.value = entry.path === "missing" ? entry.typed : `https://vectordev.ai${entry.path === "/" ? "/" : entry.path}`
      open.href = realURL(entry.path === "missing" ? entry.typed : entry.path)
      // A missing page that is a real page of the site offers to open it.
      real.hidden = entry.path !== "missing" || open.href === "https://vectordev.ai/"
      real.href = open.href
      realLabel.textContent = open.href.replace(/^https:\/\//, "")
      back.disabled = state.at === 0
      forward.disabled = state.at === state.history.length - 1
      setMenu(false)
    }

    const reload = () => {
      show()
      if (reducedMotion()) return
      root.dataset.loading = ""
      setTimeout(() => delete root.dataset.loading, 450)
    }

    // Opening the address already showing reloads it, as a browser does,
    // rather than adding it to the history again.
    const go = (typed: string) => {
      const entry = state.history[state.at]
      const path = resolve(typed)
      if (path === entry.path && (path !== "missing" || typed.trim() === entry.typed.trim())) {
        reload()
        return
      }
      state.history = [...state.history.slice(0, state.at + 1), { path, typed }]
      state.at = state.history.length - 1
      show()
    }

    back.addEventListener("click", () => {
      state.at = Math.max(0, state.at - 1)
      show()
    })
    forward.addEventListener("click", () => {
      state.at = Math.min(state.history.length - 1, state.at + 1)
      show()
    })
    root.querySelector("[data-browser-reload]")?.addEventListener("click", reload)
    root.querySelector("[data-browser-form]")?.addEventListener("submit", (event) => {
      event.preventDefault()
      go(url.value)
      url.blur()
    })
    url.addEventListener("focus", () => url.select())
    url.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return
      // Handled here, so the session around it does not close anything too.
      event.preventDefault()
      show()
      url.blur()
    })
    root.querySelectorAll<HTMLAnchorElement>("[data-browser-link]").forEach((link) =>
      link.addEventListener("click", (event) => {
        event.preventDefault()
        go(link.href)
      }),
    )

    // The site's menu closes on a second press, a press anywhere else, or
    // Escape.
    menu.addEventListener("click", () => setMenu(menuList.hidden))
    root.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || menuList.hidden || event.defaultPrevented) return
      event.preventDefault()
      setMenu(false)
      menu.focus({ preventScroll: true })
    })
    const outside = (event: PointerEvent) => {
      if (!root.isConnected) {
        document.removeEventListener("pointerdown", outside)
        return
      }
      const target = event.target as Node
      if (!menuList.hidden && !menuList.contains(target) && !menu.contains(target)) setMenu(false)
    }
    document.addEventListener("pointerdown", outside)

    const hideToast = () => {
      clearTimeout(state.toast)
      toast.hidden = true
    }
    root.querySelector("[data-browser-publish]")?.addEventListener("click", () => {
      clearTimeout(state.toast)
      toast.hidden = false
      state.toast = window.setTimeout(hideToast, 7000)
    })
    root.querySelector("[data-browser-toast-close]")?.addEventListener("click", hideToast)
  }

  document.querySelectorAll<HTMLElement>("[data-browser]").forEach(boot)
  // A window put back by its Reset brings a fresh browser with it.
  document.addEventListener("shot:mounted", (event) => {
    if (!(event.target instanceof HTMLElement)) return
    event.target.querySelectorAll<HTMLElement>("[data-browser]").forEach(boot)
  })
</script>

<style>
  .bp {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    font-family: var(--as-font);
  }

  :where(.bp) :is(h3, p, ul, ol) {
    margin: 0;
    padding: 0;
  }

  .bp-toolbar {
    display: flex;
    flex: none;
    align-items: center;
    gap: 2px;
    height: 40px;
    padding: 0 8px 0 7px;
    border-bottom: 1px solid rgba(226, 213, 237, 0.07);
    background: #1f1e25;
  }

  .bp-btn {
    display: grid;
    flex: none;
    width: 26px;
    height: 26px;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: rgba(255, 255, 255, 0.58);
    cursor: pointer;
    transition:
      background-color 120ms ease,
      color 120ms ease;
  }

  .bp-btn:hover:not(:disabled),
  .bp-btn[aria-pressed="true"] {
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
  }

  .bp-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .bp-btn + .bp-btn {
    margin-left: 2px;
  }

  .bp :is(button, a, input):focus-visible {
    outline: 2px solid rgba(147, 116, 236, 0.75);
    outline-offset: 1px;
  }

  .bp[data-loading] :global(.bp-reload) {
    animation: bp-spin 450ms linear;
  }

  @keyframes bp-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .bp-address {
    display: flex;
    flex: 1;
    align-items: center;
    min-width: 0;
    height: 28px;
    margin: 0 10px 0 12px;
    padding: 0 4px 0 12px;
    border: 1px solid rgba(226, 213, 237, 0.08);
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.12);
  }

  .bp-address:focus-within {
    border-color: rgba(147, 116, 236, 0.5);
    background: rgba(0, 0, 0, 0.28);
  }

  .bp-address input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: rgba(255, 255, 255, 0.86);
    font: inherit;
    font-size: 12px;
    outline: none;
  }

  /* Under 16px, Safari on a phone zooms the whole page into a field it
     focuses and leaves it zoomed. */
  @media (pointer: coarse) {
    .bp-address input {
      font-size: 16px;
    }
  }

  .bp-address input:focus-visible {
    outline: none;
  }

  .bp-go {
    display: grid;
    width: 22px;
    height: 22px;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
  }

  .bp-publish {
    height: 24px;
    margin-left: 7px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: linear-gradient(180deg, #a98af7, #8f6ff0);
    color: #f6f2ff;
    font: inherit;
    font-size: 11.5px;
    font-weight: 500;
    cursor: pointer;
  }

  .bp-publish:hover {
    filter: brightness(1.1);
  }

  /* The site's nav stays at the top of every page; the page under it fills
     the rest. The glow sits under the nav and the wordmark, as on the site. */
  .bp-viewport {
    container: bp / inline-size;
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    background:
      radial-gradient(420px 320px at 15% 18%, rgba(120, 64, 220, 0.2), transparent 70%),
      radial-gradient(360px 300px at 8% 72%, rgba(143, 82, 255, 0.12), transparent 70%),
      var(--bp-rain) right top,
      #0e0a17;
    background-repeat: no-repeat;
    color: #f5f2f8;
  }

  .bp-head {
    position: relative;
    z-index: 2;
    flex: none;
    padding: 11px 24px 0 21px;
  }

  .bp-page {
    position: relative;
    flex: 1;
    min-height: 0;
    padding: 0 24px 0 21px;
  }

  .bp-page[hidden] {
    display: none;
  }

  /* The home page runs its hero window down to the panel's bottom edge
     and on past it, however short the panel is. */
  .bp-home {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .bp-home > :not(.bp-window) {
    flex-shrink: 0;
  }

  /* The site's glass nav: one light edge around a dark fill. */
  .bp-nav {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    height: 55px;
    margin-left: 4px;
    padding: 0 8px;
    border: 1px solid rgba(235, 228, 255, 0.3);
    border-radius: 22px;
    background: linear-gradient(100deg, rgba(38, 24, 66, 0.95), rgba(24, 15, 40, 0.92));
    box-shadow:
      inset 0 0 14px rgba(8, 5, 16, 0.3),
      0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .bp-logo {
    display: grid;
    flex: none;
    box-sizing: border-box;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid rgba(235, 228, 255, 0.22);
    border-radius: 13px;
    background: rgba(70, 56, 92, 0.55);
  }

  .bp-logo > span {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border-radius: 9px;
    background: linear-gradient(145deg, #b4a3f6, #7e66da);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
    color: #1d1338;
  }

  .bp-logo :global(svg *) {
    stroke-width: 1.9;
  }

  .bp-menu {
    display: grid;
    width: 39px;
    height: 39px;
    margin-left: auto;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(235, 228, 255, 0.2);
    border-radius: 12px;
    background: #201b2c;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
    color: rgba(241, 236, 251, 0.8);
    cursor: pointer;
  }

  .bp-menu :global(path) {
    stroke-width: 1.6;
  }

  .bp-menu:hover {
    background: #2a2339;
    color: #f1ecfb;
  }

  .bp-menu-list {
    position: absolute;
    z-index: 2;
    top: calc(100% + 6px);
    right: 0;
    display: grid;
    min-width: 150px;
    padding: 5px;
    border: 1px solid rgba(235, 228, 255, 0.16);
    border-radius: 14px;
    background: rgba(30, 20, 50, 0.96);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.5);
  }

  .bp-menu-list[hidden] {
    display: none;
  }

  .bp-menu-list a {
    padding: 8px 12px;
    border-radius: 9px;
    color: #f1ecfb;
    font-size: 13px;
    text-decoration: none;
  }

  .bp-menu-list a:hover {
    background: rgba(255, 255, 255, 0.07);
  }

  .bp-menu-list a[aria-current="page"] {
    color: #cdbdfb;
  }

  .bp-wordmark {
    display: block;
    flex: none;
