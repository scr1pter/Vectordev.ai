  model: {
    box: 16,
    body: stroke("M8 8A5.6 5.6 0 0 1 8.00 2.40A5.6 5.6 0 0 1 8 8M8 8A5.6 5.6 0 0 1 12.85 5.20A5.6 5.6 0 0 1 8 8M8 8A5.6 5.6 0 0 1 12.85 10.80A5.6 5.6 0 0 1 8 8M8 8A5.6 5.6 0 0 1 8.00 13.60A5.6 5.6 0 0 1 8 8M8 8A5.6 5.6 0 0 1 3.15 10.80A5.6 5.6 0 0 1 8 8M8 8A5.6 5.6 0 0 1 3.15 5.20A5.6 5.6 0 0 1 8 8", 1),
  },
  // The context meter: a dim track with the part of the window in use drawn
  // brighter from the top.
  ring: {
    box: 16,
    body: `<circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.4" opacity=".72"/><path d="M8 1.6a6.4 6.4 0 0 1 2.45.49" fill="none" stroke="#d9d6de" stroke-width="1.4" stroke-linecap="round"/>`,
  },
  dots: {
    box: 16,
    body: `<circle cx="3.5" cy="8" r="1.05" fill="currentColor"/><circle cx="8" cy="8" r="1.05" fill="currentColor"/><circle cx="12.5" cy="8" r="1.05" fill="currentColor"/>`,
