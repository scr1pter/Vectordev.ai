  stop: { box: 20, body: `<rect x="5" y="5" width="10" height="10" fill="currentColor"/>` },
}

const glyph = glyphs[Astro.props.name]
---

<svg
  class={Astro.props.class}
  width={Astro.props.size ?? 16}
  height={Astro.props.size ?? 16}
  viewBox={`0 0 ${glyph.box} ${glyph.box}`}
  fill="none"
  aria-hidden="true"
  focusable="false"
  set:html={glyph.body}
/>
