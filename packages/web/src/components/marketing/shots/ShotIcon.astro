  plus: { box: 16, body: stroke("M8 3v10M3 8h10", 1.2) },
  caret: { box: 16, body: stroke("m4.75 6.25 3.25 3 3.25-3", 1.25) },
  project: {
    box: 16,
    body: `<rect x="3" y="3" width="10" height="10" rx="2.2" fill="none" stroke="currentColor" stroke-width="1.1"/>${stroke("M5.5 8h5M8 5.5v5", 1.05)}`,
  },
