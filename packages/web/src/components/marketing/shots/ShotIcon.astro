---
// The glyphs the app screenshots draw with, copied from the desktop app so the
// replicas match it line for line: the 16px set from the sidebar, header and
// browser panel (packages/app/src/components/workspace-navigation.tsx,
// session-header.tsx, session-side-panel.tsx) and the 20px square-cap set from
// packages/ui/src/components/icon.tsx that the header tools and the Background
// tasks panel use.

interface Props {
  name: keyof typeof glyphs
  size?: number
  class?: string
}

const stroke = (d: string, width = 1.15) =>
  `<path d="${d}" fill="none" stroke="currentColor" stroke-width="${width}" stroke-linecap="round" stroke-linejoin="round"/>`
const square = (d: string) => `<path d="${d}" fill="none" stroke="currentColor" stroke-linecap="square"/>`

