---
// "Every pull request, reviewed", as a recording of a pull request page. The review text follows
// packages/core/src/review/format.ts: the summary heading "Vector review · Risk: …", the count line, the
// "File | + | − | Why it matters" table and the footer line with the model and "included with Vector"; an inline
// comment opens with "**Blocking** · title", carries a suggestion block, and ends with its confidence and the
// .vector/review.md rule it applies. GitHub's own chrome is drawn in Vector's colours and without GitHub's logo.
import RecordingFrame from "./RecordingFrame.astro"

const label =
  "Recording of a pull request titled Add rate limiting to the public API. Vector posts its review: risk medium, 1 blocking issue on the changed lines, and a table of the files that matter, run on opencode/big-pickle, a model included with Vector. On middleware/limit.ts it comments Blocking: the limit falls back to the client IP, with a suggested change that keys the limit on the API token only. The suggestion is committed."
---

<RecordingFrame kind="review" label={label} class="review-recording">
  <span slot="bar" class="rr-url">
    <svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true">
      <rect x="3.5" y="7" width="9" height="6.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"></rect>
      <path d="M5.5 7V5.2a2.5 2.5 0 0 1 5 0V7" fill="none" stroke="currentColor" stroke-width="1.4"></path>
    </svg>
    github.com/acme/api/pull/128
  </span>

  <div class="rr-view">
    <div class="rr-page" data-rec="page">
      <header class="rr-head">
        <h3 class="rr-title">Add rate limiting to the public API <span>#128</span></h3>
        <p class="rr-sub">
          <span class="rr-open">
            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
              <circle cx="4.5" cy="3.5" r="1.8" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
              <circle cx="4.5" cy="12.5" r="1.8" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
              <circle cx="11.5" cy="12.5" r="1.8" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
              <path d="M4.5 5.3v5.4M11.5 10.7V7a2 2 0 0 0-2-2H7" fill="none" stroke="currentColor" stroke-width="1.4"
              ></path>
            </svg>
            Open
          </span>
          <span><b>you</b> wants to merge 3 commits into <code>main</code> from <code>rate-limit</code></span>
        </p>
        <nav class="rr-tabs" aria-hidden="true">
          <span class="is-active">Conversation</span>
          <span>Commits <i>3</i></span>
          <span>Checks <i>2</i></span>
          <span>Files changed <i>4</i></span>
        </nav>
      </header>

      <article class="rr-comment" data-rec="summary" data-hidden data-on>
        <p class="rr-author">
          <span class="rr-avatar" aria-hidden="true"></span>
          <b>vector</b><span class="rr-bot">bot</span><span class="rr-when">commented just now</span>
        </p>
        <div class="rr-body">
          <h4 class="rr-h">Vector review · Risk: Medium</h4>
          <p>
            Adds a sliding-window limiter to every public route and a test for the limit. The limiter falls back to
            the client IP when a request has no API key.
          </p>
          <p class="rr-count" data-rec="s-count" data-hidden data-on><b>1 blocking</b> on the changed lines</p>
          <table class="rr-table" data-rec="s-table" data-hidden data-on>
            <thead>
              <tr><th>File</th><th>+</th><th>−</th><th>Why it matters</th></tr>
            </thead>
            <tbody>
              <tr>
                <td><code>middleware/limit.ts</code></td><td class="rr-add">42</td><td class="rr-del">3</td><td
                  >The new limiter every public route passes through</td
                >
              </tr>
              <tr>
                <td><code>routes/public.ts</code></td><td class="rr-add">6</td><td class="rr-del">1</td><td
                  >Wires the limiter in ahead of the handlers</td
                >
              </tr>
            </tbody>
          </table>
          <p class="rr-foot" data-rec="s-foot" data-hidden data-on>
            Reviewed <code>d4e5f6a</code> against <code>main</code> · full review · opencode/big-pickle · included with
            Vector (48.2k in / 3.1k out) · 1m 52s
          </p>
        </div>
      </article>

      <section class="rr-file" data-rec="review">
        <p class="rr-file-name">
          <b>vector</b> reviewed <code>middleware/limit.ts</code>
        </p>
        <div class="rr-diff" aria-hidden="true">
          <p class="rr-hunk">@@ -12,6 +12,14 @@ export function rateLimit(options: LimitOptions)</p>
          <p class="rr-line"><i>13</i><span> const windows = new Map&lt;string, number[]&gt;()</span></p>
          <p class="rr-line is-add"><i>14</i><span>+ return (req: Request, next: Next) =&gt; &#123;</span></p>
          <p class="rr-line is-add is-flag"><i>15</i><span>+ const key = req.headers.get("x-api-key") ?? req.ip</span></p>
          <p class="rr-line is-add"><i>16</i><span>+ const now = Date.now()</span></p>
        </div>

        <div class="rr-thread" data-rec="finding" data-hidden data-on>
          <p class="rr-author">
            <span class="rr-avatar" aria-hidden="true"></span>
            <b>vector</b><span class="rr-bot">bot</span><span class="rr-when">just now</span>
          </p>
          <p class="rr-finding"><b>Blocking</b> · The limit falls back to the client IP</p>
          <p class="rr-reason">
            Requests without an API key share their IP's window, so everyone behind one office network or proxy can be
            locked out together. Reject those requests instead of limiting them by address.
          </p>
          <div class="rr-suggestion" data-rec="suggestion" data-hidden data-on>
            <p class="rr-suggestion-head">Suggested change</p>
            <p class="rr-line is-del"><span>- const key = req.headers.get("x-api-key") ?? req.ip</span></p>
            <p class="rr-line is-add"><span>+ const key = req.headers.get("x-api-key")</span></p>
            <p class="rr-line is-add"><span>+ if (!key) return unauthorized()</span></p>
            <p class="rr-suggestion-actions">
              <span class="rr-commit" data-rec="commit-btn">
                <span class="rr-commit-labels">
                  <span data-rec="commit-label" data-toggle data-off>Commit suggestion</span>
                  <span data-rec="committed-label" data-hidden data-still data-on>
                    <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                      <path
                        d="M3.5 8.5 6.5 11.5 12.5 4.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                    </svg>
                    Suggestion committed
                  </span>
                </span>
              </span>
            </p>
          </div>
          <p class="rr-meta">confidence 0.93 · rule from .vector/review.md: "Key rate limits on the API token"</p>
        </div>
      </section>
    </div>
  </div>
</RecordingFrame>

<script>
  import { bootRecordings, click, hide, move, pointerAway, scroll, show, wait } from "./recording"

  bootRecordings("review", () => [
    // The pull request is open; Vector's review arrives.
    wait(1000),
    show("summary", 1300),
    show("s-count", 520),
    show("s-table", 760),
    show("s-foot", 1300),

    // Down to the changed line it flagged.
    scroll("page", "review", { ms: 1100, offset: 10 }),
    wait(300),
    show("finding", 1500),
    show("suggestion", 1000),

    // The author commits the fix from the comment.
    move("commit-btn", { ms: 900 }),
    click("commit-btn"),
    hide("commit-label"),
    show("committed-label", 900),
    pointerAway(),
  ])
</script>

<style>
  .rr-url {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.7);
    font-size: 11.5px;
  }

  .rr-view {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    overflow: clip;
    background: var(--rec-canvas);
  }

  .rr-page {
    display: grid;
    gap: 18px;
    padding: 22px 30px 34px;
    will-change: transform;
  }

  .rr-page p,
  .rr-page h3,
  .rr-page h4 {
    margin: 0;
  }

  .rr-page code {
    padding: 1px 5px;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.07);
    color: var(--rec-subtle);
    font-family: var(--rec-mono);
    font-size: 0.86em;
  }

  /* ---- the pull request header ---- */

  .rr-head {
    display: grid;
    gap: 10px;
  }

  .rr-title {
    color: var(--rec-text);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .rr-title span {
    color: var(--rec-faint);
    font-weight: 400;
  }

  .rr-sub {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    color: var(--rec-muted);
    font-size: 12.5px;
  }

  .rr-sub b {
    color: var(--rec-text);
    font-weight: 600;
  }

  .rr-open {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 11px;
    border-radius: 999px;
    background: rgba(111, 208, 154, 0.16);
    color: var(--rec-green);
    font-weight: 500;
  }

  .rr-tabs {
    display: flex;
    gap: 22px;
    margin-top: 4px;
    border-bottom: 1px solid var(--rec-line-soft);
    color: var(--rec-muted);
    font-size: 12.5px;
  }

  .rr-tabs span {
    padding: 8px 0 9px;
    white-space: nowrap;
  }

  .rr-tabs i {
    margin-left: 4px;
    padding: 1px 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    font-size: 11px;
    font-style: normal;
  }

  .rr-tabs .is-active {
    color: var(--rec-text);
    box-shadow: inset 0 -2px 0 var(--rec-accent);
  }

  /* ---- comments ---- */

  .rr-comment,
  .rr-file {
    border: 1px solid var(--rec-line);
    border-radius: 12px;
    background: var(--rec-surface);
    overflow: hidden;
  }

  .rr-author {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--rec-muted);
    font-size: 12.5px;
  }

  .rr-comment > .rr-author {
    padding: 10px 16px;
    border-bottom: 1px solid var(--rec-line-soft);
    background: rgba(255, 255, 255, 0.02);
  }

  .rr-author b {
    color: var(--rec-text);
    font-weight: 600;
  }

  .rr-avatar {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    background: linear-gradient(145deg, #c7b3ff, var(--rec-purple));
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2);
  }

  .rr-bot {
    padding: 0 6px;
    border: 1px solid var(--rec-line);
    border-radius: 999px;
    color: var(--rec-faint);
    font-size: 10.5px;
    line-height: 16px;
  }

  .rr-when {
    color: var(--rec-faint);
  }

  .rr-body {
    display: grid;
    gap: 10px;
    padding: 14px 16px 16px;
    color: var(--rec-subtle);
    font-size: 13px;
    line-height: 1.6;
  }

  .rr-h {
    color: var(--rec-text);
    font-size: 15px;
    font-weight: 600;
  }

  .rr-count b {
    color: var(--rec-text);
  }

  .rr-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
    line-height: 1.45;
  }

  .rr-table th,
  .rr-table td {
    padding: 6px 10px;
    border: 1px solid var(--rec-line-soft);
    text-align: left;
  }

  .rr-table th {
    color: var(--rec-muted);
    font-weight: 600;
  }

  .rr-table th:nth-child(2),
  .rr-table th:nth-child(3),
  .rr-table td:nth-child(2),
  .rr-table td:nth-child(3) {
    width: 42px;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .rr-add {
    color: var(--rec-green);
  }

  .rr-del {
    color: var(--rec-red);
  }

  .rr-foot {
    padding-top: 10px;
    border-top: 1px solid var(--rec-line-soft);
    color: var(--rec-faint);
    font-size: 11.5px;
  }

  /* ---- the reviewed file ---- */

  .rr-file-name {
    padding: 10px 16px;
    border-bottom: 1px solid var(--rec-line-soft);
    background: rgba(255, 255, 255, 0.02);
    color: var(--rec-muted);
    font-size: 12.5px;
  }

  .rr-file-name b {
    color: var(--rec-text);
  }

  .rr-diff,
  .rr-suggestion {
    font-family: var(--rec-mono);
    font-size: 12px;
    line-height: 20px;
  }

  .rr-hunk {
    padding: 4px 16px;
    background: rgba(170, 140, 255, 0.08);
    color: var(--rec-faint);
  }

  .rr-line {
    display: flex;
    gap: 14px;
    padding: 0 16px;
    color: var(--rec-subtle);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .rr-line i {
    flex: none;
    width: 22px;
    color: var(--rec-faint);
    font-style: normal;
    text-align: right;
  }

  .rr-line.is-add {
    background: rgba(111, 208, 154, 0.09);
  }

  .rr-line.is-del {
    background: rgba(239, 133, 137, 0.1);
  }

  .rr-line.is-flag {
    box-shadow: inset 2px 0 0 var(--rec-amber);
  }

  .rr-thread {
    display: grid;
    gap: 8px;
    margin: 10px 16px 16px;
    padding: 12px 14px 14px;
    border: 1px solid var(--rec-line);
    border-radius: 10px;
    background: var(--rec-canvas);
  }

  .rr-finding {
    color: var(--rec-text);
    font-size: 13.5px;
  }

  .rr-finding b {
    color: var(--rec-red);
    font-weight: 600;
  }

  .rr-reason {
    color: var(--rec-subtle);
    font-size: 13px;
    line-height: 1.6;
  }

  .rr-suggestion {
    overflow: hidden;
    border: 1px solid var(--rec-line);
    border-radius: 8px;
    background: var(--rec-surface);
  }

  .rr-suggestion-head {
    padding: 6px 12px;
    border-bottom: 1px solid var(--rec-line-soft);
    color: var(--rec-muted);
    font-family: var(--rec-sans);
    font-size: 12px;
  }

  .rr-suggestion .rr-line {
    padding: 0 12px;
  }

  .rr-suggestion-actions {
    display: flex;
    justify-content: flex-end;
    padding: 8px 10px;
    border-top: 1px solid var(--rec-line-soft);
    font-family: var(--rec-sans);
  }

  .rr-commit {
    display: inline-flex;
    padding: 6px 12px;
    border-radius: 8px;
    background: #f5f4f8;
    color: #16131c;
    font-size: 12px;
    font-weight: 600;
  }

  .rr-commit-labels {
    display: grid;
  }

  .rr-commit-labels > span {
    display: inline-flex;
    grid-area: 1 / 1;
    align-items: center;
    justify-content: center;
    gap: 6px;
    white-space: nowrap;
  }

  .rr-meta {
    color: var(--rec-faint);
    font-size: 11.5px;
  }

  @container rec (max-width: 720px) {
    .rr-view {
      height: 560px;
    }

    .rr-page {
      gap: 14px;
      padding: 14px 14px 24px;
    }

    .rr-title {
      font-size: 16px;
    }

    .rr-tabs {
      gap: 14px;
      overflow: hidden;
    }

    .rr-tabs span:nth-child(3) {
      display: none;
    }

    .rr-body,
    .rr-reason {
      font-size: 12px;
    }

    .rr-table th:nth-child(4),
    .rr-table td:nth-child(4) {
      display: none;
    }

    .rr-diff,
    .rr-suggestion {
      font-size: 10.5px;
      line-height: 17px;
    }

    .rr-line {
      gap: 8px;
      padding: 0 10px;
    }

    .rr-thread {
      margin: 8px 10px 12px;
      padding: 10px;
    }
  }
</style>
