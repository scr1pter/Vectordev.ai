---
// "No API key needed", as a recording of the Vector desktop app with no provider connected. The picker mirrors
// packages/app/src/components/dialog-select-model.tsx and packages/app/src/utils/provider-brand.ts: "Search models",
// the "Models included with Vector" section, "Included" on each row, and Connect provider after the rows. The
// composer placeholder is prompt.placeholder.simple and the rail is the new layout's project tools.
import RecordingFrame from "./RecordingFrame.astro"
import Typed from "./Typed.astro"
import Words from "./Words.astro"

const included = [
  "Big Pickle",
  "Nemotron 3 Ultra",
  "Nemotron 3.5 Lightning",
  "Muse Spark 1.3",
  "Muse Spark 1.2",
  "MiMo V2.5",
  "Ling 3.0 Flash Fin",
]
const rail = ["Agent", "Agent Dashboard", "Project rules", "Editor", "Browser", "Review"]
const prompt = "How are requests authenticated in this repo?"
const reply =
  "In middleware/auth.ts. It reads the bearer token, finds the API key it belongs to, and attaches that account to the request before any route runs. A request without a valid key gets a 401."
const label =
  "Recording of the Vector desktop app with no API key connected. The model picker opens on Models included with Vector: Big Pickle, Nemotron 3 Ultra, Nemotron 3.5 Lightning, Muse Spark 1.3, Muse Spark 1.2, MiMo V2.5 and Ling 3.0 Flash Fin, each marked Included. Nemotron 3 Ultra is chosen, a question about how requests are authenticated is sent, and the answer streams in."
---

<RecordingFrame kind="models" label={label} title="acme-api — Vector" class="models-recording">
  <span slot="status" class="mr-status"><i></i> Ready</span>

  <div class="mr">
    <aside class="mr-rail">
      <p class="mr-rail-title">Project tools</p>
      {
        rail.map((item, index) => (
          <p class:list={["mr-rail-item", index === 0 && "is-active"]}>
            <i />
            {item}
          </p>
        ))
      }
    </aside>

    <div class="mr-main">
      <div class="mr-tabs">
        <span class="is-active">Agent</span>
        <span>Editor</span>
      </div>

      <div class="mr-log">
        <p class="mr-user" data-rec="m-user" data-hidden data-on>{prompt}</p>
        <p class="mr-reply"><Words name="m-reply" text={reply} /></p>
        <p class="mr-meta" data-rec="m-meta" data-hidden data-on>
          <span class="mr-meta-agent">Build</span> · Nemotron 3 Ultra · <span class="mr-meta-tag">Included with Vector</span>
        </p>
      </div>

      <div class="mr-dock">
        <div class="mr-picker" data-rec="picker" data-hidden>
          <div class="mr-search">
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <circle cx="7" cy="7" r="4.6" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
              <path d="M10.6 10.6 14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
            <span>Search models</span>
          </div>
          <p class="mr-section">
            <span class="mr-section-mark" aria-hidden="true"></span>
            Models included with Vector
          </p>
          <div class="mr-rows">
            {
              included.map((name, index) => (
                <p class="mr-row" data-rec={index === 1 ? "row-pick" : undefined}>
                  <span class="mr-row-name">{name}</span>
                  <span class="mr-row-tag">Included</span>
                  <span class="mr-row-check" aria-hidden="true">
                    {index === 0 && (
                      <svg viewBox="0 0 16 16" width="14" height="14">
                        <path
                          d="M3.5 8.5 6.5 11.5 12.5 4.5"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    )}
                  </span>
                </p>
              ))
            }
          </div>
          <p class="mr-connect">
            <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
              <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
            Connect provider
          </p>
        </div>

        <div class="mr-composer">
          <div class="mr-input">
            <span class="mr-placeholder" data-rec="m-placeholder" data-toggle>Ask Vector anything...</span>
            <Typed name="m-type" text={prompt} typed={false} class="mr-typed" />
          </div>
          <div class="mr-controls">
            <span class="mr-agent">Build</span>
            <span class="mr-chip" data-rec="m-chip">
              <span class="mr-chip-mark" aria-hidden="true"></span>
              <span class="mr-chip-labels">
                <span data-rec="chip-old" data-toggle data-off>Big Pickle</span>
                <span data-rec="chip-new" data-hidden data-still data-on>Nemotron 3 Ultra</span>
              </span>
              <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                <path
                  d="M4.5 6.5 8 10l3.5-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
            <span class="mr-send" data-rec="m-send" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="14" height="14">
                <path
                  d="M8 12.5V3.5M4 7.5l4-4 4 4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</RecordingFrame>

<script>
  import {
    bootRecordings,
    clearTyped,
    click,
    flag,
    hide,
    move,
    pointerAway,
    show,
    stream,
    type,
    wait,
  } from "./recording"

  bootRecordings("models", () => [
    // No key connected: open the model picker from the composer.
    wait(900),
    move("m-chip", { ms: 900 }),
    click("m-chip"),
    show("picker", 1100),

    // Pick an included model.
    move("row-pick", { ms: 760, fx: 0.3 }),
    flag("row-pick", "data-active", true, 560),
    click("row-pick"),
    hide("picker"),
    hide("chip-old"),
    show("chip-new", 760),
    pointerAway(260),

    // Ask a question and watch the answer arrive.
    flag("m-type", "data-caret", true, 380),
    hide("m-placeholder"),
    type("m-type"),
    wait(420),
    move("m-send", { ms: 560 }),
    click("m-send"),
    clearTyped("m-type"),
    flag("m-placeholder", "data-off", false),
    pointerAway(),
    show("m-user", 900),
    stream("m-reply", { every: 55 }),
    wait(260),
    show("m-meta"),
  ])
</script>

<style>
  .mr-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .mr-status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--rec-green);
    box-shadow: 0 0 8px rgba(111, 208, 154, 0.55);
  }

  .mr {
    display: grid;
    flex: 1 1 auto;
    grid-template-columns: 188px minmax(0, 1fr);
    min-height: 0;
    background: var(--rec-canvas);
  }

  .mr p {
    margin: 0;
  }

  /* ---- the rail ---- */

  .mr-rail {
    display: grid;
    align-content: start;
    gap: 2px;
    padding: 18px 12px;
    border-right: 1px solid var(--rec-line-soft);
    background: rgba(255, 255, 255, 0.012);
  }

  .mr-rail-title {
    padding: 0 10px 8px;
    color: var(--rec-faint);
    font-size: 11px;
  }

  .mr-rail-item {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 10px;
    border-radius: 8px;
    color: var(--rec-muted);
    font-size: 12.5px;
  }

  .mr-rail-item i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
  }

  .mr-rail-item.is-active {
    color: var(--rec-text);
    background: var(--rec-raised);
  }

  /* ---- the session ---- */

  .mr-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
  }

  .mr-tabs {
    display: inline-flex;
    align-self: flex-start;
    gap: 2px;
    margin: 16px 22px 0;
    padding: 3px;
    border: 1px solid var(--rec-line-soft);
    border-radius: 10px;
    background: var(--rec-surface);
    font-size: 12px;
  }

  .mr-tabs span {
    padding: 5px 16px;
    border-radius: 7px;
    color: var(--rec-muted);
  }

  .mr-tabs .is-active {
    color: var(--rec-text);
    background: var(--rec-raised);
  }

  .mr-log {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 14px;
    min-height: 0;
    padding: 22px 26px 8px;
  }

  .mr-user {
    align-self: flex-end;
    max-width: 78%;
    padding: 10px 14px;
    border: 1px solid var(--rec-line);
    border-radius: 12px;
    background: var(--rec-surface);
    color: var(--rec-text);
    font-size: 14px;
  }

  .mr-reply {
    max-width: 62ch;
    color: var(--rec-subtle);
    font-size: 14px;
    line-height: 1.65;
  }

  .mr-meta {
    color: var(--rec-faint);
    font-size: 12px;
  }

  .mr-meta-agent {
    color: var(--rec-text);
  }

  .mr-meta-tag {
    color: var(--rec-bright);
  }

  /* ---- the composer and the picker ---- */

  .mr-dock {
    position: relative;
    flex: none;
    margin: 0 22px 20px;
  }

  .mr-composer {
    padding: 14px 14px 10px 16px;
    border: 1px solid var(--rec-line);
    border-radius: 16px;
    background: var(--rec-surface);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.28);
  }

  .mr-input {
    display: grid;
    min-height: 22px;
    color: var(--rec-text);
    font-size: 14px;
    line-height: 22px;
  }

  .mr-input > :global(*) {
    grid-area: 1 / 1;
  }

  .mr-placeholder {
    overflow: hidden;
    color: var(--rec-faint);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .mr-controls {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    font-size: 12.5px;
  }

  .mr-agent {
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--rec-soft);
    color: var(--rec-bright);
  }

  .mr-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 9px 4px 7px;
    border: 1px solid var(--rec-line);
    border-radius: 999px;
    color: var(--rec-text);
  }

  .mr-chip-mark,
  .mr-section-mark {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: linear-gradient(145deg, #c7b3ff, var(--rec-purple));
  }

  .mr-chip-labels {
    display: grid;
  }

  .mr-chip-labels > span {
    grid-area: 1 / 1;
    white-space: nowrap;
  }

  .mr-chip svg {
    color: var(--rec-faint);
  }

  .mr-send {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin-left: auto;
    border-radius: 50%;
    background: #f5f4f8;
    color: #16131c;
  }

  .mr-picker {
    position: absolute;
    z-index: 5;
    bottom: calc(100% + 10px);
    left: 64px;
    width: 318px;
    padding: 8px;
    border: 1px solid var(--rec-line);
    border-radius: 14px;
    background: #231f29;
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    transform-origin: 30% 100%;
  }

  .mr-picker:not([data-on]) {
    transform: translate3d(0, 8px, 0) scale(0.98);
  }

  .mr-search {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--rec-line-soft);
    color: var(--rec-faint);
    font-size: 13px;
  }

  .mr-section {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px 4px;
    color: var(--rec-muted);
    font-size: 11.5px;
    font-weight: 500;
  }

  .mr-rows {
    display: grid;
    gap: 1px;
  }

  .mr-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 16px;
    align-items: center;
    gap: 10px;
    padding: 6px 10px;
    border-radius: 8px;
    color: var(--rec-text);
    font-size: 13px;
    line-height: 20px;
    transition: background-color 200ms ease;
  }

  .mr-row[data-active] {
    background: var(--rec-soft);
  }

  .mr-row-name {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .mr-row-tag {
    color: var(--rec-bright);
    font-size: 11.5px;
  }

  .mr-row-check {
    display: grid;
    place-items: center;
    color: var(--rec-text);
  }

  .mr-connect {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    padding: 8px 10px 4px;
    border-top: 1px solid var(--rec-line-soft);
    color: var(--rec-muted);
    font-size: 12.5px;
  }

  @container rec (max-width: 720px) {
    .mr {
      grid-template-columns: minmax(0, 1fr);
    }

    .mr-rail {
      display: none;
    }

    .mr-tabs {
      margin: 12px 14px 0;
    }

    .mr-log {
      gap: 10px;
      padding: 14px 14px 8px;
      min-height: 190px;
    }

    .mr-user,
    .mr-reply {
      font-size: 12.5px;
    }

    .mr-user {
      max-width: 92%;
    }

    .mr-dock {
      margin: 0 12px 12px;
    }

    .mr-composer {
      padding: 10px 10px 8px 12px;
      border-radius: 14px;
    }

    .mr-input {
      font-size: 12.5px;
    }

    .mr-controls {
      margin-top: 8px;
      font-size: 11.5px;
    }

    .mr-picker {
      left: 8px;
      right: 8px;
      width: auto;
    }

    .mr-row {
      padding: 4px 8px;
      font-size: 12px;
      line-height: 18px;
    }
  }
</style>
