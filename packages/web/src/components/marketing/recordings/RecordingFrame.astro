---
// The window every recording plays in: the hero product window's dark glass bezel, traffic lights and title bar,
// over Vector's own surfaces. It fills its container's width up to 1080px, at about 16:10, and lets content set
// the height on a phone. The recordings themselves are in CliRecording, ModelsRecording and ReviewRecording.
interface Props {
  /** [data-recording] value the runner looks for. */
  kind: string
  /** What the recording shows, for assistive technology (the figure is one image). */
  label: string
  title?: string
  class?: string
}

const { kind, label, title, class: className } = Astro.props
---

<figure class:list={["rec", className]} data-recording={kind} role="img" aria-label={label}>
  <div class="rec-window" data-rec-stage>
    <div class="rec-bar">
      <span class="rec-traffic"><i></i><i></i><i></i></span>
      <span class="rec-bar-center"><slot name="bar">{title}</slot></span>
      <span class="rec-bar-end"><slot name="status" /></span>
    </div>
    <div class="rec-screen">
      <div class="rec-content">
        <slot />
      </div>
    </div>
    <span class="rec-cursor" data-rec-cursor>
      <span class="rec-cursor-ring" data-cursor-ring></span>
      <svg class="rec-cursor-arrow" data-cursor-arrow viewBox="0 0 20 22" width="20" height="22">
        <path
          d="M3.2 1.9c0-.7.8-1.1 1.4-.6l12.3 10.2c.6.5.3 1.5-.5 1.6l-5.2.5 3.1 6.1c.3.5 0 1.1-.5 1.3l-1.9.9c-.5.3-1.1 0-1.4-.5l-3-6.2-3.6 3.8c-.5.6-1.5.2-1.5-.6z"
          fill="#fbfaff"
          stroke="#16131c"
          stroke-width="1.3"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </div>
</figure>

<style>
  .rec {
    /* Vector's surfaces (packages/app/src/vector-premium.css) and the hero window's tokens. */
    --rec-canvas: #19171d;
    --rec-surface: #211e26;
    --rec-raised: #29252f;
    --rec-control: #2e2a35;
    --rec-line: #35313f;
    --rec-line-soft: rgba(236, 230, 255, 0.07);
    --rec-text: #f5f4f8;
    --rec-subtle: #cdc9d6;
    --rec-muted: #aaa5b8;
    --rec-faint: #8e889c;
    --rec-purple: #9274ec;
    --rec-bright: #b69ff7;
    --rec-accent: #aa8cff;
    --rec-soft: rgba(170, 140, 255, 0.14);
    --rec-green: #6fd09a;
    --rec-red: #ef8589;
    --rec-amber: #e0b26a;
    --rec-sans: -apple-system, system-ui, "SF Pro Display", "SF Pro Text", "Inter Variable", Inter, "Helvetica Neue",
      Arial, sans-serif;
    --rec-mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, monospace;
    --rec-caret: var(--rec-bright);

    container: rec / inline-size;
    position: relative;
    display: block;
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0;
    color: var(--rec-text);
    text-align: left;
    font-family: var(--rec-sans);
    font-size: 14px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .rec :global(*) {
    box-sizing: border-box;
  }

  /* The entrance: a fade and a scale from 0.96 as the recording comes into view. */
  .rec[data-entrance] {
    transition:
      opacity 800ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 800ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .rec[data-entrance="wait"] {
    opacity: 0;
    transform: scale(0.96);
  }

  .rec-window {
    position: relative;
    display: flex;
    flex-direction: column;
    aspect-ratio: 16 / 10;
    padding: 7px;
    border: 1px solid rgba(235, 228, 255, 0.22);
    border-radius: 28px;
    background: var(
      --glass-fill-strong,
      linear-gradient(145deg, rgba(255, 255, 255, 0.1), rgba(185, 151, 255, 0.05) 38%, rgba(22, 16, 35, 0.64) 76%)
    );
    box-shadow:
      0 40px 120px rgba(0, 0, 0, 0.66),
      0 0 80px rgba(132, 86, 219, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.13);
    backdrop-filter: blur(28px) saturate(145%);
    -webkit-backdrop-filter: blur(28px) saturate(145%);
  }

  .rec-bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    flex: none;
    min-height: 40px;
    padding: 0 14px;
    color: rgba(255, 255, 255, 0.55);
    font-size: 11.5px;
    line-height: 1;
    background: rgba(255, 255, 255, 0.045);
    border-bottom: 1px solid rgba(190, 166, 255, 0.1);
    border-radius: 20px 20px 0 0;
    white-space: nowrap;
  }

  .rec-traffic {
    display: inline-flex;
    gap: 6px;
  }

  .rec-traffic i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #f26d6d;
  }

  .rec-traffic i:nth-child(2) {
    background: #f2b25c;
  }

  .rec-traffic i:nth-child(3) {
    background: #63c98b;
  }

  .rec-bar-center {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rec-bar-end {
    justify-self: end;
    min-width: 0;
    color: rgba(255, 255, 255, 0.45);
  }

  .rec-screen {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    overflow: clip;
    background: var(--rec-canvas);
    border-radius: 0 0 20px 20px;
  }

  .rec-content {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
    transition: opacity 480ms ease;
  }

  /* Between loops the screen fades out, resets and fades back in. */
  .rec[data-fade] .rec-content,
  .rec[data-fade] .rec-cursor {
    opacity: 0;
  }

  /* The pointer. Its position is a transform the runner sets; it only fades in and out. */
  .rec-cursor {
    position: absolute;
    z-index: 20;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 240ms ease;
    will-change: transform;
  }

  .rec-cursor[data-on] {
    opacity: 1;
  }

  .rec-cursor-arrow {
    position: absolute;
    top: -2px;
    left: -3px;
    display: block;
    transform-origin: 4px 3px;
    filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.45));
  }

  .rec-cursor-ring {
    position: absolute;
    top: 0;
    left: 0;
    width: 44px;
    height: 44px;
    border: 1.5px solid rgba(214, 199, 255, 0.9);
    border-radius: 50%;
    background: rgba(170, 140, 255, 0.18);
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.2);
  }

  /* Shared reveal states for everything inside a recording. */
  .rec :global([data-hidden]) {
    transition:
      opacity 360ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 460ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .rec :global([data-hidden]:not([data-on])) {
    opacity: 0;
    transform: translate3d(0, 5px, 0);
  }

  .rec :global([data-hidden][data-still]:not([data-on])) {
    transform: none;
  }

  .rec :global([data-toggle]) {
    transition: opacity 280ms ease;
  }

  .rec :global([data-off]) {
    opacity: 0;
  }

  @container rec (max-width: 720px) {
    .rec-window {
      aspect-ratio: auto;
      padding: 5px;
      border-radius: 22px;
    }

    .rec-bar {
      min-height: 34px;
      padding: 0 12px;
      gap: 10px;
      font-size: 11px;
      border-radius: 16px 16px 0 0;
    }

    .rec-traffic {
      gap: 5px;
    }

    .rec-traffic i {
      width: 8px;
      height: 8px;
    }

    .rec-screen {
      border-radius: 0 0 16px 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rec[data-entrance],
    .rec-content,
    .rec-cursor,
    .rec :global([data-hidden]),
    .rec :global([data-toggle]) {
      transition: none;
    }

    .rec-cursor {
      display: none;
    }
  }
</style>
