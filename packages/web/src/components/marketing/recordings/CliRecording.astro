---
// The Vector CLI, as a terminal recording. Every line mirrors the product: the npm package and its single platform
// binary (packages/opencode/script/publish-vector.ts), `vector login` (packages/opencode/src/cli/vector-account.ts),
// and the TUI's own tool rows, prompt line and message footer (packages/tui/src/routes/session/index.tsx,
// component/prompt/index.tsx), where an included model names no provider but "Included with Vector"
// (packages/tui/src/util/included-model.ts).
import RecordingFrame from "./RecordingFrame.astro"
import Typed from "./Typed.astro"
import Words from "./Words.astro"

const prompt = "Add rate limiting to the public API. Key it on the API token."
const summary =
  "Added a sliding-window limiter to every public route, keyed on the API token, with tests for the limit and the reset."
const label =
  "Recording of the Vector CLI in a terminal. npm installs @vectordevai/cli, vector login signs in as you@yourteam.dev, and vector starts on Big Pickle, a model included with Vector. Asked to add rate limiting to the public API keyed on the API token, it reads middleware/auth.ts, edits middleware/limit.ts, runs bun test, reports 24 tests passed, and summarises the change."
---

<RecordingFrame kind="cli" label={label} title="~/acme-api" class="cli-recording">
  <span slot="status" class="cli-proc">
    <span data-rec="proc-shell" data-toggle data-off>zsh</span>
    <span data-rec="proc-vector" data-hidden data-still data-on>vector</span>
  </span>

  <div class="cli">
    <div class="cli-layer cli-shell" data-rec="shell" data-toggle data-off>
      <p class="cli-row">
        <span class="cli-ps">$</span>
        <Typed name="cmd-install" text="npm install -g @vectordevai/cli" />
      </p>
      <p class="cli-row cli-dim" data-rec="out-install" data-hidden data-on>added 2 packages in 2m</p>

      <p class="cli-row cli-gap" data-rec="row-login" data-hidden data-still data-on>
        <span class="cli-ps">$</span>
        <Typed name="cmd-login" text="vector login" />
      </p>
      <p class="cli-row cli-dim" data-rec="out-browser" data-hidden data-on>
        Your browser is opening <span class="cli-link">https://vectordev.ai/auth/cli</span>
      </p>
      <p class="cli-row cli-ok" data-rec="out-signed" data-hidden data-on>✓ Signed in as you@yourteam.dev</p>

      <p class="cli-row cli-gap" data-rec="row-vector" data-hidden data-still data-on>
        <span class="cli-ps">$</span>
        <Typed name="cmd-vector" text="vector" />
      </p>
    </div>

    <div class="cli-layer tui" data-rec="tui" data-hidden data-still data-on>
      <header class="tui-head">
        <span class="tui-brand"><i class="tui-mark"></i>vector</span>
        <span class="tui-dir">~/acme-api</span>
        <span class="tui-model"><b>Big Pickle</b> <span>Included with Vector</span></span>
      </header>

      <div class="tui-log">
        <p class="tui-user" data-rec="t-user" data-hidden data-on>{prompt}</p>
        <div class="tui-tools">
          <p class="tui-tool" data-rec="t-read" data-hidden data-on>
            <span class="tui-icon">→</span> Read middleware/auth.ts
          </p>
          <p class="tui-tool" data-rec="t-edit" data-hidden data-on>
            <span class="tui-icon">←</span> Edit middleware/limit.ts <span class="tui-add">+18</span>
          </p>
        </div>
        <div class="tui-block" data-rec="t-bash" data-hidden data-on>
          <p class="tui-cmd">$ bun test</p>
          <p class="tui-ok" data-rec="t-pass" data-hidden data-on>✓ 24 passed</p>
        </div>
        <p class="tui-text"><Words name="t-summary" text={summary} /></p>
        <p class="tui-meta" data-rec="t-meta" data-hidden data-on>
          <span class="tui-square">▣</span> <span class="tui-agent-name">Build</span> · Big Pickle · 41.2s
        </p>
      </div>

      <div class="tui-prompt" data-rec="t-prompt">
        <div class="tui-input">
          <span class="tui-placeholder" data-rec="t-placeholder" data-toggle>Ask anything... "Fix broken tests"</span>
          <Typed name="t-type" text={prompt} typed={false} class="tui-typed" />
        </div>
        <p class="tui-line">
          <span class="tui-agent">Build</span> <span class="tui-sep">·</span> <span class="tui-name">Big Pickle</span>
          <span class="tui-sub">Included with Vector</span>
        </p>
      </div>
    </div>
  </div>
</RecordingFrame>

<script>
  import {
    bootRecordings,
    caretOff,
    clearTyped,
    flag,
    hide,
    show,
    stream,
    type,
    wait,
  } from "./recording"

  bootRecordings("cli", () => [
    // The shell: install, sign in, start the agent.
    flag("cmd-install", "data-caret", true, 700),
    type("cmd-install"),
    wait(420),
    caretOff("cmd-install", 900),
    show("out-install", 420),
    show("row-login", 380),
    type("cmd-login", { lead: 140 }),
    wait(380),
    caretOff("cmd-login", 520),
    show("out-browser", 1100),
    show("out-signed", 560),
    show("row-vector", 360),
    type("cmd-vector", { lead: 140 }),
    wait(460),
    caretOff("cmd-vector"),

    // `vector` takes over the terminal.
    hide("shell"),
    hide("proc-shell"),
    show("proc-vector"),
    show("tui", 760),

    // The prompt is typed and sent.
    flag("t-type", "data-caret", true, 420),
    hide("t-placeholder"),
    type("t-type"),
    wait(460),
    clearTyped("t-type"),
    flag("t-placeholder", "data-off", false),
    show("t-user", 820),

    // The agent works.
    show("t-read", 700),
    show("t-edit", 820),
    show("t-bash", 1250),
    show("t-pass", 620),
    stream("t-summary", { every: 60 }),
    wait(240),
    show("t-meta"),
  ])
</script>

<style>
  .cli-proc {
    display: inline-grid;
    font-family: var(--rec-mono);
    font-size: 11px;
  }

  .cli-proc > span {
    grid-area: 1 / 1;
    justify-self: end;
  }

  .cli {
    display: grid;
    flex: 1 1 auto;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    min-height: 0;
    background: var(--rec-canvas);
  }

  .cli,
  .cli :global(*) {
    font-family: var(--rec-mono);
    font-variant-ligatures: none;
  }

  .cli-layer {
    grid-area: 1 / 1;
    min-width: 0;
    min-height: 0;
  }

  .cli p {
    margin: 0;
  }

  /* ---- the shell ---- */

  .cli-shell {
    padding: 26px 30px;
    color: #ebe8f1;
    font-size: 14px;
    line-height: 25px;
  }

  .cli-row {
    overflow-wrap: anywhere;
  }

  .cli-gap {
    margin-top: 14px !important;
  }

  .cli-ps {
    color: var(--rec-bright);
    font-weight: 700;
  }

  .cli-dim {
    color: var(--rec-faint);
  }

  .cli-link {
    color: var(--rec-subtle);
    text-decoration: underline;
    text-decoration-color: rgba(205, 201, 214, 0.35);
    text-underline-offset: 3px;
  }

  .cli-ok {
    color: var(--rec-green);
  }

  /* ---- the TUI ---- */

  .tui {
    display: flex;
    flex-direction: column;
    color: var(--rec-text);
    font-size: 14px;
    line-height: 23px;
  }

  .tui-head {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: none;
    padding: 12px 26px;
    color: var(--rec-muted);
    font-size: 12.5px;
    border-bottom: 1px solid var(--rec-line-soft);
    background: rgba(255, 255, 255, 0.015);
  }

  .tui-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--rec-text);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .tui-mark {
    width: 9px;
    height: 13px;
    border-radius: 1px;
    background: linear-gradient(180deg, #c7b3ff, var(--rec-purple));
    box-shadow: 0 0 12px rgba(170, 140, 255, 0.45);
  }

  .tui-model {
    margin-left: auto;
    white-space: nowrap;
  }

  .tui-model b {
    color: var(--rec-text);
    font-weight: 600;
  }

  .tui-log {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 16px;
    min-height: 0;
    padding: 22px 26px 10px;
  }

  .tui-user {
    padding: 10px 16px;
    color: var(--rec-text);
    background: var(--rec-surface);
    border-left: 2px solid var(--rec-accent);
  }

  .tui-tools {
    display: grid;
    gap: 3px;
  }

  .tui-tool,
  .tui-text,
  .tui-meta {
    padding-left: 18px;
  }

  .tui-tool {
    color: var(--rec-subtle);
  }

  .tui-icon {
    display: inline-block;
    width: 1.3em;
    color: var(--rec-faint);
  }

  .tui-add {
    margin-left: 0.6em;
    color: var(--rec-green);
  }

  .tui-block {
    display: grid;
    gap: 4px;
    margin-left: 18px;
    padding: 11px 16px;
    background: var(--rec-surface);
    border-left: 2px solid var(--rec-raised);
  }

  .tui-cmd {
    color: var(--rec-text);
  }

  .tui-ok {
    color: var(--rec-green);
  }

  .tui-text {
    color: var(--rec-text);
  }

  .tui-meta {
    margin-top: -6px !important;
    color: var(--rec-faint);
  }

  .tui-square {
    color: var(--rec-accent);
  }

  .tui-agent-name {
    color: var(--rec-text);
  }

  .tui-prompt {
    flex: none;
    margin: 6px 26px 22px;
    padding: 12px 16px 11px;
    background: var(--rec-surface);
    border-left: 2px solid var(--rec-accent);
  }

  .tui-input {
    display: grid;
    min-height: 23px;
  }

  .tui-input > :global(*) {
    grid-area: 1 / 1;
  }

  .tui-placeholder {
    overflow: hidden;
    color: var(--rec-faint);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .tui-line {
    margin-top: 9px !important;
    color: var(--rec-muted);
    font-size: 12.5px;
    line-height: 18px;
  }

  .tui-agent {
    color: var(--rec-bright);
  }

  .tui-name {
    color: var(--rec-text);
  }

  .tui-sep,
  .tui-sub {
    color: var(--rec-faint);
  }

  @container rec (max-width: 720px) {
    .cli-shell {
      min-height: 100%;
      padding: 16px 16px 20px;
      font-size: 12px;
      line-height: 20px;
    }

    .cli-gap {
      margin-top: 10px !important;
    }

    .tui {
      font-size: 12px;
      line-height: 19px;
    }

    .tui-head {
      flex-wrap: wrap;
      gap: 2px 10px;
      padding: 10px 16px;
      font-size: 11px;
      line-height: 16px;
    }

    .tui-model {
      flex-basis: 100%;
      margin-left: 0;
    }

    .tui-log {
      gap: 12px;
      padding: 14px 16px 8px;
    }

    .tui-user {
      padding: 8px 12px;
    }

    .tui-tool,
    .tui-text,
    .tui-meta {
      padding-left: 12px;
    }

    .tui-block {
      margin-left: 12px;
      padding: 8px 12px;
    }

    .tui-meta {
      margin-top: -4px !important;
    }

    .tui-prompt {
      margin: 4px 16px 16px;
      padding: 10px 12px;
    }

    .tui-input {
      min-height: 19px;
    }

    .tui-line {
      font-size: 11px;
      line-height: 16px;
    }
  }
</style>
