---
// The landing page's footer: one rounded card with the call to action and the
// site's links, then the pixel VECTOR wordmark at page width, faded almost to
// nothing and cut off by the bottom of the page. Every other page keeps
// MarketingFooter.

interface Props {
  /** The lit cells of the pixel VECTOR wordmark, passed in so every mark on the page is drawn from one font. */
  cells: Array<{ x: number; y: number }>
}

const { cells } = Astro.props

const columns = [
  {
    title: "Product",
    links: [
      ["Desktop", "/download"],
      ["CLI", "/docs/product#ch-cli"],
      ["Code review", "/docs#code-review"],
      ["Models", "/docs/product#ch-models"],
    ],
  },
  {
    title: "Resources",
    links: [
      ["Docs", "/docs"],
      ["Product tour", "/docs/product"],
      ["Releases", "/releases"],
      ["About", "/about"],
    ],
  },
  {
    title: "Legal",
    links: [
      ["Privacy", "/legal/privacy"],
      ["Terms", "/legal/terms"],
      ["Licence", "/legal/license"],
    ],
  },
]

const width = 6 * 7 - 2
---

<footer class="landing-footer">
  <div class="footer-card" data-reveal-group>
    <div class="footer-lead" data-reveal>
      <a class="footer-mark" href="/" aria-label="Vector home">
        <svg viewBox={`0 0 ${width} 7`} width="96" height="17" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true">
          {cells.map((cell) => <rect x={cell.x} y={cell.y} width="0.92" height="0.92" />)}
        </svg>
      </a>
      <h2 class="footer-title">Get Vector today.</h2>
      <p class="footer-copy">The agentic workspace for builders. Free during beta.</p>
      <a class="landing-pill footer-pill" href="/login">Get Vector</a>
      <p class="footer-legal">© 2026 Vector</p>
    </div>

    <div class="footer-columns">
      {
        columns.map((column) => (
          <nav class="footer-column" aria-label={column.title} data-reveal>
            <h3>{column.title}</h3>
            <ul>
              {column.links.map(([label, href]) => (
                <li>
                  <a href={href}>{label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <div class="footer-wordmark" aria-hidden="true">
    <svg viewBox={`0 0 ${width} 7`} fill="currentColor" shape-rendering="crispEdges" preserveAspectRatio="xMidYMin meet">
      {cells.map((cell) => <rect x={cell.x} y={cell.y} width="0.92" height="0.92" />)}
    </svg>
  </div>
</footer>

<style>
  .landing-footer {
    padding-top: 80px;
  }

  .footer-card {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
    padding: 56px 56px 48px;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 48px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 32px;
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
  }

  .footer-lead {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-mark {
    display: inline-flex;
    padding: 6px 0;
    color: #f5f5f7;
    text-decoration: none;
    border-radius: 6px;
  }

  .footer-mark svg {
    display: block;
    width: 96px;
    height: auto;
  }

  .footer-title {
    margin: 28px 0 0;
    color: #f5f5f7;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .footer-copy {
    max-width: 34ch;
    margin: 10px 0 0;
    color: #a1a1a6;
    font-size: 15px;
    line-height: 1.55;
  }

  .footer-pill {
    margin-top: 24px;
  }

  .footer-legal {
    margin: 40px 0 0;
    color: #86868b;
    font-size: 13px;
    line-height: 1.5;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .footer-column {
    min-width: 0;
  }

  .footer-column h3 {
    margin: 6px 0 0;
    color: #f5f5f7;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
  }

  .footer-column ul {
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    gap: 4px;
    list-style: none;
  }

  .footer-column a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: #a1a1a6;
    font-size: 15px;
    text-decoration: none;
    border-radius: 6px;
    transition: color 180ms ease;
  }

  .footer-column a:hover {
    color: #f5f5f7;
  }

  /* The mark runs the page's full width and the page ends partway down its
     letters, so only the top of the word shows. */
  .footer-wordmark {
    width: calc(100% - 40px);
    max-width: 1680px;
    margin: 72px auto 0;
    aspect-ratio: 40 / 4.4;
    overflow: hidden;
    color: rgba(245, 245, 247, 0.06);
    pointer-events: none;
    user-select: none;
  }

  .footer-wordmark svg {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 900px) {
    .footer-card {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }

  @media (max-width: 640px) {
    .landing-footer {
      padding-top: 56px;
    }

    .footer-card {
      width: calc(100% - 24px);
      padding: 36px 24px 28px;
      gap: 36px;
      border-radius: 28px;
    }

    .footer-title {
      margin-top: 22px;
      font-size: 21px;
    }

    .footer-legal {
      margin-top: 28px;
    }

    .footer-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 20px;
    }

    .footer-wordmark {
      width: calc(100% - 24px);
      margin-top: 48px;
    }
  }
</style>
