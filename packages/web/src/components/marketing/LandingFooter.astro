---
// The landing page's footer: one rounded card with the call to action and the
// site's links, and nothing after it — the card is the bottom of the page.
// Every other page keeps MarketingFooter.

interface Props {
  /** The lit cells of the pixel VECTOR wordmark, passed in so every mark on the page is drawn from one font. */
  cells: Array<{ x: number; y: number }>
}

const { cells } = Astro.props

const columns = [
  {
    title: "Product",
    links: [
      ["Desktop", "/download"],
      ["CLI", "/docs/product#ch-cli"],
      ["Code review", "/docs#code-review"],
      ["Models", "/docs/product#ch-models"],
    ],
  },
  {
    title: "Resources",
    links: [
      ["Docs", "/docs"],
      ["Product tour", "/docs/product"],
      ["Releases", "/releases"],
      ["About", "/about"],
    ],
  },
  {
    title: "Legal",
    links: [
      ["Privacy", "/legal/privacy"],
      ["Terms", "/legal/terms"],
      ["Licence", "/legal/license"],
    ],
  },
]

const width = 6 * 7 - 2
---

<footer class="landing-footer">
  <div class="footer-card" data-reveal-group>
    <div class="footer-lead" data-reveal>
      <a class="footer-mark" href="/" aria-label="Vector home">
        <svg viewBox={`0 0 ${width} 7`} width="96" height="17" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true">
          {cells.map((cell) => <rect x={cell.x} y={cell.y} width="1" height="1" />)}
        </svg>
      </a>
      <h2 class="footer-title">Start building with Vector.</h2>
      <p class="footer-copy">
        The engineering workspace with an agent of its own. Desktop is $10 a month or $99 a year, with models included. The CLI is free with a Vector account.
      </p>
      <a class="landing-pill footer-pill" href="/login">Get Vector</a>
      <p class="footer-legal">© 2026 Vector</p>
    </div>

    <div class="footer-columns">
      {
        columns.map((column) => (
          <nav class="footer-column" aria-label={column.title} data-reveal>
            <h3>{column.title}</h3>
            <ul>
              {column.links.map(([label, href]) => (
                <li>
                  <a href={href}>{label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

</footer>

<style>
  .landing-footer {
    padding-top: 56px;
    padding-bottom: 72px;
  }

  .footer-card {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
    padding: 56px 56px 48px;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 48px;
    background: rgba(20, 18, 26, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 32px;
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
  }

  .footer-lead {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-mark {
    display: inline-flex;
    padding: 6px 0;
    /* Inherited from the landing page; the fallback keeps the mark purple
       wherever this footer is used on its own. */
    color: var(--wordmark, #b79aff);
    text-decoration: none;
    border-radius: 6px;
  }

  .footer-mark svg {
    display: block;
    width: 96px;
    height: auto;
  }

  .footer-title {
    margin: 28px 0 0;
    color: #f5f5f7;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .footer-copy {
    max-width: 34ch;
    margin: 10px 0 0;
    color: #a1a1a6;
    font-size: 15px;
    line-height: 1.55;
  }

  .footer-pill {
    margin-top: 24px;
  }

  .footer-legal {
    margin: 40px 0 0;
    color: #86868b;
    font-size: 13px;
    line-height: 1.5;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .footer-column {
    min-width: 0;
  }

  .footer-column h3 {
    margin: 6px 0 0;
    color: #f5f5f7;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
  }

  .footer-column ul {
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    gap: 4px;
    list-style: none;
  }

  .footer-column a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: #a1a1a6;
    font-size: 15px;
    text-decoration: none;
    border-radius: 6px;
    transition: color 180ms ease;
  }

  .footer-column a:hover {
    color: #f5f5f7;
  }

  @media (max-width: 900px) {
    .footer-card {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }

  @media (max-width: 640px) {
    .landing-footer {
      padding-top: 56px;
      padding-bottom: 48px;
    }

    .footer-card {
      width: calc(100% - 24px);
      padding: 36px 24px 28px;
      gap: 36px;
      border-radius: 28px;
    }

    .footer-title {
      margin-top: 22px;
      font-size: 21px;
    }

    .footer-legal {
      margin-top: 28px;
    }

    .footer-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 20px;
    }
  }

  /* Very wide screens: line the card up with the product window. */
  @media (min-width: 1800px) {
    .footer-card {
      width: min(1440px, calc(100% - 40px));
    }
  }
</style>
