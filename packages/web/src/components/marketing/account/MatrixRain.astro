<canvas class="account-matrix" data-account-matrix aria-hidden="true"></canvas>

<script>
  // Dense rain: every cell of the screen holds a dim glyph, and bright streams run down the
  // columns over them, lighting the glyphs they pass. Glyphs flicker in place, as in the film,
  // instead of travelling with the stream.
  type Drop = { column: number; row: number; speed: number; trail: number; glow: number }

  const bootMatrix = () => {
    const canvas = document.querySelector<HTMLCanvasElement>("[data-account-matrix]")
    const context = canvas?.getContext("2d")
    const field = document.createElement("canvas")
    const fieldContext = field.getContext("2d")
    if (!canvas || !context || !fieldContext || canvas.dataset.ready === "true") return
    canvas.dataset.ready = "true"

    const glyphs = "01VECTOR{}[]<>/\\+=:*#$%&;~"
    const reduced = globalThis.matchMedia("(prefers-reduced-motion: reduce)").matches
    const pick = () => glyphs[Math.floor(Math.random() * glyphs.length)]
    const state = {
      width: 1,
      height: 1,
      ratio: 1,
      size: 14,
      pitch: 13,
      line: 15,
      columns: 0,
      rows: 0,
      cells: [] as string[],
      drops: [] as Drop[],
      last: 0,
      fieldAt: 0,
      frame: 0,
    }

    const spawn = (column: number, row: number): Drop => ({
      column,
      row,
      speed: 7 + Math.random() * 15,
      trail: 14 + Math.floor(Math.random() * 30),
      glow: 0.55 + Math.random() * 0.45,
    })

    const build = () => {
      state.size = state.width < 720 ? 12 : 14
      state.pitch = Math.round(state.size * 0.92)
      state.line = Math.round(state.size * 1.1)
      state.columns = Math.ceil(state.width / state.pitch) + 1
      state.rows = Math.ceil(state.height / state.line) + 1
      state.cells = Array.from({ length: state.columns * state.rows }, pick)
      // About two streams per column, spread over the screen and above it, so it starts full.
      state.drops = Array.from({ length: Math.round(state.columns * (state.width < 720 ? 1.5 : 2)) }, (_, index) =>
        spawn(index % state.columns, Math.random() * state.rows * 1.4 - state.rows * 0.3),
      )
    }

    const font = (target: CanvasRenderingContext2D) => {
      target.font = `${state.size}px ui-monospace, SFMono-Regular, Menlo, Monaco, monospace`
      target.textAlign = "center"
      target.textBaseline = "top"
    }

    // The dim layer, drawn to its own canvas and refreshed a few times a second, since it is
    // every cell on the screen.
    const paintField = () => {
      fieldContext.setTransform(state.ratio, 0, 0, state.ratio, 0, 0)
      fieldContext.clearRect(0, 0, state.width, state.height)
      font(fieldContext)
      fieldContext.fillStyle = "rgb(148, 108, 238)"
      fieldContext.globalAlpha = 0.085
      for (let column = 0; column < state.columns; column += 1) {
        for (let row = 0; row < state.rows; row += 1) {
          fieldContext.fillText(state.cells[column * state.rows + row], column * state.pitch, row * state.line)
        }
      }
      fieldContext.globalAlpha = 1
    }

    const render = (timestamp = performance.now()) => {
      const elapsed = state.last ? timestamp - state.last : 40
      if (!reduced && elapsed < 38) {
        state.frame = requestAnimationFrame(render)
        return
      }
      const delta = Math.min(elapsed, 100) / 1000
      state.last = timestamp

      for (let flicker = Math.ceil(state.cells.length * 0.012); flicker > 0; flicker -= 1) {
        state.cells[Math.floor(Math.random() * state.cells.length)] = pick()
      }
      if (timestamp - state.fieldAt > 320) {
        state.fieldAt = timestamp
        paintField()
      }

      context.clearRect(0, 0, state.width, state.height)
      context.drawImage(field, 0, 0, state.width, state.height)
      font(context)

      // Tails first in one colour, then the heads, so the fill colour changes twice per frame.
      context.fillStyle = "rgb(168, 126, 255)"
      state.drops.forEach((drop) => {
        if (!reduced) drop.row += drop.speed * delta
        const head = Math.floor(drop.row)
        for (let step = 1; step < drop.trail; step += 1) {
          const row = head - step
          if (row < 0 || row >= state.rows) continue
          const fade = 1 - step / drop.trail
          context.globalAlpha = step < 3 ? 0.85 * drop.glow : Math.pow(fade, 1.5) * 0.8 * drop.glow
          context.fillText(state.cells[drop.column * state.rows + row], drop.column * state.pitch, row * state.line)
        }
      })
      context.fillStyle = "rgb(244, 238, 255)"
      state.drops.forEach((drop, index) => {
        const head = Math.floor(drop.row)
        if (head >= 0 && head < state.rows) {
          context.globalAlpha = drop.glow
          context.fillText(pick(), drop.column * state.pitch, head * state.line)
        }
        if (head - drop.trail < state.rows) return
        state.drops[index] = spawn(Math.floor(Math.random() * state.columns), -Math.random() * state.rows * 0.35)
      })
      context.globalAlpha = 1

      if (!reduced && !document.hidden) state.frame = requestAnimationFrame(render)
    }

    const resize = () => {
      const rectangle = canvas.getBoundingClientRect()
      state.ratio = Math.min(globalThis.devicePixelRatio || 1, 2)
      state.width = Math.max(1, rectangle.width)
      state.height = Math.max(1, rectangle.height)
      canvas.width = field.width = Math.round(state.width * state.ratio)
      canvas.height = field.height = Math.round(state.height * state.ratio)
      context.setTransform(state.ratio, 0, 0, state.ratio, 0, 0)
      build()
      state.fieldAt = 0
      if (reduced) render()
    }

    new ResizeObserver(resize).observe(canvas)
    resize()
    if (reduced) return
    state.frame = requestAnimationFrame(render)
    document.addEventListener("visibilitychange", () => {
      cancelAnimationFrame(state.frame)
      if (document.hidden) return
      state.last = 0
      state.frame = requestAnimationFrame(render)
    })
  }

  bootMatrix()
  document.addEventListener("astro:page-load", bootMatrix)
</script>

<style>
  .account-matrix {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
