---
// A working replica of Vector's Agent Dashboard, embedded in the marketing page
// so a visitor can decide whether they like the product before downloading it.
// Everything here is real interaction against local data — the filters filter,
// the views switch, the search searches. Nothing is a screenshot, and nothing
// talks to a server.

const sessions = [
  {
    id: "s1",
    name: "Add rate limiting to the public API",
    space: "Auth hardening",
    column: "running",
    state: "Editing middleware/limit.ts",
    runtime: "vector",
    pr: "none",
    age: "4m",
  },
  {
    id: "s2",
    name: "Migrate the session store to Postgres",
    space: "",
    column: "running",
    state: "Running commands",
    runtime: "codex",
    pr: "none",
    age: "11m",
  },
  {
    id: "s3",
    name: "Fix the flaky upload test",
    space: "Auth hardening",
    column: "attention",
    state: "PR is ready",
    runtime: "claude-code",
    pr: "open",
    age: "26m",
  },
  {
    id: "s4",
    name: "Upgrade the app to React 19",
    space: "",
    column: "attention",
    state: "A typecheck failed",
    runtime: "vector",
    pr: "none",
    age: "38m",
  },
  {
    id: "s5",
    name: "Add the OAuth device flow",
    space: "Auth hardening",
    column: "done",
    state: "Merged",
    runtime: "vector",
    pr: "merged",
    age: "1h",
  },
  {
    id: "s6",
    name: "Write the billing webhook handler",
    space: "",
    column: "done",
    state: "Complete",
    runtime: "cursor",
    pr: "none",
    age: "3h",
  },
  {
    id: "s7",
    name: "Redact secrets from deploy logs",
    space: "",
    column: "done",
    state: "Merged",
    runtime: "codex",
    pr: "merged",
    age: "5h",
  },
]

const columns = [
  { id: "running", label: "Running" },
  { id: "attention", label: "Needs you" },
  { id: "done", label: "Done" },
]

const filters = [
  {
    key: "column",
    label: "Status",
    options: [
      { value: "running", label: "Running" },
      { value: "attention", label: "Needs you" },
      { value: "done", label: "Done" },
    ],
  },
  {
    key: "space",
    label: "Team",
    options: [{ value: "Auth hardening", label: "Auth hardening" }],
  },
  {
    key: "pr",
    label: "Pull request",
    options: [
      { value: "open", label: "Open" },
      { value: "merged", label: "Merged" },
      { value: "none", label: "No pull request" },
    ],
  },
  {
    key: "runtime",
    label: "Agent",
    options: [
      { value: "vector", label: "Vector" },
      { value: "claude-code", label: "Claude Code" },
      { value: "codex", label: "Codex" },
      { value: "cursor", label: "Cursor" },
    ],
  },
]
---

<section class="demo" aria-labelledby="demo-title" data-reveal>
  <div class="demo-intro">
    <p class="demo-kicker">Try it right here</p>
    <h2 id="demo-title">Click around the real thing.</h2>
    <p class="demo-deck">
      This is Vector, running in the page. Move between the Agent Dashboard, Codespace, your project rules and the
      browser from the rail on the left. On the dashboard, switch the board to a list, filter by status, team, pull
      request or which agent ran it, and search. No download, no account — see whether you like it first.
    </p>
  </div>

  <div class="demo-frame" data-demo>
    <div class="demo-titlebar">
      <span class="demo-lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="demo-titlebar-name">Vector</span>
    </div>

    <div class="demo-body">
      <aside class="demo-rail" aria-label="Workspace">
        <p class="demo-rail-heading">Workspace</p>
        <button type="button" class="demo-rail-nav is-on" data-surface-nav="dashboard">Agent Dashboard</button>
        <button type="button" class="demo-rail-nav" data-surface-nav="codespace">Codespace</button>
        <button type="button" class="demo-rail-nav" data-surface-nav="rules">Project rules</button>
        <button type="button" class="demo-rail-nav" data-surface-nav="browser">Browser</button>
        <p class="demo-rail-heading">Spaces</p>
        <p class="demo-rail-group">Auth hardening</p>
        {sessions.filter((session) => session.space).map((session) => (
          <p class="demo-rail-session is-nested">{session.name}</p>
        ))}
        {sessions.filter((session) => !session.space).map((session) => (
          <p class="demo-rail-session">{session.name}</p>
        ))}
      </aside>

      <div class="demo-main">
        <div class="demo-surface" data-surface="dashboard">
        <div class="demo-toolbar">
          <div class="demo-views" role="tablist" aria-label="View">
            <button type="button" role="tab" class="is-on" data-view="board" aria-selected="true">Board</button>
            <button type="button" role="tab" data-view="list" aria-selected="false">List</button>
          </div>
          <label class="demo-search">
            <span class="sr-only">Search agents</span>
            <input type="search" placeholder="Search agents" data-search autocomplete="off" />
          </label>
        </div>

        <div class="demo-filters">
          {filters.map((filter) => (
            <div class="demo-filter" data-filter={filter.key}>
              <button type="button" class="demo-filter-button" aria-expanded="false" aria-haspopup="menu">
                <span>{filter.label}</span>
                <span class="demo-filter-value" data-filter-value></span>
                <svg viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3" /></svg>
              </button>
              <div class="demo-menu" role="menu" hidden>
                <p class="demo-menu-head">{filter.label}</p>
                {filter.options.map((option) => (
                  <button type="button" role="menuitemcheckbox" aria-checked="false" data-value={option.value}>
                    <span>{option.label}</span>
                    <svg viewBox="0 0 12 12" aria-hidden="true"><path d="m2.5 6.5 2.5 2.5 4.5-5" /></svg>
                  </button>
                ))}
              </div>
            </div>
          ))}
          <button type="button" class="demo-clear" data-clear hidden>Clear filters</button>
        </div>

        <div class="demo-stage">
          <div class="demo-board" data-board>
            {columns.map((column) => (
              <div class="demo-column" data-column={column.id}>
                <div class="demo-column-head">
                  <span>{column.label}</span>
                  <span class="demo-count" data-count>0</span>
                </div>
                <div class="demo-column-body">
                  {sessions.filter((session) => session.column === column.id).map((session) => (
                    <button
                      type="button"
                      class="demo-card"
                      data-session
                      data-column-value={session.column}
                      data-space-value={session.space}
                      data-pr-value={session.pr}
                      data-runtime-value={session.runtime}
                      data-text={`${session.name} ${session.space} ${session.state}`.toLowerCase()}
                    >
                      {session.space ? <span class="demo-card-space">{session.space}</span> : null}
                      <span class="demo-card-name">{session.name}</span>
                      <span class="demo-card-foot">
                        <i class={`demo-dot is-${session.column}`}></i>
                        <span class="demo-card-state">{session.state}</span>
                        <span class="demo-card-age">{session.age}</span>
                      </span>
                      {session.pr === "open" ? <span class="demo-card-pr">PR is ready</span> : null}
                    </button>
                  ))}
                </div>
                <p class="demo-empty" data-empty hidden>Nothing here</p>
              </div>
            ))}
          </div>

          <div class="demo-list" data-list hidden>
            {columns.map((column) => (
              <div class="demo-list-group" data-list-group={column.id}>
                <p class="demo-list-head">
                  <span>{column.label}</span>
                  <span class="demo-count" data-count>0</span>
                </p>
                {sessions.filter((session) => session.column === column.id).map((session) => (
                  <button
                    type="button"
                    class="demo-row"
                    data-session
                    data-column-value={session.column}
                    data-space-value={session.space}
                    data-pr-value={session.pr}
                    data-runtime-value={session.runtime}
                    data-text={`${session.name} ${session.space} ${session.state}`.toLowerCase()}
                  >
                    <span class="demo-row-name">{session.name}</span>
                    <span class="demo-row-space">{session.space}</span>
                    <span class="demo-row-state">{session.state}</span>
                    <span class="demo-row-age">{session.age}</span>
                    <i class={`demo-dot is-${session.column}`}></i>
                  </button>
                ))}
              </div>
            ))}
          </div>

          <p class="demo-none" data-none hidden>No agents match these filters.</p>
        </div>
        </div>

        <div class="demo-surface" data-surface="codespace" hidden>
          <div class="demo-code">
            <div class="demo-tree">
              <p class="demo-tree-head">middleware</p>
              <p class="demo-tree-file is-open">limit.ts</p>
              <p class="demo-tree-file">auth.ts</p>
              <p class="demo-tree-head">routes</p>
              <p class="demo-tree-file">upload.ts</p>
              <p class="demo-tree-file">billing.ts</p>
            </div>
            <div class="demo-editor">
              <div class="demo-editor-tabs">
                <span class="is-on">limit.ts</span>
                <span>auth.ts</span>
              </div>
              <pre class="demo-editor-code"><code>{`const WINDOW_MS = 60_000
const MAX = 100

// Keyed on the API token, not the IP: everyone
// behind one office NAT is not one caller.
export function allow(token: string) {
  const now = Date.now()
  const hits = seen.get(token) ?? []
  const live = hits.filter((at) => now - at < WINDOW_MS)
  if (live.length >= MAX) return false
  seen.set(token, [...live, now])
  return true
}`}</code></pre>
              <div class="demo-editor-foot">
                <span class="demo-diag">2 diagnostics</span>
                <span>TypeScript</span>
                <span>Edited by Vector agent</span>
              </div>
            </div>
          </div>
        </div>

        <div class="demo-surface" data-surface="rules" hidden>
          <div class="demo-rules">
            <p class="demo-rules-lead">
              Standards in plain English, scoped to a repository and the files they govern. Saved to
              <code>.vector/RULES.md</code> in the repo, so they are committed and every agent follows them.
            </p>
            <div class="demo-rule">
              <p class="demo-rule-text">We don't put database query logic in the controller.</p>
              <p class="demo-rule-scope">vectordev.ai · whole repository</p>
            </div>
            <div class="demo-rule">
              <p class="demo-rule-text">Components stay presentational — no data fetching inside them.</p>
              <p class="demo-rule-scope">vectordev.ai · src/app/web/*.tsx</p>
            </div>
            <div class="demo-rule">
              <p class="demo-rule-text">Never widen a public type without a migration note.</p>
              <p class="demo-rule-scope">Every project</p>
            </div>
            <p class="demo-rules-foot">Vector · Claude Code · Codex · Cursor all follow these.</p>
          </div>
        </div>

        <div class="demo-surface" data-surface="browser" hidden>
          <div class="demo-browser">
            <div class="demo-browser-bar">
              <span class="demo-browser-url">localhost:3000/checkout</span>
            </div>
            <div class="demo-browser-page">
              <p class="demo-browser-step">Filled the card field with a test number</p>
              <p class="demo-browser-step">Clicked Pay</p>
              <p class="demo-browser-step is-fail">Expected a receipt, got a 500</p>
              <p class="demo-browser-note">
                The agent drives a real browser and refuses to type into password, one-time-code and card fields.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <p class="demo-foot">
    Everything above runs locally in this page. In the app, these are real isolated workspaces you can open, review and
    merge.
  </p>
</section>

<script is:inline>
  function bootVectorDemo() {
    const root = document.querySelector("[data-demo]")
    if (!root || root.dataset.booted === "1") return
    root.dataset.booted = "1"

    const state = { view: "board", query: "", filters: { column: [], space: [], pr: [], runtime: [] } }
    const board = root.querySelector("[data-board]")
    const list = root.querySelector("[data-list]")
    const none = root.querySelector("[data-none]")
    const clear = root.querySelector("[data-clear]")

    // Every card and row is server-rendered; filtering only toggles them. Astro
    // scopes component CSS to the elements it rendered, so nodes built in
    // JavaScript would carry none of the styles below.
    const matches = (el) => {
      const needle = state.query.trim().toLowerCase()
      if (needle && !el.dataset.text.includes(needle)) return false
      for (const [key, chosen] of Object.entries(state.filters)) {
        if (!chosen.length) continue
        if (!chosen.includes(el.dataset[`${key}Value`])) return false
      }
      return true
    }

    const render = () => {
      let total = 0
      for (const el of root.querySelectorAll("[data-session]")) {
        const show = matches(el)
        el.hidden = !show
      }
      for (const column of root.querySelectorAll("[data-column]")) {
        const shown = [...column.querySelectorAll("[data-session]")].filter((el) => !el.hidden).length
        column.querySelector("[data-count]").textContent = String(shown)
        column.querySelector("[data-empty]").hidden = shown > 0
        total += shown
      }
      for (const group of root.querySelectorAll("[data-list-group]")) {
        const shown = [...group.querySelectorAll("[data-session]")].filter((el) => !el.hidden).length
        group.querySelector("[data-count]").textContent = String(shown)
        group.hidden = shown === 0
      }
      const empty = total === 0
      board.hidden = empty || state.view !== "board"
      list.hidden = empty || state.view !== "list"
      none.hidden = !empty
      clear.hidden = !(state.query.trim() || Object.values(state.filters).some((chosen) => chosen.length))
    }

    // The rail switches which surface of the app you are looking at. Everything
    // is server-rendered and only toggled, so this stays a visibility flip.
    root.querySelectorAll("[data-surface-nav]").forEach((button) => {
      button.addEventListener("click", () => {
        const target = button.dataset.surfaceNav
        root.querySelectorAll("[data-surface]").forEach((surface) => {
          surface.hidden = surface.dataset.surface !== target
        })
        root.querySelectorAll("[data-surface-nav]").forEach((other) => {
          other.classList.toggle("is-on", other === button)
        })
      })
    })

    root.querySelectorAll("[data-view]").forEach((button) => {
      button.addEventListener("click", () => {
        state.view = button.dataset.view
        root.querySelectorAll("[data-view]").forEach((other) => {
          const on = other === button
          other.classList.toggle("is-on", on)
          other.setAttribute("aria-selected", String(on))
        })
        render()
      })
    })

    root.querySelector("[data-search]").addEventListener("input", (event) => {
      state.query = event.currentTarget.value
      render()
    })

    const closeMenus = (except) => {
      root.querySelectorAll(".demo-filter").forEach((filter) => {
        if (filter === except) return
        filter.querySelector(".demo-menu").hidden = true
        filter.querySelector(".demo-filter-button").setAttribute("aria-expanded", "false")
      })
    }

    root.querySelectorAll(".demo-filter").forEach((filter) => {
      const key = filter.dataset.filter
      const button = filter.querySelector(".demo-filter-button")
      const menu = filter.querySelector(".demo-menu")
      button.addEventListener("click", (event) => {
        event.stopPropagation()
        const open = menu.hidden
        closeMenus(filter)
        menu.hidden = !open
        button.setAttribute("aria-expanded", String(open))
      })
      menu.querySelectorAll("[data-value]").forEach((option) => {
        option.addEventListener("click", (event) => {
          event.stopPropagation()
          const value = option.dataset.value
          const chosen = state.filters[key]
          state.filters[key] = chosen.includes(value) ? chosen.filter((item) => item !== value) : [...chosen, value]
          option.setAttribute("aria-checked", String(state.filters[key].includes(value)))
          const labels = state.filters[key].map(
            (item) => menu.querySelector(`[data-value="${item}"] span`).textContent,
          )
          filter.querySelector("[data-filter-value]").textContent =
            labels.length > 1 ? `${labels[0]} +${labels.length - 1}` : (labels[0] ?? "")
          button.classList.toggle("is-on", state.filters[key].length > 0)
          render()
        })
      })
    })

    document.addEventListener("click", () => closeMenus(null))

    clear.addEventListener("click", () => {
      state.query = ""
      state.filters = { column: [], space: [], pr: [], runtime: [] }
      root.querySelector("[data-search]").value = ""
      root.querySelectorAll("[data-filter-value]").forEach((slot) => (slot.textContent = ""))
      root.querySelectorAll("[data-value]").forEach((option) => option.setAttribute("aria-checked", "false"))
      root.querySelectorAll(".demo-filter-button").forEach((button) => button.classList.remove("is-on"))
      render()
    })

    render()
  }

  bootVectorDemo()
  document.addEventListener("astro:page-load", bootVectorDemo)
</script>

<style>
