---
// A replica of the real Vector window, built from the app's own design tokens
// (packages/app/src/vector-premium.css) rather than the marketing palette — the
// product is a grey ramp with a muted purple, not near-black with a vivid one,
// and using the site's colours here made it look like a different application.
//
// Every nav item goes somewhere. The composer is deliberately inert: it is the
// one thing that cannot honestly work in a page with no model behind it, so it
// is shown as a picture of the composer rather than a box that swallows what
// you type.

interface Props {
  bare?: boolean
}

const { bare = false } = Astro.props

const navGroups = [
  {
    label: "Project tools",
    items: [
      { id: "session", name: "Session" },
      { id: "dashboard", name: "Agent Dashboard" },
      { id: "rules", name: "Project rules" },
      { id: "editor", name: "Code editor" },
      { id: "browser", name: "Browser" },
      { id: "canvas", name: "Canvas" },
    ],
  },
  {
    label: "Connections",
    items: [
      { id: "pulls", name: "Pull Requests" },
      { id: "mcp", name: "MCP" },
      { id: "plugins", name: "Plugins" },
    ],
  },
]

const board = [
  { id: "b1", col: "running", space: "Auth hardening", name: "Add rate limiting to the public API", state: "Editing middleware/limit.ts", age: "4m" },
  { id: "b2", col: "running", space: "", name: "Migrate the session store to Postgres", state: "Running commands", age: "11m" },
  { id: "b3", col: "attention", space: "Auth hardening", name: "Fix the flaky upload test", state: "PR is ready", age: "26m" },
  { id: "b4", col: "attention", space: "", name: "Upgrade the app to React 19", state: "A typecheck failed", age: "38m" },
  { id: "b5", col: "done", space: "Auth hardening", name: "Add the OAuth device flow", state: "Merged", age: "1h" },
  { id: "b6", col: "done", space: "", name: "Write the billing webhook handler", state: "Complete", age: "3h" },
]

const columns = [
  { id: "running", label: "Running" },
  { id: "attention", label: "Needs you" },
  { id: "done", label: "Done" },
]

const files = [
  { id: "limit", dir: "middleware", name: "limit.ts", code: `const WINDOW_MS = 60_000\nconst MAX = 100\n\n// Keyed on the API token, not the IP: everyone\n// behind one office NAT is not one caller.\nexport function allow(token: string) {\n  const now = Date.now()\n  const live = (seen.get(token) ?? [])\n    .filter((at) => now - at < WINDOW_MS)\n  if (live.length >= MAX) return false\n  seen.set(token, [...live, now])\n  return true\n}` },
  { id: "auth", dir: "middleware", name: "auth.ts", code: `export async function requireUser(req: Request) {\n  const token = bearer(req)\n  if (!token) throw new Unauthorized()\n  // Verified against the session store rather than\n  // decoded locally: a revoked session has to stop\n  // working the moment it is revoked.\n  const session = await sessions.find(token)\n  if (!session) throw new Unauthorized()\n  return session.user\n}` },
  { id: "upload", dir: "routes", name: "upload.ts", code: `export const config = { bodyParser: false }\n\nexport async function POST(req: Request) {\n  const user = await requireUser(req)\n  if (!allow(user.token)) return tooMany()\n  const file = await readMultipart(req)\n  // Streamed to storage, never buffered whole.\n  return store.put(user.id, file.stream)\n}` },
]

const plugins = [
  { name: "GitHub", blurb: "Repositories, issues, pull requests" },
  { name: "Linear", blurb: "Issues and project tracking" },
  { name: "Greptile", blurb: "Ask questions about an indexed codebase" },
  { name: "Sentry", blurb: "Errors, traces and releases" },
  { name: "Postgres", blurb: "Query and inspect your database" },
  { name: "Figma", blurb: "Files, frames and design tokens" },
]
---

<section class={bare ? "demo is-bare" : "demo"} data-reveal={bare ? undefined : true}>
  {!bare && (
    <div class="demo-intro">
      <p class="demo-kicker">Try it right here</p>
      <h2>Click around the real thing.</h2>
      <p class="demo-deck">
        This is Vector's own interface, running in the page. Every item in the sidebar goes somewhere. No download, no
        account — see whether you like it first.
      </p>
    </div>
  )}

  <div class={bare ? "demo-frame is-bare" : "demo-frame"} data-demo>
    <div class="demo-titlebar">
      <span class="demo-lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="demo-titlebar-name">vectordev.ai — main</span>
      <span class="demo-titlebar-right" aria-hidden="true"><i class="demo-chip">Opus 5</i></span>
    </div>

    <div class="demo-body">
      <aside class="demo-rail" aria-label="Workspace">
        {navGroups.map((group) => (
          <>
            <p class="demo-nav-label">{group.label}</p>
            {group.items.map((item) => (
              <button type="button" class={`demo-nav-item${item.id === "session" ? " is-on" : ""}`} data-surface-nav={item.id}>
                <i class="demo-nav-dot" aria-hidden="true"></i>
                <span>{item.name}</span>
              </button>
            ))}
          </>
        ))}
      </aside>

      <div class="demo-main">
        <div class="demo-surface" data-surface="session">
          <div class="demo-thread">
            <div class="demo-msg is-user"><p>Add rate limiting to the public API. Key it on the API token, not the IP.</p></div>
            <div class="demo-msg">
              <p>Reading <code>middleware/</code> to see how requests are already wrapped, then I'll add the limiter and a test.</p>
              <div class="demo-tool"><span class="demo-tool-k">read</span><span>middleware/auth.ts</span></div>
              <div class="demo-tool"><span class="demo-tool-k">edit</span><span>middleware/limit.ts</span><span class="demo-tool-add">+18</span></div>
              <div class="demo-tool"><span class="demo-tool-k">bash</span><span>bun test middleware</span><span class="demo-tool-ok">passed</span></div>
              <p>Added a sliding window keyed on the token — everyone behind one office NAT is not one caller. Tests pass.</p>
            </div>
          </div>

          <div class="demo-composer" aria-label="Prompt composer (static preview)">
            <p class="demo-composer-text">Ask Vector to build, fix, or explain something…</p>
            <div class="demo-composer-row">
              <span class="demo-control">Opus 5</span>
              <span class="demo-control demo-effort-control">
                <span class="demo-effort"><i class="demo-effort-thumb"></i></span>
                <span class="demo-effort-label">Max</span>
              </span>
              <span class="demo-control"><i class="demo-mode-dot"></i>Fast</span>
              <span class="demo-spacer"></span>
              <span class="demo-send" aria-hidden="true">
                <svg viewBox="0 0 16 16"><path d="M8 12.5v-9M4.5 7 8 3.5 11.5 7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
            </div>
            <p class="demo-composer-note">The composer is a preview — there is no model behind this page.</p>
          </div>
        </div>

        <div class="demo-surface" data-surface="dashboard" hidden>
          <div class="demo-toolbar">
            <div class="demo-views" role="tablist" aria-label="View">
              <button type="button" role="tab" class="is-on" data-view="board" aria-selected="true">Board</button>
              <button type="button" role="tab" data-view="list" aria-selected="false">List</button>
            </div>
            <label class="demo-search">
              <span class="sr-only">Search agents</span>
              <input type="search" placeholder="Search agents" data-search autocomplete="off" />
            </label>
          </div>

          <div class="demo-filters">
            {[
              { key: "col", label: "Status", options: columns.map((c) => ({ value: c.id, label: c.label })) },
              { key: "space", label: "Team", options: [{ value: "Auth hardening", label: "Auth hardening" }] },
            ].map((filter) => (
              <div class="demo-filter" data-filter={filter.key}>
                <button type="button" class="demo-filter-button" aria-expanded="false" aria-haspopup="menu">
                  <span>{filter.label}</span>
                  <span class="demo-filter-value" data-filter-value></span>
                  <svg viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3" /></svg>
                </button>
                <div class="demo-menu" role="menu" hidden>
                  {filter.options.map((option) => (
                    <button type="button" role="menuitemcheckbox" aria-checked="false" data-value={option.value}>
                      <span>{option.label}</span>
                      <svg viewBox="0 0 12 12" aria-hidden="true"><path d="m2.5 6.5 2.5 2.5 4.5-5" /></svg>
                    </button>
                  ))}
                </div>
              </div>
            ))}
            <button type="button" class="demo-clear" data-clear hidden>Clear filters</button>
          </div>

          <div class="demo-board" data-board>
            {columns.map((column) => (
              <div class="demo-column" data-column={column.id}>
                <div class="demo-column-head"><span>{column.label}</span><span class="demo-count" data-count>0</span></div>
                <div class="demo-column-body">
                  {board.filter((item) => item.col === column.id).map((item) => (
                    <button type="button" class="demo-card" data-item data-col-value={item.col} data-space-value={item.space} data-text={`${item.name} ${item.space} ${item.state}`.toLowerCase()}>
                      {item.space ? <span class="demo-card-space">{item.space}</span> : null}
                      <span class="demo-card-name">{item.name}</span>
                      <span class="demo-card-foot"><i class={`demo-dot is-${item.col}`}></i><span>{item.state}</span><span class="demo-card-age">{item.age}</span></span>
                    </button>
                  ))}
                </div>
                <p class="demo-empty" data-empty hidden>Nothing here</p>
              </div>
            ))}
          </div>

          <div class="demo-list" data-list hidden>
            {columns.map((column) => (
              <div class="demo-list-group" data-list-group={column.id}>
                <p class="demo-list-head"><span>{column.label}</span><span class="demo-count" data-count>0</span></p>
                {board.filter((item) => item.col === column.id).map((item) => (
                  <button type="button" class="demo-row" data-item data-col-value={item.col} data-space-value={item.space} data-text={`${item.name} ${item.space} ${item.state}`.toLowerCase()}>
                    <span class="demo-row-name">{item.name}</span>
                    <span class="demo-row-space">{item.space}</span>
                    <span class="demo-row-state">{item.state}</span>
                    <span class="demo-row-age">{item.age}</span>
                  </button>
                ))}
              </div>
            ))}
          </div>

          <p class="demo-none" data-none hidden>No agents match these filters.</p>
        </div>

        <div class="demo-surface" data-surface="rules" hidden>
          <p class="demo-lead">
            Standards in plain English, scoped to a repository and the files they govern. Saved to
            <code>.vector/RULES.md</code>, so they are committed and every agent follows them.
          </p>
          <div class="demo-panel"><p class="demo-panel-title">We don't put database query logic in the controller.</p><p class="demo-panel-sub">vectordev.ai · whole repository</p></div>
          <div class="demo-panel"><p class="demo-panel-title">Components stay presentational — no data fetching inside them.</p><p class="demo-panel-sub">vectordev.ai · src/app/web/*.tsx</p></div>
          <div class="demo-panel"><p class="demo-panel-title">Never widen a public type without a migration note.</p><p class="demo-panel-sub">Every project</p></div>
          <p class="demo-note">Vector · Claude Code · Codex · Cursor all follow these.</p>
        </div>

        <div class="demo-surface" data-surface="editor" hidden>
          <div class="demo-code">
            <div class="demo-tree">
              {files.map((file, index) => (
                <>
                  {index === 0 || files[index - 1].dir !== file.dir ? <p class="demo-tree-dir">{file.dir}</p> : null}
                  <button type="button" class={`demo-tree-file${index === 0 ? " is-on" : ""}`} data-file={file.id}>{file.name}</button>
                </>
              ))}
            </div>
            <div class="demo-pane">
              <div class="demo-tabs">
                {files.map((file, index) => (
                  <span class={`demo-tab${index === 0 ? " is-on" : ""}`} data-tab={file.id}>{file.name}</span>
                ))}
              </div>
              {files.map((file, index) => (
                <pre class="demo-editor-code" data-code={file.id} hidden={index !== 0}><code>{file.code}</code></pre>
              ))}
              <div class="demo-statusbar"><span class="demo-warn">2 diagnostics</span><span>TypeScript</span><span>Edited by Vector agent</span></div>
            </div>
          </div>
        </div>

        <div class="demo-surface" data-surface="browser" hidden>
          <div class="demo-urlbar">localhost:3000/checkout</div>
          <p class="demo-step">Opened the checkout page</p>
          <p class="demo-step">Filled the card field with a test number</p>
          <p class="demo-step is-guard">Refused to type into the CVC field</p>
          <p class="demo-step">Clicked Pay</p>
          <p class="demo-step is-fail">Expected a receipt, got a 500</p>
          <p class="demo-note">A real Chromium view in the window. It will not type into password, one-time-code or card fields.</p>
        </div>

        <div class="demo-surface" data-surface="canvas" hidden>
          <div class="demo-canvas">
            <div class="demo-canvas-tile"><span>Editor</span><i>middleware/limit.ts</i></div>
            <div class="demo-canvas-tile"><span>Browser</span><i>localhost:3000</i></div>
            <div class="demo-canvas-tile"><span>Terminal</span><i>bun test — 41 passed</i></div>
            <div class="demo-canvas-tile"><span>Notes</span><i>Rate limit design</i></div>
          </div>
          <p class="demo-note">Canvas puts the editor, the browser, the terminal and your notes on one surface.</p>
        </div>

        <div class="demo-surface" data-surface="pulls" hidden>
          <div class="demo-panel demo-row-flex"><span class="demo-panel-title">Add the OAuth device flow</span><span class="demo-badge is-merged">Merged</span></div>
          <div class="demo-panel demo-row-flex"><span class="demo-panel-title">Fix the flaky upload test</span><span class="demo-badge is-open">Open · checks passing</span></div>
          <div class="demo-panel demo-row-flex"><span class="demo-panel-title">Redact secrets from deploy logs</span><span class="demo-badge is-merged">Merged</span></div>
          <p class="demo-note">Pull requests and their CI runs, with a failed run turned into a repair prompt.</p>
        </div>

        <div class="demo-surface" data-surface="mcp" hidden>
          <div class="demo-panel demo-row-flex"><span class="demo-panel-title">github</span><span class="demo-badge is-on">Connected · 24 tools</span></div>
          <div class="demo-panel demo-row-flex"><span class="demo-panel-title">greptile</span><span class="demo-badge is-on">Connected · 4 tools</span></div>
          <div class="demo-panel demo-row-flex"><span class="demo-panel-title">postgres</span><span class="demo-badge">Not connected</span></div>
          <p class="demo-note">Any MCP server you configure, alongside the ones in the catalogue.</p>
        </div>

        <div class="demo-surface" data-surface="plugins" hidden>
          <div class="demo-grid">
            {plugins.map((plugin) => (
              <div class="demo-plugin"><span class="demo-plugin-name">{plugin.name}</span><span class="demo-plugin-blurb">{plugin.blurb}</span></div>
            ))}
          </div>
          <p class="demo-note">118 connectors ready to turn on, and the runtime installs itself.</p>
        </div>
      </div>
    </div>
  </div>

  {!bare && (
    <p class="demo-foot">
      Everything above runs locally in this page. In the app these are real isolated workspaces you can open, review
      and merge.
    </p>
  )}
</section>

<script is:inline>
  function bootVectorDemo() {
    const root = document.querySelector("[data-demo]")
    if (!root || root.dataset.booted === "1") return
    root.dataset.booted = "1"

    root.querySelectorAll("[data-surface-nav]").forEach((button) => {
      button.addEventListener("click", () => {
        const target = button.dataset.surfaceNav
        root.querySelectorAll("[data-surface]").forEach((surface) => {
          surface.hidden = surface.dataset.surface !== target
        })
        root.querySelectorAll("[data-surface-nav]").forEach((other) => {
          other.classList.toggle("is-on", other === button)
        })
      })
    })

    const state = { view: "board", query: "", filters: { col: [], space: [] } }
    const board = root.querySelector("[data-board]")
    const list = root.querySelector("[data-list]")
    const none = root.querySelector("[data-none]")
    const clear = root.querySelector("[data-clear]")

    const matches = (el) => {
      const needle = state.query.trim().toLowerCase()
      if (needle && !el.dataset.text.includes(needle)) return false
      for (const [key, chosen] of Object.entries(state.filters)) {
        if (chosen.length && !chosen.includes(el.dataset[`${key}Value`])) return false
      }
      return true
    }

    const render = () => {
      let total = 0
      root.querySelectorAll("[data-item]").forEach((el) => (el.hidden = !matches(el)))
      root.querySelectorAll("[data-column]").forEach((column) => {
        const shown = [...column.querySelectorAll("[data-item]")].filter((el) => !el.hidden).length
        column.querySelector("[data-count]").textContent = String(shown)
        column.querySelector("[data-empty]").hidden = shown > 0
        total += shown
      })
      root.querySelectorAll("[data-list-group]").forEach((group) => {
        const shown = [...group.querySelectorAll("[data-item]")].filter((el) => !el.hidden).length
        group.querySelector("[data-count]").textContent = String(shown)
        group.hidden = shown === 0
      })
      const empty = total === 0
      board.hidden = empty || state.view !== "board"
      list.hidden = empty || state.view !== "list"
      none.hidden = !empty
      clear.hidden = !(state.query.trim() || Object.values(state.filters).some((chosen) => chosen.length))
    }

    root.querySelectorAll("[data-view]").forEach((button) => {
      button.addEventListener("click", () => {
        state.view = button.dataset.view
        root.querySelectorAll("[data-view]").forEach((other) => {
          const on = other === button
          other.classList.toggle("is-on", on)
          other.setAttribute("aria-selected", String(on))
        })
        render()
      })
    })

    root.querySelector("[data-search]").addEventListener("input", (event) => {
      state.query = event.currentTarget.value
      render()
    })

    const closeMenus = (except) => {
      root.querySelectorAll(".demo-filter").forEach((filter) => {
        if (filter === except) return
        filter.querySelector(".demo-menu").hidden = true
        filter.querySelector(".demo-filter-button").setAttribute("aria-expanded", "false")
      })
    }

    root.querySelectorAll(".demo-filter").forEach((filter) => {
      const key = filter.dataset.filter
      const button = filter.querySelector(".demo-filter-button")
      const menu = filter.querySelector(".demo-menu")
      button.addEventListener("click", (event) => {
        event.stopPropagation()
        const open = menu.hidden
        closeMenus(filter)
        menu.hidden = !open
        button.setAttribute("aria-expanded", String(open))
      })
      menu.querySelectorAll("[data-value]").forEach((option) => {
        option.addEventListener("click", (event) => {
          event.stopPropagation()
          const value = option.dataset.value
          const chosen = state.filters[key]
          state.filters[key] = chosen.includes(value) ? chosen.filter((item) => item !== value) : [...chosen, value]
          option.setAttribute("aria-checked", String(state.filters[key].includes(value)))
          const labels = state.filters[key].map((item) => menu.querySelector(`[data-value="${item}"] span`).textContent)
          filter.querySelector("[data-filter-value]").textContent =
            labels.length > 1 ? `${labels[0]} +${labels.length - 1}` : (labels[0] ?? "")
          button.classList.toggle("is-on", state.filters[key].length > 0)
          render()
        })
      })
    })

    document.addEventListener("click", () => closeMenus(null))

    clear.addEventListener("click", () => {
      state.query = ""
      state.filters = { col: [], space: [] }
      root.querySelector("[data-search]").value = ""
      root.querySelectorAll("[data-filter-value]").forEach((slot) => (slot.textContent = ""))
      root.querySelectorAll("[data-value]").forEach((option) => option.setAttribute("aria-checked", "false"))
      root.querySelectorAll(".demo-filter-button").forEach((button) => button.classList.remove("is-on"))
      render()
    })

    root.querySelectorAll("[data-file]").forEach((button) => {
      button.addEventListener("click", () => {
        const id = button.dataset.file
        root.querySelectorAll("[data-file]").forEach((other) => other.classList.toggle("is-on", other === button))
        root.querySelectorAll("[data-tab]").forEach((tab) => tab.classList.toggle("is-on", tab.dataset.tab === id))
        root.querySelectorAll("[data-code]").forEach((code) => (code.hidden = code.dataset.code !== id))
      })
    })

    render()
  }

  bootVectorDemo()
  document.addEventListener("astro:page-load", bootVectorDemo)
</script>

<style>
  /* Vector's own tokens, copied from packages/app/src/vector-premium.css. */
  .demo {
    --c-canvas: #15141a;
    --c-stage: #19181f;
    --c-sidebar: #222028;
    --c-surface: #201e27;
    --c-raised: #292631;
    --c-control: #27242f;
    --c-control-hover: #322f3b;
    --c-line: #35313f;
    --c-text: #f0eff3;
    --c-subtle: #c0bdc7;
    --c-muted: #8d8995;
    --c-purple: #9274ec;
    --c-bright: #b69ff7;
    --c-soft: rgba(182, 159, 247, 0.14);
    --c-green: #65c78e;
    --c-amber: #d6a95c;
    --c-red: #e6787d;
    --c-mono: "SFMono-Regular", "Cascadia Code", ui-monospace, monospace;
    width: min(1240px, calc(100% - 56px));
    margin-inline: auto;
    padding: clamp(40px, 6vw, 72px) 0 clamp(16px, 3vw, 28px);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif;
  }

  .demo.is-bare { width: 100%; padding: 0; }

  .demo-intro { max-width: 640px; margin-bottom: 22px; }
  .demo-kicker { margin: 0 0 8px; font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-bright); }
  .demo-intro h2 { margin: 0 0 10px; font-size: clamp(24px, 3.2vw, 34px); line-height: 1.15; letter-spacing: -0.02em; }
  .demo-deck { margin: 0; font-size: 14.5px; line-height: 1.55; color: rgba(255, 255, 255, 0.55); }

  .demo-frame { overflow: hidden; border: 1px solid var(--c-line); border-radius: 14px; background: var(--c-canvas); box-shadow: 0 30px 80px -40px rgba(0, 0, 0, 0.9); }
  .demo-frame.is-bare { border: 0; border-radius: 0 0 20px 20px; box-shadow: none; }

  .demo-titlebar { display: flex; align-items: center; gap: 10px; padding: 9px 14px; border-bottom: 1px solid var(--c-line); background: var(--c-sidebar); }
  .demo-lights { display: inline-flex; gap: 6px; }
  .demo-lights i { width: 10px; height: 10px; border-radius: 50%; background: #3a3742; }
  .demo-titlebar-name { font-size: 11.5px; color: var(--c-muted); }
  .demo-titlebar-right { margin-left: auto; }
  .demo-chip { padding: 3px 9px; border: 1px solid var(--c-line); border-radius: 7px; background: var(--c-control); font-size: 11px; font-style: normal; color: var(--c-subtle); }

  .demo-body { display: grid; grid-template-columns: 218px minmax(0, 1fr); min-height: 452px; }
  .demo-rail { padding: 12px 10px; border-right: 1px solid var(--c-line); background: var(--c-sidebar); }

  /* [data-vector-nav-label] in the app. */
  .demo-nav-label { margin: 14px 0 0; padding: 0 10px 5px; font-size: 9.5px; font-weight: 600; color: rgba(255, 255, 255, 0.27); }
  .demo-nav-label:first-child { margin-top: 0; }

