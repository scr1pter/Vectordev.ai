---
import Default from '@astrojs/starlight/components/Head.astro'
import config from '../../config.mjs'

const base = import.meta.env.BASE_URL.replace(/^\//, "").replace(/\/$/, "")

const slug = Astro.url.pathname.replace(/^\//, "").replace(/\/$/, "");
const shareSlug = base === "" ? "s" : `${base}/s`
const isShare = slug === shareSlug || slug.startsWith(`${shareSlug}/`)
const isHome = slug === "" || slug === base

const ogImage = `${config.url}/vector-logo.png`;

---

<Default {...Astro.props}><slot /></Default>

{ isHome && (
  <>
    <meta name="application-name" content="Vector" />
    <meta name="apple-mobile-web-app-title" content="Vector" />
    <meta name="theme-color" content="#1d1d1f" />
    <meta property="og:site_name" content="Vector" />
    <meta property="og:image" content={`${config.url}/vector-logo.png`} />
    <meta property="twitter:image" content={`${config.url}/vector-logo.png`} />
  </>
)}

{ !isShare && !isHome && (
  <meta property="og:image" content={ogImage} />
  <meta property="twitter:image" content={ogImage} />
)}
