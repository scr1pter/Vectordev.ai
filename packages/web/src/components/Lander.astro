---

<div class="vector-marketing">
  <canvas class="ascii-field" data-vector-field aria-hidden="true"></canvas>
  <LanderMotion />
  <LanderMaterials />
  <MarketingNav active="home" />

  <main>
    <section id="ch-start" data-chapter="Start" class="scene scene-hero simple-hero-section" aria-labelledby="hero-title">
      <div class="scene-stage simple-stage">
        <div class="sky" aria-hidden="true">
          <i class="sky-aurora"></i>
          <i class="sky-stars"></i>
        </div>
        <div class="hero simple-hero">
          <h1 class="wordmark" id="hero-title">
            <span class="sr-only">Vector</span>
            <svg
              viewBox={`0 0 ${6 * 7 - 2} 7`}
              width="252"
              height="42"
              fill="currentColor"
              shape-rendering="crispEdges"
              aria-hidden="true"
            >
              {wordmarkCells.map((cell) => <rect x={cell.x} y={cell.y} width="0.92" height="0.92" />)}
            </svg>
          </h1>

          <p class="headline">
            <span class="headline-lead">An engineering workspace&nbsp;that</span>{" "}
            <span class="headline-rotate" data-scramble aria-hidden="true">has an agent of its own.</span>
            <span class="sr-only">An engineering workspace that has an agent of its own, verifies its work before calling it done, sets up your database and deploys it, runs subagents in parallel with no cap, invites your team into the session, runs in your terminal too, records what a run really cost, hosts Claude, Codex and Cursor alongside its own agent, and has its own 300 billion parameter model coming.</span>
          </p>

          <p class="hero-deck simple-deck">
            Open a repository on your computer. Plan, edit, run, and ship with Vector's own agent beside your editor —
            on your desktop, in your terminal, or from the cloud.
          </p>

          <div class="simple-actions">
            <a class="hero-cta simple-cta" href="/login">
              <span>Get Vector</span>
              <ArrowRight size={18} strokeWidth={2} aria-hidden="true" />
            </a>
            <a class="simple-secondary" href="/docs/product#ch-cli">Install the CLI</a>
          </div>
          <p class="hero-note">Free during beta. macOS, Windows, and Linux.</p>
        </div>

        <div class="showcase simple-showcase" aria-label="Interactive preview of the Vector interface">
          <figure class="product-window">
            <div class="product-bar" aria-hidden="true">
              <span class="traffic"><i></i><i></i><i></i></span>
              <span class="product-title">Vector — Workspace</span>
              <span class="product-status"><i></i> Ready</span>
            </div>
            <ProductDemo bare />
          </figure>
          <p class="showcase-note">
            An interactive preview — move around the rail, filter the board, open a file. The desktop app connects
            these surfaces to your real repository and agents.
          </p>
        </div>
      </div>
    </section>

    <section id="models" data-chapter="No API key needed" class="story" aria-labelledby="models-title">
      <div class="story-copy" data-reveal-group>
        <p class="story-kicker" data-reveal>Models</p>
        <h2 id="models-title" class="story-title" data-reveal>No API&nbsp;key needed.</h2>
        <p class="story-subtitle" data-reveal>Models come included with Vector.</p>
        <p class="story-body" data-reveal>
          Big Pickle is the default, alongside models from NVIDIA, Meta and others, so your first task runs before you
          connect anything. Want Claude, GPT or Gemini too? Add your own key and choose them from the same list.
        </p>
        <ul class="story-models" data-reveal aria-label="Models included with Vector today">
          {includedModels.map((model) => <li>{model}</li>)}
        </ul>
        <div class="story-action" data-reveal>
          <a class="landing-pill" href="/docs/product#ch-models">See the models</a>
        </div>
      </div>
    </section>

    <section id="everything" data-chapter="One workspace" class="story" aria-labelledby="everything-title">
      <div class="story-copy" data-reveal-group>
        <p class="story-kicker" data-reveal>One workspace</p>
        <h2 id="everything-title" class="story-title" data-reveal>Everything shipping&nbsp;takes.</h2>
        <p class="story-subtitle" data-reveal>Not a chat box bolted onto an editor.</p>
        <p class="story-body" data-reveal>
          Point a swarm of agents at separate branches and let each one spawn subagents for the parts. Set up the
          database, deploy to your own cloud account, and have the change reviewed before it reaches main. Vector does
          all of it in one window, over the repository already on your disk — with a browser it can drive, a tokenomics
          engine that measures every run, {pluginCount} one-click plugins, and any MCP server you write yourself.
        </p>
        <ul class="story-facts" data-reveal>
          {
            workspaceFacts.map((fact) => (
              <li>
                <h3>{fact.title}</h3>
                <p>{fact.text}</p>
              </li>
            ))
          }
        </ul>
        <ul class="story-models" data-reveal aria-label="A few of the plugins you can turn on">
          {pluginNames.map((name) => <li>{name}</li>)}
        </ul>
        <div class="story-action" data-reveal>
          <a class="landing-pill" href="/docs/product">See everything Vector does</a>
        </div>
      </div>
    </section>

    <section id="trust" data-chapter="Trust" class="trust" aria-labelledby="trust-title">
      <div class="trust-head" data-reveal-group>
        <div class="trust-mark" data-reveal aria-hidden="true">
          <svg
            viewBox={`0 0 ${6 * 7 - 2} 7`}
            width="92"
            height="16"
            fill="currentColor"
            shape-rendering="crispEdges"
          >
            {wordmarkCells.map((cell) => <rect x={cell.x} y={cell.y} width="1" height="1" />)}
          </svg>
        </div>
        <h2 id="trust-title" class="trust-title" data-reveal>
          An agent you can <strong>trust</strong><br class="trust-break" /> is one that <strong>shows its work</strong>.
        </h2>
        <p class="trust-sub" data-reveal>
          {trustCards.length} of them, in detail — code review, the browser, coordinated agents, the judge, the ledger.
          Every card opens the documentation behind it.
        </p>
      </div>

      <div class="trust-carousel">
        <ul class="trust-row" data-trust-row data-reveal-group>
          {
            trustCards.map((card) => {
              const Icon = card.icon
              return (
                <li class="trust-slot" data-reveal>
                  <article class="trust-card">
                    <span class="trust-icon">
                      <Icon size={26} strokeWidth={1.75} aria-hidden="true" />
                    </span>
                    <h3 class="trust-lead">{card.lead}</h3>
                    <p class="trust-text">{card.text}</p>
                    <a class="trust-more" href={card.href} aria-label={card.more}>
                      <Plus size={18} strokeWidth={2} aria-hidden="true" />
                    </a>
                  </article>
                </li>
              )
            })
          }
        </ul>
        <div class="trust-controls" data-trust-controls>
          <button type="button" class="trust-arrow" data-trust-step="-1" aria-label="Previous card">
            <ChevronLeft size={18} strokeWidth={2} aria-hidden="true" />
          </button>
          <button type="button" class="trust-arrow" data-trust-step="1" aria-label="Next card">
            <ChevronRight size={18} strokeWidth={2} aria-hidden="true" />
          </button>
        </div>
      </div>
    </section>
  </main>

  <LandingFooter cells={wordmarkCells} />
  <ScrollTicks />
</div>

<script>
  const reducedMotion = () => globalThis.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false

  // Signals that the animation runtime is alive. Reveal styles only hide
  // content under html.va, so a failed script load leaves the page readable.
  document.documentElement.classList.add("va")

  const initReveals = () => {
    // A group reveals its marked children together, 80ms apart, when the group
    // itself comes into view. That keeps a heading, its subtitle and its button
    // in step, and lets a row of cards in a horizontal scroller reveal even
    // though the cards past its edge are clipped.
    const groups = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal-group]"))
    groups.forEach((group) => {
      group.querySelectorAll<HTMLElement>("[data-reveal]").forEach((node, index) => {
        if (!node.style.getPropertyValue("--rd")) node.style.setProperty("--rd", `${index * 80}ms`)
      })
    })
    const nodes = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]:not(.in)"))
    if (reducedMotion() || !("IntersectionObserver" in globalThis)) {
      nodes.forEach((node) => node.classList.add("in"))
      return () => {}
    }
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          // The first report for every target arrives on observe, visible or
          // not, so check the ratio rather than trusting isIntersecting.
          if (!entry.isIntersecting || entry.intersectionRatio < 0.11) return
          const target = entry.target as HTMLElement
          const members = target.hasAttribute("data-reveal-group")
            ? Array.from(target.querySelectorAll<HTMLElement>("[data-reveal]"))
            : [target]
          members.forEach((member) => member.classList.add("in"))
          observer.unobserve(target)
        })
      },
      { threshold: [0, 0.12] },
    )
    groups.forEach((group) => observer.observe(group))
    nodes.filter((node) => !node.parentElement?.closest("[data-reveal-group]")).forEach((node) => observer.observe(node))
    return () => observer.disconnect()
  }

  const initScramble = () => {
    const node = document.querySelector<HTMLElement>("[data-scramble]")
    if (!node) return () => {}
    // Each phrase completes the same opening clause, so the headline always
    // reads as one sentence rather than a label with a caption.
    const phrases = [
      "has an agent of its own.",
      "verifies before it says done.",
      "sets up your database and deploys.",
      "runs subagents in parallel, no cap.",
      "invites your team into the session.",
      "runs in your terminal too.",
      "records what a run cost.",
      "hosts Claude, Codex, and Cursor too.",
      "has a 300B model coming.",
    ]
    const stages = Array.from(document.querySelectorAll<HTMLElement>("[data-hero-stage]"))
    const progress = document.querySelector<HTMLElement>("[data-hero-progress]")
    const selectStage = (index: number) => {
      stages.forEach((stage, stageIndex) => stage.classList.toggle("is-active", stageIndex === index))
      progress?.style.setProperty("--stage", String(index))
    }
    if (reducedMotion()) {
      node.textContent = phrases[0]
      selectStage(0)
      return () => {}
    }

    // Reserve the width of the longest phrase so a swap cannot reflow the hero
    // beneath it mid-scramble.
    const measure = document.createElement("span")
    measure.setAttribute("aria-hidden", "true")
    measure.style.cssText = "position:absolute;visibility:hidden;white-space:nowrap;pointer-events:none"
    node.after(measure)
    measure.style.font = getComputedStyle(node).font
    measure.textContent = phrases.reduce((longest, phrase) => (phrase.length > longest.length ? phrase : longest), "")
    node.style.minWidth = `${Math.min(Math.ceil(measure.getBoundingClientRect().width), node.parentElement?.clientWidth || Infinity)}px`
    node.style.display = "inline-block"
    measure.remove()
    // Inter is a web font on systems without SF Pro, and it can finish loading
    // after the first measure. Measure again once it has, so the reserved width
    // is the real one.
    document.fonts?.ready.then(() => {
      if (!node.isConnected) return
      node.after(measure)
      measure.style.font = getComputedStyle(node).font
      node.style.minWidth = `${Math.min(Math.ceil(measure.getBoundingClientRect().width), node.parentElement?.clientWidth || Infinity)}px`
      measure.remove()
    })

    const glyphs = "abcdefghijklmnopqrstuvwxyz<>{}/\\=+*"
    let phrase = 0
    let frame = 0
    let raf = 0
    let timer: ReturnType<typeof globalThis.setTimeout> | undefined
    const step = () => {
      const target = phrases[phrase]
      selectStage(phrase % Math.max(stages.length, 1))
      const total = target.length + 10
      frame++
      const revealed = Math.max(0, Math.floor(((frame - 6) / total) * target.length))
      const scrambled = Math.min(target.length - revealed, 9)
      node.textContent =
        target.slice(0, revealed) +
        Array.from({ length: scrambled }, () => glyphs[Math.floor(Math.random() * glyphs.length)]).join("")
      if (frame < total + 6) {
        raf = requestAnimationFrame(step)
        return
      }
      node.textContent = target
      phrase = (phrase + 1) % phrases.length
      frame = 0
      timer = globalThis.setTimeout(() => {
        if (!document.hidden) raf = requestAnimationFrame(step)
        else timer = globalThis.setTimeout(() => (raf = requestAnimationFrame(step)), 4000)
      }, 3600)
    }
    node.textContent = phrases[0]
    selectStage(0)
    timer = globalThis.setTimeout(() => (raf = requestAnimationFrame(step)), 2400)
    return () => {
      if (timer) globalThis.clearTimeout(timer)
      if (raf) cancelAnimationFrame(raf)
      node.textContent = phrases[0]
      selectStage(0)
    }
  }

  const initField = () => {
    const canvas = document.querySelector<HTMLCanvasElement>("[data-vector-field]")
    const context = canvas?.getContext("2d")
    if (!canvas || !context) return () => {}

    const glyphs = "01VECTOR{}[]<>/\\+=:*"
    const clusters = [
      [0.84, 0.1, 0.22, 0.16, 1.05],
      [0.96, 0.32, 0.18, 0.2, 0.9],
      [0.7, 0.05, 0.16, 0.1, 0.8],
      [0.05, 0.08, 0.14, 0.12, 0.6],
      [0.08, 0.6, 0.16, 0.18, 0.5],
      [0.92, 0.78, 0.2, 0.16, 0.55],
    ]
    const hash = (x: number, y: number, seed = 0) => {
      const value = Math.sin(x * 12.9898 + y * 78.233 + seed * 37.719) * 43758.5453
      return value - Math.floor(value)
    }
    const animate = !reducedMotion()
    let width = 1
    let height = 1
    let fontSize = 12
    let animationFrame = 0
    let lastFrame = 0
    let pointerX = 0.5
    let pointerY = 0.5
    let backdropCells: Array<{
      x: number
      y: number
      glyph: string
      alpha: number
      drift: number
      speed: number
    }> = []
    let columns: Array<{
      x: number
      y: number
      speed: number
      trail: number
      phase: number
      opacity: number
    }> = []

    const build = () => {
      fontSize = width < 720 ? 8.5 : 9
      const stepX = 9
      const stepY = 10
      backdropCells = []
      for (let y = 0; y < height + stepY; y += stepY) {
        for (let x = 0; x < width + stepX; x += stepX) {
          const nx = x / Math.max(1, width)
          const ny = y / Math.max(1, height)
          const warpX = nx + Math.sin(ny * 19) * 0.018
          const warpY = ny + Math.sin(nx * 15) * 0.014
          let field = 0
          clusters.forEach(([cx, cy, rx, ry, strength], index) => {
            const dx = (warpX - cx) / rx
            const dy = (warpY - cy) / ry
            field = Math.max(field, Math.exp(-(dx * dx + dy * dy) * (1.2 + (index % 3) * 0.1)) * strength)
          })
          const texture = hash(x / stepX, y / stepY) * 0.32 + Math.sin(nx * 46 + ny * 29) * 0.07
          if (field + texture < 0.51) continue
          const copyZone = Math.exp(-(Math.pow((nx - 0.42) / 0.3, 2) + Math.pow((ny - 0.3) / 0.3, 2)))
          const edge = Math.min(1, Math.max(0, (field + texture - 0.46) * 2.1))
          backdropCells.push({
            x,
            y,
            glyph: glyphs[Math.floor(hash(x, y, 2) * glyphs.length)],
            alpha: Math.max(0.08, (0.17 + edge * 0.42) * (1 - copyZone * 0.5)),
            drift: 2 + hash(x, y, 3) * 5,
            speed: 4 + hash(x, y, 4) * 11,
          })
        }
      }

      const spacing = fontSize * 1.08
      const count = Math.ceil(width / spacing)
      columns = Array.from({ length: count }, (_, index) => ({
        x: index * spacing + spacing / 2,
        // Seed the first frame across the viewport so the field is present
        // immediately, then recycle each stream from above as it falls.
        y: Math.random() * height,
        speed: 26 + Math.random() * 40,
        trail: 10 + Math.floor(Math.random() * 19),
        phase: Math.floor(Math.random() * glyphs.length),
        opacity: 0.26 + Math.random() * 0.54,
      }))
    }

    const render = (timestamp = performance.now()) => {
      const elapsed = lastFrame ? timestamp - lastFrame : 34
      if (animate && elapsed < 30) {
        animationFrame = requestAnimationFrame(render)
        return
      }
      const delta = Math.min(elapsed, 80) / 1000
      lastFrame = timestamp
      context.clearRect(0, 0, width, height)
      context.font = `${fontSize}px ui-monospace, SFMono-Regular, Menlo, Monaco, monospace`
      context.textAlign = "center"
      context.textBaseline = "middle"
      const offsetX = (pointerX - 0.5) * 7
      const offsetY = (pointerY - 0.5) * 4
      const tick = Math.floor(timestamp / 170)
      const lineHeight = fontSize * 1.18

      backdropCells.forEach((cell) => {
        const travel = animate ? (timestamp * cell.speed) / 1000 : 0
        const y = ((cell.y + travel) % (height + lineHeight * 2)) - lineHeight
        context.fillStyle = `rgba(164, 116, 255, ${cell.alpha * 0.72})`
        context.fillText(cell.glyph, cell.x + offsetX * cell.drift * 0.34, y + offsetY * cell.drift * 0.2)
      })

      columns.forEach((column, columnIndex) => {
        if (animate) column.y += column.speed * delta
        for (let step = 0; step < column.trail; step += 1) {
          const y = column.y - step * lineHeight
          if (y < -lineHeight || y > height + lineHeight) continue
          const fade = 1 - step / column.trail
          const normalizedX = column.x / Math.max(1, width)
          const normalizedY = y / Math.max(1, height)
          const copyZone = Math.exp(
            -(Math.pow((normalizedX - 0.47) / 0.32, 2) + Math.pow((normalizedY - 0.31) / 0.29, 2)),
          )
          const alpha = Math.max(0.04, fade * fade * column.opacity * 0.78 * (1 - copyZone * 0.5))
          const glyphIndex = Math.abs(column.phase + columnIndex * 3 + tick - step * 2) % glyphs.length
          context.fillStyle =
            step === 0
              ? `rgba(226, 215, 255, ${Math.min(0.94, alpha + 0.28)})`
              : `rgba(164, 116, 255, ${alpha})`
          context.fillText(glyphs[glyphIndex], column.x + offsetX * fade, y + offsetY * fade)
        }
        if (column.y - column.trail * lineHeight <= height + lineHeight) return
        column.y = -Math.random() * height * 0.7 - lineHeight
        column.speed = 26 + Math.random() * 40
        column.trail = 10 + Math.floor(Math.random() * 19)
        column.phase = Math.floor(Math.random() * glyphs.length)
      })

      if (animate && !document.hidden) animationFrame = requestAnimationFrame(render)
    }

    const resize = () => {
      const rect = canvas.getBoundingClientRect()
      const dpr = Math.min(globalThis.devicePixelRatio || 1, 2)
      width = Math.max(1, rect.width)
      height = Math.max(1, rect.height)
      canvas.width = Math.round(width * dpr)
      canvas.height = Math.round(height * dpr)
      context.setTransform(dpr, 0, 0, dpr, 0, 0)
      build()
      if (!animate) render()
    }

    const move = (event: PointerEvent) => {
      pointerX = event.clientX / Math.max(1, globalThis.innerWidth)
      pointerY = event.clientY / Math.max(1, globalThis.innerHeight)
    }

    const visibility = () => {
      if (document.hidden) {
        if (animationFrame) cancelAnimationFrame(animationFrame)
        animationFrame = 0
        return
      }
      lastFrame = 0
      if (animate && !animationFrame) animationFrame = requestAnimationFrame(render)
    }

    const resizeObserver = new ResizeObserver(resize)
    resizeObserver.observe(canvas)
    globalThis.addEventListener("pointermove", move, { passive: true })
    document.addEventListener("visibilitychange", visibility)
    resize()
    if (animate) animationFrame = requestAnimationFrame(render)

    return () => {
      resizeObserver.disconnect()
      globalThis.removeEventListener("pointermove", move)
      document.removeEventListener("visibilitychange", visibility)
      if (animationFrame) cancelAnimationFrame(animationFrame)
    }
  }

  const initTrust = () => {
    const row = document.querySelector<HTMLElement>("[data-trust-row]")
    const controls = document.querySelector<HTMLElement>("[data-trust-controls]")
    if (!row || !controls) return () => {}
    const buttons = Array.from(controls.querySelectorAll<HTMLButtonElement>("[data-trust-step]"))
    let frame = 0

    const update = () => {
      frame = 0
      const max = row.scrollWidth - row.clientWidth
      // When every card fits there is nothing to page through.
      controls.hidden = max <= 2
      buttons.forEach((button) => {
        const back = button.dataset.trustStep === "-1"
        const stuck = back ? row.scrollLeft <= 2 : row.scrollLeft >= max - 2
        button.setAttribute("aria-disabled", String(stuck))
      })
    }
    const queue = () => {
      if (!frame) frame = requestAnimationFrame(update)
    }
    // A page at a time: as many whole cards as the shelf shows, so a long row
    // does not take a dozen presses. Cards snap to the start either way.
    const step = (direction: number) => {
      const card = row.querySelector<HTMLElement>("li")
      if (!card) return
      const gap = Number.parseFloat(getComputedStyle(row).columnGap) || 0
      const stride = card.getBoundingClientRect().width + gap
      const perPage = Math.max(1, Math.floor((row.clientWidth + gap) / stride))
      row.scrollBy({ left: direction * perPage * stride, behavior: reducedMotion() ? "auto" : "smooth" })
    }
    const handlers = buttons.map((button) => {
      const handler = () => {
        if (button.getAttribute("aria-disabled") === "true") return
        step(Number(button.dataset.trustStep))
      }
      button.addEventListener("click", handler)
      return () => button.removeEventListener("click", handler)
    })

    row.addEventListener("scroll", queue, { passive: true })
    globalThis.addEventListener("resize", queue, { passive: true })
    update()
    return () => {
      row.removeEventListener("scroll", queue)
      globalThis.removeEventListener("resize", queue)
      handlers.forEach((remove) => remove())
      if (frame) cancelAnimationFrame(frame)
    }
  }

  let cleanups: Array<() => void> = []
  const boot = () => {
    cleanups.forEach((cleanup) => cleanup())
    cleanups = [initReveals(), initScramble(), initField(), initTrust()]
  }
  const teardown = () => {
    cleanups.forEach((cleanup) => cleanup())
    cleanups = []
  }

  boot()
  document.addEventListener("astro:page-load", boot)
  document.addEventListener("astro:before-swap", teardown)
</script>

