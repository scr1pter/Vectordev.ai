---
const downloadOptions = [
  {
    title: "macOS Apple Silicon",
    subtitle: "M1, M2, M3, M4 and newer Macs",
    badge: ".dmg",
    href: "/download/mac-arm64",
  },
  {
    title: "macOS Intel",
    subtitle: "Older Intel-based Macs",
    badge: ".dmg",
    href: "/download/mac-x64",
  },
  {
    title: "Windows",
    subtitle: "Windows 10 and Windows 11",
    badge: ".exe",
    href: "/download/windows",
  },
  {
    title: "Linux",
    subtitle: "Portable AppImage build",
    badge: "AppImage",
    href: "/download/linux",
  },
]
---

<div class="hero">
  <section class="top">
    <div class="nav">
      <a class="brand" href="/">
        <span class="mark" aria-hidden="true">
          <img src="/vector-logo.png" alt="" />
        </span>
        <span>vector.ai</span>
      </a>
    </div>

    <div class="hero-copy">
      <p class="eyebrow">Free BYOK AI coding workspace</p>
      <h1>Build with any model. Keep control of every file.</h1>
      <p class="lede">
        Vector is a local-first AI coding workspace for developers who want Codex-style flow,
        Claude-grade model choice, and bring-your-own-key ownership without a locked platform bill.
      </p>
    </div>
  </section>

  <section class="install">
    <div>
      <p class="section-label">Native app</p>
      <h2>Download Vector for macOS, Windows, or Linux.</h2>
    </div>
    <div class="inline-downloads">
      {
        downloadOptions.map((option) => (
          <a class="mini-download" href={option.href}>
            <span>{option.title}</span>
            <em>{option.badge}</em>
          </a>
        ))
      }
    </div>
  </section>

  <section class="features" aria-label="Vector features">
    <article>
      <span>01</span>
      <h3>Bring Your Own Key</h3>
      <p>Use your own OpenAI, Anthropic, Google, Groq, local, or compatible provider keys.</p>
    </article>
    <article>
      <span>02</span>
      <h3>Agentic Coding</h3>
      <p>Ask Vector to inspect, plan, edit, run checks, and explain what changed in your project.</p>
    </article>
    <article>
      <span>03</span>
      <h3>Real Code Ownership</h3>
      <p>Your app remains normal files on your machine, ready for Git, review, export, and handoff.</p>
    </article>
    <article>
      <span>04</span>
      <h3>Model Freedom</h3>
      <p>Pick the model that fits the work instead of being trapped inside one bundled AI plan.</p>
    </article>
    <article>
      <span>05</span>
      <h3>Focused Workspace</h3>
      <p>A mature black workspace built for long coding sessions, project context, and fast iteration.</p>
    </article>
    <article>
      <span>06</span>
      <h3>Free To Start</h3>
      <p>Vector is designed around user-controlled API spend, not forcing a subscription on day one.</p>
    </article>
  </section>

  <section class="workspace">
    <div class="window">
      <div class="traffic">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="workspace-grid">
        <aside>
          <p>Projects</p>
          <div class="pill active">astr0gpt</div>
          <div class="pill">stock tracker</div>
          <div class="pill">launch page</div>
        </aside>
        <main>
          <p class="prompt-title">What should Vector work on?</p>
          <div class="prompt-box">
            <span>Plan, edit, and verify a multi-file feature...</span>
            <strong>BYOK</strong>
          </div>
          <div class="timeline">
            <span>reading files</span>
            <span>planning</span>
            <span>editing</span>
            <span>review ready</span>
          </div>
        </main>
      </div>
    </div>
  </section>

  <section class="footer">
    <span>vector.ai</span>
    <span>Free BYOK coding workspace</span>
    <span>Built for ownership</span>
  </section>
</div>

<style>
  .hero {
    --surface: #101015;
    --surface-2: #17131f;
    --surface-3: #21172f;
    --text: #f6f2ff;
    --muted: #a59ab8;
    --line: rgba(177, 135, 255, 0.22);
    --purple: #8f52ff;
    --purple-2: #cbb4ff;

    min-height: 100vh;
    margin: 0;
    color: var(--text);
    background:
      radial-gradient(circle at 12% 18%, rgba(143, 82, 255, 0.34), transparent 26rem),
      radial-gradient(circle at 82% 8%, rgba(203, 180, 255, 0.18), transparent 24rem),
      linear-gradient(135deg, #07070a 0%, #101015 52%, #08070b 100%);
    border: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .hero :is(a, button) {
    color: inherit !important;
  }

  .hero button {
    font: inherit;
  }

  section {
    padding: clamp(1.25rem, 4vw, 4.5rem);
  }

  .top {
    min-height: 72vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 6rem;
  }

  .nav,
  .nav-actions,
  .brand,
  .install,
  .command,
  .footer {
    display: flex;
    align-items: center;
  }

  .nav {
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    gap: 0.75rem;
    font-size: 1.18rem;
    font-weight: 650;
    letter-spacing: 0;
    text-decoration: none;
  }

  .mark {
    width: 2.35rem;
    height: 2.35rem;
    display: grid;
    place-items: center;
    border-radius: 0.8rem;
    background: linear-gradient(135deg, #d9c7ff, #8d57ff);
    box-shadow: 0 0 32px rgba(143, 82, 255, 0.45);
  }

  .mark img {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: inherit;
    object-fit: cover;
  }

  .nav-actions {
    gap: 0.85rem;
  }

  .nav-actions :is(a, button) {
    appearance: none;
    cursor: pointer;
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.7rem 1rem;
    color: var(--muted) !important;
    background: transparent;
  }

  .nav-actions .download {
    color: #09070d !important;
    background: var(--text);
    border-color: var(--text);
  }

  .hero-copy {
    max-width: 920px;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 1rem;
    color: var(--purple-2);
    text-transform: uppercase;
    letter-spacing: 0;
    font-size: 0.8rem;
    font-weight: 700;
  }

  h1 {
    color: var(--text) !important;
    font-size: 4rem !important;
    line-height: 0.96 !important;
    letter-spacing: 0;
    margin: 0;
    max-width: 12ch;
    font-weight: 680 !important;
  }

  .lede {
    max-width: 760px;
    margin: 1.6rem 0 0;
    color: var(--muted);
    font-size: 1.18rem;
    line-height: 1.55;
  }

  .install {
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.02);
  }

  .inline-downloads {
    display: grid;
    grid-template-columns: repeat(2, minmax(10rem, 1fr));
    gap: 0.7rem;
    width: min(38rem, 100%);
  }

  .mini-download {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.6rem;
    padding: 0.8rem 0.95rem;
    border: 1px solid rgba(177, 135, 255, 0.24);
    border-radius: 1rem;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.035);
    transition:
      border-color 160ms ease,
      background 160ms ease,
      transform 160ms ease;
  }

  .mini-download:hover {
    transform: translateY(-1px);
    border-color: var(--purple);
    background: rgba(143, 82, 255, 0.13);
  }

  .mini-download span {
    color: var(--text);
    font-size: 0.92rem;
  }

  .mini-download em {
    color: var(--purple-2);
    font-style: normal;
    font-size: 0.76rem;
  }

  h2 {
    color: var(--text) !important;
    margin: 0;
    font-size: 2.4rem !important;
    line-height: 1.05 !important;
    letter-spacing: 0;
    max-width: 660px;
  }

  .command {
    appearance: none;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: #060609;
    color: var(--text);
    cursor: pointer;
    gap: 0.9rem;
    padding: 1rem 1.2rem;
    max-width: 100%;
  }

  .command span {
    color: var(--purple-2);
    font-size: 0.95rem;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    padding: 1px;
  }

  .features article {
    min-height: 14rem;
    padding: clamp(1.2rem, 2.5vw, 2rem);
    background: rgba(16, 16, 21, 0.96);
  }

  .features span {
    color: var(--purple-2);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .features h3 {
    color: var(--text) !important;
    margin: 2.4rem 0 0.75rem;
    font-size: 1.35rem !important;
  }

  .features p {
    color: var(--muted);
    margin: 0;
    line-height: 1.55;
  }

  .workspace {
    padding-top: clamp(3rem, 7vw, 7rem);
    padding-bottom: clamp(3rem, 7vw, 7rem);
  }

  .window {
    border: 1px solid var(--line);
    border-radius: 1.4rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.02));
    overflow: hidden;
    box-shadow: 0 30px 120px rgba(0, 0, 0, 0.42);
  }

  .traffic {
    display: flex;
    gap: 0.55rem;
    padding: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .traffic span {
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 50%;
    background: #ff5f56;
  }

  .traffic span:nth-child(2) {
    background: #ffbd2e;
  }

  .traffic span:nth-child(3) {
    background: #27c93f;
  }

  .workspace-grid {
    display: grid;
    grid-template-columns: minmax(14rem, 20rem) 1fr;
    min-height: 34rem;
  }

  .workspace-grid aside {
    border-right: 1px solid var(--line);
    padding: 1.25rem;
    background: rgba(0, 0, 0, 0.22);
  }

  .workspace-grid aside p,
  .prompt-title {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0;
    font-size: 0.78rem;
    margin: 0 0 1rem;
  }

  .pill {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.8rem;
    padding: 0.85rem;
    color: var(--muted);
    margin-top: 0.65rem;
  }

  .pill.active {
    color: var(--text);
    border-color: var(--purple);
    background: rgba(143, 82, 255, 0.16);
  }

  .workspace-grid main {
    display: grid;
    align-content: center;
    padding: clamp(1.5rem, 4vw, 4rem);
  }

  .prompt-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 7rem;
    border-radius: 1.35rem;
    padding: 1.4rem;
    background: #0a0a0d;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--muted);
    font-size: 1.12rem;
  }

  .prompt-box strong {
    color: var(--purple-2);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.45rem 0.7rem;
  }

  .timeline {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .timeline span {
    border-radius: 999px;
    padding: 0.65rem 0.75rem;
    background: rgba(143, 82, 255, 0.13);
    color: var(--purple-2);
    text-align: center;
    font-size: 0.82rem;
  }

  .footer {
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    flex-wrap: wrap;
  }

  .footer span:first-child {
    color: var(--text);
    font-weight: 700;
  }

  @media (max-width: 56rem) {
    h1 {
      font-size: 3rem !important;
    }

    h2 {
      font-size: 2rem !important;
    }

    .features {
      grid-template-columns: 1fr;
    }

    .install,
    .workspace-grid {
      grid-template-columns: 1fr;
      flex-direction: column;
      align-items: flex-start;
    }

    .workspace-grid aside {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .timeline {
      grid-template-columns: 1fr 1fr;
    }

    .inline-downloads {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 36rem) {
    h1 {
      font-size: 2.35rem !important;
    }

    .lede {
      font-size: 1rem;
    }

    .nav {
      align-items: flex-start;
      flex-direction: column;
    }

    .timeline {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  :root[data-has-hero] {
    header.header {
      display: none;
    }

    .main-frame {
      padding-top: 0;

      .main-pane > main {
        padding: 0;
      }
    }

    main > .content-panel .sl-markdown-content {
      margin-top: 0;
    }
  }
</style>
