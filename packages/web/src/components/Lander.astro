---
import { ArrowRight, ChevronDown, Download } from "lucide-react"
import MarketingFooter from "./marketing/MarketingFooter.astro"
import MarketingNav from "./marketing/MarketingNav.astro"
import screenshotAgent from "../assets/lander/vector-agent-current.png"
import screenshotAgents from "../assets/lander/vector-workspaces-current.png"
import screenshotBrowser from "../assets/lander/vector-browser-current.png"
import screenshotCloud from "../assets/lander/vector-cloud-current.png"
import screenshotEditor from "../assets/lander/vector-editor-current.png"

const runtimes = ["Vector", "Claude Code", "Codex", "Cursor Agent"]

const chapters = [
  {
    eyebrow: "Parallel workspaces",
    title: "Give every responsibility its own agent.",
    copy: "Launch up to 16 isolated workspaces from one repository. Each agent gets its own branch, files, terminal, conversation, model, and checks, so frontend, backend, testing, and deployment can move at the same time without touching main.",
    facts: ["Isolated git worktrees", "Live status and token activity", "Review, merge, continue, or discard"],
    image: screenshotAgents,
    alt: "Vector showing multiple isolated agent workspaces for the same repository",
  },
  {
    eyebrow: "Controlled browser",
    title: "The browser is part of the engineering loop.",
    copy: "Vector can open the running product, navigate it, interact with forms, inspect page state, read console and network failures, capture evidence, repair the code, and test the result again. You can take over at any time.",
    facts: ["Visible browser session", "DOM, console, and network evidence", "Approval gates for sensitive actions"],
    image: screenshotBrowser,
    alt: "Vector controlled browser beside an active engineering session",
  },
  {
    eyebrow: "Codespace and Canvas",
    title: "Code yourself. Delegate beside it.",
    copy: "Open a real project editor with search, diagnostics, terminal access, inline assistance, and a resizable editor agent. Canvas lets you arrange the editor, browser, terminal, notes, and cloud controls into one multitasking surface.",
    facts: ["Syntax-aware code editing", "Project search and diagnostics", "Resizable tools on one canvas"],
    image: screenshotEditor,
    alt: "Vector Codespace with project files, editor, and the integrated editor agent",
  },
  {
    eyebrow: "Vector Cloud",
    title: "Ship without losing the context that built it.",
    copy: "Connect hosting, source control, and data services from the project that produced the build. Publish through your own accounts, manage environment variables, inspect releases and logs, and hand the live result back to the browser for verification.",
    facts: ["Vercel and Netlify publishing", "GitHub, GitLab, and Supabase connections", "Domains, logs, health, and environment variables"],
    image: screenshotCloud,
    alt: "Vector Cloud showing deployment, infrastructure, and project health",
  },
]

const systemRows = [
  ["Context engine", "Indexes symbols, dependencies, references, and likely impact so the model receives the code that matters instead of an indiscriminate repository dump."],
  ["Persistent memory", "Keeps repository conventions, accepted decisions, and corrections attached to the project across sessions."],
  ["Execution controls", "Quick, normal, fast, and effort settings let the user trade latency and token depth without changing the workflow."],
  ["Trust boundary", "Diffs, checks, secret scanning, checkpoints, risk signals, and approvals stand between agent output and main."],
  ["Transparent economics", "Input, output, reasoning, cache, context, model, and recorded cost remain visible per session and workspace."],
]

const comparison = [
  ["Existing local repositories", "Native", "Native", "Native", "Native", "Git import"],
  ["Editor and terminal", "Both built in", "Terminal-first", "Agent workspace", "IDE-native", "Managed editor"],
  ["Parallel isolated agents", "Up to 16", "Subagents", "Worktrees", "Background agents", "Not core"],
  ["Visible browser loop", "Built in", "Via tools", "Browser + CDP", "Via tools", "Preview-centric"],
  ["Review before merge", "Diff + checks + risk", "Git workflow", "Diff + worktrees", "Diff + merge", "History/Git"],
  ["Provider choice", "Multi-provider BYOK", "Claude", "OpenAI", "Multiple models", "Platform managed"],
  ["Publishing surface", "Vercel + Netlify", "Via tools", "Via skills", "Via MCP", "Native hosting"],
]
---

<div class="vector-marketing">
  <canvas class="ascii-field site-field" data-vector-field aria-hidden="true"></canvas>
  <MarketingNav active="product" />

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-shade" aria-hidden="true"></div>

      <div class="hero-inner">
        <div class="hero-copy reveal is-visible">
          <img class="hero-logo" src="/vector-logo.png" width="56" height="56" alt="Vector" />
          <p class="hero-name">Vector</p>
          <h1 id="hero-title">Build, test, and ship with a team of agents.</h1>
          <a class="hero-cta" href="/download">
            <span>Get Vector</span>
            <ArrowRight size={17} strokeWidth={1.8} aria-hidden="true" />
          </a>
          <p class="hero-note">Local repositories. Your models. Every change reviewable.</p>
        </div>

        <figure class="hero-product reveal is-visible">
          <div class="product-bar" aria-hidden="true">
            <span class="traffic"><i></i><i></i><i></i></span>
            <span class="product-title">Vector engineering workspace</span>
            <span class="product-status"><i></i> Ready</span>
          </div>
          <img
            src={screenshotAgent.src}
            width={screenshotAgent.width}
            height={screenshotAgent.height}
            alt="Vector engineering a product inside a repository"
            loading="eager"
          />
        </figure>
      </div>
    </section>

    <section class="runtime-band" aria-labelledby="runtime-title">
      <p id="runtime-title">One workspace for the agents and tools you already use</p>
      <div class="runtime-list">
        {runtimes.map((runtime) => <span>{runtime}</span>)}
      </div>
    </section>

    <section id="workspace" class="intro chapter-width">
      <div class="intro-copy reveal">
        <p class="eyebrow">The complete engineering loop</p>
        <h2>From an idea to reviewed, running software.</h2>
        <p>
          Vector keeps the request, repository context, agent activity, files, terminal, browser,
          usage, review, and release in one place. Open an existing codebase or begin a new one,
          then choose how much of the work you want to do yourself.
        </p>
      </div>
      <ol class="loop-list reveal" aria-label="Vector engineering workflow">
        <li><span>01</span><strong>Open</strong><p>Attach the repository already on your computer.</p></li>
        <li><span>02</span><strong>Direct</strong><p>Give one agent a task or divide the work across isolated agents.</p></li>
        <li><span>03</span><strong>Observe</strong><p>Follow plans, edits, commands, browser actions, tokens, and cost.</p></li>
        <li><span>04</span><strong>Verify</strong><p>Run checks, inspect the product, and review every changed line.</p></li>
        <li><span>05</span><strong>Ship</strong><p>Merge trusted work and publish through your connected accounts.</p></li>
      </ol>
    </section>

    <div class="chapter-stack">
      {chapters.map((chapter, index) => (
        <section class="chapter chapter-width">
          <div class="chapter-copy reveal">
            <div>
              <p class="eyebrow">{chapter.eyebrow}</p>
              <h2>{chapter.title}</h2>
            </div>
            <div>
              <p>{chapter.copy}</p>
              <ul>
                {chapter.facts.map((fact) => <li><span aria-hidden="true"></span>{fact}</li>)}
              </ul>
            </div>
          </div>
          <figure class:list={["chapter-media", "reveal", { "media-browser": index === 1 }]}>
            <div class="media-topline" aria-hidden="true">
              <span>{chapter.eyebrow}</span>
              <span>{index === 0 ? "Isolated from main" : index === 1 ? "User takeover available" : index === 2 ? "Local workspace" : "Connected release"}</span>
            </div>
            <img
              src={chapter.image.src}
              width={chapter.image.width}
              height={chapter.image.height}
              alt={chapter.alt}
              loading="lazy"
            />
          </figure>
        </section>
      ))}
    </div>

    <section class="engine-section">
      <div class="engine-inner chapter-width">
        <div class="engine-heading reveal">
          <p class="eyebrow">The system underneath</p>
          <h2>Powerful agents need an observable runtime.</h2>
          <p>
            Vector is designed around the parts that determine whether agentic engineering is useful:
            relevant context, persistent knowledge, reliable execution, visible cost, and a human review boundary.
          </p>
        </div>
        <div class="engine-list">
          {systemRows.map(([title, copy], index) => (
            <article class="engine-row reveal">
              <span>0{index + 1}</span>
              <h3>{title}</h3>
              <p>{copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="evidence chapter-width">
      <div class="evidence-heading reveal">
        <p class="eyebrow">Measured, not implied</p>
        <h2>One controlled repair task. A useful data point.</h2>
        <p>
          In a July 2026 scheduler-repair benchmark, Vector Balanced completed the task in 149 seconds
          and reported roughly 67% fewer tokens than Codex CLI. Both passed all five public tests.
          Codex passed more hidden tests, so this is evidence from one reproducible run, not a universal claim.
        </p>
      </div>
      <dl class="evidence-grid reveal">
        <div><dt>Vector Balanced</dt><dd>149s</dd><span>Completion time</span></div>
        <div><dt>Codex CLI</dt><dd>284s</dd><span>Completion time</span></div>
        <div><dt>Reported usage</dt><dd>67%</dd><span>Fewer tokens for Vector</span></div>
        <div><dt>Public checks</dt><dd>5 / 5</dd><span>Passed by both</span></div>
      </dl>
    </section>

    <section class="connections chapter-width">
      <div class="connections-copy reveal">
        <p class="eyebrow">Bring your stack</p>
        <h2>Models, protocols, source control, and cloud services.</h2>
        <p>
          Use Vector’s provider system, connect MCP servers, call local Claude Code, Codex, and Cursor
          runtimes when installed, then publish through GitHub, GitLab, Vercel, Netlify, and Supabase workflows.
        </p>
      </div>
      <div class="connection-rail reveal" aria-label="Supported Vector connections">
        <span>Anthropic</span><span>OpenAI</span><span>Google</span><span>MCP</span><span>GitHub</span>
        <span>GitLab</span><span>Vercel</span><span>Netlify</span><span>Supabase</span><span>Playwright</span>
      </div>
    </section>

    <section class="comparison-section chapter-width">
      <div class="comparison-heading reveal">
        <p class="eyebrow">A wider product boundary</p>
        <h2>Fewer disconnected surfaces between request and release.</h2>
        <p>
          Vector combines capabilities commonly split across an agent, editor, browser, Git client,
          and deployment dashboard. Product capabilities change quickly, so verify current vendor
          documentation before making a purchasing decision.
        </p>
      </div>
      <details class="comparison reveal">
        <summary>
          <span>View the detailed product comparison</span>
          <ChevronDown size={18} strokeWidth={1.7} aria-hidden="true" />
        </summary>
        <div class="comparison-scroll">
          <table>
            <thead>
              <tr><th>Capability</th><th>Vector</th><th>Claude Code</th><th>Codex</th><th>Cursor</th><th>App builders</th></tr>
            </thead>
            <tbody>
              {comparison.map((row) => (
                <tr>{row.map((cell, cellIndex) => cellIndex === 0 ? <th>{cell}</th> : <td>{cell}</td>)}</tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </section>

    <section class="closing">
      <div class="closing-copy reveal">
        <img src="/vector-logo.png" width="56" height="56" alt="" />
        <h2>Keep the whole build in view.</h2>
        <p>Open the repository. Direct the agents. Inspect the evidence. Ship the result.</p>
        <a class="closing-cta" href="/download">
          <Download size={17} strokeWidth={1.8} aria-hidden="true" />
          <span>Download Vector</span>
        </a>
      </div>
    </section>
  </main>

  <MarketingFooter />
</div>

<script>
  const reducedMotion = globalThis.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false

  const revealNodes = () => {
    if (reducedMotion || !("IntersectionObserver" in globalThis)) return
    const nodes = Array.from(document.querySelectorAll<HTMLElement>(".reveal:not(.is-visible)"))
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return
        const node = entry.target as HTMLElement
        node.classList.add("is-visible")
        node.animate(
          [{ opacity: 0, transform: "translateY(16px)" }, { opacity: 1, transform: "translateY(0)" }],
          { duration: 460, easing: "cubic-bezier(.2,.7,.2,1)" },
        )
        observer.unobserve(node)
      })
    }, { rootMargin: "0px 0px -7%", threshold: 0.08 })
    nodes.forEach((node) => observer.observe(node))
  }

  const drawField = (canvas: HTMLCanvasElement) => {
    const context = canvas.getContext("2d")
    if (!context) return
    const lowDensity = canvas.dataset.density === "low"
    let width = 1
    let height = 1
    let dpr = 1
    let pointerX = 0.5
    let pointerY = 0.4
    let pointerActive = false
    const glyphs = "VECTOR01{}<>/\\+=:*"
    const clusters = lowDensity
      ? [
          [0.14, 0.34, 0.24, 0.18, 1],
          [0.78, 0.28, 0.3, 0.2, 1],
          [0.86, 0.73, 0.25, 0.14, 0.75],
        ]
      : [
          [0.04, 0.3, 0.14, 0.13, 0.9],
          [0.16, 0.38, 0.23, 0.16, 1.05],
          [0.27, 0.46, 0.16, 0.1, 0.72],
          [0.7, 0.22, 0.24, 0.13, 0.92],
          [0.82, 0.31, 0.27, 0.18, 1.12],
          [0.96, 0.45, 0.18, 0.15, 0.82],
          [0.08, 0.75, 0.22, 0.12, 0.64],
          [0.84, 0.77, 0.3, 0.13, 0.7],
        ]
    const stars = Array.from({ length: lowDensity ? 28 : 52 }, (_, index) => ({
      x: ((index * 193 + 41) % 997) / 997,
      y: ((index * 347 + 73) % 991) / 991,
      size: index % 11 === 0 ? 3 : index % 5 === 0 ? 2 : 1,
      alpha: 0.28 + ((index * 29) % 57) / 100,
    }))

    const hash = (x: number, y: number, seed = 0) => {
      const value = Math.sin(x * 12.9898 + y * 78.233 + seed * 37.719) * 43758.5453
      return value - Math.floor(value)
    }

    const render = () => {
      context.clearRect(0, 0, width, height)
      const stepX = lowDensity ? 10 : 8
      const stepY = lowDensity ? 11 : 9
      context.font = `${lowDensity ? 8 : 7.5}px ui-monospace, SFMono-Regular, Menlo, monospace`
      context.textAlign = "center"
      context.textBaseline = "middle"

      if (pointerActive && !reducedMotion) {
        context.save()
        context.filter = "blur(54px)"
        context.fillStyle = "rgba(123, 81, 210, 0.1)"
        context.beginPath()
        context.arc(pointerX * width, pointerY * height, Math.min(width, height) * 0.085, 0, Math.PI * 2)
        context.fill()
        context.restore()
      }

      for (let y = -stepY; y < height + stepY; y += stepY) {
        for (let x = -stepX; x < width + stepX; x += stepX) {
          const normalizedX = x / Math.max(1, width)
          const normalizedY = y / Math.max(1, height)
          const warpX = normalizedX + Math.sin(normalizedY * 19) * 0.018
          const warpY = normalizedY + Math.sin(normalizedX * 15) * 0.014
          let field = 0

          clusters.forEach(([centerX, centerY, radiusX, radiusY, strength], index) => {
            const dx = (warpX - centerX) / radiusX
            const dy = (warpY - centerY) / radiusY
            const shape = Math.exp(-(dx * dx + dy * dy) * (1.18 + (index % 3) * 0.1)) * strength
            field = Math.max(field, shape)
          })

          const texture = hash(x / stepX, y / stepY) * 0.34
            + Math.sin(normalizedX * 46 + normalizedY * 29) * 0.08
          if (field + texture < 0.52) continue

          const safeCopyZone = Math.exp(
            -(
              Math.pow((normalizedX - 0.5) / 0.23, 2)
              + Math.pow((normalizedY - 0.28) / 0.22, 2)
            ),
          )
          const edge = Math.min(1, Math.max(0, (field + texture - 0.48) * 1.8))
          const alpha = Math.max(0.1, (0.16 + edge * 0.42) * (1 - safeCopyZone * 0.66))
          const glyphIndex = Math.floor(hash(x, y, 2) * glyphs.length)
          const drawX = x + (pointerX - 0.5) * (2 + hash(x, y, 3) * 5)
          const drawY = y + (pointerY - 0.5) * (2 + hash(x, y, 4) * 4)
          context.fillStyle = `rgba(190, 166, 255, ${alpha})`
          context.fillText(glyphs[glyphIndex], drawX, drawY)
        }
      }

      stars.forEach((star, index) => {
        const x = star.x * width + (pointerX - 0.5) * (index % 7)
        const y = star.y * height + (pointerY - 0.5) * (index % 5)
        context.fillStyle = `rgba(247, 243, 255, ${star.alpha})`
        context.fillRect(x, y, star.size, star.size)
        if (star.size < 3) return
        context.fillRect(x - 5, y + 1, 13, 1)
        context.fillRect(x + 1, y - 5, 1, 13)
      })
    }

    const resize = () => {
      const rect = canvas.getBoundingClientRect()
      dpr = Math.min(globalThis.devicePixelRatio || 1, 2)
      width = Math.max(1, rect.width)
      height = Math.max(1, rect.height)
      canvas.width = Math.round(width * dpr)
      canvas.height = Math.round(height * dpr)
      context.setTransform(dpr, 0, 0, dpr, 0, 0)
      render()
    }

    const move = (event: PointerEvent) => {
      const rect = canvas.getBoundingClientRect()
      pointerX = (event.clientX - rect.left) / Math.max(1, rect.width)
      pointerY = (event.clientY - rect.top) / Math.max(1, rect.height)
      pointerActive = true
      render()
    }

    const resizeObserver = new ResizeObserver(resize)
    resizeObserver.observe(canvas)
    globalThis.addEventListener("pointermove", move, { passive: true })
    resize()

    return () => {
      resizeObserver.disconnect()
      globalThis.removeEventListener("pointermove", move)
    }
  }

  const cleanups = Array.from(document.querySelectorAll<HTMLCanvasElement>("[data-vector-field]"))
    .map(drawField)
    .filter(Boolean)
  revealNodes()
  document.addEventListener("astro:before-swap", () => cleanups.forEach((cleanup) => cleanup?.()), { once: true })
</script>

<style>
  .vector-marketing {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    overflow: clip;
    color: #f5f2f8;
    background: #050406;
  }

  .vector-marketing > main {
    position: relative;
    z-index: 1;
  }

  .chapter-width {
    width: min(1080px, calc(100% - 48px));
    margin-inline: auto;
  }

  .hero {
    position: relative;
    min-height: 0;
    padding-bottom: 72px;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid #2a252e;
    background: rgba(5, 4, 6, 0.08);
  }

  .ascii-field {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.96;
    transform: scale(1.01);
    animation: vector-field-breathe 12s ease-in-out infinite alternate;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(5, 4, 6, 0.1);
    box-shadow: inset 0 54px 72px rgba(5, 4, 6, 0.9);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    width: min(1280px, calc(100% - 48px));
    margin-inline: auto;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    width: min(680px, 100%);
    padding-top: 92px;
    margin-left: 30%;
  }

  .hero-logo {
    display: block;
    width: 56px;
    height: 56px;
    border-radius: 12px;
    box-shadow: 0 18px 54px rgba(151, 112, 255, 0.24);
  }

  .hero-name {
    margin: 14px 0 0;
    color: #c8b6ff;
    font-size: 13px;
    font-weight: 600;
  }

  .hero h1 {
    margin: 18px 0 0;
    color: #fff;
    font-size: clamp(42px, 3.8vw, 54px);
    font-weight: 610;
    line-height: 1.02;
    letter-spacing: 0;
  }

  .hero-cta,
  .closing-cta {
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    color: #120d17 !important;
    background: #eee9f5;
    border: 1px solid #eee9f5;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 590;
    text-decoration: none;
    transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
  }

  .hero-cta {
    width: min(360px, 100%);
    margin-top: 30px;
    padding: 0 16px;
  }

  .hero-cta:hover,
  .closing-cta:hover {
    color: #120d17 !important;
    background: #c9b9ff;
    border-color: #c9b9ff;
    transform: translateY(-1px);
  }

  .hero-note {
    margin: 14px 0 0;
    color: #918a96;
    font-size: 13px;
  }

  .hero-product {
    position: relative;
    z-index: 1;
    margin: 76px 0 0;
    overflow: hidden;
    border: 1px solid #403746;
    border-radius: 8px 8px 0 0;
    background: #121015;
    box-shadow: 0 44px 130px rgba(0, 0, 0, 0.72), 0 0 70px rgba(132, 86, 219, 0.1);
  }

  .product-bar,
  .media-topline {
    min-height: 42px;
    padding: 0 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: #847d89;
    background: #17141a;
    border-bottom: 1px solid #302b34;
    font-size: 11px;
  }

  .traffic { display: inline-flex; gap: 6px; }
  .traffic i { width: 8px; height: 8px; border-radius: 50%; background: #5a535e; }
  .traffic i:first-child { background: #b46579; }
  .traffic i:nth-child(2) { background: #b58e55; }
  .traffic i:nth-child(3) { background: #5d9b79; }
  .product-title { color: #b9b2be; }
  .product-status { display: inline-flex; align-items: center; gap: 7px; }
  .product-status i { width: 6px; height: 6px; border-radius: 50%; background: #70ca9a; box-shadow: 0 0 10px rgba(112, 202, 154, 0.45); }
  .hero-product img { display: block; width: 100%; height: auto; }

  .runtime-band {
    width: min(980px, calc(100% - 48px));
    min-height: 178px;
    margin-inline: auto;
    padding: 50px 0 44px;
    display: grid;
    place-items: center;
    border-bottom: 1px solid #2a252e;
  }

  .runtime-band p {
    margin: 0;
    color: #77707d;
    font-size: 12px;
  }

  .runtime-list {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 18px 34px;
  }

  .runtime-list span {
    color: #c4bdc8;
    font-size: 15px;
    font-weight: 550;
  }

  .intro {
    padding: 124px 0 96px;
  }

  .intro-copy {
    max-width: 780px;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: #ae91ff;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    color: #f7f4fa;
    font-size: clamp(34px, 4.4vw, 58px);
    font-weight: 570;
    line-height: 1.04;
    letter-spacing: 0;
  }

  .intro-copy > p:last-child,
  .engine-heading > p:last-child,
  .evidence-heading > p:last-child,
  .connections-copy > p:last-child,
  .comparison-heading > p:last-child {
    max-width: 700px;
    margin: 24px 0 0;
    color: #96909b;
    font-size: 17px;
    line-height: 1.7;
  }

