      transform: translateY(calc(var(--t-exit) * -52px)) scale(calc(1 - var(--t-exit) * 0.04));
      filter: blur(calc(var(--t-exit) * 10px));
    }

    :global(html.va) .scene-hero .showcase {
      width: min(1150px, calc(100vw - 48px));
      padding-top: 0;
      opacity: min(1, calc(var(--t-window) * 2.4));
      transform: translateY(calc((1 - var(--t-window)) * 84vh)) scale(calc(0.94 + var(--t-window) * 0.06));
      will-change: transform;
    }

    /* Suite: the four command-center cards deal in one at a time. */
    :global(html.va) .scene-suite .suite {
      margin-top: 0;
      --t-head: clamp(0, var(--p, 0) / 0.16, 1);
    }

    :global(html.va) .scene-suite .chapter-head {
