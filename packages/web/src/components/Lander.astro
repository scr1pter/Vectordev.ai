---
import { ArrowRight, Bot, ChevronDown, Cloud, CloudUpload, Code2, Globe2, Laptop2 } from "lucide-react"
import MarketingFooter from "./marketing/MarketingFooter.astro"
import MarketingNav from "./marketing/MarketingNav.astro"
import screenshotAgent from "../assets/lander/vector-agent-current.png"
import screenshotAgents from "../assets/lander/vector-workspaces-current.png"
import screenshotBrowser from "../assets/lander/vector-browser-current.png"
import screenshotCloud from "../assets/lander/vector-cloud-current.png"
import screenshotEditor from "../assets/lander/vector-editor-current.png"

const pixelFont: Record<string, string[]> = {
  V: ["10001", "10001", "10001", "10001", "10001", "01010", "00100"],
  E: ["11111", "10000", "10000", "11110", "10000", "10000", "11111"],
  C: ["01111", "10000", "10000", "10000", "10000", "10000", "01111"],
  T: ["11111", "00100", "00100", "00100", "00100", "00100", "00100"],
  O: ["01110", "10001", "10001", "10001", "10001", "10001", "01110"],
  R: ["11110", "10001", "10001", "11110", "10100", "10010", "10001"],
}

const wordmarkCells = "VECTOR".split("").flatMap((letter, letterIndex) =>
  pixelFont[letter].flatMap((row, y) =>
    row.split("").flatMap((cell, x) => (cell === "1" ? [{ x: letterIndex * 7 + x, y }] : [])),
  ),
)

const ecosystem = [
  "Claude Code",
  "Codex",
  "Cursor Agent",
  "Anthropic",
  "OpenAI",
  "Google",
  "MCP",
  "GitHub",
  "GitLab",
  "Vercel",
  "Netlify",
  "Supabase",
  "Playwright",
  "Vel",
]

const features = [
  {
    title: "Ask for an outcome. Keep the engineering in view.",
    body: "Vector reads the active repository, plans the work, edits real files, runs commands, and reports a reviewable result in one session. Context, tool activity, token use, checkpoints, and changed files stay attached to that repository.",
    tag: "Vector Agent",
    note: "Repository-native",
    image: screenshotAgent,
    alt: "Vector Agent working inside a local software repository",
    href: "/docs#vector-agent",
    link: "Run your first session",
  },
  {
    title: "Give every responsibility its own agent.",
    body: "Launch up to 16 isolated workspaces from one repository. Each agent gets its own branch, files, terminal, conversation, model, and checks, so frontend, backend, testing, and deployment move at the same time without touching main.",
    tag: "Parallel workspaces",
    note: "Isolated from main",
    image: screenshotAgents,
    alt: "Vector showing multiple isolated agent workspaces for the same repository",
    href: "/docs",
    link: "Learn about workspaces",
  },
  {
    title: "The browser is part of the engineering loop.",
    body: "Vector opens the running product, navigates it, reads console and network failures, captures evidence, repairs the code, and tests the result again. You can take over at any time.",
    tag: "Controlled browser",
    note: "User takeover available",
    image: screenshotBrowser,
    alt: "Vector controlled browser beside an active engineering session",
    href: "/docs",
    link: "See the browser loop",
  },
  {
    title: "Code yourself. Delegate beside it.",
    body: "A real project editor with search, diagnostics, terminal access, and a resizable editor agent. Canvas arranges the editor, browser, terminal, notes, and cloud controls into one surface.",
    tag: "Codespace and Canvas",
    note: "Local workspace",
    image: screenshotEditor,
    alt: "Vector Codespace with project files, editor, and the integrated editor agent",
    href: "/docs",
    link: "Explore the Codespace",
  },
  {
    title: "Ship without losing the context that built it.",
    body: "Publish through your own Vercel, Netlify, GitHub, GitLab, and Supabase accounts. Manage environment variables, inspect releases and logs, and hand the live result back to the browser for verification.",
    tag: "Cloud Services",
    note: "Connected release",
    image: screenshotCloud,
    alt: "Vector Cloud Services showing deployment, infrastructure, and repository health",
    href: "/docs",
    link: "Read about Cloud Services",
  },
]

const workflow = [
  ["Open", "Attach the repository already on your computer."],
  ["Direct", "Give one agent a task or divide work across isolated agents."],
  ["Observe", "Follow plans, edits, commands, browser actions, tokens, and cost."],
  ["Verify", "Run checks, inspect the product, and review every changed line."],
  ["Ship", "Merge trusted work and publish through your connected accounts."],
]

const systemRows = [
  ["Context engine", "Indexes symbols, dependencies, references, and likely impact so each model receives the code that matters instead of an indiscriminate repository dump."],
  ["Persistent project memory", "Keeps repository conventions, accepted decisions, and corrections attached to the project across sessions."],
  ["Execution controls", "Quick, normal, and fast modes plus effort settings let you trade latency and token depth without changing the workflow."],
  ["Trust boundary", "Diffs, checks, secret scanning, checkpoints, risk signals, and approvals stand between agent output and main."],
  ["Transparent economics", "Input, output, reasoning, cache, context, model, and recorded cost stay visible per session and workspace."],
]

const connectionGroups = [
  ["Models", "Anthropic, OpenAI, Google, and other BYOK providers"],
  ["Agent runtimes", "Local Claude Code, Codex, and Cursor tools when installed"],
  ["Protocols and source", "MCP servers, GitHub, and GitLab"],
  ["Cloud and validation", "Vercel, Netlify, Supabase, and Playwright"],
]

const products = [
  {
    name: "Vector Agent",
    eyebrow: "Plan, edit, run, verify",
    body: "Give Vector a repository-level outcome and follow the plan, file edits, commands, checks, browser evidence, and final summary from one session.",
    icon: Bot,
  },
  {
    name: "Parallel workspaces",
    eyebrow: "Up to 16 isolated agents",
    body: "Split independent responsibilities across Git worktrees, keep unfinished changes away from main, then inspect checks and merge only the work you trust.",
    icon: Laptop2,
  },
  {
    name: "Controlled browser",
    eyebrow: "Observe, interact, retest",
    body: "Let the active agent inspect a running app, navigate, capture errors and screenshots, repair the code, and verify the result without losing session context.",
    icon: Globe2,
  },
  {
    name: "Codespace and Canvas",
    eyebrow: "Code directly or delegate",
    body: "Use the editor, project search, diagnostics, terminal, notes, browser, and editor agent together when you want hands-on control beside autonomous work.",
    icon: Code2,
  },
  {
    name: "Vector Cloud Services",
    eyebrow: "Connected infrastructure · available",
    body: "Deployments, databases, authentication, storage, environment variables, domains, logs, and infrastructure controls stay connected to the project that needs them.",
    icon: Cloud,
  },
]

const comparison = [
  ["Existing local repositories", "Native", "Native", "Native", "Native", "Git import"],
  ["Editor and terminal", "Both built in", "Terminal-first", "Agent workspace", "IDE-native", "Managed editor"],
  ["Parallel isolated agents", "Up to 16", "Subagents", "Worktrees", "Background agents", "Not core"],
  ["Visible browser loop", "Built in", "Via tools", "Browser + CDP", "Via tools", "Preview-centric"],
  ["Review before merge", "Diff + checks + risk", "Git workflow", "Diff + worktrees", "Diff + merge", "History / Git"],
  ["Provider choice", "Multi-provider BYOK", "Claude", "OpenAI", "Multiple models", "Platform managed"],
  ["Publishing surface", "Vercel + Netlify", "Via tools", "Via skills", "Via MCP", "Native hosting"],
]

const changelog = [
  ["July 2026", "Vector desktop release and download refresh", "Signed installers for macOS, Windows, and Linux, served from the new download pipeline with automatic updates."],
  ["July 2026", "Review tools and shell polish", "A refined review panel, window recovery fixes, and a cleaner desktop chrome across the workspace."],
  ["July 2026", "Models and settings controls", "Restored provider management, model pickers, and execution settings throughout the rebuilt shell."],
]
---

<div class="vector-marketing">
  <canvas class="ascii-field" data-vector-field aria-hidden="true"></canvas>
  <MarketingNav active="product" />

  <main>
    <section class="scene scene-hero" data-scene style="--scene-span: 2.3" aria-labelledby="hero-title">
      <div class="scene-stage">
        <div class="sky" aria-hidden="true">
          <i class="sky-aurora"></i>
          <i class="sky-stars"></i>
        </div>
        <div class="hero">
          <h1 class="wordmark" id="hero-title">
            <span class="sr-only">Vector</span>
            <svg
              viewBox={`0 0 ${6 * 7 - 2} 7`}
              width="252"
              height="42"
              fill="currentColor"
              shape-rendering="crispEdges"
              aria-hidden="true"
            >
              {wordmarkCells.map((cell) => <rect x={cell.x} y={cell.y} width="0.92" height="0.92" />)}
            </svg>
          </h1>

          <p class="headline">
            <span>Build software with agents you can inspect.</span>
            <span class="scramble" data-scramble aria-hidden="true">Open the repo. Direct the work. Ship with evidence.</span>
            <span class="sr-only">Vector brings agents, code, terminal, browser testing, review, and cloud delivery into one local-first workspace.</span>
          </p>

          <div class="hero-loop" aria-label="Vector's build, test, and ship workflow">
            <div class="hero-loop-progress" aria-hidden="true"><i data-hero-progress></i></div>
            <div class="hero-loop-stage is-active" data-hero-stage="0">
              <span class="hero-loop-icon"><Bot size={16} strokeWidth={1.8} aria-hidden="true" /></span>
              <span><strong>Direct</strong><small>The outcome</small></span>
            </div>
            <div class="hero-loop-stage" data-hero-stage="1">
              <span class="hero-loop-icon"><Globe2 size={16} strokeWidth={1.8} aria-hidden="true" /></span>
              <span><strong>Execute</strong><small>Files and commands</small></span>
            </div>
            <div class="hero-loop-stage" data-hero-stage="2">
              <span class="hero-loop-icon"><CloudUpload size={16} strokeWidth={1.8} aria-hidden="true" /></span>
              <span><strong>Verify</strong><small>Review and browser</small></span>
            </div>
          </div>

          <a class="hero-cta" href="/download">
            <span>Get Vector</span>
            <ArrowRight size={18} strokeWidth={2} aria-hidden="true" />
          </a>

          <p class="hero-note">Local-first. Bring your own models. Available for macOS, Windows, and Linux.</p>
        </div>

        <div class="showcase" aria-label="Vector workspace screenshot">
          <figure class="product-window">
            <div class="product-bar" aria-hidden="true">
              <span class="traffic"><i></i><i></i><i></i></span>
              <span class="product-title">Vector — Agent workspace</span>
              <span class="product-status"><i></i> Ready</span>
            </div>
            <img
              data-parallax
              src={screenshotAgent.src}
              width={screenshotAgent.width}
              height={screenshotAgent.height}
              alt="Vector Agent working with a local repository"
              loading="eager"
            />
          </figure>
        </div>
      </div>
    </section>

    <section class="product-system section-width" aria-labelledby="product-system-title">
      <div class="section-heading chapter-head" data-reveal>
        <p class="section-kicker">One engineering workspace</p>
        <h2 id="product-system-title">Delegate broadly. Inspect precisely.</h2>
        <p>
          Vector keeps autonomous work and hands-on engineering in the same local workspace: agent sessions,
          isolated worktrees, editor, terminal, controlled browser, review, and cloud delivery.
        </p>
      </div>
      <div class="product-system-grid">
        {products.map((product) => {
          const Icon = product.icon
          return (
            <article data-reveal>
              <span class="product-system-icon"><Icon size={18} strokeWidth={1.7} aria-hidden="true" /></span>
              <small>{product.eyebrow}</small>
              <h3>{product.name}</h3>
              <p>{product.body}</p>
            </article>
          )
        })}
      </div>
      <a class="product-system-account" href="/download" data-reveal>
        Choose monthly or annual access and download Vector for your platform <ArrowRight size={15} strokeWidth={2} aria-hidden="true" />
      </a>
    </section>

    <section class="scene scene-suite" data-scene style="--scene-span: 3.1" aria-labelledby="suite-title">
      <div class="scene-stage">
        <div class="suite section-width">
          <div class="section-heading chapter-head">
            <p class="section-kicker">One Vector</p>
            <h2 id="suite-title">One place to direct, build, test, and ship.</h2>
            <p>Use one focused agent or coordinate independent workspaces while the repository, tools, evidence, and release destination remain connected.</p>
          </div>
          <div class="suite-grid">
            <article style="--i: 0">
              <span class="suite-icon"><Bot size={19} strokeWidth={1.7} aria-hidden="true" /></span>
              <small>Repository intelligence</small>
              <h3>Work from context</h3>
              <p>Vector selects relevant files and symbols, remembers project decisions, and keeps each session grounded in the repository it belongs to.</p>
            </article>
            <article style="--i: 1">
              <span class="suite-icon"><Globe2 size={19} strokeWidth={1.7} aria-hidden="true" /></span>
              <small>Execution you can observe</small>
              <h3>Terminal and browser actions</h3>
              <p>The agent can run commands, inspect the app in a controlled browser, collect failures, and retest while activity remains visible and interruptible.</p>
            </article>
            <article style="--i: 2">
              <span class="suite-icon"><CloudUpload size={19} strokeWidth={1.7} aria-hidden="true" /></span>
              <small>Human control</small>
              <h3>Review before main</h3>
              <p>Inspect diffs, checks, risk signals, and checkpoints before isolated agent work reaches the primary repository files.</p>
            </article>
            <article style="--i: 3">
              <span class="suite-icon"><CloudUpload size={19} strokeWidth={1.7} aria-hidden="true" /></span>
              <small>Connect and ship</small>
              <h3>MCP, providers, and Cloud</h3>
              <p>Bring your own model provider, connect approved tools through MCP, and publish through the infrastructure accounts that already belong to you.</p>
            </article>
          </div>
          <div class="scene-rail" aria-hidden="true"><i></i></div>
        </div>
      </div>
    </section>

    <section class="belt" aria-label="Agents, models, and services Vector works with">
      <p>Free and BYOK — bring the agents, models, and services you already use</p>
      <div class="marquee">
        <div class="marquee-track" aria-hidden="true">
          {[...ecosystem, ...ecosystem].map((name) => <span>{name}</span>)}
        </div>
        <ul class="marquee-static">
          {ecosystem.map((name) => <li>{name}</li>)}
        </ul>
      </div>
    </section>

    <section class="scene scene-workflow" data-scene style="--scene-span: 2.8" aria-labelledby="workflow-title">
      <div class="scene-stage">
        <div class="workflow section-width">
          <div class="section-heading chapter-head">
            <p class="section-kicker">One operating loop</p>
            <h2 id="workflow-title">From a brief to verified, shipped work.</h2>
            <p>
              Vector keeps the request, repository context, agent activity, files, terminal, browser,
              usage, review, and release in one place. Work directly or delegate as much as you want.
            </p>
          </div>
          <ol class="workflow-list">
            {workflow.map(([title, body], index) => (
              <li style={`--i: ${index}`}>
                <span>0{index + 1}</span>
                <strong>{title}</strong>
                <p>{body}</p>
              </li>
            ))}
          </ol>
          <div class="workflow-rail" aria-hidden="true"><i></i></div>
        </div>
      </div>
    </section>

    <div id="workspace" class="features">
      {features.map((feature) => (
        <section class="feature">
          <div class="feature-copy" data-reveal>
            <p class="feature-tag">{feature.tag}</p>
            <h2>{feature.title}</h2>
            <p class="feature-body">{feature.body}</p>
          </div>
          <figure class="feature-card reveal-zoom" data-reveal style="--rd: 90ms">
            <div class="card-topline" aria-hidden="true">
              <span>{feature.tag}</span>
              <span>{feature.note}</span>
            </div>
            <img
              src={feature.image.src}
              width={feature.image.width}
              height={feature.image.height}
              alt={feature.alt}
              loading="lazy"
            />
          </figure>
          <a class="feature-link" href={feature.href} data-reveal style="--rd: 180ms">
            <span>{feature.link}</span>
            <ArrowRight size={15} strokeWidth={2} aria-hidden="true" />
          </a>
        </section>
      ))}
    </div>

    <section class="runtime section-width" aria-labelledby="runtime-title">
      <div class="runtime-intro chapter-head" data-reveal>
        <p class="section-kicker">The system underneath</p>
        <h2 id="runtime-title">Powerful agents need an observable runtime.</h2>
        <p>
          The difficult part is not generating text. It is giving agents the right context,
          preserving project knowledge, validating their work, and keeping the human in control.
        </p>
      </div>
      <div class="runtime-list">
        {systemRows.map(([title, body], index) => (
          <article data-reveal>
            <span>0{index + 1}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="evidence section-width" aria-labelledby="evidence-title">
      <div class="section-heading chapter-head" data-reveal>
        <p class="section-kicker">Measured, not implied</p>
        <h2 id="evidence-title">One controlled repair task. A useful data point.</h2>
        <p>
          In a July 2026 scheduler-repair benchmark, Vector Balanced completed the task in 149 seconds
          and reported roughly 67% fewer tokens than Codex CLI. Both passed all five public tests.
          Codex passed more hidden tests, so this is one reproducible result, not a universal claim.
        </p>
      </div>
      <dl class="evidence-grid" data-reveal>
        <div><dt>Vector Balanced</dt><dd data-count="149" data-suffix="s">149s</dd><span>Completion time</span></div>
        <div><dt>Codex CLI</dt><dd data-count="284" data-suffix="s">284s</dd><span>Completion time</span></div>
        <div><dt>Reported usage</dt><dd data-count="67" data-suffix="%">67%</dd><span>Fewer tokens for Vector</span></div>
        <div><dt>Public checks</dt><dd>5 / 5</dd><span>Passed by both</span></div>
      </dl>
    </section>

    <section class="connections section-width" aria-labelledby="connections-title">
      <div class="section-heading chapter-head" data-reveal>
        <p class="section-kicker">Bring your stack</p>
        <h2 id="connections-title">One workspace for the tools you already trust.</h2>
        <p>
          Use Vector's provider system, connect MCP servers and source control, call supported local
          agent runtimes when installed, then validate and publish through your own services.
        </p>
      </div>
      <div class="connection-grid">
        {connectionGroups.map(([title, body]) => (
          <article data-reveal>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="comparison-section section-width" aria-labelledby="comparison-title">
      <div class="section-heading chapter-head" data-reveal>
        <p class="section-kicker">A wider product boundary</p>
        <h2 id="comparison-title">Fewer disconnected surfaces between request and release.</h2>
        <p>
          Vector combines capabilities commonly split across an agent, editor, browser, Git client,
          and deployment dashboard. Capabilities change quickly, so verify current vendor documentation.
        </p>
      </div>
      <details class="comparison" data-reveal>
        <summary>
          <span>View the detailed product comparison</span>
          <ChevronDown size={18} strokeWidth={1.7} aria-hidden="true" />
        </summary>
        <div class="comparison-scroll">
          <table>
            <thead>
              <tr><th>Capability</th><th>Vector</th><th>Claude Code</th><th>Codex</th><th>Cursor</th><th>App builders</th></tr>
            </thead>
            <tbody>
              {comparison.map((row) => (
                <tr>{row.map((cell, index) => index === 0 ? <th>{cell}</th> : <td>{cell}</td>)}</tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </section>

    <section class="changelog" aria-labelledby="changelog-title">
      <div class="changelog-inner">
        <h2 id="changelog-title">Changelog</h2>
        <ol>
          {changelog.map(([date, title, blurb]) => (
            <li data-reveal>
              <span class="changelog-date">{date}</span>
              <div>
                <strong>{title}</strong>
                <p>{blurb}</p>
              </div>
            </li>
          ))}
        </ol>
        <a class="changelog-link" href="/releases">
          <span>View all releases</span>
          <ArrowRight size={15} strokeWidth={2} aria-hidden="true" />
        </a>
      </div>
    </section>

    <section class="closing">
      <div class="sky" aria-hidden="true">
        <i class="sky-aurora"></i>
        <i class="sky-stars"></i>
      </div>
      <h2 data-reveal class="reveal-blur">Keep the whole build in view.</h2>
      <p data-reveal style="--rd: 120ms">Open the repository. Direct the agents. Ship the result.</p>
      <a class="closing-cta" href="/download" data-reveal style="--rd: 220ms">
        <span>Get Vector</span>
        <ArrowRight size={18} strokeWidth={2} aria-hidden="true" />
      </a>
    </section>
  </main>

  <MarketingFooter />
</div>

<script>
  const reducedMotion = () => globalThis.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false

  // Signals that the animation runtime is alive. Reveal styles only hide
  // content under html.va, so a failed script load leaves the page readable.
  document.documentElement.classList.add("va")

  const initReveals = () => {
    const nodes = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]:not(.in)"))
    if (reducedMotion() || !("IntersectionObserver" in globalThis)) {
      nodes.forEach((node) => node.classList.add("in"))
      return () => {}
    }
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return
          entry.target.classList.add("in")
          observer.unobserve(entry.target)
        })
      },
      { rootMargin: "0px 0px -6%", threshold: 0.08 },
    )
    nodes.forEach((node) => observer.observe(node))
    return () => observer.disconnect()
  }

  const initScramble = () => {
    const node = document.querySelector<HTMLElement>("[data-scramble]")
    if (!node) return () => {}
    const phrases = [
      "Direct the agent with a clear outcome.",
      "Watch files, commands, and checks run.",
      "Review the evidence and ship confidently.",
    ]
    const stages = Array.from(document.querySelectorAll<HTMLElement>("[data-hero-stage]"))
    const progress = document.querySelector<HTMLElement>("[data-hero-progress]")
    const selectStage = (index: number) => {
      stages.forEach((stage, stageIndex) => stage.classList.toggle("is-active", stageIndex === index))
      progress?.style.setProperty("--stage", String(index))
    }
    if (reducedMotion()) {
      node.textContent = phrases[0]
      selectStage(0)
      return () => {}
    }
    const glyphs = "abcdefghijklmnopqrstuvwxyz<>{}/\\=+*"
    let phrase = 0
    let frame = 0
    let raf = 0
    let timer = 0
    const step = () => {
      const target = phrases[phrase]
      selectStage(phrase)
      const total = target.length + 10
      frame++
      const revealed = Math.max(0, Math.floor(((frame - 6) / total) * target.length))
      const scrambled = Math.min(target.length - revealed, 9)
      node.textContent =
        target.slice(0, revealed) +
        Array.from({ length: scrambled }, () => glyphs[Math.floor(Math.random() * glyphs.length)]).join("")
      if (frame < total + 6) {
        raf = requestAnimationFrame(step)
        return
      }
      node.textContent = target
      phrase = (phrase + 1) % phrases.length
      frame = 0
      timer = globalThis.setTimeout(() => {
        if (!document.hidden) raf = requestAnimationFrame(step)
        else timer = globalThis.setTimeout(() => raf = requestAnimationFrame(step), 4000)
      }, 3600)
    }
    timer = globalThis.setTimeout(() => raf = requestAnimationFrame(step), 2400)
    return () => {
      globalThis.clearTimeout(timer)
      if (raf) cancelAnimationFrame(raf)
      node.textContent = phrases[0]
      selectStage(0)
    }
  }

  // Apple-style pinned scenes: each [data-scene] is a tall runway with a sticky
  // full-viewport stage. Scroll progress through the runway is written to --p
  // (0..1) and the scene CSS choreographs its layers from that one number.
  // Reduced motion and small screens collapse to static layouts via CSS, so the
  // engine just parks --p at its final value there.
  const initScenes = () => {
    const scenes = Array.from(document.querySelectorAll<HTMLElement>("[data-scene]"))
    if (!scenes.length) return () => {}
    const park = () => scenes.forEach((scene) => scene.style.setProperty("--p", "1"))
    if (reducedMotion()) {
      park()
      return () => {}
    }
    let frame = 0
    const update = () => {
      frame = 0
      if (globalThis.innerWidth < 641) {
        park()
        return
      }
      const viewport = globalThis.innerHeight
      scenes.forEach((scene) => {
        if (scene.hasAttribute("data-static")) return
        const rect = scene.getBoundingClientRect()
        const span = rect.height - viewport
        const raw = span > 0 ? -rect.top / span : 1
        // Only touch scenes near the viewport; distant ones keep their edge value.
        if (raw < -0.2 || raw > 1.2) return
        scene.style.setProperty("--p", Math.min(1, Math.max(0, raw)).toFixed(4))
      })
    }
    // A pinned stage must show its whole chapter at once. When the viewport is
    // too short for a scene's content, pinning would clip it against the glass
    // nav — so that scene falls back to a plain, fully-revealed section.
    const audit = () => {
      scenes.forEach((scene) => {
        scene.removeAttribute("data-static")
        const stage = scene.querySelector<HTMLElement>(".scene-stage")
        if (!stage) return
        if (stage.scrollHeight > stage.clientHeight + 1) {
          scene.setAttribute("data-static", "")
          scene.style.setProperty("--p", "1")
        }
      })
      update()
    }
    const queue = () => {
      if (!frame) frame = requestAnimationFrame(update)
    }
    const requeue = () => {
      audit()
      queue()
    }
    globalThis.addEventListener("scroll", queue, { passive: true })
    globalThis.addEventListener("resize", requeue, { passive: true })
    audit()
    return () => {
      globalThis.removeEventListener("scroll", queue)
      globalThis.removeEventListener("resize", requeue)
      if (frame) cancelAnimationFrame(frame)
      scenes.forEach((scene) => {
        scene.style.removeProperty("--p")
        scene.removeAttribute("data-static")
      })
    }
  }

  // Benchmark numerals count up once when the stat band enters the viewport.
  const initCounters = () => {
    const nodes = Array.from(document.querySelectorAll<HTMLElement>("[data-count]"))
    if (!nodes.length || reducedMotion() || !("IntersectionObserver" in globalThis)) return () => {}
    const rafs = new Set<number>()
    const run = (node: HTMLElement) => {
      const target = Number(node.dataset.count)
      const suffix = node.dataset.suffix ?? ""
      if (!Number.isFinite(target)) return
      const started = performance.now()
      const duration = 1100
      const tick = (now: number) => {
        const t = Math.min(1, (now - started) / duration)
        const eased = 1 - Math.pow(1 - t, 3)
        node.textContent = `${Math.round(target * eased)}${suffix}`
        if (t < 1) rafs.add(requestAnimationFrame(tick))
      }
      rafs.add(requestAnimationFrame(tick))
    }
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return
          observer.unobserve(entry.target)
          run(entry.target as HTMLElement)
        })
      },
      { threshold: 0.5 },
    )
    nodes.forEach((node) => observer.observe(node))
    return () => {
      observer.disconnect()
      rafs.forEach((raf) => cancelAnimationFrame(raf))
      nodes.forEach((node) => (node.textContent = `${node.dataset.count}${node.dataset.suffix ?? ""}`))
    }
  }

  const initParallax = () => {
    const node = document.querySelector<HTMLElement>("[data-parallax]")
    if (!node || reducedMotion()) return () => {}
    let frame = 0
    const update = () => {
      frame = 0
      const shift = Math.min(globalThis.scrollY, 900) * -0.028
      node.style.transform = `scale(1.06) translateY(${shift.toFixed(1)}px)`
    }
    const queue = () => {
      if (!frame) frame = requestAnimationFrame(update)
    }
    globalThis.addEventListener("scroll", queue, { passive: true })
    update()
    return () => {
      globalThis.removeEventListener("scroll", queue)
      if (frame) cancelAnimationFrame(frame)
      node.style.transform = ""
    }
  }

  const initField = () => {
    const canvas = document.querySelector<HTMLCanvasElement>("[data-vector-field]")
    const context = canvas?.getContext("2d")
    if (!canvas || !context) return () => {}

    const glyphs = "01VECTOR{}[]<>/\\+=:*"
    const clusters = [
      [0.84, 0.1, 0.22, 0.16, 1.05],
      [0.96, 0.32, 0.18, 0.2, 0.9],
      [0.7, 0.05, 0.16, 0.1, 0.8],
      [0.05, 0.08, 0.14, 0.12, 0.6],
      [0.08, 0.6, 0.16, 0.18, 0.5],
      [0.92, 0.78, 0.2, 0.16, 0.55],
    ]
    const hash = (x: number, y: number, seed = 0) => {
      const value = Math.sin(x * 12.9898 + y * 78.233 + seed * 37.719) * 43758.5453
      return value - Math.floor(value)
    }
    const animate = !reducedMotion()
    let width = 1
    let height = 1
    let fontSize = 12
    let animationFrame = 0
    let lastFrame = 0
    let pointerX = 0.5
    let pointerY = 0.5
    let backdropCells: Array<{
      x: number
      y: number
      glyph: string
      alpha: number
      drift: number
      speed: number
    }> = []
    let columns: Array<{
      x: number
      y: number
      speed: number
      trail: number
      phase: number
      opacity: number
    }> = []

    const build = () => {
      fontSize = width < 720 ? 8.5 : 9
      const stepX = 9
      const stepY = 10
      backdropCells = []
      for (let y = 0; y < height + stepY; y += stepY) {
        for (let x = 0; x < width + stepX; x += stepX) {
          const nx = x / Math.max(1, width)
          const ny = y / Math.max(1, height)
          const warpX = nx + Math.sin(ny * 19) * 0.018
          const warpY = ny + Math.sin(nx * 15) * 0.014
          let field = 0
          clusters.forEach(([cx, cy, rx, ry, strength], index) => {
            const dx = (warpX - cx) / rx
            const dy = (warpY - cy) / ry
            field = Math.max(field, Math.exp(-(dx * dx + dy * dy) * (1.2 + (index % 3) * 0.1)) * strength)
          })
          const texture = hash(x / stepX, y / stepY) * 0.32 + Math.sin(nx * 46 + ny * 29) * 0.07
          if (field + texture < 0.51) continue
          const copyZone = Math.exp(-(Math.pow((nx - 0.42) / 0.3, 2) + Math.pow((ny - 0.3) / 0.3, 2)))
          const edge = Math.min(1, Math.max(0, (field + texture - 0.46) * 2.1))
          backdropCells.push({
            x,
            y,
            glyph: glyphs[Math.floor(hash(x, y, 2) * glyphs.length)],
            alpha: Math.max(0.08, (0.17 + edge * 0.42) * (1 - copyZone * 0.5)),
            drift: 2 + hash(x, y, 3) * 5,
            speed: 4 + hash(x, y, 4) * 11,
          })
        }
      }

      const spacing = fontSize * 1.08
      const count = Math.ceil(width / spacing)
      columns = Array.from({ length: count }, (_, index) => ({
        x: index * spacing + spacing / 2,
        // Seed the first frame across the viewport so the field is present
        // immediately, then recycle each stream from above as it falls.
        y: Math.random() * height,
        speed: 26 + Math.random() * 40,
        trail: 10 + Math.floor(Math.random() * 19),
        phase: Math.floor(Math.random() * glyphs.length),
        opacity: 0.26 + Math.random() * 0.54,
      }))
    }

    const render = (timestamp = performance.now()) => {
      const elapsed = lastFrame ? timestamp - lastFrame : 34
      if (animate && elapsed < 30) {
        animationFrame = requestAnimationFrame(render)
        return
      }
      const delta = Math.min(elapsed, 80) / 1000
      lastFrame = timestamp
      context.clearRect(0, 0, width, height)
      context.font = `${fontSize}px ui-monospace, SFMono-Regular, Menlo, Monaco, monospace`
      context.textAlign = "center"
      context.textBaseline = "middle"
      const offsetX = (pointerX - 0.5) * 7
      const offsetY = (pointerY - 0.5) * 4
      const tick = Math.floor(timestamp / 170)
      const lineHeight = fontSize * 1.18

      backdropCells.forEach((cell) => {
        const travel = animate ? (timestamp * cell.speed) / 1000 : 0
        const y = ((cell.y + travel) % (height + lineHeight * 2)) - lineHeight
        context.fillStyle = `rgba(164, 116, 255, ${cell.alpha * 0.72})`
        context.fillText(cell.glyph, cell.x + offsetX * cell.drift * 0.34, y + offsetY * cell.drift * 0.2)
      })

      columns.forEach((column, columnIndex) => {
        if (animate) column.y += column.speed * delta
        for (let step = 0; step < column.trail; step += 1) {
          const y = column.y - step * lineHeight
          if (y < -lineHeight || y > height + lineHeight) continue
          const fade = 1 - step / column.trail
          const normalizedX = column.x / Math.max(1, width)
          const normalizedY = y / Math.max(1, height)
          const copyZone = Math.exp(
            -(Math.pow((normalizedX - 0.47) / 0.32, 2) + Math.pow((normalizedY - 0.31) / 0.29, 2)),
          )
          const alpha = Math.max(0.04, fade * fade * column.opacity * 0.78 * (1 - copyZone * 0.5))
          const glyphIndex = Math.abs(column.phase + columnIndex * 3 + tick - step * 2) % glyphs.length
          context.fillStyle =
            step === 0
              ? `rgba(226, 215, 255, ${Math.min(0.94, alpha + 0.28)})`
              : `rgba(164, 116, 255, ${alpha})`
          context.fillText(glyphs[glyphIndex], column.x + offsetX * fade, y + offsetY * fade)
        }
        if (column.y - column.trail * lineHeight <= height + lineHeight) return
        column.y = -Math.random() * height * 0.7 - lineHeight
        column.speed = 26 + Math.random() * 40
        column.trail = 10 + Math.floor(Math.random() * 19)
        column.phase = Math.floor(Math.random() * glyphs.length)
      })

      if (animate && !document.hidden) animationFrame = requestAnimationFrame(render)
    }

    const resize = () => {
      const rect = canvas.getBoundingClientRect()
      const dpr = Math.min(globalThis.devicePixelRatio || 1, 2)
      width = Math.max(1, rect.width)
      height = Math.max(1, rect.height)
      canvas.width = Math.round(width * dpr)
      canvas.height = Math.round(height * dpr)
      context.setTransform(dpr, 0, 0, dpr, 0, 0)
      build()
      if (!animate) render()
    }

    const move = (event: PointerEvent) => {
      pointerX = event.clientX / Math.max(1, globalThis.innerWidth)
      pointerY = event.clientY / Math.max(1, globalThis.innerHeight)
    }

    const visibility = () => {
      if (document.hidden) {
        if (animationFrame) cancelAnimationFrame(animationFrame)
        animationFrame = 0
        return
      }
      lastFrame = 0
      if (animate && !animationFrame) animationFrame = requestAnimationFrame(render)
    }

    const resizeObserver = new ResizeObserver(resize)
    resizeObserver.observe(canvas)
    globalThis.addEventListener("pointermove", move, { passive: true })
    document.addEventListener("visibilitychange", visibility)
    resize()
    if (animate) animationFrame = requestAnimationFrame(render)

    return () => {
      resizeObserver.disconnect()
      globalThis.removeEventListener("pointermove", move)
      document.removeEventListener("visibilitychange", visibility)
      if (animationFrame) cancelAnimationFrame(animationFrame)
    }
  }

  let cleanups: Array<() => void> = []
  const boot = () => {
    cleanups.forEach((cleanup) => cleanup())
    cleanups = [initReveals(), initScramble(), initScenes(), initCounters(), initParallax(), initField()]
  }
  const teardown = () => {
    cleanups.forEach((cleanup) => cleanup())
    cleanups = []
  }

  boot()
  document.addEventListener("astro:page-load", boot)
  document.addEventListener("astro:before-swap", teardown)
</script>

<style>
  .vector-marketing {
    --paper: #08060d;
    --card: var(--glass-fill);
