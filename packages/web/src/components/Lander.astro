<script>
  const reducedMotion = () => globalThis.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false

  // Signals that the animation runtime is alive. Reveal styles only hide
  // content under html.va, so a failed script load leaves the page readable.
  document.documentElement.classList.add("va")

  const initReveals = () => {
    const nodes = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]:not(.in)"))
    if (reducedMotion() || !("IntersectionObserver" in globalThis)) {
      nodes.forEach((node) => node.classList.add("in"))
      return () => {}
    }
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return
          entry.target.classList.add("in")
          observer.unobserve(entry.target)
        })
      },
      { rootMargin: "0px 0px -6%", threshold: 0.08 },
    )
    nodes.forEach((node) => observer.observe(node))
    return () => observer.disconnect()
  }

  const initScramble = () => {
    const node = document.querySelector<HTMLElement>("[data-scramble]")
    if (!node) return () => {}
    // Each phrase completes the same opening clause, so the headline always
    // reads as one sentence rather than a label with a caption.
    const phrases = [
      "remembers how you work.",
      "records what a run cost.",
      "verifies before it says done.",
      "drives a real browser.",
      "ships from your own accounts.",
      "runs sixteen agents when you want.",
    ]
    const stages = Array.from(document.querySelectorAll<HTMLElement>("[data-hero-stage]"))
    const progress = document.querySelector<HTMLElement>("[data-hero-progress]")
    const selectStage = (index: number) => {
      stages.forEach((stage, stageIndex) => stage.classList.toggle("is-active", stageIndex === index))
      progress?.style.setProperty("--stage", String(index))
    }
    if (reducedMotion()) {
      node.textContent = phrases[0]
      selectStage(0)
      return () => {}
    }

    // Reserve the width of the longest phrase so a swap cannot reflow the hero
    // beneath it mid-scramble.
    const measure = document.createElement("span")
    measure.setAttribute("aria-hidden", "true")
    measure.style.cssText = "position:absolute;visibility:hidden;white-space:nowrap;pointer-events:none"
    node.after(measure)
    measure.style.font = getComputedStyle(node).font
    measure.textContent = phrases.reduce((longest, phrase) => (phrase.length > longest.length ? phrase : longest), "")
    node.style.minWidth = `${Math.ceil(measure.getBoundingClientRect().width)}px`
    node.style.display = "inline-block"
    measure.remove()

    const glyphs = "abcdefghijklmnopqrstuvwxyz<>{}/\\=+*"
    let phrase = 0
    let frame = 0
    let raf = 0
    let timer: ReturnType<typeof globalThis.setTimeout> | undefined
    const step = () => {
      const target = phrases[phrase]
      selectStage(phrase % Math.max(stages.length, 1))
      const total = target.length + 10
      frame++
      const revealed = Math.max(0, Math.floor(((frame - 6) / total) * target.length))
      const scrambled = Math.min(target.length - revealed, 9)
      node.textContent =
        target.slice(0, revealed) +
        Array.from({ length: scrambled }, () => glyphs[Math.floor(Math.random() * glyphs.length)]).join("")
      if (frame < total + 6) {
        raf = requestAnimationFrame(step)
        return
      }
      node.textContent = target
      phrase = (phrase + 1) % phrases.length
      frame = 0
      timer = globalThis.setTimeout(() => {
        if (!document.hidden) raf = requestAnimationFrame(step)
        else timer = globalThis.setTimeout(() => (raf = requestAnimationFrame(step)), 4000)
      }, 3600)
    }
    node.textContent = phrases[0]
    selectStage(0)
    timer = globalThis.setTimeout(() => (raf = requestAnimationFrame(step)), 2400)
    return () => {
      if (timer) globalThis.clearTimeout(timer)
      if (raf) cancelAnimationFrame(raf)
      node.textContent = phrases[0]
      selectStage(0)
    }
  }

  const initScenes = () => {
    const scenes = Array.from(document.querySelectorAll<HTMLElement>("[data-scene]"))
    if (!scenes.length) return () => {}
    const park = () => scenes.forEach((scene) => scene.style.setProperty("--p", "1"))
    if (reducedMotion()) {
      park()
      return () => {}
    }
    let frame = 0
    const update = () => {
      frame = 0
      if (globalThis.innerWidth < 641) {
        park()
        return
      }
      const viewport = globalThis.innerHeight
      scenes.forEach((scene) => {
        if (scene.hasAttribute("data-static")) return
        const rect = scene.getBoundingClientRect()
        const span = rect.height - viewport
        const raw = span > 0 ? -rect.top / span : 1
        // Only touch scenes near the viewport; distant ones keep their edge value.
        if (raw < -0.2 || raw > 1.2) return
        scene.style.setProperty("--p", Math.min(1, Math.max(0, raw)).toFixed(4))
      })
    }
    // A pinned stage must show its whole chapter at once. When the viewport is
    // too short for a scene's content, pinning would clip it against the glass
    // nav — so that scene falls back to a plain, fully-revealed section.
    const audit = () => {
      scenes.forEach((scene) => {
        scene.removeAttribute("data-static")
        const stage = scene.querySelector<HTMLElement>(".scene-stage")
        if (!stage) return
        if (stage.scrollHeight > stage.clientHeight + 1) {
          scene.setAttribute("data-static", "")
          scene.style.setProperty("--p", "1")
        }
      })
      update()
    }
    const queue = () => {
      if (!frame) frame = requestAnimationFrame(update)
    }
    const requeue = () => {
      audit()
      queue()
    }
    globalThis.addEventListener("scroll", queue, { passive: true })
    globalThis.addEventListener("resize", requeue, { passive: true })
    audit()
    return () => {
      globalThis.removeEventListener("scroll", queue)
      globalThis.removeEventListener("resize", requeue)
      if (frame) cancelAnimationFrame(frame)
      scenes.forEach((scene) => {
        scene.style.removeProperty("--p")
        scene.removeAttribute("data-static")
      })
    }
  }

  const initParallax = () => {
    const node = document.querySelector<HTMLElement>("[data-parallax]")
    if (!node || reducedMotion()) return () => {}
    let frame = 0
    const update = () => {
      frame = 0
      const shift = Math.min(globalThis.scrollY, 900) * -0.028
      node.style.transform = `scale(1.06) translateY(${shift.toFixed(1)}px)`
    }
    const queue = () => {
      if (!frame) frame = requestAnimationFrame(update)
    }
    globalThis.addEventListener("scroll", queue, { passive: true })
    update()
    return () => {
      globalThis.removeEventListener("scroll", queue)
      if (frame) cancelAnimationFrame(frame)
      node.style.transform = ""
    }
  }

  const initField = () => {
    const canvas = document.querySelector<HTMLCanvasElement>("[data-vector-field]")
    const context = canvas?.getContext("2d")
    if (!canvas || !context) return () => {}

    const glyphs = "01VECTOR{}[]<>/\\+=:*"
    const clusters = [
      [0.84, 0.1, 0.22, 0.16, 1.05],
      [0.96, 0.32, 0.18, 0.2, 0.9],
      [0.7, 0.05, 0.16, 0.1, 0.8],
      [0.05, 0.08, 0.14, 0.12, 0.6],
      [0.08, 0.6, 0.16, 0.18, 0.5],
      [0.92, 0.78, 0.2, 0.16, 0.55],
    ]
    const hash = (x: number, y: number, seed = 0) => {
      const value = Math.sin(x * 12.9898 + y * 78.233 + seed * 37.719) * 43758.5453
      return value - Math.floor(value)
    }
    const animate = !reducedMotion()
    let width = 1
    let height = 1
    let fontSize = 12
    let animationFrame = 0
    let lastFrame = 0
    let pointerX = 0.5
    let pointerY = 0.5
    let backdropCells: Array<{
      x: number
      y: number
      glyph: string
      alpha: number
      drift: number
      speed: number
    }> = []
    let columns: Array<{
      x: number
      y: number
      speed: number
      trail: number
      phase: number
      opacity: number
    }> = []

    const build = () => {
      fontSize = width < 720 ? 8.5 : 9
      const stepX = 9
      const stepY = 10
      backdropCells = []
      for (let y = 0; y < height + stepY; y += stepY) {
        for (let x = 0; x < width + stepX; x += stepX) {
          const nx = x / Math.max(1, width)
          const ny = y / Math.max(1, height)
          const warpX = nx + Math.sin(ny * 19) * 0.018
          const warpY = ny + Math.sin(nx * 15) * 0.014
          let field = 0
          clusters.forEach(([cx, cy, rx, ry, strength], index) => {
            const dx = (warpX - cx) / rx
            const dy = (warpY - cy) / ry
            field = Math.max(field, Math.exp(-(dx * dx + dy * dy) * (1.2 + (index % 3) * 0.1)) * strength)
          })
          const texture = hash(x / stepX, y / stepY) * 0.32 + Math.sin(nx * 46 + ny * 29) * 0.07
          if (field + texture < 0.51) continue
          const copyZone = Math.exp(-(Math.pow((nx - 0.42) / 0.3, 2) + Math.pow((ny - 0.3) / 0.3, 2)))
          const edge = Math.min(1, Math.max(0, (field + texture - 0.46) * 2.1))
          backdropCells.push({
            x,
            y,
            glyph: glyphs[Math.floor(hash(x, y, 2) * glyphs.length)],
            alpha: Math.max(0.08, (0.17 + edge * 0.42) * (1 - copyZone * 0.5)),
            drift: 2 + hash(x, y, 3) * 5,
            speed: 4 + hash(x, y, 4) * 11,
          })
        }
      }

      const spacing = fontSize * 1.08
      const count = Math.ceil(width / spacing)
      columns = Array.from({ length: count }, (_, index) => ({
        x: index * spacing + spacing / 2,
        // Seed the first frame across the viewport so the field is present
        // immediately, then recycle each stream from above as it falls.
        y: Math.random() * height,
        speed: 26 + Math.random() * 40,
        trail: 10 + Math.floor(Math.random() * 19),
        phase: Math.floor(Math.random() * glyphs.length),
        opacity: 0.26 + Math.random() * 0.54,
      }))
    }

    const render = (timestamp = performance.now()) => {
      const elapsed = lastFrame ? timestamp - lastFrame : 34
      if (animate && elapsed < 30) {
        animationFrame = requestAnimationFrame(render)
        return
      }
      const delta = Math.min(elapsed, 80) / 1000
      lastFrame = timestamp
      context.clearRect(0, 0, width, height)
      context.font = `${fontSize}px ui-monospace, SFMono-Regular, Menlo, Monaco, monospace`
      context.textAlign = "center"
      context.textBaseline = "middle"
      const offsetX = (pointerX - 0.5) * 7
      const offsetY = (pointerY - 0.5) * 4
      const tick = Math.floor(timestamp / 170)
      const lineHeight = fontSize * 1.18

      backdropCells.forEach((cell) => {
        const travel = animate ? (timestamp * cell.speed) / 1000 : 0
        const y = ((cell.y + travel) % (height + lineHeight * 2)) - lineHeight
        context.fillStyle = `rgba(164, 116, 255, ${cell.alpha * 0.72})`
        context.fillText(cell.glyph, cell.x + offsetX * cell.drift * 0.34, y + offsetY * cell.drift * 0.2)
      })

      columns.forEach((column, columnIndex) => {
        if (animate) column.y += column.speed * delta
        for (let step = 0; step < column.trail; step += 1) {
          const y = column.y - step * lineHeight
          if (y < -lineHeight || y > height + lineHeight) continue
          const fade = 1 - step / column.trail
          const normalizedX = column.x / Math.max(1, width)
          const normalizedY = y / Math.max(1, height)
          const copyZone = Math.exp(
            -(Math.pow((normalizedX - 0.47) / 0.32, 2) + Math.pow((normalizedY - 0.31) / 0.29, 2)),
          )
          const alpha = Math.max(0.04, fade * fade * column.opacity * 0.78 * (1 - copyZone * 0.5))
          const glyphIndex = Math.abs(column.phase + columnIndex * 3 + tick - step * 2) % glyphs.length
          context.fillStyle =
            step === 0
              ? `rgba(226, 215, 255, ${Math.min(0.94, alpha + 0.28)})`
              : `rgba(164, 116, 255, ${alpha})`
          context.fillText(glyphs[glyphIndex], column.x + offsetX * fade, y + offsetY * fade)
        }
        if (column.y - column.trail * lineHeight <= height + lineHeight) return
        column.y = -Math.random() * height * 0.7 - lineHeight
        column.speed = 26 + Math.random() * 40
        column.trail = 10 + Math.floor(Math.random() * 19)
        column.phase = Math.floor(Math.random() * glyphs.length)
      })

      if (animate && !document.hidden) animationFrame = requestAnimationFrame(render)
    }

    const resize = () => {
      const rect = canvas.getBoundingClientRect()
      const dpr = Math.min(globalThis.devicePixelRatio || 1, 2)
      width = Math.max(1, rect.width)
      height = Math.max(1, rect.height)
      canvas.width = Math.round(width * dpr)
      canvas.height = Math.round(height * dpr)
      context.setTransform(dpr, 0, 0, dpr, 0, 0)
      build()
      if (!animate) render()
    }

    const move = (event: PointerEvent) => {
      pointerX = event.clientX / Math.max(1, globalThis.innerWidth)
      pointerY = event.clientY / Math.max(1, globalThis.innerHeight)
    }

    const visibility = () => {
      if (document.hidden) {
        if (animationFrame) cancelAnimationFrame(animationFrame)
        animationFrame = 0
        return
      }
      lastFrame = 0
      if (animate && !animationFrame) animationFrame = requestAnimationFrame(render)
    }

    const resizeObserver = new ResizeObserver(resize)
    resizeObserver.observe(canvas)
    globalThis.addEventListener("pointermove", move, { passive: true })
    document.addEventListener("visibilitychange", visibility)
    resize()
    if (animate) animationFrame = requestAnimationFrame(render)

    return () => {
      resizeObserver.disconnect()
      globalThis.removeEventListener("pointermove", move)
      document.removeEventListener("visibilitychange", visibility)
      if (animationFrame) cancelAnimationFrame(animationFrame)
    }
  }

  let cleanups: Array<() => void> = []
  const boot = () => {
    cleanups.forEach((cleanup) => cleanup())
    cleanups = [initReveals(), initScramble(), initScenes(), initParallax(), initField()]
  }
  const teardown = () => {
    cleanups.forEach((cleanup) => cleanup())
    cleanups = []
  }

  boot()
  document.addEventListener("astro:page-load", boot)
  document.addEventListener("astro:before-swap", teardown)
</script>

<style>
  .vector-marketing {
