    gap: 6px;
    overflow: hidden;
    background: linear-gradient(145deg, rgba(32, 23, 49, 0.78), rgba(11, 8, 17, 0.74));
    border: 1px solid rgba(201, 176, 255, 0.2);
    border-radius: 20px;
    box-shadow:
      0 22px 70px rgba(0, 0, 0, 0.34),
      0 0 42px rgba(143, 82, 255, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(24px) saturate(145%);
    -webkit-backdrop-filter: blur(24px) saturate(145%);
  }

  .hero-loop-progress {
    position: absolute;
    inset: auto 12px 7px;
    height: 2px;
    overflow: hidden;
    background: rgba(201, 176, 255, 0.1);
    border-radius: 999px;
  }

  .hero-loop-progress i {
    --stage: 0;
    display: block;
    width: 33.333%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--purple), var(--purple-soft));
    box-shadow: 0 0 16px rgba(167, 124, 255, 0.72);
    transform: translateX(calc(var(--stage) * 100%));
    transition: transform 460ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-loop-stage {
    min-width: 0;
    min-height: 48px;
    padding: 8px 10px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink-40);
    border: 1px solid transparent;
    border-radius: 13px;
    transition:
      color 240ms ease,
      background 240ms ease,
      border-color 240ms ease,
      transform 240ms ease;
  }

  .hero-loop-stage.is-active {
    color: #fff;
    background: rgba(143, 82, 255, 0.12);
    border-color: rgba(201, 176, 255, 0.2);
    transform: translateY(-1px);
  }

  .hero-loop-icon {
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    display: grid;
    place-items: center;
    color: var(--ink-40);
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 9px;
    transition: color 240ms ease, background 240ms ease, box-shadow 240ms ease;
  }

  .hero-loop-stage.is-active .hero-loop-icon {
    color: var(--lavender);
    background: rgba(143, 82, 255, 0.18);
    box-shadow: 0 0 22px rgba(143, 82, 255, 0.2);
  }

  .hero-loop-stage > span:last-child {
    min-width: 0;
    display: grid;
    gap: 2px;
  }

  .hero-loop-stage strong {
    color: inherit;
    font-size: 12.5px;
    font-weight: 650;
  }

  .hero-loop-stage small {
    overflow: hidden;
    color: var(--ink-40);
    font-size: 10.5px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hero-cta {
    width: 100%;
    min-height: 48px;
    margin-top: 36px;
    padding: 0 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: #120d17 !important;
    background: linear-gradient(180deg, rgba(245, 240, 255, 0.98), rgba(207, 184, 255, 0.94));
    border: 1px solid rgba(255, 255, 255, 0.62);
    border-radius: 18px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.82), 0 16px 45px rgba(79, 51, 137, 0.2);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: background 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .hero-cta:hover {
    background: linear-gradient(180deg, #f7f2ff, #c9b0ff);
    border-color: rgba(255, 255, 255, 0.74);
    transform: translateY(-1px);
    box-shadow: 0 12px 44px rgba(146, 116, 236, 0.32);
  }

  .hero-cta svg {
    transition: transform 180ms ease;
  }

  .hero-cta:hover svg {
    transform: translateX(3px);
  }

  .hero-note {
    margin: 18px 0 0;
    color: var(--ink-40);
    font-size: 12.5px;
    letter-spacing: 0.01em;
  }

  /* ---- showcase ---- */

  .showcase {
    width: min(1150px, calc(100% - 32px));
    margin-inline: auto;
    padding-top: clamp(56px, 7vw, 88px);
  }

  .product-window {
    margin: 0;
    overflow: hidden;
    padding: 7px;
    border: 1px solid rgba(235, 228, 255, 0.22);
    border-radius: 28px;
    background: var(--glass-fill-strong);
    box-shadow:
      0 40px 120px rgba(0, 0, 0, 0.66),
      0 0 80px rgba(132, 86, 219, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.13);
    backdrop-filter: blur(28px) saturate(145%);
    -webkit-backdrop-filter: blur(28px) saturate(145%);
  }

  .product-bar {
    min-height: 40px;
    padding: 0 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--ink-40);
    background: rgba(255, 255, 255, 0.045);
    border-bottom: 1px solid rgba(190, 166, 255, 0.1);
    border-radius: 20px 20px 0 0;
    font-size: 11.5px;
  }

  .traffic { display: inline-flex; gap: 6px; }
  .traffic i { width: 9px; height: 9px; border-radius: 50%; background: #3f3752; }
  .traffic i:first-child { background: #f26d6d; }
  .traffic i:nth-child(2) { background: #f2b25c; }
  .traffic i:nth-child(3) { background: #63c98b; }
  .product-title { color: var(--ink-55); }
  .product-status { display: inline-flex; align-items: center; gap: 7px; }
  .product-status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #63c98b;
    box-shadow: 0 0 10px rgba(99, 201, 139, 0.4);
  }

  .product-window img {
    display: block;
    width: 100%;
    height: auto;
    will-change: transform;
    transform-origin: center top;
    border-radius: 0 0 20px 20px;
  }

  /* ---- belt ---- */

  .belt {
    width: min(980px, calc(100% - 40px));
    margin: clamp(52px, 7vw, 88px) auto 0;
    padding: 30px 0;
    overflow: hidden;
    background: var(--glass-fill);
    border: 1px solid var(--glass-line);
    border-radius: 24px;
    box-shadow: var(--glass-shadow-soft);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
  }

  .belt > p {
    margin: 0 auto 26px;
    width: min(680px, calc(100% - 40px));
    color: var(--ink-40);
    font-size: 13px;
    text-align: center;
    letter-spacing: 0.01em;
  }

  .marquee {
    position: relative;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
  }

  .marquee-track {
    display: flex;
    align-items: center;
    gap: 52px;
    width: max-content;
    padding-right: 52px;
    animation: marquee 44s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-track span {
    color: var(--ink-55);
    font-size: clamp(15px, 1.7vw, 18px);
    font-weight: 500;
    white-space: nowrap;
  }

  .marquee-static {
    display: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 28px;
    list-style: none;
  }

  .marquee-static li {
    color: var(--ink-55);
    font-size: 14px;
    font-weight: 500;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      mask-image: none;
      -webkit-mask-image: none;
    }
    .marquee-track { display: none; }
    .marquee-static { display: flex; }
  }

  /* ---- product loop ---- */

  .section-width {
    width: min(1080px, calc(100% - 40px));
    margin-inline: auto;
  }

  .section-heading {
    max-width: 760px;
  }

  .section-kicker {
    margin: 0 0 13px;
    color: var(--purple-soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .section-heading h2,
  .runtime-intro h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(30px, 4.4vw, 50px);
    font-weight: 590;
    line-height: 1.06;
    letter-spacing: -0.035em;
  }

  .section-heading > p:last-child,
  .runtime-intro > p:last-child {
    margin: 20px 0 0;
    color: var(--ink-55);
    font-size: 16px;
    line-height: 1.7;
  }

  /* Chapter heads carry the Apple-scale voice: bigger, tighter, brighter. */
  .chapter-head h2 {
    font-size: clamp(34px, 5.4vw, 62px);
    font-weight: 620;
    line-height: 1.02;
    letter-spacing: -0.042em;
    background: linear-gradient(180deg, #ffffff 62%, #cdb6ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .chapter-head > p:last-child {
    max-width: 58ch;
    font-size: 17px;
  }

  .suite {
    margin-top: clamp(68px, 10vw, 126px);
  }

  .suite-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 44px;
    overflow: hidden;
    border: 1px solid var(--glass-line);
    border-radius: 24px;
    background: var(--glass-line);
    box-shadow: var(--glass-shadow);
  }

  .suite-grid article {
    min-height: 226px;
    background: color-mix(in srgb, var(--glass-fill-strong) 96%, #15131a);
    padding: 26px;
    backdrop-filter: blur(28px) saturate(140%);
    -webkit-backdrop-filter: blur(28px) saturate(140%);
  }

  .suite-icon {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid rgba(184, 158, 252, 0.22);
    border-radius: 10px;
    background: rgba(147, 116, 236, 0.11);
    color: var(--purple-soft);
  }

  .suite-grid small {
    display: block;
    margin-top: 22px;
    color: var(--purple-soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .suite-grid h3 {
    margin: 6px 0 0;
    color: white;
    font-size: 21px;
    font-weight: 590;
  }

  .suite-grid p {
    max-width: 48ch;
    margin: 11px 0 0;
    color: var(--ink-45);
    font-size: 12.5px;
    line-height: 1.62;
  }

  .workflow {
    margin-top: clamp(64px, 9vw, 112px);
    padding: clamp(34px, 5vw, 58px);
    background: var(--glass-fill-strong);
    border: 1px solid var(--glass-line);
    border-radius: 30px;
    box-shadow: var(--glass-shadow);
    backdrop-filter: blur(30px) saturate(145%);
    -webkit-backdrop-filter: blur(30px) saturate(145%);
  }

  .workflow-list {
    margin: 48px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border-top: 1px solid rgba(227, 215, 255, 0.14);
    border-bottom: 1px solid rgba(227, 215, 255, 0.14);
    list-style: none;
  }

  .workflow-list li {
    min-height: 166px;
    padding: 22px 17px;
    border-right: 1px solid rgba(227, 215, 255, 0.12);
  }

  .workflow-list li:last-child { border-right: 0; }
  .workflow-list li > span {
    color: var(--purple-soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
  }
  .workflow-list strong {
    display: block;
    margin-top: 24px;
    color: #f3eef9;
    font-size: 14px;
    font-weight: 600;
  }
  .workflow-list li p {
    margin: 9px 0 0;
    color: var(--ink-40);
    font-size: 12px;
    line-height: 1.55;
  }

  /* ---- features ---- */

  .features {
    padding: clamp(24px, 4vw, 48px) 0;
  }

  .feature {
    width: min(820px, calc(100% - 40px));
    margin-inline: auto;
    padding: clamp(44px, 6vw, 64px) 0;
    display: grid;
    gap: 22px;
  }

  .feature-tag {
    margin: 0 0 10px;
    color: var(--purple-soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .feature-copy {
    padding: 25px 26px 27px;
    background: var(--glass-fill);
    border: 1px solid var(--glass-line);
    border-radius: 24px;
    box-shadow: var(--glass-shadow-soft);
    backdrop-filter: blur(24px) saturate(145%);
    -webkit-backdrop-filter: blur(24px) saturate(145%);
  }

  .feature h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(20px, 2.6vw, 24px);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .feature-body {
    margin: 12px 0 0;
    color: var(--ink-55);
    font-size: 15.5px;
    line-height: 1.65;
  }

  .feature-card {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--hairline);
    padding: 7px;
    border-radius: 26px;
    background: var(--card);
    box-shadow: var(--glass-shadow);
    backdrop-filter: blur(28px) saturate(145%);
    -webkit-backdrop-filter: blur(28px) saturate(145%);
    transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1), border-color 360ms ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: rgba(167, 124, 255, 0.4);
  }

  .card-topline {
    min-height: 36px;
    padding: 0 13px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    color: var(--ink-40);
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(190, 166, 255, 0.1);
    border-radius: 18px 18px 0 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10.5px;
    letter-spacing: 0.04em;
  }

  .feature-card img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0 0 18px 18px;
  }

  .feature-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    width: fit-content;
    min-height: 38px;
    padding: 0 14px;
    color: #fff !important;
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid var(--glass-line);
    border-radius: 999px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    font-size: 14px;
    font-weight: 550;
    text-decoration: none;
  }

  .feature-link svg {
    transition: transform 180ms ease;
  }

  .feature-link:hover svg {
    transform: translateX(3px);
  }

  /* ---- observable runtime and proof ---- */

  .runtime,
  .evidence,
  .connections,
  .comparison-section {
    margin-top: clamp(56px, 8vw, 96px);
    padding: clamp(34px, 5vw, 58px);
    background: var(--glass-fill-strong);
    border: 1px solid var(--glass-line);
    border-radius: 30px;
    box-shadow: var(--glass-shadow);
    backdrop-filter: blur(30px) saturate(145%);
    -webkit-backdrop-filter: blur(30px) saturate(145%);
  }

  .runtime {
    display: grid;
    grid-template-columns: minmax(260px, 0.76fr) minmax(0, 1.24fr);
    gap: clamp(40px, 7vw, 84px);
    align-items: start;
  }

  .runtime-intro {
    position: sticky;
    top: 106px;
  }

  .runtime-list {
    border-top: 1px solid rgba(227, 215, 255, 0.14);
  }

  .runtime-list article {
    padding: 24px 0;
    display: grid;
    grid-template-columns: 30px minmax(120px, 0.48fr) minmax(0, 1fr);
    gap: 18px;
    border-bottom: 1px solid rgba(227, 215, 255, 0.14);
  }

  .runtime-list article > span {
    color: var(--purple-soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
  }

  .runtime-list h3,
  .connection-grid h3 {
    margin: 0;
    color: #f2edf7;
    font-size: 13.5px;
    font-weight: 600;
  }

  .runtime-list article p,
  .connection-grid article p {
    margin: 0;
    color: var(--ink-40);
    font-size: 12.5px;
    line-height: 1.65;
  }

  .evidence-grid {
    margin: 48px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid rgba(227, 215, 255, 0.14);
    border-bottom: 1px solid rgba(227, 215, 255, 0.14);
  }

  .evidence-grid div {
    min-height: 156px;
    padding: 23px 20px;
    border-right: 1px solid rgba(227, 215, 255, 0.12);
  }

  .evidence-grid div:last-child { border-right: 0; }
  .evidence-grid dt { color: var(--ink-40); font-size: 11px; }
  .evidence-grid dd {
    margin: 21px 0 5px;
    color: #f5f0fa;
    font-size: clamp(29px, 4vw, 37px);
    font-weight: 590;
    letter-spacing: -0.03em;
  }
  .evidence-grid span { color: var(--ink-40); font-size: 11px; }

  .connection-grid {
    margin-top: 46px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid rgba(227, 215, 255, 0.14);
    border-left: 1px solid rgba(227, 215, 255, 0.14);
    border-radius: 18px;
    overflow: hidden;
  }

  .connection-grid article {
    min-height: 126px;
    padding: 23px;
    background: rgba(255, 255, 255, 0.025);
    border-right: 1px solid rgba(227, 215, 255, 0.14);
    border-bottom: 1px solid rgba(227, 215, 255, 0.14);
  }

  .connection-grid article p { margin-top: 11px; }

  .comparison {
    margin-top: 44px;
    overflow: hidden;
    background: rgba(4, 3, 7, 0.25);
    border: 1px solid rgba(227, 215, 255, 0.14);
    border-radius: 20px;
  }

  .comparison summary {
    min-height: 62px;
    padding: 0 19px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    color: #e5dfee;
    cursor: pointer;
    font-size: 13.5px;
    list-style: none;
  }

  .comparison summary::-webkit-details-marker { display: none; }
  .comparison summary svg { transition: transform 180ms ease; }
  .comparison[open] summary svg { transform: rotate(180deg); }
  .comparison-scroll {
    overflow-x: auto;
    border-top: 1px solid rgba(227, 215, 255, 0.14);
  }
  .comparison table { width: 100%; min-width: 880px; border-collapse: collapse; }
  .comparison th,
  .comparison td {
    padding: 15px 13px;
    color: var(--ink-40);
    border-bottom: 1px solid rgba(227, 215, 255, 0.1);
    font-size: 11.5px;
    text-align: left;
  }
  .comparison thead th { color: var(--ink-55); font-weight: 600; }
  .comparison tbody th { color: var(--ink-70); font-weight: 550; }
  .comparison th:nth-child(2),
  .comparison td:nth-child(2) {
    color: #d4c3ff;
    background: rgba(126, 83, 220, 0.08);
  }

  /* ---- changelog ---- */

  .changelog {
    padding: 42px 0;
  }

  .changelog-inner {
    width: min(820px, calc(100% - 40px));
    margin-inline: auto;
    padding: clamp(42px, 6vw, 66px);
    background: var(--glass-fill-strong);
    border: 1px solid var(--glass-line);
    border-radius: 28px;
    box-shadow: var(--glass-shadow);
    backdrop-filter: blur(30px) saturate(145%);
    -webkit-backdrop-filter: blur(30px) saturate(145%);
  }

  .changelog h2 {
    margin: 0 0 34px;
    color: #fff;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .changelog ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .changelog li {
    padding: 22px 0;
    display: grid;
    grid-template-columns: 118px 1fr;
    gap: 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .changelog-date {
    color: var(--ink-40);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    padding-top: 3px;
  }

  .changelog strong {
    display: block;
    color: #fff;
    font-size: 15px;
    font-weight: 600;
  }

  .changelog li p {
    margin: 7px 0 0;
    color: var(--ink-55);
    font-size: 14px;
    line-height: 1.6;
  }

  .changelog-link {
    margin-top: 26px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 38px;
    padding: 0 14px;
    color: #fff !important;
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid var(--glass-line);
    border-radius: 999px;
    font-size: 14px;
    font-weight: 550;
    text-decoration: none;
  }

  .changelog-link svg {
    transition: transform 180ms ease;
  }

  .changelog-link:hover svg {
    transform: translateX(3px);
  }

  /* ---- connected product system ---- */

  .product-system {
    margin-top: clamp(72px, 10vw, 150px);
    padding: clamp(44px, 7vw, 82px);
    background: var(--glass-fill-strong);
    border: 1px solid var(--glass-line);
    border-radius: 28px;
    box-shadow: var(--glass-shadow-soft);
    backdrop-filter: blur(28px) saturate(145%);
    -webkit-backdrop-filter: blur(28px) saturate(145%);
  }

  .product-system-grid {
    margin-top: 46px;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
  }

  .product-system-grid article {
