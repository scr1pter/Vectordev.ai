---
import "@fontsource-variable/inter"
import {
  AppWindow,
  ArrowRight,
  BadgeCheck,
  Bot,
  ChevronLeft,
  ChevronRight,
  Coins,
  Eye,
  GitBranch,
  GitPullRequest,
  GitFork,
  Laptop,
  Lock,
  Network,
  Plus,
  Radar,
  Rocket,
  ShieldCheck,
  ScanEye,
  Sparkles,
  Split,
  Terminal,
  Waypoints,
  Workflow,
} from "lucide-react"
import MarketingNav from "./marketing/MarketingNav.astro"
import ProductDemo from "./marketing/ProductDemo.astro"
import LanderMotion from "./marketing/LanderMotion.astro"
import LanderMaterials from "./marketing/LanderMaterials.astro"
import LandingFooter from "./marketing/LandingFooter.astro"
import ScrollTicks from "./marketing/ScrollTicks.astro"

// Everything the product does, section by section, lives on /docs/product.
// This page is the short version: the hero and its one interactive picture,
// two things worth knowing in detail, why the agent can be trusted, and a way in.

// The OpenCode Zen models Vector includes today, with no API key. Named, never
// counted: the lineup changes as model makers add and retire models.
const includedModels = [
  "Big Pickle",
  "Nemotron 3 Ultra",
  "Nemotron 3.5 Lightning",
  "Muse Spark 1.3",
  "Muse Spark 1.2",
  "MiMo V2.5",
  "Ling 3.0 Flash Fin",
]

// The work Vector does in one window. Six, so the grid fills two even rows.
const workspaceFacts = [
  {
    title: "As many agents as you want",
    text: "No cap. Each one works in its own copy of the repository, and you merge the ones that landed.",
  },
  {
    title: "Subagents for the parts",
    text: "A large task splits itself, the pieces run at once, and a card shows what each one is doing.",
  },
  {
    title: "Ships to your own cloud",
    text: "Provision Supabase, sync environment values, publish to your Vercel or Netlify account.",
  },
  {
    title: "Reviewed before main",
    text: "A summary and line comments on every pull request, or run the same pass on your branch first.",
  },
  {
    title: "A browser it drives",
    text: "It loads your app, clicks through it, reads the console, and tells you what actually happened.",
  },
  {
    title: "A tokenomics engine",
    text: "Tokens and cost as the provider reported them, with limits per run, per day and per project.",
  },
]

// The one-click plugins in the workspace: the count, and a sample to name
// (packages/app/src/components/plugins/catalog.tsx — keep the number in step with it).
const pluginCount = 135
const pluginNames = [
  "GitHub",
  "Linear",
  "Sentry",
  "Supabase",
  "Vercel",
  "Figma",
  "Notion",
  "Stripe",
  "Postgres",
  "Slack",
  "Playwright",
  "Your own MCP server",
]

const pixelFont: Record<string, string[]> = {
  V: ["10001", "10001", "10001", "10001", "10001", "01010", "00100"],
  E: ["11111", "10000", "10000", "11110", "10000", "10000", "11111"],
  C: ["01111", "10000", "10000", "10000", "10000", "10000", "01111"],
  T: ["11111", "00100", "00100", "00100", "00100", "00100", "00100"],
  O: ["01110", "10001", "10001", "10001", "10001", "10001", "01110"],
  R: ["11110", "10001", "10001", "11110", "10100", "10010", "10001"],
}

const wordmarkCells = "VECTOR".split("").flatMap((letter, letterIndex) =>
  pixelFont[letter].flatMap((row, y) =>
    row.split("").flatMap((cell, x) => (cell === "1" ? [{ x: letterIndex * 7 + x, y }] : [])),
  ),
)

// The shelf of things Vector does, each sentence checked against the code that
// ships it and linked to the docs section that describes it in full. Order:
// review, the browser, the agents, what it ships to, then how it keeps itself
// honest.
const trustCards = [
  {
    icon: GitPullRequest,
    lead: "AI code reviews.",
    text: "On every pull request: a summary, comments on the exact lines, a fix you can commit — and it never approves.",
    href: "/docs#code-review",
    more: "Read about code review",
  },
  {
    icon: ShieldCheck,
    lead: "Security gets its own reader.",
    text: "Touch auth, crypto, SQL, payments or a workflow file and a second, security-only review runs beside the first.",
    href: "/docs#code-review",
    more: "Read what the security pass covers",
  },
  {
    icon: Terminal,
    lead: "Reviewed before you push.",
    text: "One command runs the same review on your branch, against its merge base, before anyone else sees it.",
    href: "/docs#code-review",
    more: "Read about reviewing before you push",
  },
  {
    icon: AppWindow,
    lead: "A real browser, not screenshots.",
    text: "Vector opens a Chromium view in its own window: the agent drives the page, and you can take it over.",
    href: "/docs#controlled-browser",
    more: "Read about the controlled browser",
  },
  {
    icon: ScanEye,
    lead: "It sees what it clicked.",
    text: "Every action hands back the page text, the clickable elements, runtime errors, console errors and failed requests.",
    href: "/docs#controlled-browser",
    more: "Read what the browser reports back",
  },
  {
    icon: Lock,
    lead: "Localhost until you approve.",
    text: "The browser opens local pages only until you approve an origin, and refuses to type into password or card fields.",
    href: "/docs#controlled-browser",
    more: "Read about the browser's guardrails",
  },
  {
    icon: Network,
    lead: "Run agents side by side.",
    text: "Start as many as you like: each works in its own git worktree, or a managed copy when a worktree won't do.",
    href: "/docs#agent-workspaces",
    more: "Read about agent workspaces",
  },
  {
    icon: Waypoints,
    lead: "Agents talk where you link them.",
    text: "Wire a team everyone-to-everyone or through one coordinator; a message to a pair you never linked is refused.",
    href: "/docs#agent-workspaces",
    more: "Read about agent teams",
  },
  {
    icon: GitBranch,
    lead: "Agents split their own work.",
    text: "One agent delegates to nine built-in subagents — and four of them cannot edit a file, whatever the repo config says.",
    href: "/docs#subagents",
    more: "Read about subagents and specialists",
  },
  {
    icon: Workflow,
    lead: "One objective, many agents.",
    text: "Vector plans the task graph itself, gives each task its own agent and model, and runs them in dependency order.",
    href: "/docs#agent-workspaces",
    more: "Read about coordinated runs",
  },
  {
    icon: Rocket,
    lead: "Ship from your own accounts.",
    text: "Connect Vercel, Netlify or Supabase and deploy on your own tokens, encrypted on your machine.",
    href: "/docs#cloud-services",
    more: "Read about Cloud Services",
  },
  {
    icon: Radar,
    lead: "Deploys check themselves.",
    text: "Vector scans the build for leaked secrets, health-checks the live URL, and reads the provider's logs back.",
    href: "/docs#cloud-services",
    more: "Read what Vector checks before it publishes",
  },
  {
    icon: GitFork,
    lead: "GitHub, GitLab and AWS.",
    text: "Pull requests and review on GitHub, sign-in, repositories and pushes on GitLab, read-only checks on your AWS.",
    href: "/docs#cloud-services",
    more: "Read about the integrations",
  },
  {
    icon: BadgeCheck,
    lead: "A second check on done.",
    text: "Turn the judge on and a read-only subagent weighs your request, the changed files and the test output.",
    href: "/docs#verified-completion",
    more: "Read about verified completion",
  },
  {
    icon: Split,
    lead: "Merge the hunks you trust.",
    text: "Tick the parts of an agent's diff you want and Vector merges a patch built from exactly those.",
    href: "/docs#only-in-vector",
    more: "Read about selective merges",
  },
  {
    icon: Eye,
    lead: "Watch it type.",
    text: "Follow mode opens the file an agent is about to change and tints those lines in that agent's own colour.",
    href: "/docs#follow",
    more: "Read about Follow mode",
  },
  {
    icon: Sparkles,
    lead: "Start with no key at all.",
    text: "Models come included with Vector, in the desktop app and the terminal alike, before you connect a provider.",
    href: "/docs#models",
