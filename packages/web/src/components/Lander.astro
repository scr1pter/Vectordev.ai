    color: var(--ink-55);
    font-size: 14.5px;
    line-height: 1.65;
  }

  .proof-shot-frame {
    margin: 0;
    overflow: hidden;
    padding: 6px;
    border: 1px solid var(--glass-line);
    border-radius: 20px;
    background: var(--glass-fill-strong);
    box-shadow: var(--glass-shadow);
  }

  .proof-shot-frame img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
  }

  /* ---- tally ---- */

  .tally {
    display: grid;
    gap: 18px;
    margin-top: clamp(52px, 7vw, 92px);
    padding: clamp(26px, 3vw, 38px) clamp(22px, 3vw, 40px);
    border: 1px solid var(--glass-line);
    border-radius: 24px;
    background: var(--glass-fill);
    box-shadow: var(--glass-shadow-soft);
  }

  @media (min-width: 760px) {
    .tally {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 26px;
    }
  }

  .tally strong {
    display: block;
    color: var(--ink);
    font-size: clamp(30px, 4.4vw, 46px);
    font-weight: 600;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .tally span {
    display: block;
    margin-top: 8px;
    color: var(--ink-45);
    font-size: 12.5px;
    line-height: 1.5;
  }

  /* ---- pull quote ---- */

  .pullquote {
    margin: clamp(64px, 10vw, 132px) auto;
    text-align: center;
  }

  .pullquote blockquote {
    max-width: 20ch;
    margin: 0 auto;
    color: var(--ink);
    font-size: clamp(28px, 5.2vw, 58px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .hero-ship {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px 0 0;
    color: var(--ink-40);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    letter-spacing: 0.01em;
  }

  .hero-ship-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #6ee7b7;
    box-shadow: 0 0 10px rgba(110, 231, 183, 0.55);
  }

  .hero-ship-sep {
    opacity: 0.4;
  }

  /* Rows land one after another instead of the whole grid appearing at once. */
  .comparison-section tbody tr {
    animation: row-land 520ms cubic-bezier(0.22, 1, 0.36, 1) backwards;
    animation-delay: calc(var(--row, 0) * 55ms);
  }

  @keyframes row-land {
    from {
      opacity: 0;
      transform: translateY(9px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .comparison-section tbody tr {
      animation: none;
    }
  }

  .showcase-note {
    margin: 12px 0 0;
    text-align: center;
    font-size: 12.5px;
    color: var(--ink-40);
  }

  .product-window {
    margin: 0;
    overflow: hidden;
    padding: 7px;
    border: 1px solid rgba(235, 228, 255, 0.22);
    border-radius: 28px;
    background: var(--glass-fill-strong);
    box-shadow:
      0 40px 120px rgba(0, 0, 0, 0.66),
      0 0 80px rgba(132, 86, 219, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.13);
    backdrop-filter: blur(28px) saturate(145%);
    -webkit-backdrop-filter: blur(28px) saturate(145%);
  }

  .product-bar {
    min-height: 40px;
    padding: 0 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--ink-40);
    background: rgba(255, 255, 255, 0.045);
    border-bottom: 1px solid rgba(190, 166, 255, 0.1);
    border-radius: 20px 20px 0 0;
    font-size: 11.5px;
  }

  .traffic { display: inline-flex; gap: 6px; }
  .traffic i { width: 9px; height: 9px; border-radius: 50%; background: #3f3752; }
  .traffic i:first-child { background: #f26d6d; }
  .traffic i:nth-child(2) { background: #f2b25c; }
  .traffic i:nth-child(3) { background: #63c98b; }
  .product-title { color: var(--ink-55); }
  .product-status { display: inline-flex; align-items: center; gap: 7px; }
  .product-status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #63c98b;
    box-shadow: 0 0 10px rgba(99, 201, 139, 0.4);
  }

  .product-window img {
    display: block;
    width: 100%;
    height: auto;
    will-change: transform;
    transform-origin: center top;
    border-radius: 0 0 20px 20px;
  }

  /* ---- belt ---- */

  .belt {
    width: var(--measure);
    margin: clamp(52px, 7vw, 88px) auto 0;
    padding: 30px 0;
    overflow: hidden;
    background: var(--glass-fill);
    border: 1px solid var(--glass-line);
    border-radius: 24px;
    box-shadow: var(--glass-shadow-soft);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
  }

  .belt > p {
    margin: 0 auto 26px;
    width: min(680px, calc(100% - 40px));
    color: var(--ink-40);
    font-size: 13px;
    text-align: center;
    letter-spacing: 0.01em;
  }

  .marquee {
    position: relative;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
  }

  .marquee-track {
    display: flex;
    align-items: center;
    gap: 52px;
    width: max-content;
    padding-right: 52px;
    animation: marquee 44s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-track span {
    color: var(--ink-55);
    font-size: clamp(15px, 1.7vw, 18px);
    font-weight: 500;
    white-space: nowrap;
  }

  .marquee-static {
    display: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 28px;
    list-style: none;
  }

  .marquee-static li {
    color: var(--ink-55);
    font-size: 14px;
    font-weight: 500;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      mask-image: none;
      -webkit-mask-image: none;
    }
    .marquee-track { display: none; }
    .marquee-static { display: flex; }
  }

  /* ---- product loop ---- */

  .section-width {
    width: var(--measure);
    margin-inline: auto;
  }

  .section-heading {
    max-width: 760px;
  }

  .section-kicker {
    margin: 0 0 13px;
    color: var(--purple-soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .section-heading h2,
  .runtime-intro h2 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(30px, 4.4vw, 50px);
    font-weight: 590;
    line-height: 1.06;
    letter-spacing: -0.035em;
  }

  .section-heading > p:last-child,
  .runtime-intro > p:last-child {
    margin: 20px 0 0;
    color: var(--ink-55);
    font-size: 16px;
    line-height: 1.7;
  }

  /* Chapter heads carry the Apple-scale voice: bigger, tighter, brighter. */
  .chapter-head h2 {
    font-size: clamp(34px, 5.4vw, 62px);
    font-weight: 620;
    line-height: 1.02;
    letter-spacing: -0.042em;
    background: linear-gradient(180deg, #ffffff 62%, #cdb6ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .chapter-head > p:last-child {
    max-width: 58ch;
    font-size: 17px;
  }

  .suite {
    margin-top: clamp(68px, 10vw, 126px);
  }

  .suite-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 44px;
    overflow: hidden;
    border: 1px solid var(--glass-line);
    border-radius: 24px;
    background: var(--glass-line);
    box-shadow: var(--glass-shadow);
  }

  .suite-grid article {
    min-height: 226px;
    background: color-mix(in srgb, var(--glass-fill-strong) 96%, #15131a);
    padding: 26px;
    backdrop-filter: blur(28px) saturate(140%);
    -webkit-backdrop-filter: blur(28px) saturate(140%);
  }

  .suite-icon {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid rgba(184, 158, 252, 0.22);
    border-radius: 10px;
    background: rgba(147, 116, 236, 0.11);
    color: var(--purple-soft);
  }

  .suite-grid small {
    display: block;
    margin-top: 22px;
    color: var(--purple-soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .suite-grid h3 {
    margin: 6px 0 0;
    color: white;
    font-size: 21px;
    font-weight: 590;
  }

  .suite-grid p {
    max-width: 48ch;
    margin: 11px 0 0;
    color: var(--ink-45);
    font-size: 12.5px;
    line-height: 1.62;
  }

  .workflow {
    margin-top: clamp(64px, 9vw, 118px);
    padding: clamp(34px, 5vw, 58px);
    background: var(--glass-fill-strong);
    border: 1px solid var(--glass-line);
    border-radius: 30px;
    box-shadow: var(--glass-shadow);
    backdrop-filter: blur(30px) saturate(145%);
    -webkit-backdrop-filter: blur(30px) saturate(145%);
  }

  .workflow-list {
    margin: 48px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border-top: 1px solid rgba(227, 215, 255, 0.14);
    border-bottom: 1px solid rgba(227, 215, 255, 0.14);
    list-style: none;
  }

  .workflow-list li {
    min-height: 166px;
    padding: 22px 17px;
    border-right: 1px solid rgba(227, 215, 255, 0.12);
  }

  .workflow-list li:last-child { border-right: 0; }
  .workflow-list li > span {
    color: var(--purple-soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
  }
  .workflow-list strong {
    display: block;
    margin-top: 24px;
    color: #f3eef9;
    font-size: 14px;
    font-weight: 600;
  }
  .workflow-list li p {
    margin: 9px 0 0;
    color: var(--ink-40);
    font-size: 12px;
    line-height: 1.55;
  }

  /* ---- features ---- */

  .features {
    padding: clamp(24px, 4vw, 48px) 0;
  }

  .feature {
    width: var(--measure);
    margin-inline: auto;
    padding: clamp(44px, 6vw, 64px) 0;
    display: grid;
    gap: 22px;
  }

  /* Side by side once there is room for both: the copy keeps a readable
     measure while the live surface gets the width it needs, and alternating
     which side leads stops the run of features reading as one long column. */
  @media (min-width: 1000px) {
    .feature {
      grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
      gap: clamp(28px, 3.4vw, 52px);
      align-items: center;
    }

    .features > .feature:nth-child(even) > .feature-copy {
      order: 2;
    }
  }

  .feature-tag {
    margin: 0 0 10px;
    color: var(--purple-soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .feature-copy {
    padding: 25px 26px 27px;
    background: var(--glass-fill);
    border: 1px solid var(--glass-line);
    border-radius: 24px;
    box-shadow: var(--glass-shadow-soft);
    backdrop-filter: blur(24px) saturate(145%);
    -webkit-backdrop-filter: blur(24px) saturate(145%);
  }

  .feature h2 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(20px, 2.6vw, 24px);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .feature-body {
    margin: 12px 0 0;
    color: var(--ink-55);
    font-size: 15.5px;
    line-height: 1.65;
  }

  .feature-card {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--hairline);
    padding: 7px;
    border-radius: 26px;
    background: var(--card);
    box-shadow: var(--glass-shadow);
    backdrop-filter: blur(28px) saturate(145%);
    -webkit-backdrop-filter: blur(28px) saturate(145%);
    transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1), border-color 360ms ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: rgba(167, 124, 255, 0.4);
  }

  .card-topline {
    min-height: 36px;
    padding: 0 13px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    color: var(--ink-40);
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(190, 166, 255, 0.1);
    border-radius: 18px 18px 0 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10.5px;
    letter-spacing: 0.04em;
  }

  .feature-card img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0 0 18px 18px;
  }

  /* Stands in for a screenshot on the pillars the product does not show in one
     frame, at the same card size so no pillar reads as the smaller claim. */
  .feature-proof dl {
    margin: 0;
    display: grid;
    gap: 1px;
    overflow: hidden;
    border-radius: 0 0 18px 18px;
    background: rgba(190, 166, 255, 0.1);
  }

  .feature-proof dl > div {
    padding: 28px 26px;
    background: color-mix(in srgb, var(--glass-fill-strong) 96%, #15131a);
  }

  .feature-proof dt {
    margin: 0;
    color: var(--purple-soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .feature-proof dd {
    margin: 11px 0 0;
    color: var(--ink-40);
    font-size: 13.5px;
    line-height: 1.72;
  }

  .feature-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    width: fit-content;
    margin-top: 20px;
    min-height: 38px;
    padding: 0 14px;
    color: #fff !important;
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid var(--glass-line);
    border-radius: 999px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    font-size: 14px;
    font-weight: 550;
    text-decoration: none;
  }

  .feature-link svg {
    transition: transform 180ms ease;
  }

  .feature-link:hover svg {
    transform: translateX(3px);
  }

  /* ---- scheduled automation and stated conditions ---- */

  .card-topline span:first-child {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .automation-note {
    margin: clamp(24px, 3vw, 34px) 0 0;
    padding: 20px 22px;
    color: var(--ink-55);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--glass-line);
    border-radius: 18px;
    font-size: 13px;
    line-height: 1.72;
  }

  .automation-note strong {
    color: var(--purple-soft);
    font-weight: 600;
  }

  .automation-note code {
    padding: 1px 6px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(227, 215, 255, 0.16);
    border-radius: 6px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
    font-size: 11.5px;
  }

  /* ---- observable runtime and proof ---- */

  .runtime,
  .connections,
  .comparison-section,
  .automation,
  .crew {
    margin-top: clamp(56px, 8vw, 96px);
    padding: clamp(34px, 5vw, 58px);
    background: var(--glass-fill-strong);
    border: 1px solid var(--glass-line);
    border-radius: 30px;
    box-shadow: var(--glass-shadow);
    backdrop-filter: blur(30px) saturate(145%);
    -webkit-backdrop-filter: blur(30px) saturate(145%);
  }

  .runtime {
    display: grid;
    grid-template-columns: minmax(260px, 0.76fr) minmax(0, 1.24fr);
    gap: clamp(40px, 7vw, 84px);
    align-items: start;
  }

  .runtime-intro {
    position: sticky;
    top: 106px;
  }

  .runtime-list {
    border-top: 1px solid rgba(227, 215, 255, 0.14);
  }

  .runtime-list article {
    padding: 24px 0;
    display: grid;
    grid-template-columns: 30px minmax(120px, 0.48fr) minmax(0, 1fr);
    gap: 18px;
    border-bottom: 1px solid rgba(227, 215, 255, 0.14);
  }

  .runtime-list article > span {
    color: var(--purple-soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
  }

  .runtime-list h3,
  .connection-grid h3 {
    margin: 0;
    color: #f2edf7;
    font-size: 13.5px;
    font-weight: 600;
  }

  .runtime-list article p,
  .connection-grid article p {
    margin: 0;
    color: var(--ink-40);
    font-size: 12.5px;
    line-height: 1.65;
  }




  .connection-grid {
    margin-top: 46px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid rgba(227, 215, 255, 0.14);
    border-left: 1px solid rgba(227, 215, 255, 0.14);
    border-radius: 18px;
    overflow: hidden;
  }

  .connection-grid article {
    min-height: 126px;
    padding: 23px;
    background: rgba(255, 255, 255, 0.025);
    border-right: 1px solid rgba(227, 215, 255, 0.14);
    border-bottom: 1px solid rgba(227, 215, 255, 0.14);
  }

  .connection-grid article p { margin-top: 11px; }

  .comparison {
    margin-top: 44px;
    overflow: hidden;
    background: rgba(4, 3, 7, 0.25);
    border: 1px solid rgba(227, 215, 255, 0.14);
    border-radius: 20px;
  }

  .comparison summary {
    min-height: 62px;
    padding: 0 19px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    color: #e5dfee;
    cursor: pointer;
    font-size: 13.5px;
    list-style: none;
  }

  .comparison summary::-webkit-details-marker { display: none; }
  .comparison summary svg { transition: transform 180ms ease; }
  .comparison[open] summary svg { transform: rotate(180deg); }
  .comparison-scroll {
    overflow-x: auto;
    border-top: 1px solid rgba(227, 215, 255, 0.14);
  }
  .comparison table { width: 100%; min-width: 880px; border-collapse: collapse; }
  .comparison th,
  .comparison td {
    padding: 15px 13px;
    color: var(--ink-40);
    border-bottom: 1px solid rgba(227, 215, 255, 0.1);
    font-size: 11.5px;
    text-align: left;
  }
  .comparison thead th { color: var(--ink-55); font-weight: 600; }
  .comparison tbody th { color: var(--ink-70); font-weight: 550; }
  .comparison th:nth-child(2),
  .comparison td:nth-child(2) {
    color: #d4c3ff;
    background: rgba(126, 83, 220, 0.08);
  }

  /* ---- the crew ---- */

  .crew-grid {
    margin-top: 46px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .crew-grid article {
    min-height: 224px;
    padding: 22px;
    background: rgba(7, 5, 10, 0.42);
    border: 1px solid rgba(227, 215, 255, 0.11);
    border-radius: 16px;
    transition: transform 220ms ease, border-color 220ms ease, background 220ms ease;
  }

  .crew-grid article:hover {
    transform: translateY(-3px);
    border-color: hsl(var(--crew-hue) 70% 72% / 0.34);
    background: rgba(38, 27, 57, 0.6);
  }

  .crew-mark {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: hsl(var(--crew-hue) 78% 72%);
    background: hsl(var(--crew-hue) 72% 62% / 0.1);
    border: 1px solid hsl(var(--crew-hue) 72% 72% / 0.2);
    border-radius: 13px;
  }

  .crew-mark svg {
    width: 30px;
    height: 30px;
  }

  .crew-grid small {
    display: block;
    margin-top: 18px;
    color: var(--ink-40);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .crew-grid h3 {
    margin: 6px 0 0;
    color: #f6f2fb;
    font-size: 17px;
    font-weight: 600;
  }

  .crew-species {
    color: var(--ink-55);
    font-weight: 500;
  }

  .crew-tagline {
    margin: 8px 0 0;
    color: hsl(var(--crew-hue) 72% 78%);
    font-size: 12.5px;
    font-style: italic;
  }

  .crew-role {
    margin: 9px 0 0;
    color: var(--ink-40);
    font-size: 12.5px;
    line-height: 1.62;
  }

  /* ---- changelog ---- */

  .changelog {
    padding: 42px 0;
  }

  .changelog-inner {
    width: var(--measure);
    margin-inline: auto;
    padding: clamp(42px, 6vw, 66px);
    background: var(--glass-fill-strong);
    border: 1px solid var(--glass-line);
    border-radius: 28px;
    box-shadow: var(--glass-shadow);
    backdrop-filter: blur(30px) saturate(145%);
    -webkit-backdrop-filter: blur(30px) saturate(145%);
