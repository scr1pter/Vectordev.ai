---
import { ArrowRight, BadgeCheck, Brain, CalendarClock, ChevronDown, Cloud, CloudUpload, Code2, Coins, Globe2, Puzzle, ShieldCheck, Terminal, Users } from "lucide-react"
import MarketingFooter from "./marketing/MarketingFooter.astro"
import MarketingNav from "./marketing/MarketingNav.astro"
import ProductDemo from "./marketing/ProductDemo.astro"
import LanderMotion from "./marketing/LanderMotion.astro"
import LanderMaterials from "./marketing/LanderMaterials.astro"
import desktopPackage from "../../../desktop/package.json"
import { release119, release199 } from "../data/vector-releases"
import sessionScreenshot from "../assets/lander/vector-session-live.png"
import FeatureDemo from "./marketing/FeatureDemo.astro"

// Read from the desktop package and the release log at build time rather than
// typed in, so the page cannot advertise a version that was never shipped.
const currentVersion = desktopPackage.version
const currentRelease = [...release119, ...release199].find((release) => release.version === currentVersion)

const pixelFont: Record<string, string[]> = {
  V: ["10001", "10001", "10001", "10001", "10001", "01010", "00100"],
  E: ["11111", "10000", "10000", "11110", "10000", "10000", "11111"],
  C: ["01111", "10000", "10000", "10000", "10000", "10000", "01111"],
  T: ["11111", "00100", "00100", "00100", "00100", "00100", "00100"],
  O: ["01110", "10001", "10001", "10001", "10001", "10001", "01110"],
  R: ["11110", "10001", "10001", "11110", "10100", "10010", "10001"],
}

const wordmarkCells = "VECTOR".split("").flatMap((letter, letterIndex) =>
  pixelFont[letter].flatMap((row, y) =>
    row.split("").flatMap((cell, x) => (cell === "1" ? [{ x: letterIndex * 7 + x, y }] : [])),
  ),
)

const ecosystem = [
  "Claude Code",
  "Codex",
  "Cursor Agent",
  "Anthropic",
  "OpenAI",
  "Google",
  "MCP",
  "GitHub",
  "GitLab",
  "Linear",
  "Sentry",
  "Figma",
  "Stripe",
  "Vercel",
  "Netlify",
  "Supabase",
  "AWS",
  "Playwright",
]

// The nine parts of the workspace, in the order the page argues them. Each one
// gets a card here and a full section below, so no single capability carries
// the page on its own.
const pillars = [
  {
    name: "The workspace",
    eyebrow: "Editor, file search, diagnostics, terminal",
    body: "Agent and Editor are two modes over the same local repository and session, with project-wide file search, diagnostics, a terminal, browser, review, and the same agent beside the file you opened.",
    icon: Code2,
  },
  {
    name: "Local memory",
    eyebrow: "One file, on your machine",
    body: "What you choose to save about how you work is stored in a Markdown file in Vector's local app config directory and deleted when you erase it. The file is not uploaded to Vector's servers; when it exists, Vector automatically includes it in built-in agent context sent to the model provider you chose.",
    icon: Brain,
  },
  {
    name: "Model economics",
    eyebrow: "Provider-reported, or nothing",
    body: "The tokens and cost a run spent, taken from what the provider itself reported. Nothing estimated. A run nothing reported is marked unmeasured rather than shown as free.",
    icon: Coins,
  },
  {
    name: "Controlled browser",
    eyebrow: "Observe, repair, retest",
    body: "A real browser view the agent drives against the running product — and one that refuses to type into password, one-time-code and card fields, handing the step to you instead.",
    icon: Globe2,
  },
  {
    name: "Verified completion",
    eyebrow: "Opt-in · not on plan or quick",
    body: "Turn on LLM-as-a-judge and a separate subagent compares the finished work against your original request and the evidence, and sends it back for repair on a failed verdict.",
    icon: BadgeCheck,
  },
  {
    name: "Cloud Services",
    eyebrow: "Your own accounts",
    body: "Deployments, domains with real DNS checks, environment variables, databases and logs, run through the Vercel, Netlify, Supabase and AWS accounts that already belong to you.",
    icon: Cloud,
  },
  {
    name: "MCP and plugins",
    eyebrow: "118 ready to connect",
    body: "GitHub, Linear, Sentry, Figma, Playwright, Postgres, Stripe, Slack and more, plus any MCP server you add — and Vector installs the runtime a plugin needs instead of sending you to a terminal.",
    icon: Puzzle,
  },
  {
    name: "Parallel agents",
    eyebrow: "Up to 16 · isolated or shared",
    body: "When one agent is not enough, run several in their own checkouts or together in one, watch them from a single dashboard, and merge only what you trust.",
    icon: Users,
  },
  {
    name: "Automations",
    eyebrow: "Desktop · runs with no window open",
    body: "Recurring work across repositories on a repeat you set, each run a real session with a transcript waiting, still firing after the last window is closed.",
    icon: CalendarClock,
  },
]

type FeatureKind = "editor" | "memory" | "browser" | "cloud" | "agents" | "automations" | "work" | "cost" | "terminal" | "diff"

type Feature = {
  title: string
  body: string
  tag: string
  note: string
  href: string
  link: string
  demo?: FeatureKind
  proof?: string[][]
}

// Each pillar in full. `proof` stands in for an interactive demo on the
// pillars the product does not show in a single frame.
const features: Feature[] = [
  {
    title: "Agent and Editor, without losing the thread.",
    body: "Vector opens a repository that is already on your computer and keeps Agent and Editor as two views of the same session. Search across the project, open files in full-screen tabs, use language diagnostics and the terminal, edit directly, or ask the agent beside the file to make the change. The browser and review stay attached to that same workspace, and edits an agent makes while you watch remain attributable. None of this is a hosted IDE: the files are the files on your disk, and your repository is never proxied through Vector.",
    tag: "Agent and Editor",
    note: "Your files, on your disk",
    demo: "editor",
    href: "/docs",
    link: "Explore Agent and Editor",
  },
  {
    title: "It remembers how you work, with storage you can inspect.",
    body: "Vector lets you save durable facts about how you work — your stack, your conventions, the corrections you would otherwise repeat — in one MEMORY.md file inside Vector's local app config directory. It is read across every project and repository. The file stays on your computer rather than being uploaded to Vector's servers; when it exists, Vector automatically includes it in built-in agent context sent to the model provider you selected. Settings lets you add and edit the text and shows the exact platform-specific path, size, and last change. Erasing it deletes the file rather than blanking it.",
    tag: "Local memory",
    note: "Stored locally · inspect or erase",
    demo: "memory",
    href: "/docs",
    link: "How local memory works",
  },
  {
    title: "What the run cost, as the provider reported it.",
    body: "Vector records what a run cost by reading the numbers the provider itself reported on the assistant messages — input, output, reasoning, cache reads and cache writes — along with the provider's own cost figure. Nothing is estimated from character counts. A run whose provider reported no usage is recorded as unmeasured rather than as zero, because a fabricated zero reads as free. Finished work builds a ledger of outcomes per kind of task, and once a model has at least three recorded runs in a category Vector can suggest it in the composer, ranked by check pass rate first, measured cost second, median latency third. Below three it suggests nothing at all: the cold start is silent rather than confident.",
    tag: "Model economics",
    note: "Measured, or marked unmeasured",
    demo: "cost",
    href: "/docs",
    link: "Read how spend is measured",
  },
  {
    title: "The browser is part of the loop, and it will not touch your password.",
    body: "The browser is a real Chromium view embedded in the Vector window, not a screenshot service. The agent opens the running product, clicks and types, reads console and network failures, captures what it saw, repairs the code, and loads the page again. It will not type into a password field, a one-time-code field, or a card number field — that is refused where the keystrokes are executed, not merely discouraged in a prompt — and the run hands you the live browser to finish that step yourself before carrying on from what it can see. You can take the browser back at any other moment too, and everything it observed stays attached to the session that asked for it.",
    tag: "Controlled browser",
    note: "Refuses credential fields",
    demo: "browser",
    href: "/docs",
    link: "See the browser loop",
  },
  {
    title: "Completion you can check, instead of a confident summary.",
    body: "Turn on LLM-as-a-judge and finishing stops being the agent's own opinion. Before it starts, it writes down the observable success criteria your request implies. After implementing, it has to exercise the work rather than describe it — run the tests, typechecks, build, browser or CLI checks — and capture what they actually printed. It then hands the original request, those criteria, the changed files and that evidence to a separate judge subagent, which returns PASS, FAIL, or INCONCLUSIVE. A FAIL has to name each blocking finding with its evidence and the specific repair; the agent applies them and is judged again, up to three rounds, then reports what is still blocking. It is off until you turn it on, it costs extra model calls, and it does not apply to the plan or quick lanes.",
    tag: "Verified completion",
    note: "Opt-in · extra model calls",
    demo: "terminal",
    href: "/docs",
    link: "Turn on verified completion",
  },
  {
    title: "Ship it on the accounts that are already yours.",
    body: "Deployments, domains, environment variables, databases, logs and build settings sit beside the project they belong to and run on accounts that already belong to you. Authorize Vercel, Netlify or Supabase once and Vector drives the deploy on your account, hands back the live URL, and can promote a release, roll one back, re-run its checks, or pull its runtime logs. An AWS profile already configured on this computer is read through the AWS CLI you installed. A custom domain is checked with a real DNS lookup, so “verified” means a CNAME actually resolves to the target rather than that a form was submitted. Your code is never proxied through Vector.",
    tag: "Cloud Services",
    note: "OAuth into your own account",
    demo: "cloud",
    href: "/docs",
    link: "Read about Cloud Services",
  },
  {
    title: "118 connectors, and the runtime installs itself.",
    body: "Vector ships a catalog of 118 connectors you can turn on today — GitHub, Linear, Sentry, Figma, Playwright, Supabase, Postgres, Stripe, Notion, Slack, Chrome DevTools, Context7, Exa, Greptile, CodeRabbit and more — grouped into categories like observability, project tracking, databases, design and search, alongside any MCP server you configure yourself. A further seventeen are listed in the catalog and marked coming soon rather than presented as ready. Several of them are published to PyPI and run through uvx, which most machines do not have. Rather than sending you to a terminal, Vector looks for that runner on your PATH and in the places uv actually installs itself, installs it through Astral's own installer when it is missing and tells you it is doing so, then rewrites the plugin's command to the resolved absolute path so it still spawns from a process that has no login shell.",
    tag: "MCP and plugins",
    note: "Catalog · plus your own servers",
    proof: [
      ["118 ready to connect", "GitHub, Linear, Sentry, Figma, Playwright, Supabase, Postgres, Stripe, Notion, Slack, Chrome DevTools, Context7, Exa, Greptile, CodeRabbit and more, by category. Seventeen further entries are marked coming soon."],
      ["Your own MCP servers too", "Anything you configure yourself runs beside the catalog entries, with the same tool surface for the agent."],
      ["No terminal detour", "A plugin that needs uvx gets it: resolved on PATH, installed through Astral's installer when absent, then rewritten to an absolute path."],
    ],
    href: "/docs",
    link: "Browse the connectors",
  },
  {
    title: "Start with the ticket. Close the loop from the same session.",
    body: "There is no separate Work product or ticket board in Vector. Instead, connect Jira, Linear, Slack, GitHub, Sentry and other systems through MCP, then use those tools from an ordinary project session. An agent can read the ticket's description, comments and links, navigate the repository, make the change, run the project's checks, open a pull request, and report back through the connected service. You stay the reviewer; the connected session handles the round trip.",
    tag: "End to end",
    note: "Connected-tool workflow",
    demo: "work",
    href: "/docs",
    link: "See the connectors",
  },
  {
    title: "Write the project rule once. Carry it across runtimes.",
    body: "Standards your team cares about, written the way you would say them in review and scoped to a repository or the files they govern. Vector saves project rules to .vector/RULES.md, making them committed and reviewable instead of a preference buried on one machine. Vector agents read that file as project instructions, while matching rules are included in the prompts Vector starts for Claude Code, Codex and Cursor. Clone the repository and the committed project rules come with it.",
    tag: "Project rules",
    note: "Committed with the repo",
    proof: [
      ["Plain English", "Describe the standard the way you would in review. No configuration language, no rule engine, no schema to learn."],
      ["Scoped where it matters", "A rule can cover a whole repository, a folder, or a glob like src/app/web/*.tsx — and the scope travels into the prompt as words, so it still means something to the model."],
      ["Across supported runtimes", "Vector agents read the committed file; matching rules are included when Vector starts Claude Code, Codex or Cursor for that project."],
    ],
    href: "/docs",
    link: "Set your rules",
  },
  {
    title: "Every agent, on one board.",
    body: "The Agent Dashboard now opens on a board: Running, Needs you, Done. A card carries the task, what the agent is doing right now, how long it has been at it, and whether a pull request is already waiting. Search across names and tasks, then narrow by status, by runtime, by team, or to just the runs that opened a PR. Needs you deliberately merges failed with needs review — both are stopped and waiting on a person, and splitting them would put the same decision in two places. Teams stay first-class: agents that share a team or a swarm can be filtered as a unit, because in Vector they are not independent runs that happen to be adjacent — they message each other while they work.",
    tag: "Agent Dashboard",
    note: "Board or list",
    proof: [
      ["Three columns, honest ones", "Running, Needs you, Done — derived from real run state, including a finished run that reported an error and still needs a person."],
      ["Filters that compose", "Two statuses means either; a status and a runtime means both. Facet choices stay available from the whole dashboard, while counts, warnings, cards and team conversations follow the visible result."],
      ["Teams are a unit", "Filter by a team or a swarm and see only that crew, including the messages they sent each other mid-run."],
    ],
    href: "/docs",
    link: "See the dashboard",
  },
  {
    title: "Nothing lands until you say it lands.",
    body: "An agent works in its own git worktree or its own copy of the project, so while it is running your files are untouched. What comes back is a diff you review — and you merge it the way you would review a colleague's branch: hunk by hunk, keeping the parts that are right and leaving the rest behind. Vector writes a checkpoint before it touches your working tree, refuses the merge outright when a deterministic check is still failing, and tells you which files two agents are both holding so you never discover the conflict by merging into it. The agent proposes. You are still the one who decides what your project becomes.",
    tag: "Review and merge",
    note: "Hunk by hunk",
    demo: "diff",
    href: "/docs",
    link: "How review works",
  },
  {
    title: "And when one agent is not enough, run sixteen.",
    body: "A single task can hold up to sixteen active agents. Each gets its own checkout: a Git worktree on its own branch cut from HEAD when the project is a Git repository with a clean working tree, and an isolated copy of the project otherwise — Vector records which one it used rather than failing quietly. Or put them in one shared checkout, where they see each other's edits as they happen and message a named teammate or the whole team; you choose who may reach whom, and a message to someone you have not linked is refused with a reason rather than dropped. The dashboard shows status, model, files touched, cost so far, elapsed time, and both agents whenever two are holding the same file.",
    tag: "Parallel agents",
    note: "Isolated by default",
    demo: "agents",
    href: "/docs",
    link: "Learn about workspaces",
  },
  {
    title: "Work that repeats, whether or not you are there.",
    body: "Put recurring work on a repeat — every day, weekdays only, one weekday a week, or once at a set time — and each run opens a real Vector session in that project's directory, sends your prompt, and leaves the finished transcript waiting. One task can name several repositories, each with a new session or a thread you already have, and each reports its own result so one failure does not condemn the rest. A recurring task re-arms itself the moment a run settles. This lives in the Vector desktop app: close the last window and it stays resident in the menu bar or tray while tasks are armed, and on a desktop that offers no tray it closes as it always did rather than leaving a process you cannot quit.",
    tag: "Automations",
    note: "Desktop only",
    demo: "automations",
    href: "#conditions",
    link: "See what scheduling needs",
  },
]

// Every capability above that carries a condition, stated once, in one place.
const conditions = [
  [
    "Worktrees need clean Git",
