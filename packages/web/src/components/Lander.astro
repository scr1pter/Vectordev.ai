    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ---- motion system ---- */

  :global(html.va) [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 18px, 0);
    transition:
      opacity 640ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 640ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 640ms cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--rd, 0ms);
  }

  :global(html.va) [data-reveal].reveal-blur {
    filter: blur(14px);
  }

  :global(html.va) [data-reveal].reveal-zoom {
    transform: translate3d(0, 26px, 0) scale(0.965);
  }

  :global(html.va) [data-reveal].in {
    opacity: 1;
    transform: translate3d(0, 0, 0);
