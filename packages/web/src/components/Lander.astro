      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }
  }

  /* ---- pinned scenes ----
     Each scene is a tall runway; its stage stays pinned a full viewport while
     scroll progress (--p, written by initScenes) drives the choreography.
     Everything is gated on html.va + desktop + motion-ok, so no-JS, reduced
     motion, and small screens all read the plain stacked layout. */

  .scene {
    position: relative;
  }

  .scene-stage {
    position: relative;
  }

  .scene-rail,
  .workflow-rail {
    display: none;
  }

  @media (min-width: 641px) and (prefers-reduced-motion: no-preference) {
    :global(html.va) .scene[data-scene] {
      height: calc(var(--scene-span, 2.4) * 100vh);
      height: calc(var(--scene-span, 2.4) * 100svh);
    }

    :global(html.va) .scene-stage {
      position: sticky;
      top: 0;
      height: 100vh;
      height: 100svh;
      display: flex;
      flex-direction: column;
      /* safe center: on short viewports overflow clips at the bottom only,
         never under the nav. */
      justify-content: safe center;
      overflow: clip;
      /* Clear the sticky glass nav so pinned chapter heads never sit under it. */
      padding-top: 96px;
      padding-bottom: 20px;
    }

    /* Scenes whose content can't fit a pinned viewport (short windows) become
       plain, fully-revealed sections — initScenes marks them data-static. */
    :global(html.va) .scene[data-static] {
      height: auto;
    }

    :global(html.va) .scene[data-static] .scene-stage {
      position: static;
      display: block;
      height: auto;
      padding: 0;
      overflow: visible;
    }

    :global(html.va) .scene[data-static] .hero,
    :global(html.va) .scene[data-static] .showcase,
