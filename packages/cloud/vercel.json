{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/p/:project/:path*", "destination": "/api/site?project=:project&path=:path*" },
    { "source": "/p/:project", "destination": "/api/site?project=:project&path=" },
    { "source": "/s/:slug/:path*", "destination": "/api/site?slug=:slug&path=:path*" },
    { "source": "/s/:slug", "destination": "/api/site?slug=:slug&path=" }
  ]
}
