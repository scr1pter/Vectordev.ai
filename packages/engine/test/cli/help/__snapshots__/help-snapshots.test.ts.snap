exports[`vector CLI help-text snapshots every documented command emits stable help text: vector review --help 1`] = `
"vector review

Vectorscope: review your branch, uncommitted changes or a pull request

Options:
  -h, --help          show help                                                            [boolean]
  -v, --version       show version number                                                  [boolean]
      --print-logs    print logs to stderr                                                 [boolean]
      --log-level     log level                 [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure          run without external plugins                                         [boolean]
      --base          branch or commit to compare with (default: the merge-base with origin's
                      default branch)                                                       [string]
      --uncommitted   review changes you have not committed, untracked files included      [boolean]
      --staged        review only staged changes                                           [boolean]
      --pr            review pull request <n> from origin without checking it out           [number]
      --post          post the review to the pull request (with --pr)                      [boolean]
      --yes           answer yes to confirmation questions                                 [boolean]
      --json          print { version, target, outcome } as JSON                           [boolean]
      --model         model to review with, as provider/model                               [string]
      --security      always run the security reviewer (--no-security: never)              [boolean]
      --max-comments  findings listed in detail, 0 to 50 (default 10)                       [number]
      --min-severity  lowest severity listed in detail (default concern)
                                                    [string] [choices: "blocking", "concern", "nit"]
      --max-cost      stop the review at this many US dollars; 0 for no limit               [number]
      --fail-on       exit 1 while findings of this severity or above are open
                                                  [string] [choices: "blocking", "concern", "never"]
      --checks        let the reviewer run your tests and typecheck                        [boolean]
      --full          review the whole change again, ignoring the last local review        [boolean]"
`;

