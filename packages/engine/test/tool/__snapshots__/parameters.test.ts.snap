exports[`tool parameters JSON Schema (wire shape) task 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "budget": {
      "description": "Shared ceiling for this entire batch, subordinate to the parent run budget",
      "properties": {
        "steps": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
        "unpricedSteps": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
        "usd": {
          "exclusiveMinimum": 0,
          "type": "number",
        },
        "warnAt": {
          "maximum": 1,
          "minimum": 0,
          "type": "number",
        },
      },
      "type": "object",
    },
    "tasks": {
      "description": "One to eight complete, independent subagent briefs",
      "items": {
        "properties": {
          "budget": {
            "description": "A child spend/step ceiling subordinate to the parent run budget",
            "properties": {
              "steps": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer",
              },
              "unpricedSteps": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer",
              },
              "usd": {
                "exclusiveMinimum": 0,
                "type": "number",
              },
              "warnAt": {
                "maximum": 1,
                "minimum": 0,
                "type": "number",
              },
            },
            "type": "object",
          },
          "command": {
            "description": "The command that triggered this task",
            "type": "string",
          },
          "context_pack": {
            "description": "Established paths, symbols and findings the child can reuse; maximum 8192 UTF-8 bytes",
            "properties": {
              "findings": {
                "items": {
                  "type": "string",
                },
                "maxItems": 16,
                "type": "array",
              },
              "paths": {
                "items": {
                  "type": "string",
                },
                "maxItems": 32,
                "type": "array",
              },
              "symbols": {
                "items": {
                  "type": "string",
                },
                "maxItems": 32,
                "type": "array",
              },
            },
            "type": "object",
          },
          "depends_on": {
            "description": "Task IDs that must complete successfully before this subagent starts",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "description": {
            "description": "A short (3-5 words) title for this subagent, shown to the user on its card, e.g. "Map auth middleware". Make it specific and distinct from sibling subagents",
            "type": "string",
          },
          "owned_paths": {
            "description": "Repository-relative files or directory prefixes this subagent owns. Vector rejects overlapping ownership among active sibling subagents",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "prompt": {
            "description": "A standalone brief; the subagent sees none of your conversation",
            "type": "string",
          },
          "subagent_type": {
            "description": "A listed agent type. Omit it for general only when general is listed",
            "type": "string",
          },
          "success_criteria": {
            "description": "Observable conditions the subagent must verify before reporting completion",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "task_id": {
            "description": "Set only to resume a child of this session, which continues with its earlier messages and tool outputs instead of starting fresh. An unknown ID fails without starting work",
            "type": "string",
          },
        },
        "required": [
          "description",
          "prompt",
        ],
        "type": "object",
      },
      "maxItems": 8,
      "minItems": 1,
      "type": "array",
    },
  },
  "required": [
    "tasks",
  ],
  "type": "object",
}
`;

