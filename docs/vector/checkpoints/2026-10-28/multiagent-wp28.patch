+import { MessageID } from "@/session/schema"
+import { testEffect } from "../lib/effect"
+
+const it = testEffect(
+  AppNodeBuilder.build(
+    LayerNode.group([
+      Session.node,
+      SessionProjector.node,
+      SessionAudience.node,
+      EventV2Bridge.node,
+      CrossSpawnSpawner.node,
+    ]),
+  ),
+)
