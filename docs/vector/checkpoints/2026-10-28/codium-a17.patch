+    micro: input.requiredMicro,
+    day: new Date(now).toISOString().slice(0, 10),
+    epoch: input.snapshot.meterEpoch,
+    version: input.snapshot.version,
+    deadline: now + MODEL_HOLD_MS,
+    periodEnd: input.funding.end * 1000,
