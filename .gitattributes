packages/core/migration/**/snapshot.json linguist-generated
packages/core/src/database/migration.gen.ts linguist-generated

# Release audits compare these checked-in bytes with recorded hashes and generated output.
/LICENSE text eol=lf
/THIRD_PARTY_NOTICES.md text eol=lf
/DEPENDENCY_NOTICES.md text eol=lf
/licenses/** text eol=lf
/packages/web/public/config.json text eol=lf
/packages/web/public/tui.json text eol=lf
/packages/web/public/install text eol=lf

# Review output is compared byte-for-byte with these canonical fixtures.
/packages/core/test/review/fixtures/*.golden.txt text eol=lf

# Prompts and tool descriptions go to the model as written, so a Windows checkout must not add carriage returns to them.
/packages/engine/src/**/*.txt text eol=lf
/packages/core/src/**/*.txt text eol=lf

# Vector Hands' helper inputs: blocklist.json is compared byte-for-byte with a fresh render and embedded verbatim in
# the native helpers' generated sources, and the native helpers read the conformance transcripts line by line.
/packages/desktop/native/computer-helper/*.json text eol=lf
/packages/desktop/test/fixtures/computer-protocol/*.jsonl text eol=lf
