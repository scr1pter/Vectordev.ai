# Vector accounts (server-only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Signs vct_ CLI tokens (unless VECTOR_CLI_TOKEN_SECRET is set) and keys rate limits.
# Keep the existing value: changing it signs every terminal out.
VECTOR_LICENSE_SECRET=

# Bug-report email (Resend)
RESEND_API_KEY=
VECTOR_PURCHASE_EMAIL_FROM=Vector <support@your-domain.example>

# Public production URLs
VECTOR_PUBLIC_URL=https://vectordev.ai
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Hosted OAuth broker for Vector Desktop Cloud Services
VECTOR_OAUTH_PUBLIC_URL=https://vectordev.ai
VECTOR_OAUTH_STATE_SECRET=
VECTOR_VERCEL_INTEGRATION_SLUG=
VECTOR_VERCEL_CLIENT_ID=
VECTOR_VERCEL_CLIENT_SECRET=
VECTOR_SUPABASE_CLIENT_ID=
VECTOR_SUPABASE_CLIENT_SECRET=

# Vector Help AI assistant. Server-side only — the desktop bundle never ships it.
# Groq retires hosted models without notice; if help starts returning
# HELP_UPSTREAM_404, pick a current id from https://api.groq.com/openai/v1/models
GROQ_API_KEY=
GROQ_HELP_MODEL=openai/gpt-oss-120b

# Persistent Codium billing storage (server-only).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vector Codium monthly plans (server-only; payment connection deferred). There are no top-ups.
MODEL_PLANS_ENABLED=false
# live or test, matching STRIPE_SECRET_KEY (sk_/rk_ live or test). A live key runs only with VERCEL_ENV=production.
# Every Codium store key sits under vector:codium:<mode>:, so test and live records never mix.
CODIUM_STRIPE_MODE=
STRIPE_SECRET_KEY=
STRIPE_MODEL_PLAN_WEBHOOK_SECRET=
STRIPE_MODEL_PLAN_PORTAL_CONFIG_ID=
# Optional: the portal that also changes plans, opened only while Codium is on sale and funded.
STRIPE_MODEL_PLAN_CHANGE_PORTAL_CONFIG_ID=
OPENROUTER_MANAGEMENT_KEY=
MODEL_PLAN_KEY_ENCRYPTION_SECRET=
STRIPE_MODEL_PLAN_10_PRICE_ID=
STRIPE_MODEL_PLAN_50_PRICE_ID=
STRIPE_MODEL_PLAN_100_PRICE_ID=
STRIPE_MODEL_PLAN_200_PRICE_ID=
# Configure private credit allowances or a private markup in the hosting environment before enabling sales.
# There is no default allowance or markup; missing private configuration leaves purchases unavailable.
# Codium stays off unless Pro, Max and Ultra credits are 5.5x, 12x and 25x Plus's (within 0.05), the public
# usage multiples; a markup alone scales by price and cannot meet them.
MODEL_CREDIT_MARKUP_PERCENT=
MODEL_PLAN_10_CREDITS_USD=
MODEL_PLAN_50_CREDITS_USD=
MODEL_PLAN_100_CREDITS_USD=
MODEL_PLAN_200_CREDITS_USD=
# Blank uses the reviewed coding catalog; [] intentionally disables all models.
MODEL_PLAN_MODELS_JSON=
# Oldest desktop or CLI version Codium serves, like 1.99.113. Blank uses the compiled-in minimum.
MODEL_PLANS_MIN_CLIENT=
# Only tokens marked for Codium spend it (default true); set false only to debug.
MODEL_PLAN_REQUIRE_MARKED_TOKENS=
# Stripe test mode only: each OpenRouter key Codium creates is capped at this many dollars (default 0.50, at most 200),
# and test checkout is open only to the comma-separated admin emails below.
CODIUM_TEST_CREDIT_CAP_USD=
VECTOR_ADMIN_EMAILS=
# Server-only limits (defaults 7 days, 120 minutes; the grace is at most 360).
CODIUM_TRUST_RAMP_DAYS=
CODIUM_RENEWAL_GRACE_MINUTES=
# Codium funding check and private ledger (docs/vector/owner-actions/codium-payments.md).
# Pause and reopen emails go here (falls back to VECTOR_BUG_REPORT_TO); they use RESEND_API_KEY above.
CODIUM_OWNER_EMAIL=
# At least 32 characters; the only key to GET /api/model-plans/ledger.
CODIUM_OWNER_SECRET=
# New sales need OpenRouter's balance to cover what customers hold or are buying, plus this margin (defaults 10 and 20).
CODIUM_FUNDING_MARGIN_PERCENT=
CODIUM_FUNDING_MARGIN_USD=
# OpenRouter's fee on credit purchases, for the ledger's estimate (default 5.5).
CODIUM_OPENROUTER_FEE_PERCENT=
