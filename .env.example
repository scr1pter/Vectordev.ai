# Vector accounts (Supabase Auth + server-owned product data)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional allowlist. Leave empty to discover providers enabled in Supabase Auth.
VECTOR_AUTH_PROVIDERS=
VECTOR_PLATFORM_SECRET=
# Keep the immediately previous vault key here during rotations so saved
# environments and MCP connections can be read and re-saved with the new key.
VECTOR_PLATFORM_SECRET_PREVIOUS=

# Vector monthly and annual billing and licensing (server-only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
VECTOR_LICENSE_SECRET=
RESEND_API_KEY=
VECTOR_PURCHASE_EMAIL_FROM=Vector <licenses@your-domain.example>

# Vector Cloud Agents (OpenRouter models + isolated Vercel Sandboxes)
OPENROUTER_API_KEY=
VECTOR_CLOUD_AGENT_MODEL=openrouter/openrouter/free
VECTOR_CLOUD_AGENT_MODELS=openrouter/openrouter/free,openrouter/poolside/laguna-s-2.1:free,openrouter/cohere/north-mini-code:free,openrouter/nvidia/nemotron-3-super-120b-a12b:free,openrouter/openai/gpt-oss-20b:free
VECTOR_CLOUD_AGENT_ENGINE_COMMAND=opencode
VECTOR_CLOUD_SANDBOX_IMAGE=
VECTOR_CLOUD_AGENT_MAX_MINUTES=30
VECTOR_CLOUD_AGENT_30_DAY_LAUNCH_LIMIT=24
VECTOR_CLOUD_AGENT_30_DAY_TURN_LIMIT=240
VECTOR_API_DAILY_EXECUTION_LIMIT=500
CRON_SECRET=

# Public production URLs
VECTOR_PUBLIC_URL=https://vectordev.ai
VECTOR_INSTALLER_BLOB_PREFIX=releases/vector-downloads
VECTOR_INSTALLER_BLOB_PRIVATE=true
VECTOR_INSTALLER_BLOB_TOKEN=vercel_blob_rw_...
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
