{
  "installCommand": "bun install",
  "buildCommand": "bun --cwd packages/web build && node script/prune-vector-site.mjs",
  "outputDirectory": "packages/web/dist",
  "redirects": [
    {
      "source": "/account",
      "destination": "/download",
      "permanent": true
    },
    {
      "source": "/billing",
      "destination": "/download",
      "permanent": true
    },
    {
      "source": "/settings",
      "destination": "/download",
      "permanent": true
    },
    {
      "source": "/builder",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/play-park",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cloud-agents",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/api-studio",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/download/mac",
      "destination": "/download?target=mac-arm64",
      "permanent": false
    },
    {
      "source": "/download/mac-arm64",
      "destination": "/download?target=mac-arm64",
      "permanent": false
    },
    {
      "source": "/download/mac-x64",
      "destination": "/download?target=mac-x64",
      "permanent": false
    },
    {
      "source": "/download/windows",
      "destination": "/download?target=windows-x64",
      "permanent": false
    },
    {
      "source": "/download/windows-x64",
      "destination": "/download?target=windows-x64",
      "permanent": false
    },
    {
      "source": "/download/windows-arm64",
      "destination": "/download?target=windows-arm64",
      "permanent": false
    },
    {
      "source": "/download/linux",
      "destination": "/download?target=linux-x64",
      "permanent": false
    },
    {
      "source": "/download/linux-x64",
      "destination": "/download?target=linux-x64",
      "permanent": false
    },
    {
      "source": "/download/linux-arm64",
      "destination": "/download?target=linux-arm64",
      "permanent": false
    },
    {
      "source": "/download/checksums",
      "destination": "/api/download-checksums",
      "permanent": false
    }
  ]
}
