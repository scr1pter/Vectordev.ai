{
  "git": {
    "deploymentEnabled": {
      "workspace-redesign": false,
      "vector-only": false
    }
  },
  "installCommand": "bun install",
  "functions": {
    "api/design-lab/serve.ts": {
      "includeFiles": "design-lab/**"
    }
  },
  "buildCommand": "bun --cwd packages/web build && node script/prune-vector-site.mjs",
  "outputDirectory": "packages/web/dist",
