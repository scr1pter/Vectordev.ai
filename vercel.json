    {
      "source": "/download/windows-arm64",
      "destination": "/download?target=windows-arm64",
      "permanent": false
    },
    {
      "source": "/download/linux",
      "destination": "/download?target=linux-x64",
      "permanent": false
    },
    {
      "source": "/download/linux-x64",
      "destination": "/download?target=linux-x64",
      "permanent": false
    },
    {
      "source": "/download/linux-arm64",
      "destination": "/download?target=linux-arm64",
      "permanent": false
    },
    {
      "source": "/download/checksums",
      "destination": "/api/download-checksums",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=(), microphone=()"
        }
      ]
    },
    {
      "source": "/s/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/install",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/install.ps1",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/design-lab/:path*",
      "destination": "/api/design-lab/serve?path=:path*"
    },
    {
      "source": "/s/:id([a-f0-9]{32})",
      "destination": "/s/index.html"
    },
    {
      "source": "/models",
      "destination": "/models/api.json"
    },
    {
      "source": "/api/billing/config",
      "destination": "/api/legacy-desktop-access"
    },
    {
      "source": "/api/billing/status",
      "destination": "/api/legacy-desktop-access"
    }
  ],
  "crons": [
    {
      "path": "/api/free-models/refresh",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/shares/cleanup",
      "schedule": "*/10 * * * *"
    }
  ]
}
