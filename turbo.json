{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI"],
  "globalPassThroughEnv": ["CI", "ASTRO_TELEMETRY_DISABLED", "XDG_CONFIG_HOME"],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "@vectordevai/engine#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["*"]
    },
    "@vectordevai/core#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["COMSPEC", "PATHEXT", "PSModuleAnalysisCachePath"]
    },
    "@vectordevai/app#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@vectordevai/ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@vectordevai/session-ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
